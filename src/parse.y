%प्रकार व्यञ्जकम्_2 {व्यञ्जकम्*}
%destructor व्यञ्जकम्_2 {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}
%प्रकार पदांशः {व्यञ्जकम्*}
%destructor पदांशः {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  स्थिर व्यञ्जकम् *token_व्यञ्जकम्(Parse *pParse, पूर्णाङ्क op, Token t){
    व्यञ्जकम् *p = sqlite3DbMallocRawNN(pParse->db, परिमाण(व्यञ्जकम्)+t.n+1);
    यदि( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_व्यञ्जकम् = 0;
      p->flags = EP_पर्णम्;
      व्यञ्जकम्_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_वामः = p->p_दक्षिणः = 0;
      p->pAggInfo = 0;
      स्मृतिं_पूरय(&p->x, 0, परिमाण(p->x));
      स्मृतिं_पूरय(&p->y, 0, परिमाण(p->y));
      p->op2 = 0;
      p->i_सारणी = 0;
      p->iColumn = 0;
      p->u.zToken = (वर्ण*)&p[1];
      स्मृतिं_प्रतिलिख(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (पूर्णाङ्क)(t.z - pParse->z_पुच्छ);
      यदि( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_व्यञ्जकम्(p);
      }
#यदि SQLITE_MAX_व्यञ्जकम्_गभीरता>0
      p->nHeight = 1;
#यदि_अन्तः  
      यदि( अन्तर्_RENAME_OBJECT ){
        प्रत्यागम (व्यञ्जकम्*)sqlite3RenameTokenMap(pParse, (शून्य*)p, &t);
      }
    }
    प्रत्यागम p;
  }

}

व्यञ्जकम्_2(A) ::= पदांशः(A).
व्यञ्जकम्_2(A) ::= LP व्यञ्जकम्_2(X) RP. {A = X;}
व्यञ्जकम्_2(A) ::= idj(X).          {A=token_व्यञ्जकम्(pParse,TK_ID,X); /*A-overwrites-X*/}
व्यञ्जकम्_2(A) ::= nm(X) DOT nm(Y). {
  व्यञ्जकम् *temp1 = token_व्यञ्जकम्(pParse,TK_ID,X);
  व्यञ्जकम् *temp2 = token_व्यञ्जकम्(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
व्यञ्जकम्_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  व्यञ्जकम् *temp1 = token_व्यञ्जकम्(pParse,TK_ID,X);
  व्यञ्जकम् *temp2 = token_व्यञ्जकम्(pParse,TK_ID,Y);
  व्यञ्जकम् *temp3 = token_व्यञ्जकम्(pParse,TK_ID,Z);
  व्यञ्जकम् *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  यदि( अन्तर्_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
पदांशः(A) ::= रिक्त|FLOAT|BLOB(X). {A=token_व्यञ्जकम्(pParse,@X,X); /*A-overwrites-X*/}
पदांशः(A) ::= STRING(X).          {A=token_व्यञ्जकम्(pParse,@X,X); /*A-overwrites-X*/}
पदांशः(A) ::= INTEGER(X). {
  पूर्णाङ्क i_मानम्;
  यदि( sqlite3GetInt32(X.z, &i_मानम्)==0 ){
    A = sqlite3_व्यञ्जकम्_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }अन्यथा{
    A = sqlite3_व्यञ्जकम्_Int32(pParse->db, i_मानम्);
  }
  यदि( A ) A->w.iOfst = (पूर्णाङ्क)(X.z - pParse->z_पुच्छ);
}
व्यञ्जकम्_2(A) ::= VARIABLE(X).     {
  यदि( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_व्यञ्जकम्(pParse, TK_VARIABLE, X);
    sqlite3_व्यञ्जकम्_नियोजय_Var_सङ्ख्या(pParse, A, n);
  }अन्यथा{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    प्रतिज्ञा( t.n>=2 );
    यदि( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }अन्यथा{
      A = sqlite3PExpr(pParse, TK_पञ्जिकाकोशः, 0, 0);
      यदि( A ) sqlite3GetInt32(&t.z[1], &A->i_सारणी);
    }
  }
}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) COLLATE ids(C). {
  A = sqlite3_व्यञ्जकम्_सङ्कलय_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
व्यञ्जकम्_2(A) ::= CAST LP व्यञ्जकम्_2(E) AS typetoken(T) RP. {
  A = sqlite3_व्यञ्जकम्_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_व्यञ्जकम्_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


व्यञ्जकम्_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_व्यञ्जकम्_Function(pParse, Y, &X, D);
}
व्यञ्जकम्_2(A) ::= idj(X) LP distinct(D) exprlist(Y) क्रमः BY sortlist(O) RP. {
  A = sqlite3_व्यञ्जकम्_Function(pParse, Y, &X, D);
  sqlite3_व्यञ्जकम्_सङ्कलय_Function_क्रमः_By(pParse, A, O);
}
व्यञ्जकम्_2(A) ::= idj(X) LP तारकम् RP. {
  A = sqlite3_व्यञ्जकम्_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_समुच्चयः_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  स्थिर व्यञ्जकम् *sqlite3_व्यञ्जकम्_सङ्कलय_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    पूर्णाङ्क isDistinct,        /* DISTINCT or ALL qualifier */
    व्यञ्जकम्_List *pOrig,       /* Arguments to the function */
    व्यञ्जकम् *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    व्यञ्जकम्_List *p;           /* Modified argument list */
    व्यञ्जकम् *p_व्यञ्जकम्;           /* Final result */
    p = sqlite3_व्यञ्जकम्_List_Append(pParse, 0, pOrderby);
    यदि( pOrig ){
      पूर्णाङ्क i;
      प्रति(i=0; i<pOrig->n_व्यञ्जकम्; i++){
        p = sqlite3_व्यञ्जकम्_List_Append(pParse, p, pOrig->a[i].p_व्यञ्जकम्);
        pOrig->a[i].p_व्यञ्जकम् = 0;
      }
      sqlite3_व्यञ्जकम्_List_Delete(pParse->db, pOrig);
    }
    p_व्यञ्जकम् = sqlite3_व्यञ्जकम्_Function(pParse, p, pFuncname, 0);
    यदि( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      प्रतिज्ञा( p_व्यञ्जकम्!=0 );  /* Because otherwise pParse->nErr would not be zero */
      प्रतिज्ञा( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3FindFunction(pParse->db, p_व्यञ्जकम्->u.zToken, -2, enc, 0);
      यदि( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_सन्देशः(pParse, "%#T() is not an ordered-set aggregate", p_व्यञ्जकम्);
      }अन्यथा यदि( isDistinct==SF_Distinct ){
        sqlite3_Error_सन्देशः(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    प्रत्यागम p_व्यञ्जकम्;
  }
}
