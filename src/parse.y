// Setup for the parser stack
%stack_size        50                        // Initial stack size
%stack_size_limit  parser_దొంతర_కొలత_హద్దు      // Function returning max stack size
%realloc           parser_దొంతర_Realloc        // realloc() for the stack
%విడుదల              parser_దొంతర_Free           // free() for the stack

// All token codes are small integers with #defines that begin with "TK_"
%token_prefix TK_

// The type of the data attached to each token is Token.  This is also the
// default type for non-terminals.
//
%token_type {Token}
%default_type {Token}

// An extra argument to the constructor for the parser, which is available
// to all actions.
%extra_context {Parse *pParse}

// This code runs whenever there is a syntax error
//
%syntax_error {
  వాడని_PARAMETER(yymajor);  /* Silence some compiler warnings */
  ఒకవేళ( TOKEN.z[0] ){
    parserSyntaxError(pParse, &TOKEN);
  }లేకపోతే{
    sqlite3_Error_సందేశం(pParse, "incomplete input");
  }
}
%stack_overflow {
  ఒకవేళ( pParse->nErr==0 ) sqlite3_Error_సందేశం(pParse, "Recursion limit");
}

// The name of the generated procedure that implements the parser
// is as follows:
%name sqlite3Parser

// The following text is included near the beginning of the C source
// code file that implements the parser.
//
%include {
#అన్తర్భావ "sqliteInt.h"

/*
** Verify that the pParse->isCreate field is set
*/
#నిర్వచించు ASSERT_IS_CREATE   ప్రతిజ్ఞా(pParse->isCreate)

/*
** Disable all error recovery processing in the parser push-down
** automaton.
*/
#నిర్వచించు YYNOERRORRECOVERY 1

/*
** Make yytestcase() the same as testcase()
*/
#నిర్వచించు yytestcase(X) testcase(X)

/*
** Indicate that sqlite3ParserFree() will never be called with a null
** pointer.
*/
#నిర్వచించు YYPARSEFREENEVERNULL 1

/*
** In the amalgamation, the parse.c file generated by lemon and the
** tokenize.c file are concatenated.  In that case, sqlite3RunParser()
** has access to the the size of the yyParser object and so the parser
** engine can be allocated from stack.  In that case, only the
** sqlite3ParserInit() and sqlite3ParserFinalize() routines are invoked
** and the sqlite3ParserAlloc() and sqlite3ParserFree() routines can be
** omitted.
*/
#నిర్వచితమైతే SQLITE_AMALGAMATION
# define sqlite3Parser_ENGINEALWAYSONSTACK 1
#అయితే_ముగింపు

/*
** Alternative datatype for the argument to the malloc() routine passed
** into sqlite3ParserAlloc().  The default is size_t.
*/
#నిర్వచించు YYMALLOCARGTYPE  u64

/*
** An instance of the following structure describes the event of a
** TRIGGER.  "a" is the event type, one of TK_UPDATE, TK_INSERT,
** TK_DELETE, or TK_INSTEAD.  If the event is of the form
**
**      UPDATE ON (a,b,c)
**
** Then the "b" IdList records the list "a,b,c".
*/
నిర్మాణం TrigEvent { పూర్ణాంకం a; IdList * b; };

నిర్మాణం చట్రం_Bound     { పూర్ణాంకం eType; సమాసం *p_సమాసం; };

/*
** Generate a syntax error
*/
స్థిర శూన్య parserSyntaxError(Parse *pParse, Token *p){
  sqlite3_Error_సందేశం(pParse, "near \"%T\": syntax error", p);
}

/*
** Disable lookaside memory allocation for objects that might be
** shared across database connections.
*/
స్థిర శూన్య disableLookaside(Parse *pParse){
  sqlite3 *db = pParse->db;
  pParse->disableLookaside++;
#నిర్వచితమైతే SQLITE_DEBUG
  pParse->isCreate = 1;
#అయితే_ముగింపు
  memset(&pParse->u1.cr, 0, పరిమాణం(pParse->u1.cr));
  DisableLookaside;
}

#ఒకవేళ !defined(SQLITE_ENABLE_UPDATE_DELETE_హద్దు) \
 && defined(SQLITE_UDL_CAPABLE_PARSER)
/*
** Issue an error message if an ORDER BY or LIMIT clause occurs on an
** UPDATE or DELETE statement.
*/
స్థిర శూన్య update_Delete_హద్దు_Error(
  Parse *pParse,
  సమాసం_List *p_క్రమం_By,
  సమాసం *p_హద్దు
){
  ఒకవేళ( p_క్రమం_By ){
    sqlite3_Error_సందేశం(pParse, "syntax error near \"ORDER BY\"");
  }లేకపోతే{
    sqlite3_Error_సందేశం(pParse, "syntax error near \"LIMIT\"");
  }
  sqlite3_సమాసం_List_Delete(pParse->db, p_క్రమం_By);
  sqlite3_సమాసం_Delete(pParse->db, p_హద్దు);
}
#అయితే_ముగింపు /* SQLITE_ENABLE_UPDATE_DELETE_LIMIT */

} // end %include

// Input is a single SQL command
ఆదానం ::= cmdlist.
cmdlist ::= cmdlist ecmd.
cmdlist ::= ecmd.
ecmd ::= SEMI.
ecmd ::= cmdx SEMI.
%ifndef SQLITE_OMIT_EXPLAIN
ecmd ::= explain cmdx SEMI.       {NEVER-REDUCE}
explain ::= EXPLAIN.              { ఒకవేళ( pParse->pReprepare==0 ) pParse->explain = 1; }
explain ::= EXPLAIN QUERY PLAN.   { ఒకవేళ( pParse->pReprepare==0 ) pParse->explain = 2; }
%endif  SQLITE_OMIT_EXPLAIN
cmdx ::= cmd.           { sqlite3_ముగింపు_Coding(pParse); }

///////////////////// Begin and end transactions. ////////////////////////////
//

cmd ::= BEGIN transtype(Y) trans_opt.  {sqlite3BeginTransaction(pParse, Y);}
trans_opt ::= .
trans_opt ::= TRANSACTION.
trans_opt ::= TRANSACTION nm.
%రకం transtype {పూర్ణాంకం}
transtype(A) ::= .             {A = TK_DEFERRED;}
transtype(A) ::= DEFERRED(X).  {A = @X; /*A-overwrites-X*/}
transtype(A) ::= తక్షణ(X). {A = @X; /*A-overwrites-X*/}
transtype(A) ::= EXCLUSIVE(X). {A = @X; /*A-overwrites-X*/}
cmd ::= COMMIT|చివర(X) trans_opt.   {sqlite3_చివర_Transaction(pParse,@X);}
cmd ::= ROLLBACK(X) trans_opt.     {sqlite3_చివర_Transaction(pParse,@X);}

savepoint_opt ::= SAVEPOINT.
savepoint_opt ::= .
cmd ::= SAVEPOINT nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_BEGIN, &X);
}
cmd ::= RELEASE savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_RELEASE, &X);
}
cmd ::= ROLLBACK trans_opt గమ్యం_2 savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_ROLLBACK, &X);
}

///////////////////// The CREATE TABLE statement ////////////////////////////
//
cmd ::= create_పట్టిక create_పట్టిక_వాదనలు.
create_పట్టిక ::= createkw తాత్కాలిక(T) పట్టిక_3 ifnotexists(E) nm(Y) dbnm(Z). {
   sqlite3_ప్రారంభం_పట్టిక(pParse,&Y,&Z,T,0,0,E);
}
createkw(A) ::= CREATE(A).  {
  disableLookaside(pParse);
}

%రకం ifnotexists {పూర్ణాంకం}
ifnotexists(A) ::= .              {A = 0;}
ifnotexists(A) ::= IF NOT EXISTS. {A = 1;}
%రకం తాత్కాలిక {పూర్ణాంకం}
%ifndef SQLITE_OMIT_TEMPDB
తాత్కాలిక(A) ::= తాత్కాలిక_2.  {A = pParse->db->init.busy==0;}
%endif  SQLITE_OMIT_TEMPDB
తాత్కాలిక(A) ::= .      {A = 0;}
create_పట్టిక_వాదనలు ::= LP columnlist conslist_opt(X) RP(E) పట్టిక_option_సమితి(F). {
  sqlite3_చివర_పట్టిక(pParse,&X,&E,F,0);
}
create_పట్టిక_వాదనలు ::= AS select(S). {
  sqlite3_చివర_పట్టిక(pParse,0,0,0,S);
  sqlite3SelectDelete(pParse->db, S);
}
%రకం పట్టిక_option_సమితి {u32}
%రకం పట్టిక_option {u32}
పట్టిక_option_సమితి(A) ::= .    {A = 0;}
పట్టిక_option_సమితి(A) ::= పట్టిక_option(A).
పట్టిక_option_సమితి(A) ::= పట్టిక_option_సమితి(X) COMMA పట్టిక_option(Y). {A = X|Y;}
పట్టిక_option(A) ::= WITHOUT nm(X). {
  ఒకవేళ( X.n==5 && sqlite3_strnicmp(X.z,"rowid",5)==0 ){
    A = TF_WithoutRowid | TF_NoVisibleRowid;
  }లేకపోతే{
    A = 0;
    sqlite3_Error_సందేశం(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
పట్టిక_option(A) ::= nm(X). {
  ఒకవేళ( X.n==6 && sqlite3_strnicmp(X.z,"strict",6)==0 ){
    A = TF_Strict;
  }లేకపోతే{
    A = 0;
    sqlite3_Error_సందేశం(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
columnlist ::= columnlist COMMA columnname carglist.
columnlist ::= columnname carglist.
columnname(A) ::= nm(A) typetoken(Y). {sqlite3_కూడు_స్తంభం(pParse,A,Y);}

// Declare some tokens early in order to influence their values, to 
// improve performance and reduce the executable size.  The goal here is
// to get the "jump" operations in ISNULL through ESCAPE to have numeric
// values that are early enough so that all jump operations are clustered
// at the beginning.  Also, operators like NE and EQ need to be adjacent,
// and all of the comparison operators need to be clustered together.
// Various assert() statements throughout the code enforce these restrictions.
//
%token ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST.
%token CONFLICT DATABASE DEFERRED DESC DETACH EACH చివర EXCLUSIVE EXPLAIN FAIL.
%token OR AND NOT IS ISNOT సరిపోలిక_2 LIKE_KW BETWEEN లోపల_2 ISNULL NOTNULL NE EQ.
%token GT LE LT GE ESCAPE.

// The following directive causes tokens ABORT, AFTER, ASC, etc. to
// fallback to ID if they will not parse as their original value.
// This obviates the need for the "id" nonterminal.
//
%fallback ID
  ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST COLUMNKW
  CONFLICT DATABASE DEFERRED DESC DETACH DO
  EACH చివర EXCLUSIVE EXPLAIN FAIL FOR
  IGNORE తక్షణ INITIALLY INSTEAD LIKE_KW సరిపోలిక_2 NO PLAN
  QUERY కీలకం_2 యొక్క_2 స్థానభ్రంశం_3 PRAGMA RAISE RECURSIVE RELEASE REPLACE RESTRICT అడ్డువరుస అడ్డువరుసలు
  ROLLBACK SAVEPOINT తాత్కాలిక_2 TRIGGER VACUUM VIEW VIRTUAL WITH WITHOUT
  NULLS మొదటి_2 చివరి
%ifdef SQLITE_OMIT_COMPOUND_SELECT
  EXCEPT INTERSECT UNION
%endif SQLITE_OMIT_COMPOUND_SELECT
%ifndef SQLITE_OMIT_WINDOWFUNC
  CURRENT FOLLOWING విభజన PRECEDING RANGE UNBOUNDED
  EXCLUDE GROUPS OTHERS TIES
%endif SQLITE_OMIT_WINDOWFUNC
%ifdef SQLITE_ENABLE_ORDERED_సమితి_AGGREGATES
  WITHIN
%endif SQLITE_ENABLE_ORDERED_సమితి_AGGREGATES
%ifndef SQLITE_OMIT_GENERATED_COLUMNS
  GENERATED ALWAYS
%endif
  MATERIALIZED
  REINDEX RENAME CTIME_KW IF
  .
%wildcard ANY.

// Define operator precedence early so that this is the first occurrence
// of the operator tokens in the grammar.  Keeping the operators together
// causes them to be assigned integer values that are close together,
// which keeps parser tables smaller.
//
// The token values assigned to these symbols is determined by the order
// in which lemon first sees them.  It must be the case that ISNULL/NOTNULL,
// NE/EQ, GT/LE, and GE/LT are separated by only a single value.  See
// the sqlite3ExprIfFalse() routine for additional information on this
// constraint.
//
%ఎడమ OR.
%ఎడమ AND.
%కుడి NOT.
%ఎడమ IS సరిపోలిక_2 LIKE_KW BETWEEN లోపల_2 ISNULL NOTNULL NE EQ.
%ఎడమ GT LE LT GE.
%కుడి ESCAPE.
%ఎడమ BITAND BITOR LSHIFT RSHIFT.
%ఎడమ PLUS MINUS.
%ఎడమ నక్షత్రం SLASH REM.
%ఎడమ CONCAT PTR.
%ఎడమ COLLATE.
%కుడి BITNOT.
%nonassoc ON.

// An IDENTIFIER can be a generic identifier, or one of several
// keywords.  Any non-standard keyword can also be an identifier.
//
%token_class id  ID|సూచీకృత.

// And "ids" is an identifier-or-string.
//
%token_class ids  ID|STRING.

// An identifier or a join-keyword
//
%token_class idj  ID|సూచీకృత|JOIN_KW.

// The name of a column or table can be any of the following:
//
%రకం nm {Token}
nm(A) ::= idj(A).
nm(A) ::= STRING(A).

// A typetoken is really zero or more tokens that form a type name such
// as can be found after the column name in a CREATE TABLE statement.
// Multiple tokens are concatenated to form the value of the typetoken.
//
%రకం typetoken {Token}
typetoken(A) ::= .   {A.n = 0; A.z = 0;}
typetoken(A) ::= typename(A).
typetoken(A) ::= typename(A) LP గుర్తుగల RP(Y). {
  A.n = (పూర్ణాంకం)(&Y.z[Y.n] - A.z);
}
typetoken(A) ::= typename(A) LP గుర్తుగల COMMA గుర్తుగల RP(Y). {
  A.n = (పూర్ణాంకం)(&Y.z[Y.n] - A.z);
}
%రకం typename {Token}
typename(A) ::= ids(A).
typename(A) ::= typename(A) ids(Y). {A.n=Y.n+(పూర్ణాంకం)(Y.z-A.z);}
గుర్తుగల ::= plus_అంకె.
గుర్తుగల ::= minus_అంకె.

// The scanpt non-terminal takes a value which is a pointer to the
// input text just past the last token that has been shifted into
// the parser.  By surrounding some phrase in the grammar with two
// scanpt non-terminals, we can capture the input text for that phrase.
// For example:
//
//      something ::= .... scanpt(A) phrase scanpt(Z).
//
// The text that is parsed as "phrase" is a string starting at A
// and containing (int)(Z-A) characters.  There might be some extra
// whitespace on either end of the text, but that can be removed in
// post-processing, if needed.
//
%రకం scanpt {స్థిరరాశి అక్షరం*}
scanpt(A) ::= . {
  ప్రతిజ్ఞా( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken.z;
}
scantok(A) ::= . {
  ప్రతిజ్ఞా( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken;
}

// "carglist" is a list of additional constraints that come after the
// column name and column type in a CREATE TABLE statement.
//
carglist ::= carglist ccons.
carglist ::= .
ccons ::= CONSTRAINT nm(X). {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
ccons ::= DEFAULT scantok(A) పదం(X).
                            {sqlite3_కూడు_Default_విలువ(pParse,X,A.z,&A.z[A.n]);}
ccons ::= DEFAULT LP(A) సమాసం_2(X) RP(Z).
                            {sqlite3_కూడు_Default_విలువ(pParse,X,A.z+1,Z.z);}
ccons ::= DEFAULT PLUS(A) scantok(Z) పదం(X).
                            {sqlite3_కూడు_Default_విలువ(pParse,X,A.z,&Z.z[Z.n]);}
ccons ::= DEFAULT MINUS(A) scantok(Z) పదం(X). {
  సమాసం *p = sqlite3PExpr(pParse, TK_UMINUS, X, 0);
  sqlite3_కూడు_Default_విలువ(pParse,p,A.z,&Z.z[Z.n]);
}
ccons ::= DEFAULT scantok id(X).       {
  సమాసం *p = token_సమాసం(pParse, TK_STRING, X);
  ఒకవేళ( p ){
    sqlite3_సమాసం_Id_గమ్యం_True_False(p);
    testcase( p->op==TK_TRUEFALSE && sqlite3_సమాసం_Truth_విలువ(p) );
  }
    sqlite3_కూడు_Default_విలువ(pParse,p,X.z,X.z+X.n);
}

// In addition to the type name, we also care about the primary key and
// UNIQUE constraints.
//
ccons ::= ఖాళీ onconf.
ccons ::= NOT ఖాళీ onconf(R).    {sqlite3_కూడు_Not_Null(pParse, R);}
ccons ::= PRIMARY కీలకం_2 sortorder(Z) onconf(R) autoinc(I).
                                 {sqlite3_కూడు_Primary_కీలకం(pParse,0,R,I,Z);}
ccons ::= UNIQUE onconf(R).      {sqlite3_Create_సూచీ(pParse,0,0,0,0,R,0,0,0,0,
                                   SQLITE_IDXTYPE_UNIQUE);}
ccons ::= CHECK LP(A) సమాసం_2(X) RP(B).  {sqlite3_కూడు_Check_Constraint(pParse,X,A.z,B.z);}
ccons ::= REFERENCES nm(T) eidlist_opt(TA) refargs(R).
                                 {sqlite3_Create_Foreign_కీలకం(pParse,0,&T,TA,R);}
ccons ::= defer_subclause(D).    {sqlite3_Defer_Foreign_కీలకం(pParse,D);}
ccons ::= COLLATE ids(C).        {sqlite3_కూడు_Collate_Type(pParse, &C);}
ccons ::= GENERATED ALWAYS AS generated.
ccons ::= AS generated.
generated ::= LP సమాసం_2(E) RP.          {sqlite3_కూడు_Generated(pParse,E,0);}
generated ::= LP సమాసం_2(E) RP ID(TYPE). {sqlite3_కూడు_Generated(pParse,E,&TYPE);}

// The optional AUTOINCREMENT keyword
%రకం autoinc {పూర్ణాంకం}
autoinc(X) ::= .          {X = 0;}
autoinc(X) ::= AUTOINCR.  {X = 1;}

// The next group of rules parses the arguments to a REFERENCES clause
// that determine if the referential integrity checking is deferred or
// or immediate and which determine what action to take if a ref-integ
// check fails.
//
%రకం refargs {పూర్ణాంకం}
refargs(A) ::= .                  { A = OE_None*0x0101; /* EV: R-19803-45884 */}
refargs(A) ::= refargs(A) refarg(Y). { A = (A & ~Y.ముసుగు) | Y.విలువ; }
%రకం refarg {నిర్మాణం {పూర్ణాంకం విలువ; పూర్ణాంకం ముసుగు;}}
refarg(A) ::= సరిపోలిక_2 nm.              { A.విలువ = 0;     A.ముసుగు = 0x000000; }
refarg(A) ::= ON చొప్పించు refact.      { A.విలువ = 0;     A.ముసుగు = 0x000000; }
refarg(A) ::= ON DELETE refact(X).   { A.విలువ = X;     A.ముసుగు = 0x0000ff; }
refarg(A) ::= ON UPDATE refact(X).   { A.విలువ = X<<8;  A.ముసుగు = 0x00ff00; }
%రకం refact {పూర్ణాంకం}
refact(A) ::= సమితి ఖాళీ.              { A = OE_సమితి_Null;  /* EV: R-33326-45252 */}
refact(A) ::= సమితి DEFAULT.           { A = OE_సమితి_Dflt;  /* EV: R-33326-45252 */}
refact(A) ::= CASCADE.               { A = OE_Cascade;  /* EV: R-33326-45252 */}
refact(A) ::= RESTRICT.              { A = OE_Restrict; /* EV: R-33326-45252 */}
refact(A) ::= NO ACTION.             { A = OE_None;     /* EV: R-33326-45252 */}
%రకం defer_subclause {పూర్ణాంకం}
defer_subclause(A) ::= NOT DEFERRABLE init_deferred_pred_opt.     {A = 0;}
defer_subclause(A) ::= DEFERRABLE init_deferred_pred_opt(X).      {A = X;}
%రకం init_deferred_pred_opt {పూర్ణాంకం}
init_deferred_pred_opt(A) ::= .                       {A = 0;}
init_deferred_pred_opt(A) ::= INITIALLY DEFERRED.     {A = 1;}
init_deferred_pred_opt(A) ::= INITIALLY తక్షణ.    {A = 0;}

conslist_opt(A) ::= .                         {A.n = 0; A.z = 0;}
conslist_opt(A) ::= COMMA(A) conslist.
conslist ::= conslist tconscomma tcons.
conslist ::= tcons.
tconscomma ::= COMMA.          {ASSERT_IS_CREATE; pParse->u1.cr.constraintName.n = 0;}
tconscomma ::= .
tcons ::= CONSTRAINT nm(X).    {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
tcons ::= PRIMARY కీలకం_2 LP sortlist(X) autoinc(I) RP onconf(R).
                                 {sqlite3_కూడు_Primary_కీలకం(pParse,X,R,I,0);}
tcons ::= UNIQUE LP sortlist(X) RP onconf(R).
                                 {sqlite3_Create_సూచీ(pParse,0,0,0,X,R,0,0,0,0,
                                       SQLITE_IDXTYPE_UNIQUE);}
tcons ::= CHECK LP(A) సమాసం_2(E) RP(B) onconf.
                                 {sqlite3_కూడు_Check_Constraint(pParse,E,A.z,B.z);}
tcons ::= FOREIGN కీలకం_2 LP eidlist(FA) RP
          REFERENCES nm(T) eidlist_opt(TA) refargs(R) defer_subclause_opt(D). {
    sqlite3_Create_Foreign_కీలకం(pParse, FA, &T, TA, R);
    sqlite3_Defer_Foreign_కీలకం(pParse, D);
}
%రకం defer_subclause_opt {పూర్ణాంకం}
defer_subclause_opt(A) ::= .                    {A = 0;}
defer_subclause_opt(A) ::= defer_subclause(A).

// The following is a non-standard extension that allows us to declare the
// default behavior when there is a constraint conflict.
//
%రకం onconf {పూర్ణాంకం}
%రకం orconf {పూర్ణాంకం}
%రకం resolvetype {పూర్ణాంకం}
onconf(A) ::= .                              {A = OE_Default;}
onconf(A) ::= ON CONFLICT resolvetype(X).    {A = X;}
orconf(A) ::= .                              {A = OE_Default;}
orconf(A) ::= OR resolvetype(X).             {A = X;}
resolvetype(A) ::= raisetype(A).
resolvetype(A) ::= IGNORE.                   {A = OE_Ignore;}
resolvetype(A) ::= REPLACE.                  {A = OE_Replace;}

////////////////////////// The DROP TABLE /////////////////////////////////////
//
cmd ::= DROP పట్టిక_3 ifexists(E) fullname(X). {
  sqlite3_Drop_పట్టిక(pParse, X, 0, E);
}
%రకం ifexists {పూర్ణాంకం}
ifexists(A) ::= IF EXISTS.   {A = 1;}
ifexists(A) ::= .            {A = 0;}

///////////////////// The CREATE VIEW statement /////////////////////////////
//
%ifndef SQLITE_OMIT_VIEW
cmd ::= createkw(X) తాత్కాలిక(T) VIEW ifnotexists(E) nm(Y) dbnm(Z) eidlist_opt(C)
          AS select(S). {
  sqlite3CreateView(pParse, &X, &Y, &Z, C, S, T, E);
}
cmd ::= DROP VIEW ifexists(E) fullname(X). {
  sqlite3_Drop_పట్టిక(pParse, X, 1, E);
}
%endif  SQLITE_OMIT_VIEW

//////////////////////// The SELECT statement /////////////////////////////////
//
cmd ::= select(X).  {
  SelectDest dest = {SRT_Output, 0, 0, 0, 0, 0, 0};
  ఒకవేళ( (pParse->db->mDbFlags & DBFLAG_EncodingFixed)!=0
   || sqlite3ReadSchema(pParse)==SQLITE_OK
  ){
    sqlite3Select(pParse, X, &dest);
  }
  sqlite3SelectDelete(pParse->db, X);
}

%రకం select {Select*}
%destructor select {sqlite3SelectDelete(pParse->db, $$);}
%రకం selectnowith {Select*}
%destructor selectnowith {sqlite3SelectDelete(pParse->db, $$);}
%రకం oneselect {Select*}
%destructor oneselect {sqlite3SelectDelete(pParse->db, $$);}

%include {
  /*
  ** For a compound SELECT statement, make sure p->pPrior->pNext==p for
  ** all elements in the list.  And make sure list length does not exceed
  ** SQLITE_LIMIT_COMPOUND_SELECT.
  */
  స్థిర శూన్య parserDoubleLinkSelect(Parse *pParse, Select *p){
    ప్రతిజ్ఞా( p!=0 );
    ఒకవేళ( p->p_పూర్వ ){
      Select *p_తదుపరి = 0, *pLoop = p;
      పూర్ణాంకం mxSelect, cnt = 1;
      అయితే(1){
        pLoop->p_తదుపరి = p_తదుపరి;
        pLoop->selFlags |= SF_Compound;
        p_తదుపరి = pLoop;
        pLoop = pLoop->p_పూర్వ;
        ఒకవేళ( pLoop==0 ) ఆపు;
        cnt++;        
        ఒకవేళ( pLoop->p_క్రమం_By || pLoop->p_హద్దు ){
          sqlite3_Error_సందేశం(pParse,"%s clause should come after %s not before",
             pLoop->p_క్రమం_By!=0 ? "ORDER BY" : "LIMIT",
             sqlite3SelectOpName(p_తదుపరి->op));
          ఆపు;
        }
      }
      ఒకవేళ( (p->selFlags & (SF_Multi_విలువ|SF_విలువలు))==0
       && (mxSelect = pParse->db->a_హద్దు[SQLITE_LIMIT_COMPOUND_SELECT])>0
       && cnt>mxSelect
      ){
        sqlite3_Error_సందేశం(pParse, "too many terms in compound SELECT");
      }
    }
  }

  /* Attach a With object describing the WITH clause to a Select
  ** object describing the query for which the WITH clause is a prefix.
  */
  స్థిర Select *attach_With_గమ్యం_Select(Parse *pParse, Select *pSelect, With *pWith){
    ఒకవేళ( pSelect ){
      pSelect->pWith = pWith;
      parserDoubleLinkSelect(pParse, pSelect);
    }లేకపోతే{
      sqlite3WithDelete(pParse->db, pWith);
    }
    తిరిగి pSelect;
  }

  /* Memory allocator for parser stack resizing.  This is a thin wrapper around
  ** sqlite3_realloc() that includes a call to sqlite3FaultSim() to facilitate
  ** testing.
  */
  స్థిర శూన్య *parser_దొంతర_Realloc(
    శూన్య *pOld,               /* Prior allocation */
    sqlite3_uint64 new_కొలత_2,   /* Requested new alloation size */
    Parse *pParse             /* Parsing context */
  ){
    శూన్య *p = sqlite3FaultSim(700) ? 0 : sqlite3_realloc(pOld, new_కొలత_2);
    ఒకవేళ( p==0 ) sqlite3OomFault(pParse->db);
    తిరిగి p;
  }
  స్థిర శూన్య parser_దొంతర_Free(శూన్య *pOld, Parse *pParse){
    (శూన్య)pParse;
    sqlite3_free(pOld); 
  }

  /* Return an integer that is the maximum allowed stack size */
  స్థిర పూర్ణాంకం parser_దొంతర_కొలత_హద్దు(Parse *pParse){
    తిరిగి pParse->db->a_హద్దు[SQLITE_LIMIT_PARSER_DEPTH];
  }
}

%ifndef SQLITE_OMIT_CTE
select(A) ::= WITH wqlist(W) selectnowith(X). {A = attach_With_గమ్యం_Select(pParse,X,W);}
select(A) ::= WITH RECURSIVE wqlist(W) selectnowith(X).
                                              {A = attach_With_గమ్యం_Select(pParse,X,W);}

%endif /* SQLITE_OMIT_CTE */
select(A) ::= selectnowith(A). {
  Select *p = A;
  ఒకవేళ( p ){
    parserDoubleLinkSelect(pParse, p);
  }
}

selectnowith(A) ::= oneselect(A).
%ifndef SQLITE_OMIT_COMPOUND_SELECT
selectnowith(A) ::= selectnowith(A) multiselect_op(Y) oneselect(Z).  {
  Select *pRhs = Z;
  Select *pLhs = A;
  ఒకవేళ( pRhs && pRhs->p_పూర్వ ){
    SrcList *pFrom;
    Token x;
    x.n = 0;
    parserDoubleLinkSelect(pParse, pRhs);
    pFrom = sqlite3_Src_List_Append_From_పదం(pParse,0,0,0,&x,pRhs,0);
    pRhs = sqlite3SelectNew(pParse,0,pFrom,0,0,0,0,0,0);
  }
  ఒకవేళ( pRhs ){
    pRhs->op = (u8)Y;
    pRhs->p_పూర్వ = pLhs;
    ఒకవేళ( ALWAYS(pLhs) ) pLhs->selFlags &= ~(u32)SF_Multi_విలువ;
    pRhs->selFlags &= ~(u32)SF_Multi_విలువ;
    ఒకవేళ( Y!=TK_ALL ) pParse->hasCompound = 1;
  }లేకపోతే{
    sqlite3SelectDelete(pParse->db, pLhs);
  }
  A = pRhs;
}
%రకం multiselect_op {పూర్ణాంకం}
multiselect_op(A) ::= UNION(OP).             {A = @OP; /*A-overwrites-OP*/}
multiselect_op(A) ::= UNION ALL.             {A = TK_ALL;}
multiselect_op(A) ::= EXCEPT|INTERSECT(OP).  {A = @OP; /*A-overwrites-OP*/}
%endif SQLITE_OMIT_COMPOUND_SELECT

oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) 
                 orderby_opt(Z) హద్దు_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
}
%ifndef SQLITE_OMIT_WINDOWFUNC
oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) కిటికీ_clause(R)
                 orderby_opt(Z) హద్దు_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
  ఒకవేళ( A ){
    A->pWinDefn = R;
  }లేకపోతే{
    sqlite3_కిటికీ_List_Delete(pParse->db, R);
  }
}
%endif


// Single row VALUES clause.
//
%రకం విలువలు {Select*}
oneselect(A) ::= విలువలు(A).
%destructor విలువలు {sqlite3SelectDelete(pParse->db, $$);}
విలువలు(A) ::= విలువలు_2 LP nexprlist(X) RP. {
  A = sqlite3SelectNew(pParse,X,0,0,0,0,0,SF_విలువలు,0);
}

// Multiple row VALUES clause.
//
%రకం mvalues {Select*}
oneselect(A) ::= mvalues(A). {
  sqlite3_Multi_విలువలు_చివర(pParse, A);
}
%destructor mvalues {sqlite3SelectDelete(pParse->db, $$);}
mvalues(A) ::= విలువలు(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_విలువలు(pParse, A, Y);
}
mvalues(A) ::= mvalues(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_విలువలు(pParse, A, Y);
}

// The "distinct" nonterminal is true (1) if the DISTINCT keyword is
// present and false (0) if it is not.
//
%రకం distinct {పూర్ణాంకం}
distinct(A) ::= DISTINCT.   {A = SF_Distinct;}
distinct(A) ::= ALL.        {A = SF_All;}
distinct(A) ::= .           {A = 0;}

// selcollist is a list of expressions that are to become the return
// values of the SELECT statement.  The "*" in statements like
// "SELECT * FROM ..." is encoded as a special expression with an
// opcode of TK_ASTERISK.
//
%రకం selcollist {సమాసం_List*}
%destructor selcollist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
%రకం sclp {సమాసం_List*}
%destructor sclp {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
sclp(A) ::= selcollist(A) COMMA.
sclp(A) ::= .                                {A = 0;}
selcollist(A) ::= sclp(A) scanpt(B) సమాసం_2(X) scanpt(Z) as(Y).     {
   A = sqlite3_సమాసం_List_Append(pParse, A, X);
   ఒకవేళ( Y.n>0 ) sqlite3_సమాసం_List_సమితి_Name(pParse, A, &Y, 1);
   sqlite3_సమాసం_List_సమితి_పరిధి(pParse,A,B,Z);
}
selcollist(A) ::= sclp(A) scanpt నక్షత్రం(X). {
  సమాసం *p = sqlite3_సమాసం(pParse->db, TK_ASTERISK, 0);
  sqlite3_సమాసం_సమితి_Error_స్థానభ్రంశం(p, (పూర్ణాంకం)(X.z - pParse->z_తోక));
  A = sqlite3_సమాసం_List_Append(pParse, A, p);
}
selcollist(A) ::= sclp(A) scanpt nm(X) DOT నక్షత్రం(Y). {
  సమాసం *p_కుడి, *p_ఎడమ, *pDot;
  p_కుడి = sqlite3PExpr(pParse, TK_ASTERISK, 0, 0);
  sqlite3_సమాసం_సమితి_Error_స్థానభ్రంశం(p_కుడి, (పూర్ణాంకం)(Y.z - pParse->z_తోక));
  p_ఎడమ = token_సమాసం(pParse, TK_ID, X);
  pDot = sqlite3PExpr(pParse, TK_DOT, p_ఎడమ, p_కుడి);
  A = sqlite3_సమాసం_List_Append(pParse,A, pDot);
}

// An option "AS <id>" phrase that can follow one of the expressions that
// define the result set, or one of the tables in the FROM clause.
//
%రకం as {Token}
as(X) ::= AS nm(Y).    {X = Y;}
as(X) ::= ids(X).
as(X) ::= .            {X.n = 0; X.z = 0;}


%రకం seltablist {SrcList*}
%destructor seltablist {sqlite3SrcListDelete(pParse->db, $$);}
%రకం stl_ఉపసర్గ {SrcList*}
%destructor stl_ఉపసర్గ {sqlite3SrcListDelete(pParse->db, $$);}
%రకం from {SrcList*}
%destructor from {sqlite3SrcListDelete(pParse->db, $$);}

// A complete FROM clause.
//
from(A) ::= .                {A = 0;}
from(A) ::= FROM seltablist(X). {
  A = X;
  sqlite3_Src_List_జరుపు_Join_Type(pParse,A);
}

// "seltablist" is a "Select Table List" - the content of the FROM clause
// in a SELECT statement.  "stl_prefix" is a prefix of this list.
//
stl_ఉపసర్గ(A) ::= seltablist(A) joinop(Y).    {
   ఒకవేళ( ALWAYS(A && A->nSrc>0) ) A->a[A->nSrc-1].fg.jointype = (u8)Y;
}
stl_ఉపసర్గ(A) ::= .                           {A = 0;}
seltablist(A) ::= stl_ఉపసర్గ(A) nm(Y) dbnm(D) as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_పదం(pParse,A,&Y,&D,&Z,0,&N);
}
seltablist(A) ::= stl_ఉపసర్గ(A) nm(Y) dbnm(D) as(Z) సూచీకృత_by(I) on_using(N). {
  A = sqlite3_Src_List_Append_From_పదం(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_సూచీకృత_By(pParse, A, &I);
}
seltablist(A) ::= stl_ఉపసర్గ(A) nm(Y) dbnm(D) LP exprlist(E) RP as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_పదం(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_Func_వాదనలు(pParse, A, E);
}
%ifndef SQLITE_OMIT_SUBQUERY
  seltablist(A) ::= stl_ఉపసర్గ(A) LP select(S) RP as(Z) on_using(N). {
    A = sqlite3_Src_List_Append_From_పదం(pParse,A,0,0,&Z,S,&N);
  }
  seltablist(A) ::= stl_ఉపసర్గ(A) LP seltablist(F) RP as(Z) on_using(N). {
    ఒకవేళ( A==0 && Z.n==0 && N.pOn==0 && N.pUsing==0 ){
      A = F;
    }లేకపోతే ఒకవేళ( ALWAYS(F!=0) && F->nSrc==1 ){
      A = sqlite3_Src_List_Append_From_పదం(pParse,A,0,0,&Z,0,&N);
      ఒకవేళ( A ){
        Src_అంశం *pNew = &A->a[A->nSrc-1];
        Src_అంశం *pOld = F->a;
        ప్రతిజ్ఞా( pOld->fg.fixedSchema==0 );
        pNew->zName = pOld->zName;
        pOld->zName = 0;
        ప్రతిజ్ఞా( pOld->fg.fixedSchema==0 );
        ఒకవేళ( pOld->fg.isSubquery ){
          pNew->fg.isSubquery = 1;
          pNew->u4.pSubq = pOld->u4.pSubq;
          pOld->u4.pSubq = 0;
          pOld->fg.isSubquery = 0;
          ప్రతిజ్ఞా( pNew->u4.pSubq!=0 && pNew->u4.pSubq->pSelect!=0 );
          ఒకవేళ( (pNew->u4.pSubq->pSelect->selFlags & SF_NestedFrom)!=0 ){
            pNew->fg.isNestedFrom = 1;
          }
        }లేకపోతే{
          pNew->u4.zDatabase = pOld->u4.zDatabase;
          pOld->u4.zDatabase = 0;
        }
        ఒకవేళ( pOld->fg.isTabFunc ){
          pNew->u1.pFuncArg = pOld->u1.pFuncArg;
          pOld->u1.pFuncArg = 0;
          pOld->fg.isTabFunc = 0;
          pNew->fg.isTabFunc = 1;
        }లేకపోతే ఒకవేళ( pOld->fg.is_సూచీకృత_By ){
          pNew->u1.z_సూచీకృత_By = pOld->u1.z_సూచీకృత_By;
          pOld->u1.z_సూచీకృత_By = 0;
          pOld->fg.is_సూచీకృత_By = 0;
          pNew->fg.is_సూచీకృత_By = 1;
        }
        pNew->fg.not_సూచీకృత = pOld->fg.not_సూచీకృత;
      }
      sqlite3SrcListDelete(pParse->db, F);
    }లేకపోతే{
      Select *pSubquery;
      sqlite3_Src_List_జరుపు_Join_Type(pParse,F);
      pSubquery = sqlite3SelectNew(pParse,0,F,0,0,0,0,SF_NestedFrom,0);
      A = sqlite3_Src_List_Append_From_పదం(pParse,A,0,0,&Z,pSubquery,&N);
    }
  }
%endif  SQLITE_OMIT_SUBQUERY

%రకం dbnm {Token}
dbnm(A) ::= .          {A.z=0; A.n=0;}
dbnm(A) ::= DOT nm(X). {A = X;}

%రకం fullname {SrcList*}
%destructor fullname {sqlite3SrcListDelete(pParse->db, $$);}
fullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  ఒకవేళ( లోపల_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
fullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  ఒకవేళ( లోపల_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}

%రకం xfullname {SrcList*}
%destructor xfullname {sqlite3SrcListDelete(pParse->db, $$);}
xfullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  ఒకవేళ( లోపల_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
xfullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  ఒకవేళ( లోపల_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}
xfullname(A) ::= nm(X) AS nm(Z).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  ఒకవేళ( A ){
    ఒకవేళ( లోపల_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
    }లేకపోతే{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}
xfullname(A) ::= nm(X) DOT nm(Y) AS nm(Z). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  ఒకవేళ( A ){
    ఒకవేళ( లోపల_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
    }లేకపోతే{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}


%రకం joinop {పూర్ణాంకం}
joinop(X) ::= COMMA|JOIN.              { X = JT_INNER; }
joinop(X) ::= JOIN_KW(A) JOIN.
                  {X = sqlite3JoinType(pParse,&A,0,0);  /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,0); /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) nm(C) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,&C);/*X-overwrites-A*/}

// There is a parsing ambiguity in an upsert statement that uses a
// SELECT on the RHS of a the INSERT:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb ON CONFLICT ...
//                                        here ----^^
//
// When the ON token is encountered, the parser does not know if it is
// the beginning of an ON CONFLICT clause, or the beginning of an ON
// clause associated with the JOIN.  The conflict is resolved in favor
// of the JOIN.  If an ON CONFLICT clause is intended, insert a dummy
// WHERE clause in between, like this:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb WHERE true ON CONFLICT ...
//
// The [AND] and [OR] precedence marks in the rules for on_using cause the
// ON in this context to always be interpreted as belonging to the JOIN.
//
%రకం on_using {OnOrUsing}
//%destructor on_using {sqlite3ClearOnOrUsing(pParse->db, &$$);}
on_using(N) ::= ON సమాసం_2(E).            {N.pOn = E; N.pUsing = 0;}
on_using(N) ::= USING LP idlist(L) RP. {N.pOn = 0; N.pUsing = L;}
on_using(N) ::= .                 [OR] {N.pOn = 0; N.pUsing = 0;}

// Note that this block abuses the Token type just a little. If there is
// no "INDEXED BY" clause, the returned token is empty (z==0 && n==0). If
// there is an INDEXED BY clause, then the token is populated as per normal,
// with z pointing to the token data and n containing the number of bytes
// in the token.
//
// If there is a "NOT INDEXED" clause, then (z==0 && n==1), which is 
// normally illegal. The sqlite3SrcListIndexedBy() function 
// recognizes and interprets this as a special case.
//
%రకం సూచీకృత_opt {Token}
%రకం సూచీకృత_by  {Token}
సూచీకృత_opt(A) ::= .                 {A.z=0; A.n=0;}
సూచీకృత_opt(A) ::= సూచీకృత_by(A).
సూచీకృత_by(A)  ::= సూచీకృత BY nm(X). {A = X;}
సూచీకృత_by(A)  ::= NOT సూచీకృత.      {A.z=0; A.n=1;}

%రకం orderby_opt {సమాసం_List*}
%destructor orderby_opt {sqlite3_సమాసం_List_Delete(pParse->db, $$);}

// the sortlist non-terminal stores a list of expression where each
// expression is optionally followed by ASC or DESC to indicate the
// sort order.
//
%రకం sortlist {సమాసం_List*}
%destructor sortlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}

orderby_opt(A) ::= .                          {A = 0;}
orderby_opt(A) ::= క్రమం BY sortlist(X).      {A = X;}
sortlist(A) ::= sortlist(A) COMMA సమాసం_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_సమాసం_List_Append(pParse,A,Y);
  sqlite3_సమాసం_List_సమితి_క్రమీకరించు_క్రమం(A,Z,X);
}
sortlist(A) ::= సమాసం_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_సమాసం_List_Append(pParse,0,Y); /*A-overwrites-Y*/
  sqlite3_సమాసం_List_సమితి_క్రమీకరించు_క్రమం(A,Z,X);
}

%రకం sortorder {పూర్ణాంకం}

sortorder(A) ::= ASC.           {A = SQLITE_SO_ASC;}
sortorder(A) ::= DESC.          {A = SQLITE_SO_DESC;}
sortorder(A) ::= .              {A = SQLITE_SO_UNDEFINED;}

%రకం nulls {పూర్ణాంకం}
nulls(A) ::= NULLS మొదటి_2.       {A = SQLITE_SO_ASC;}
nulls(A) ::= NULLS చివరి.        {A = SQLITE_SO_DESC;}
nulls(A) ::= .                  {A = SQLITE_SO_UNDEFINED;}

%రకం groupby_opt {సమాసం_List*}
%destructor groupby_opt {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
groupby_opt(A) ::= .                      {A = 0;}
groupby_opt(A) ::= సమూహం BY nexprlist(X). {A = X;}

%రకం having_opt {సమాసం*}
%destructor having_opt {sqlite3_సమాసం_Delete(pParse->db, $$);}
having_opt(A) ::= .                {A = 0;}
having_opt(A) ::= HAVING సమాసం_2(X).  {A = X;}

%రకం హద్దు_opt {సమాసం*}

// The destructor for limit_opt will never fire in the current grammar.
// The limit_opt non-terminal only occurs at the end of a single production
// rule for SELECT statements.  As soon as the rule that create the 
// limit_opt non-terminal reduces, the SELECT statement rule will also
// reduce.  So there is never a limit_opt non-terminal on the stack 
// except as a transient.  So there is never anything to destroy.
//
//%destructor limit_opt {sqlite3ExprDelete(pParse->db, $$);}
హద్దు_opt(A) ::= .       {A = 0;}
హద్దు_opt(A) ::= హద్దు_2 సమాసం_2(X).
                         {A = sqlite3PExpr(pParse,TK_హద్దు,X,0);}
హద్దు_opt(A) ::= హద్దు_2 సమాసం_2(X) స్థానభ్రంశం_3 సమాసం_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_హద్దు,X,Y);}
హద్దు_opt(A) ::= హద్దు_2 సమాసం_2(X) COMMA సమాసం_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_హద్దు,Y,X);}

