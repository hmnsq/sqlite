%ifdef SQLITE_ENABLE_ORDERED_సమితి_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  స్థిర సమాసం *sqlite3_సమాసం_కూడు_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    పూర్ణాంకం isDistinct,        /* DISTINCT or ALL qualifier */
    సమాసం_List *pOrig,       /* Arguments to the function */
    సమాసం *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    సమాసం_List *p;           /* Modified argument list */
    సమాసం *p_సమాసం;           /* Final result */
    p = sqlite3_సమాసం_List_Append(pParse, 0, pOrderby);
    ఒకవేళ( pOrig ){
      పూర్ణాంకం i;
      కొరకు(i=0; i<pOrig->n_సమాసం; i++){
        p = sqlite3_సమాసం_List_Append(pParse, p, pOrig->a[i].p_సమాసం);
        pOrig->a[i].p_సమాసం = 0;
      }
      sqlite3_సమాసం_List_Delete(pParse->db, pOrig);
    }
    p_సమాసం = sqlite3_సమాసం_Function(pParse, p, pFuncname, 0);
    ఒకవేళ( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      ప్రతిజ్ఞా( p_సమాసం!=0 );  /* Because otherwise pParse->nErr would not be zero */
      ప్రతిజ్ఞా( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3_కనుగొను_Function(pParse->db, p_సమాసం->u.zToken, -2, enc, 0);
      ఒకవేళ( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_సందేశం(pParse, "%#T() is not an ordered-set aggregate", p_సమాసం);
      }లేకపోతే ఒకవేళ( isDistinct==SF_Distinct ){
        sqlite3_Error_సందేశం(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    తిరిగి p_సమాసం;
  }
}
సమాసం_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN సమూహం LP క్రమం BY సమాసం_2(E) RP. {
