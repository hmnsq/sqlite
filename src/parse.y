////////////////////////// The UPDATE command ////////////////////////////////
//
%ಆದರೆ SQLITE_ENABLE_UPDATE_DELETE_ಎಲ್ಲೆ || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with UPDATE orconf(R) xfullname(X) ಸೂಚ್ಯಂಕಿತ_opt(I) ಗಣ setlist(Y) from(F)
        where_opt_ret(W) orderby_opt(O) ಎಲ್ಲೆ_opt(L).  {
  sqlite3_Src_List_ಸೂಚ್ಯಂಕಿತ_By(pParse, X, &I);
  ಆದರೆ( F ){
    SrcList *pFromClause = F;
    ಆದರೆ( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_ಪದ(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Check_ಉದ್ದಳತೆ(pParse,Y,"set list"); 
#ವ್ಯಾಖ್ಯಾನಿತವಾಗದಿದ್ದರೆ SQLITE_ENABLE_UPDATE_DELETE_ಎಲ್ಲೆ
  ಆದರೆ( O || L ){
    update_Delete_ಎಲ್ಲೆ_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#ಆದರೆ_ಅಂತ್ಯ
  sqlite3Update(pParse,X,Y,W,R,O,L,0);
}
%ಇಲ್ಲದಿದ್ದರೆ
cmd ::= with UPDATE orconf(R) xfullname(X) ಸೂಚ್ಯಂಕಿತ_opt(I) ಗಣ setlist(Y) from(F)
        where_opt_ret(W). {
  sqlite3_Src_List_ಸೂಚ್ಯಂಕಿತ_By(pParse, X, &I);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Check_ಉದ್ದಳತೆ(pParse,Y,"set list"); 
  ಆದರೆ( F ){
    SrcList *pFromClause = F;
    ಆದರೆ( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_ಪದ(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3Update(pParse,X,Y,W,R,0,0,0);
}
%endif



