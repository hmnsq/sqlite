}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (Window*)sqlite3DbMallocZero(pParse->db, পরিমাণ(Window));
  যদি( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }অন্যথা{
    sqlite3_ৰাশিমালা_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP window(Z) RP. {
  A = Z;
  প্রতিজ্ঞা( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (Window*)sqlite3DbMallocZero(pParse->db, পরিমাণ(Window));
  যদি( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
