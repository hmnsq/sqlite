// Setup for the parser stack
%stack_size        50                        // Initial stack size
%stack_size_limit  parser_ڍير_سائيز_حد_بندي      // Function returning max stack size
%realloc           parser_ڍير_Realloc        // realloc() for the stack
%حرر              parser_ڍير_Free           // free() for the stack

// All token codes are small integers with #defines that begin with "TK_"
%token_prefix TK_

// The type of the data attached to each token is Token.  This is also the
// default type for non-terminals.
//
%token_type {Token}
%default_type {Token}

// An extra argument to the constructor for the parser, which is available
// to all actions.
%extra_context {Parse *pParse}

// This code runs whenever there is a syntax error
//
%syntax_error {
  اڻ_استعمال_ٿيل_PARAMETER(yymajor);  /* Silence some compiler warnings */
  إذا( TOKEN.z[0] ){
    parserSyntaxError(pParse, &TOKEN);
  }وإلا{
    sqlite3_Error_نياپو(pParse, "incomplete input");
  }
}
%stack_overflow {
  إذا( pParse->nErr==0 ) sqlite3_Error_نياپو(pParse, "Recursion limit");
}

// The name of the generated procedure that implements the parser
// is as follows:
%name sqlite3Parser

// The following text is included near the beginning of the C source
// code file that implements the parser.
//
%include {
#ضمن "sqliteInt.h"

/*
** Verify that the pParse->isCreate field is set
*/
#وصف_ڪريو ASSERT_IS_CREATE   أكد(pParse->isCreate)

/*
** Disable all error recovery processing in the parser push-down
** automaton.
*/
#وصف_ڪريو YYNOERRORRECOVERY 1

/*
** Make yytestcase() the same as testcase()
*/
#وصف_ڪريو yytestcase(X) testcase(X)

/*
** Indicate that sqlite3ParserFree() will never be called with a null
** pointer.
*/
#وصف_ڪريو YYPARSEFREENEVERNULL 1

/*
** In the amalgamation, the parse.c file generated by lemon and the
** tokenize.c file are concatenated.  In that case, sqlite3RunParser()
** has access to the the size of the yyParser object and so the parser
** engine can be allocated from stack.  In that case, only the
** sqlite3ParserInit() and sqlite3ParserFinalize() routines are invoked
** and the sqlite3ParserAlloc() and sqlite3ParserFree() routines can be
** omitted.
*/
#جيڪڏهن_وصف_ٿيل SQLITE_AMALGAMATION
# define sqlite3Parser_ENGINEALWAYSONSTACK 1
#جيڪڏهن_پورو

/*
** Alternative datatype for the argument to the malloc() routine passed
** into sqlite3ParserAlloc().  The default is size_t.
*/
#وصف_ڪريو YYMALLOCARGTYPE  u64

/*
** An instance of the following structure describes the event of a
** TRIGGER.  "a" is the event type, one of TK_UPDATE, TK_INSERT,
** TK_DELETE, or TK_INSTEAD.  If the event is of the form
**
**      UPDATE ON (a,b,c)
**
** Then the "b" IdList records the list "a,b,c".
*/
بنية TrigEvent { صحيح a; IdList * b; };

بنية چوکٺو_Bound     { صحيح eType; اظهار *p_اظهار; };

/*
** Generate a syntax error
*/
ساكن فراغ parserSyntaxError(Parse *pParse, Token *p){
  sqlite3_Error_نياپو(pParse, "near \"%T\": syntax error", p);
}

/*
** Disable lookaside memory allocation for objects that might be
** shared across database connections.
*/
ساكن فراغ disableLookaside(Parse *pParse){
  sqlite3 *db = pParse->db;
  pParse->disableLookaside++;
#جيڪڏهن_وصف_ٿيل SQLITE_DEBUG
  pParse->isCreate = 1;
#جيڪڏهن_پورو
  memset(&pParse->u1.cr, 0, حجم(pParse->u1.cr));
  DisableLookaside;
}

#إذا !defined(SQLITE_ENABLE_UPDATE_DELETE_حد_بندي) \
 && defined(SQLITE_UDL_CAPABLE_PARSER)
/*
** Issue an error message if an ORDER BY or LIMIT clause occurs on an
** UPDATE or DELETE statement.
*/
ساكن فراغ update_Delete_حد_بندي_Error(
  Parse *pParse,
  اظهار_List *p_ترتيب_By,
  اظهار *p_حد_بندي
){
  إذا( p_ترتيب_By ){
    sqlite3_Error_نياپو(pParse, "syntax error near \"ORDER BY\"");
  }وإلا{
    sqlite3_Error_نياپو(pParse, "syntax error near \"LIMIT\"");
  }
  sqlite3_اظهار_List_Delete(pParse->db, p_ترتيب_By);
  sqlite3_اظهار_Delete(pParse->db, p_حد_بندي);
}
#جيڪڏهن_پورو /* SQLITE_ENABLE_UPDATE_DELETE_LIMIT */

} // end %include

// Input is a single SQL command
داخلا ::= cmdlist.
cmdlist ::= cmdlist ecmd.
cmdlist ::= ecmd.
ecmd ::= SEMI.
ecmd ::= cmdx SEMI.
%ifndef SQLITE_OMIT_EXPLAIN
ecmd ::= explain cmdx SEMI.       {NEVER-REDUCE}
explain ::= EXPLAIN.              { إذا( pParse->pReprepare==0 ) pParse->explain = 1; }
explain ::= EXPLAIN QUERY PLAN.   { إذا( pParse->pReprepare==0 ) pParse->explain = 2; }
%endif  SQLITE_OMIT_EXPLAIN
cmdx ::= cmd.           { sqlite3_پڄاڻي_Coding(pParse); }

///////////////////// Begin and end transactions. ////////////////////////////
//

cmd ::= BEGIN transtype(Y) trans_opt.  {sqlite3BeginTransaction(pParse, Y);}
trans_opt ::= .
trans_opt ::= TRANSACTION.
trans_opt ::= TRANSACTION nm.
%نوع transtype {صحيح}
transtype(A) ::= .             {A = TK_DEFERRED;}
transtype(A) ::= DEFERRED(X).  {A = @X; /*A-overwrites-X*/}
transtype(A) ::= فوري(X). {A = @X; /*A-overwrites-X*/}
transtype(A) ::= EXCLUSIVE(X). {A = @X; /*A-overwrites-X*/}
cmd ::= COMMIT|پڇاڙي(X) trans_opt.   {sqlite3_پڇاڙي_Transaction(pParse,@X);}
cmd ::= ROLLBACK(X) trans_opt.     {sqlite3_پڇاڙي_Transaction(pParse,@X);}

savepoint_opt ::= SAVEPOINT.
savepoint_opt ::= .
cmd ::= SAVEPOINT nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_BEGIN, &X);
}
cmd ::= RELEASE savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_RELEASE, &X);
}
cmd ::= ROLLBACK trans_opt منزل_2 savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_ROLLBACK, &X);
}

///////////////////// The CREATE TABLE statement ////////////////////////////
//
cmd ::= create_جدول create_جدول_دليلون.
create_جدول ::= createkw عارضي(T) جدول_3 ifnotexists(E) nm(Y) dbnm(Z). {
   sqlite3_شروعات_جدول(pParse,&Y,&Z,T,0,0,E);
}
createkw(A) ::= CREATE(A).  {
  disableLookaside(pParse);
}

%نوع ifnotexists {صحيح}
ifnotexists(A) ::= .              {A = 0;}
ifnotexists(A) ::= IF NOT EXISTS. {A = 1;}
%نوع عارضي {صحيح}
%ifndef SQLITE_OMIT_TEMPDB
عارضي(A) ::= عارضي_2.  {A = pParse->db->init.busy==0;}
%endif  SQLITE_OMIT_TEMPDB
عارضي(A) ::= .      {A = 0;}
create_جدول_دليلون ::= LP columnlist conslist_opt(X) RP(E) جدول_option_سيٽ(F). {
  sqlite3_پڇاڙي_جدول(pParse,&X,&E,F,0);
}
create_جدول_دليلون ::= AS select(S). {
  sqlite3_پڇاڙي_جدول(pParse,0,0,0,S);
  sqlite3SelectDelete(pParse->db, S);
}
%نوع جدول_option_سيٽ {u32}
%نوع جدول_option {u32}
جدول_option_سيٽ(A) ::= .    {A = 0;}
جدول_option_سيٽ(A) ::= جدول_option(A).
جدول_option_سيٽ(A) ::= جدول_option_سيٽ(X) COMMA جدول_option(Y). {A = X|Y;}
جدول_option(A) ::= WITHOUT nm(X). {
  إذا( X.n==5 && sqlite3_strnicmp(X.z,"rowid",5)==0 ){
    A = TF_WithoutRowid | TF_NoVisibleRowid;
  }وإلا{
    A = 0;
    sqlite3_Error_نياپو(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
جدول_option(A) ::= nm(X). {
  إذا( X.n==6 && sqlite3_strnicmp(X.z,"strict",6)==0 ){
    A = TF_Strict;
  }وإلا{
    A = 0;
    sqlite3_Error_نياپو(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
columnlist ::= columnlist COMMA columnname carglist.
columnlist ::= columnname carglist.
columnname(A) ::= nm(A) typetoken(Y). {sqlite3_جوڙيو_ڪالم(pParse,A,Y);}

// Declare some tokens early in order to influence their values, to 
// improve performance and reduce the executable size.  The goal here is
// to get the "jump" operations in ISNULL through ESCAPE to have numeric
// values that are early enough so that all jump operations are clustered
// at the beginning.  Also, operators like NE and EQ need to be adjacent,
// and all of the comparison operators need to be clustered together.
// Various assert() statements throughout the code enforce these restrictions.
//
%token ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST.
%token CONFLICT DATABASE DEFERRED DESC DETACH EACH پڇاڙي EXCLUSIVE EXPLAIN FAIL.
%token OR AND NOT IS ISNOT ميلاپ_2 LIKE_KW BETWEEN اندريون_2 ISNULL NOTNULL NE EQ.
%token GT LE LT GE ESCAPE.

// The following directive causes tokens ABORT, AFTER, ASC, etc. to
// fallback to ID if they will not parse as their original value.
// This obviates the need for the "id" nonterminal.
//
%fallback ID
  ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST COLUMNKW
  CONFLICT DATABASE DEFERRED DESC DETACH DO
  EACH پڇاڙي EXCLUSIVE EXPLAIN FAIL FOR
  IGNORE فوري INITIALLY INSTEAD LIKE_KW ميلاپ_2 NO PLAN
  QUERY ڪنجي_2 جو_2 وٿي_3 PRAGMA RAISE RECURSIVE RELEASE REPLACE RESTRICT صف صفون
  ROLLBACK SAVEPOINT عارضي_2 TRIGGER VACUUM VIEW VIRTUAL WITH WITHOUT
  NULLS پهريون_2 آخري
%ifdef SQLITE_OMIT_COMPOUND_SELECT
  EXCEPT INTERSECT UNION
%endif SQLITE_OMIT_COMPOUND_SELECT
%ifndef SQLITE_OMIT_WINDOWFUNC
  CURRENT FOLLOWING حصا_ڪريو PRECEDING RANGE UNBOUNDED
  EXCLUDE GROUPS OTHERS TIES
%endif SQLITE_OMIT_WINDOWFUNC
%ifdef SQLITE_ENABLE_ORDERED_سيٽ_AGGREGATES
  WITHIN
%endif SQLITE_ENABLE_ORDERED_سيٽ_AGGREGATES
%ifndef SQLITE_OMIT_GENERATED_COLUMNS
  GENERATED ALWAYS
%endif
  MATERIALIZED
  REINDEX RENAME CTIME_KW IF
  .
%wildcard ANY.

// Define operator precedence early so that this is the first occurrence
// of the operator tokens in the grammar.  Keeping the operators together
// causes them to be assigned integer values that are close together,
// which keeps parser tables smaller.
//
// The token values assigned to these symbols is determined by the order
// in which lemon first sees them.  It must be the case that ISNULL/NOTNULL,
// NE/EQ, GT/LE, and GE/LT are separated by only a single value.  See
// the sqlite3ExprIfFalse() routine for additional information on this
// constraint.
//
%کاٻي OR.
%کاٻي AND.
%ساڄي NOT.
%کاٻي IS ميلاپ_2 LIKE_KW BETWEEN اندريون_2 ISNULL NOTNULL NE EQ.
%کاٻي GT LE LT GE.
%ساڄي ESCAPE.
%کاٻي BITAND BITOR LSHIFT RSHIFT.
%کاٻي PLUS MINUS.
%کاٻي تارو SLASH REM.
%کاٻي CONCAT PTR.
%کاٻي COLLATE.
%ساڄي BITNOT.
%nonassoc ON.

// An IDENTIFIER can be a generic identifier, or one of several
// keywords.  Any non-standard keyword can also be an identifier.
//
%token_class id  ID|اشاريي_وارو.

// And "ids" is an identifier-or-string.
//
%token_class ids  ID|STRING.

// An identifier or a join-keyword
//
%token_class idj  ID|اشاريي_وارو|JOIN_KW.

// The name of a column or table can be any of the following:
//
%نوع nm {Token}
nm(A) ::= idj(A).
nm(A) ::= STRING(A).

// A typetoken is really zero or more tokens that form a type name such
// as can be found after the column name in a CREATE TABLE statement.
// Multiple tokens are concatenated to form the value of the typetoken.
//
%نوع typetoken {Token}
typetoken(A) ::= .   {A.n = 0; A.z = 0;}
typetoken(A) ::= typename(A).
typetoken(A) ::= typename(A) LP نشانوارو RP(Y). {
  A.n = (صحيح)(&Y.z[Y.n] - A.z);
}
typetoken(A) ::= typename(A) LP نشانوارو COMMA نشانوارو RP(Y). {
  A.n = (صحيح)(&Y.z[Y.n] - A.z);
}
%نوع typename {Token}
typename(A) ::= ids(A).
typename(A) ::= typename(A) ids(Y). {A.n=Y.n+(صحيح)(Y.z-A.z);}
نشانوارو ::= plus_انگ.
نشانوارو ::= minus_انگ.

// The scanpt non-terminal takes a value which is a pointer to the
// input text just past the last token that has been shifted into
// the parser.  By surrounding some phrase in the grammar with two
// scanpt non-terminals, we can capture the input text for that phrase.
// For example:
//
//      something ::= .... scanpt(A) phrase scanpt(Z).
//
// The text that is parsed as "phrase" is a string starting at A
// and containing (int)(Z-A) characters.  There might be some extra
// whitespace on either end of the text, but that can be removed in
// post-processing, if needed.
//
%نوع scanpt {ثابت حرف*}
scanpt(A) ::= . {
  أكد( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken.z;
}
scantok(A) ::= . {
  أكد( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken;
}

// "carglist" is a list of additional constraints that come after the
// column name and column type in a CREATE TABLE statement.
//
carglist ::= carglist ccons.
carglist ::= .
ccons ::= CONSTRAINT nm(X). {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
ccons ::= DEFAULT scantok(A) رڪن(X).
                            {sqlite3_جوڙيو_Default_قدر(pParse,X,A.z,&A.z[A.n]);}
ccons ::= DEFAULT LP(A) اظهار_2(X) RP(Z).
                            {sqlite3_جوڙيو_Default_قدر(pParse,X,A.z+1,Z.z);}
ccons ::= DEFAULT PLUS(A) scantok(Z) رڪن(X).
                            {sqlite3_جوڙيو_Default_قدر(pParse,X,A.z,&Z.z[Z.n]);}
ccons ::= DEFAULT MINUS(A) scantok(Z) رڪن(X). {
  اظهار *p = sqlite3PExpr(pParse, TK_UMINUS, X, 0);
  sqlite3_جوڙيو_Default_قدر(pParse,p,A.z,&Z.z[Z.n]);
}
ccons ::= DEFAULT scantok id(X).       {
  اظهار *p = token_اظهار(pParse, TK_STRING, X);
  إذا( p ){
    sqlite3_اظهار_Id_منزل_True_False(p);
    testcase( p->op==TK_TRUEFALSE && sqlite3_اظهار_Truth_قدر(p) );
  }
    sqlite3_جوڙيو_Default_قدر(pParse,p,X.z,X.z+X.n);
}

// In addition to the type name, we also care about the primary key and
// UNIQUE constraints.
//
ccons ::= عدم onconf.
ccons ::= NOT عدم onconf(R).    {sqlite3_جوڙيو_Not_Null(pParse, R);}
ccons ::= PRIMARY ڪنجي_2 sortorder(Z) onconf(R) autoinc(I).
                                 {sqlite3_جوڙيو_Primary_ڪنجي(pParse,0,R,I,Z);}
ccons ::= UNIQUE onconf(R).      {sqlite3_Create_اشاريو(pParse,0,0,0,0,R,0,0,0,0,
                                   SQLITE_IDXTYPE_UNIQUE);}
ccons ::= CHECK LP(A) اظهار_2(X) RP(B).  {sqlite3_جوڙيو_Check_Constraint(pParse,X,A.z,B.z);}
ccons ::= REFERENCES nm(T) eidlist_opt(TA) refargs(R).
                                 {sqlite3_Create_Foreign_ڪنجي(pParse,0,&T,TA,R);}
ccons ::= defer_subclause(D).    {sqlite3_Defer_Foreign_ڪنجي(pParse,D);}
ccons ::= COLLATE ids(C).        {sqlite3_جوڙيو_Collate_Type(pParse, &C);}
ccons ::= GENERATED ALWAYS AS generated.
ccons ::= AS generated.
generated ::= LP اظهار_2(E) RP.          {sqlite3_جوڙيو_Generated(pParse,E,0);}
generated ::= LP اظهار_2(E) RP ID(TYPE). {sqlite3_جوڙيو_Generated(pParse,E,&TYPE);}

// The optional AUTOINCREMENT keyword
%نوع autoinc {صحيح}
autoinc(X) ::= .          {X = 0;}
autoinc(X) ::= AUTOINCR.  {X = 1;}

// The next group of rules parses the arguments to a REFERENCES clause
// that determine if the referential integrity checking is deferred or
// or immediate and which determine what action to take if a ref-integ
// check fails.
//
%نوع refargs {صحيح}
refargs(A) ::= .                  { A = OE_None*0x0101; /* EV: R-19803-45884 */}
refargs(A) ::= refargs(A) refarg(Y). { A = (A & ~Y.نقاب) | Y.قدر; }
%نوع refarg {بنية {صحيح قدر; صحيح نقاب;}}
refarg(A) ::= ميلاپ_2 nm.              { A.قدر = 0;     A.نقاب = 0x000000; }
refarg(A) ::= ON وجهو refact.      { A.قدر = 0;     A.نقاب = 0x000000; }
refarg(A) ::= ON DELETE refact(X).   { A.قدر = X;     A.نقاب = 0x0000ff; }
refarg(A) ::= ON UPDATE refact(X).   { A.قدر = X<<8;  A.نقاب = 0x00ff00; }
%نوع refact {صحيح}
refact(A) ::= سيٽ عدم.              { A = OE_سيٽ_Null;  /* EV: R-33326-45252 */}
refact(A) ::= سيٽ DEFAULT.           { A = OE_سيٽ_Dflt;  /* EV: R-33326-45252 */}
refact(A) ::= CASCADE.               { A = OE_Cascade;  /* EV: R-33326-45252 */}
refact(A) ::= RESTRICT.              { A = OE_Restrict; /* EV: R-33326-45252 */}
refact(A) ::= NO ACTION.             { A = OE_None;     /* EV: R-33326-45252 */}
%نوع defer_subclause {صحيح}
defer_subclause(A) ::= NOT DEFERRABLE init_deferred_pred_opt.     {A = 0;}
defer_subclause(A) ::= DEFERRABLE init_deferred_pred_opt(X).      {A = X;}
%نوع init_deferred_pred_opt {صحيح}
init_deferred_pred_opt(A) ::= .                       {A = 0;}
init_deferred_pred_opt(A) ::= INITIALLY DEFERRED.     {A = 1;}
init_deferred_pred_opt(A) ::= INITIALLY فوري.    {A = 0;}

conslist_opt(A) ::= .                         {A.n = 0; A.z = 0;}
conslist_opt(A) ::= COMMA(A) conslist.
conslist ::= conslist tconscomma tcons.
conslist ::= tcons.
tconscomma ::= COMMA.          {ASSERT_IS_CREATE; pParse->u1.cr.constraintName.n = 0;}
tconscomma ::= .
tcons ::= CONSTRAINT nm(X).    {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
tcons ::= PRIMARY ڪنجي_2 LP sortlist(X) autoinc(I) RP onconf(R).
                                 {sqlite3_جوڙيو_Primary_ڪنجي(pParse,X,R,I,0);}
tcons ::= UNIQUE LP sortlist(X) RP onconf(R).
                                 {sqlite3_Create_اشاريو(pParse,0,0,0,X,R,0,0,0,0,
                                       SQLITE_IDXTYPE_UNIQUE);}
tcons ::= CHECK LP(A) اظهار_2(E) RP(B) onconf.
                                 {sqlite3_جوڙيو_Check_Constraint(pParse,E,A.z,B.z);}
tcons ::= FOREIGN ڪنجي_2 LP eidlist(FA) RP
          REFERENCES nm(T) eidlist_opt(TA) refargs(R) defer_subclause_opt(D). {
    sqlite3_Create_Foreign_ڪنجي(pParse, FA, &T, TA, R);
    sqlite3_Defer_Foreign_ڪنجي(pParse, D);
}
%نوع defer_subclause_opt {صحيح}
defer_subclause_opt(A) ::= .                    {A = 0;}
defer_subclause_opt(A) ::= defer_subclause(A).

// The following is a non-standard extension that allows us to declare the
// default behavior when there is a constraint conflict.
//
%نوع onconf {صحيح}
%نوع orconf {صحيح}
%نوع resolvetype {صحيح}
onconf(A) ::= .                              {A = OE_Default;}
onconf(A) ::= ON CONFLICT resolvetype(X).    {A = X;}
orconf(A) ::= .                              {A = OE_Default;}
orconf(A) ::= OR resolvetype(X).             {A = X;}
resolvetype(A) ::= raisetype(A).
resolvetype(A) ::= IGNORE.                   {A = OE_Ignore;}
resolvetype(A) ::= REPLACE.                  {A = OE_Replace;}

////////////////////////// The DROP TABLE /////////////////////////////////////
//
cmd ::= DROP جدول_3 ifexists(E) fullname(X). {
  sqlite3_Drop_جدول(pParse, X, 0, E);
}
%نوع ifexists {صحيح}
ifexists(A) ::= IF EXISTS.   {A = 1;}
ifexists(A) ::= .            {A = 0;}

///////////////////// The CREATE VIEW statement /////////////////////////////
//
%ifndef SQLITE_OMIT_VIEW
cmd ::= createkw(X) عارضي(T) VIEW ifnotexists(E) nm(Y) dbnm(Z) eidlist_opt(C)
          AS select(S). {
  sqlite3CreateView(pParse, &X, &Y, &Z, C, S, T, E);
}
cmd ::= DROP VIEW ifexists(E) fullname(X). {
  sqlite3_Drop_جدول(pParse, X, 1, E);
}
%endif  SQLITE_OMIT_VIEW

//////////////////////// The SELECT statement /////////////////////////////////
//
cmd ::= select(X).  {
  SelectDest dest = {SRT_Output, 0, 0, 0, 0, 0, 0};
  إذا( (pParse->db->mDbFlags & DBFLAG_EncodingFixed)!=0
   || sqlite3ReadSchema(pParse)==SQLITE_OK
  ){
    sqlite3Select(pParse, X, &dest);
  }
  sqlite3SelectDelete(pParse->db, X);
}

%نوع select {Select*}
%destructor select {sqlite3SelectDelete(pParse->db, $$);}
%نوع selectnowith {Select*}
%destructor selectnowith {sqlite3SelectDelete(pParse->db, $$);}
%نوع oneselect {Select*}
%destructor oneselect {sqlite3SelectDelete(pParse->db, $$);}

%include {
  /*
  ** For a compound SELECT statement, make sure p->pPrior->pNext==p for
  ** all elements in the list.  And make sure list length does not exceed
  ** SQLITE_LIMIT_COMPOUND_SELECT.
  */
  ساكن فراغ parserDoubleLinkSelect(Parse *pParse, Select *p){
    أكد( p!=0 );
    إذا( p->p_اڳواٽ ){
      Select *p_ايندڙ = 0, *pLoop = p;
      صحيح mxSelect, cnt = 1;
      طالما(1){
        pLoop->p_ايندڙ = p_ايندڙ;
        pLoop->selFlags |= SF_Compound;
        p_ايندڙ = pLoop;
        pLoop = pLoop->p_اڳواٽ;
        إذا( pLoop==0 ) اكسر;
        cnt++;        
        إذا( pLoop->p_ترتيب_By || pLoop->p_حد_بندي ){
          sqlite3_Error_نياپو(pParse,"%s clause should come after %s not before",
             pLoop->p_ترتيب_By!=0 ? "ORDER BY" : "LIMIT",
             sqlite3SelectOpName(p_ايندڙ->op));
          اكسر;
        }
      }
      إذا( (p->selFlags & (SF_Multi_قدر|SF_قدرون))==0
       && (mxSelect = pParse->db->a_حد_بندي[SQLITE_LIMIT_COMPOUND_SELECT])>0
       && cnt>mxSelect
      ){
        sqlite3_Error_نياپو(pParse, "too many terms in compound SELECT");
      }
    }
  }

  /* Attach a With object describing the WITH clause to a Select
  ** object describing the query for which the WITH clause is a prefix.
  */
  ساكن Select *attach_With_منزل_Select(Parse *pParse, Select *pSelect, With *pWith){
    إذا( pSelect ){
      pSelect->pWith = pWith;
      parserDoubleLinkSelect(pParse, pSelect);
    }وإلا{
      sqlite3WithDelete(pParse->db, pWith);
    }
    أرجع pSelect;
  }

  /* Memory allocator for parser stack resizing.  This is a thin wrapper around
  ** sqlite3_realloc() that includes a call to sqlite3FaultSim() to facilitate
  ** testing.
  */
  ساكن فراغ *parser_ڍير_Realloc(
    فراغ *pOld,               /* Prior allocation */
    sqlite3_uint64 new_سائيز_2,   /* Requested new alloation size */
    Parse *pParse             /* Parsing context */
  ){
    فراغ *p = sqlite3FaultSim(700) ? 0 : sqlite3_realloc(pOld, new_سائيز_2);
    إذا( p==0 ) sqlite3OomFault(pParse->db);
    أرجع p;
  }
  ساكن فراغ parser_ڍير_Free(فراغ *pOld, Parse *pParse){
    (فراغ)pParse;
    sqlite3_free(pOld); 
  }

  /* Return an integer that is the maximum allowed stack size */
  ساكن صحيح parser_ڍير_سائيز_حد_بندي(Parse *pParse){
    أرجع pParse->db->a_حد_بندي[SQLITE_LIMIT_PARSER_DEPTH];
  }
}

%ifndef SQLITE_OMIT_CTE
select(A) ::= WITH wqlist(W) selectnowith(X). {A = attach_With_منزل_Select(pParse,X,W);}
select(A) ::= WITH RECURSIVE wqlist(W) selectnowith(X).
                                              {A = attach_With_منزل_Select(pParse,X,W);}

%endif /* SQLITE_OMIT_CTE */
select(A) ::= selectnowith(A). {
  Select *p = A;
  إذا( p ){
    parserDoubleLinkSelect(pParse, p);
  }
}

selectnowith(A) ::= oneselect(A).
%ifndef SQLITE_OMIT_COMPOUND_SELECT
selectnowith(A) ::= selectnowith(A) multiselect_op(Y) oneselect(Z).  {
  Select *pRhs = Z;
  Select *pLhs = A;
  إذا( pRhs && pRhs->p_اڳواٽ ){
    SrcList *pFrom;
    Token x;
    x.n = 0;
    parserDoubleLinkSelect(pParse, pRhs);
    pFrom = sqlite3_Src_List_Append_From_رڪن(pParse,0,0,0,&x,pRhs,0);
    pRhs = sqlite3SelectNew(pParse,0,pFrom,0,0,0,0,0,0);
  }
  إذا( pRhs ){
    pRhs->op = (u8)Y;
    pRhs->p_اڳواٽ = pLhs;
    إذا( ALWAYS(pLhs) ) pLhs->selFlags &= ~(u32)SF_Multi_قدر;
    pRhs->selFlags &= ~(u32)SF_Multi_قدر;
    إذا( Y!=TK_ALL ) pParse->hasCompound = 1;
  }وإلا{
    sqlite3SelectDelete(pParse->db, pLhs);
  }
  A = pRhs;
}
%نوع multiselect_op {صحيح}
multiselect_op(A) ::= UNION(OP).             {A = @OP; /*A-overwrites-OP*/}
multiselect_op(A) ::= UNION ALL.             {A = TK_ALL;}
multiselect_op(A) ::= EXCEPT|INTERSECT(OP).  {A = @OP; /*A-overwrites-OP*/}
%endif SQLITE_OMIT_COMPOUND_SELECT

oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) 
                 orderby_opt(Z) حد_بندي_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
}
%ifndef SQLITE_OMIT_WINDOWFUNC
oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) دري_clause(R)
                 orderby_opt(Z) حد_بندي_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
  إذا( A ){
    A->pWinDefn = R;
  }وإلا{
    sqlite3_دري_List_Delete(pParse->db, R);
  }
}
%endif


// Single row VALUES clause.
//
%نوع قدرون {Select*}
oneselect(A) ::= قدرون(A).
%destructor قدرون {sqlite3SelectDelete(pParse->db, $$);}
قدرون(A) ::= قدرون_2 LP nexprlist(X) RP. {
  A = sqlite3SelectNew(pParse,X,0,0,0,0,0,SF_قدرون,0);
}

// Multiple row VALUES clause.
//
%نوع mvalues {Select*}
oneselect(A) ::= mvalues(A). {
  sqlite3_Multi_قدرون_پڇاڙي(pParse, A);
}
%destructor mvalues {sqlite3SelectDelete(pParse->db, $$);}
mvalues(A) ::= قدرون(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_قدرون(pParse, A, Y);
}
mvalues(A) ::= mvalues(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_قدرون(pParse, A, Y);
}

// The "distinct" nonterminal is true (1) if the DISTINCT keyword is
// present and false (0) if it is not.
//
%نوع distinct {صحيح}
distinct(A) ::= DISTINCT.   {A = SF_Distinct;}
distinct(A) ::= ALL.        {A = SF_All;}
distinct(A) ::= .           {A = 0;}

// selcollist is a list of expressions that are to become the return
// values of the SELECT statement.  The "*" in statements like
// "SELECT * FROM ..." is encoded as a special expression with an
// opcode of TK_ASTERISK.
//
%نوع selcollist {اظهار_List*}
%destructor selcollist {sqlite3_اظهار_List_Delete(pParse->db, $$);}
%نوع sclp {اظهار_List*}
%destructor sclp {sqlite3_اظهار_List_Delete(pParse->db, $$);}
sclp(A) ::= selcollist(A) COMMA.
sclp(A) ::= .                                {A = 0;}
selcollist(A) ::= sclp(A) scanpt(B) اظهار_2(X) scanpt(Z) as(Y).     {
   A = sqlite3_اظهار_List_Append(pParse, A, X);
   إذا( Y.n>0 ) sqlite3_اظهار_List_سيٽ_Name(pParse, A, &Y, 1);
   sqlite3_اظهار_List_سيٽ_وسعت(pParse,A,B,Z);
}
selcollist(A) ::= sclp(A) scanpt تارو(X). {
  اظهار *p = sqlite3_اظهار(pParse->db, TK_ASTERISK, 0);
  sqlite3_اظهار_سيٽ_Error_وٿي(p, (صحيح)(X.z - pParse->z_پڇ));
  A = sqlite3_اظهار_List_Append(pParse, A, p);
}
selcollist(A) ::= sclp(A) scanpt nm(X) DOT تارو(Y). {
  اظهار *p_ساڄو, *p_کاٻو, *pDot;
  p_ساڄو = sqlite3PExpr(pParse, TK_ASTERISK, 0, 0);
  sqlite3_اظهار_سيٽ_Error_وٿي(p_ساڄو, (صحيح)(Y.z - pParse->z_پڇ));
  p_کاٻو = token_اظهار(pParse, TK_ID, X);
  pDot = sqlite3PExpr(pParse, TK_DOT, p_کاٻو, p_ساڄو);
  A = sqlite3_اظهار_List_Append(pParse,A, pDot);
}

// An option "AS <id>" phrase that can follow one of the expressions that
// define the result set, or one of the tables in the FROM clause.
//
%نوع as {Token}
as(X) ::= AS nm(Y).    {X = Y;}
as(X) ::= ids(X).
as(X) ::= .            {X.n = 0; X.z = 0;}


%نوع seltablist {SrcList*}
%destructor seltablist {sqlite3SrcListDelete(pParse->db, $$);}
%نوع stl_اڳياڙي {SrcList*}
%destructor stl_اڳياڙي {sqlite3SrcListDelete(pParse->db, $$);}
%نوع from {SrcList*}
%destructor from {sqlite3SrcListDelete(pParse->db, $$);}

// A complete FROM clause.
//
from(A) ::= .                {A = 0;}
from(A) ::= FROM seltablist(X). {
  A = X;
  sqlite3_Src_List_سرڪايو_Join_Type(pParse,A);
}

// "seltablist" is a "Select Table List" - the content of the FROM clause
// in a SELECT statement.  "stl_prefix" is a prefix of this list.
//
stl_اڳياڙي(A) ::= seltablist(A) joinop(Y).    {
   إذا( ALWAYS(A && A->nSrc>0) ) A->a[A->nSrc-1].fg.jointype = (u8)Y;
}
stl_اڳياڙي(A) ::= .                           {A = 0;}
seltablist(A) ::= stl_اڳياڙي(A) nm(Y) dbnm(D) as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_رڪن(pParse,A,&Y,&D,&Z,0,&N);
}
seltablist(A) ::= stl_اڳياڙي(A) nm(Y) dbnm(D) as(Z) اشاريي_وارو_by(I) on_using(N). {
  A = sqlite3_Src_List_Append_From_رڪن(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_اشاريي_وارو_By(pParse, A, &I);
}
seltablist(A) ::= stl_اڳياڙي(A) nm(Y) dbnm(D) LP exprlist(E) RP as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_رڪن(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_Func_دليلون(pParse, A, E);
}
%ifndef SQLITE_OMIT_SUBQUERY
  seltablist(A) ::= stl_اڳياڙي(A) LP select(S) RP as(Z) on_using(N). {
    A = sqlite3_Src_List_Append_From_رڪن(pParse,A,0,0,&Z,S,&N);
  }
  seltablist(A) ::= stl_اڳياڙي(A) LP seltablist(F) RP as(Z) on_using(N). {
    إذا( A==0 && Z.n==0 && N.pOn==0 && N.pUsing==0 ){
      A = F;
    }وإلا إذا( ALWAYS(F!=0) && F->nSrc==1 ){
      A = sqlite3_Src_List_Append_From_رڪن(pParse,A,0,0,&Z,0,&N);
      إذا( A ){
        Src_شي *pNew = &A->a[A->nSrc-1];
        Src_شي *pOld = F->a;
        أكد( pOld->fg.fixedSchema==0 );
        pNew->zName = pOld->zName;
        pOld->zName = 0;
        أكد( pOld->fg.fixedSchema==0 );
        إذا( pOld->fg.isSubquery ){
          pNew->fg.isSubquery = 1;
          pNew->u4.pSubq = pOld->u4.pSubq;
          pOld->u4.pSubq = 0;
          pOld->fg.isSubquery = 0;
          أكد( pNew->u4.pSubq!=0 && pNew->u4.pSubq->pSelect!=0 );
          إذا( (pNew->u4.pSubq->pSelect->selFlags & SF_NestedFrom)!=0 ){
            pNew->fg.isNestedFrom = 1;
          }
        }وإلا{
          pNew->u4.zDatabase = pOld->u4.zDatabase;
          pOld->u4.zDatabase = 0;
        }
        إذا( pOld->fg.isTabFunc ){
          pNew->u1.pFuncArg = pOld->u1.pFuncArg;
          pOld->u1.pFuncArg = 0;
          pOld->fg.isTabFunc = 0;
          pNew->fg.isTabFunc = 1;
        }وإلا إذا( pOld->fg.is_اشاريي_وارو_By ){
          pNew->u1.z_اشاريي_وارو_By = pOld->u1.z_اشاريي_وارو_By;
          pOld->u1.z_اشاريي_وارو_By = 0;
          pOld->fg.is_اشاريي_وارو_By = 0;
          pNew->fg.is_اشاريي_وارو_By = 1;
        }
        pNew->fg.not_اشاريي_وارو = pOld->fg.not_اشاريي_وارو;
      }
      sqlite3SrcListDelete(pParse->db, F);
    }وإلا{
      Select *pSubquery;
      sqlite3_Src_List_سرڪايو_Join_Type(pParse,F);
      pSubquery = sqlite3SelectNew(pParse,0,F,0,0,0,0,SF_NestedFrom,0);
      A = sqlite3_Src_List_Append_From_رڪن(pParse,A,0,0,&Z,pSubquery,&N);
    }
  }
%endif  SQLITE_OMIT_SUBQUERY

%نوع dbnm {Token}
dbnm(A) ::= .          {A.z=0; A.n=0;}
dbnm(A) ::= DOT nm(X). {A = X;}

%نوع fullname {SrcList*}
%destructor fullname {sqlite3SrcListDelete(pParse->db, $$);}
fullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  إذا( اندريون_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
fullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  إذا( اندريون_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}

%نوع xfullname {SrcList*}
%destructor xfullname {sqlite3SrcListDelete(pParse->db, $$);}
xfullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  إذا( اندريون_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
xfullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  إذا( اندريون_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}
xfullname(A) ::= nm(X) AS nm(Z).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  إذا( A ){
    إذا( اندريون_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
    }وإلا{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}
xfullname(A) ::= nm(X) DOT nm(Y) AS nm(Z). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  إذا( A ){
    إذا( اندريون_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
    }وإلا{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}


%نوع joinop {صحيح}
joinop(X) ::= COMMA|JOIN.              { X = JT_INNER; }
joinop(X) ::= JOIN_KW(A) JOIN.
                  {X = sqlite3JoinType(pParse,&A,0,0);  /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,0); /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) nm(C) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,&C);/*X-overwrites-A*/}

// There is a parsing ambiguity in an upsert statement that uses a
// SELECT on the RHS of a the INSERT:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb ON CONFLICT ...
//                                        here ----^^
//
// When the ON token is encountered, the parser does not know if it is
// the beginning of an ON CONFLICT clause, or the beginning of an ON
// clause associated with the JOIN.  The conflict is resolved in favor
// of the JOIN.  If an ON CONFLICT clause is intended, insert a dummy
// WHERE clause in between, like this:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb WHERE true ON CONFLICT ...
//
// The [AND] and [OR] precedence marks in the rules for on_using cause the
// ON in this context to always be interpreted as belonging to the JOIN.
//
%نوع on_using {OnOrUsing}
//%destructor on_using {sqlite3ClearOnOrUsing(pParse->db, &$$);}
on_using(N) ::= ON اظهار_2(E).            {N.pOn = E; N.pUsing = 0;}
on_using(N) ::= USING LP idlist(L) RP. {N.pOn = 0; N.pUsing = L;}
on_using(N) ::= .                 [OR] {N.pOn = 0; N.pUsing = 0;}

// Note that this block abuses the Token type just a little. If there is
// no "INDEXED BY" clause, the returned token is empty (z==0 && n==0). If
// there is an INDEXED BY clause, then the token is populated as per normal,
// with z pointing to the token data and n containing the number of bytes
// in the token.
//
// If there is a "NOT INDEXED" clause, then (z==0 && n==1), which is 
// normally illegal. The sqlite3SrcListIndexedBy() function 
// recognizes and interprets this as a special case.
//
%نوع اشاريي_وارو_opt {Token}
%نوع اشاريي_وارو_by  {Token}
اشاريي_وارو_opt(A) ::= .                 {A.z=0; A.n=0;}
اشاريي_وارو_opt(A) ::= اشاريي_وارو_by(A).
اشاريي_وارو_by(A)  ::= اشاريي_وارو BY nm(X). {A = X;}
اشاريي_وارو_by(A)  ::= NOT اشاريي_وارو.      {A.z=0; A.n=1;}

%نوع orderby_opt {اظهار_List*}
%destructor orderby_opt {sqlite3_اظهار_List_Delete(pParse->db, $$);}

// the sortlist non-terminal stores a list of expression where each
// expression is optionally followed by ASC or DESC to indicate the
// sort order.
//
%نوع sortlist {اظهار_List*}
%destructor sortlist {sqlite3_اظهار_List_Delete(pParse->db, $$);}

orderby_opt(A) ::= .                          {A = 0;}
orderby_opt(A) ::= ترتيب BY sortlist(X).      {A = X;}
sortlist(A) ::= sortlist(A) COMMA اظهار_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_اظهار_List_Append(pParse,A,Y);
  sqlite3_اظهار_List_سيٽ_ترتيب_ڏيو_ترتيب(A,Z,X);
}
sortlist(A) ::= اظهار_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_اظهار_List_Append(pParse,0,Y); /*A-overwrites-Y*/
  sqlite3_اظهار_List_سيٽ_ترتيب_ڏيو_ترتيب(A,Z,X);
}

%نوع sortorder {صحيح}

sortorder(A) ::= ASC.           {A = SQLITE_SO_ASC;}
sortorder(A) ::= DESC.          {A = SQLITE_SO_DESC;}
sortorder(A) ::= .              {A = SQLITE_SO_UNDEFINED;}

%نوع nulls {صحيح}
nulls(A) ::= NULLS پهريون_2.       {A = SQLITE_SO_ASC;}
nulls(A) ::= NULLS آخري.        {A = SQLITE_SO_DESC;}
nulls(A) ::= .                  {A = SQLITE_SO_UNDEFINED;}

%نوع groupby_opt {اظهار_List*}
%destructor groupby_opt {sqlite3_اظهار_List_Delete(pParse->db, $$);}
groupby_opt(A) ::= .                      {A = 0;}
groupby_opt(A) ::= گروهه BY nexprlist(X). {A = X;}

%نوع having_opt {اظهار*}
%destructor having_opt {sqlite3_اظهار_Delete(pParse->db, $$);}
having_opt(A) ::= .                {A = 0;}
having_opt(A) ::= HAVING اظهار_2(X).  {A = X;}

%نوع حد_بندي_opt {اظهار*}

// The destructor for limit_opt will never fire in the current grammar.
// The limit_opt non-terminal only occurs at the end of a single production
// rule for SELECT statements.  As soon as the rule that create the 
// limit_opt non-terminal reduces, the SELECT statement rule will also
// reduce.  So there is never a limit_opt non-terminal on the stack 
// except as a transient.  So there is never anything to destroy.
//
//%destructor limit_opt {sqlite3ExprDelete(pParse->db, $$);}
حد_بندي_opt(A) ::= .       {A = 0;}
حد_بندي_opt(A) ::= حد_بندي_2 اظهار_2(X).
                         {A = sqlite3PExpr(pParse,TK_حد_بندي,X,0);}
حد_بندي_opt(A) ::= حد_بندي_2 اظهار_2(X) وٿي_3 اظهار_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_حد_بندي,X,Y);}
حد_بندي_opt(A) ::= حد_بندي_2 اظهار_2(X) COMMA اظهار_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_حد_بندي,Y,X);}

/////////////////////////// The DELETE statement /////////////////////////////
//
%إذا SQLITE_ENABLE_UPDATE_DELETE_حد_بندي || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with DELETE FROM xfullname(X) اشاريي_وارو_opt(I) where_opt_ret(W)
        orderby_opt(O) حد_بندي_opt(L). {
  sqlite3_Src_List_اشاريي_وارو_By(pParse, X, &I);
#جيڪڏهن_وصف_نه_ٿيل SQLITE_ENABLE_UPDATE_DELETE_حد_بندي
  إذا( O || L ){
    update_Delete_حد_بندي_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#جيڪڏهن_پورو
  sqlite3DeleteFrom(pParse,X,W,O,L);
}
%وإلا
cmd ::= with DELETE FROM xfullname(X) اشاريي_وارو_opt(I) where_opt_ret(W). {
  sqlite3_Src_List_اشاريي_وارو_By(pParse, X, &I);
