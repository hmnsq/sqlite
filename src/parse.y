///////////////////////////// The PRAGMA command /////////////////////////////
//
%ifndef SQLITE_OMIT_PRAGMA
cmd ::= PRAGMA nm(X) dbnm(Z).                {sqlite3Pragma(pParse,&X,&Z,0,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ nmnum(Y).    {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP nmnum(Y) RP. {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ minus_عدد(Y). 
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP minus_عدد(Y) RP.
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_عدد(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class نمبر INTEGER|FLOAT.
plus_عدد(A) ::= PLUS نمبر(X).       {A = X;}
plus_عدد(A) ::= نمبر(A).
minus_عدد(A) ::= MINUS نمبر(X).     {A = X;}
//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) انتہا(Z). {
  Token all;
  all.z = A.z;
  all.n = (صحیح)(Z.z - A.z) + Z.n;
  sqlite3_اختتام_Trigger(pParse, S, &all);
}

trigger_decl(A) ::= عارضی(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_وقت(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#اگر_تعریف_شدہ SQLITE_DEBUG
  أكد( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#اگر_ختم
}

%قسم trigger_وقت {صحیح}
trigger_وقت(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_وقت(A) ::= INSTEAD کا_2.  { A = TK_INSTEAD;}
trigger_وقت(A) ::= .            { A = TK_BEFORE; }

%قسم trigger_event {ساخت TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|داخل_کرو(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE کا_2 idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH صف.

%قسم when_clause {اظہاریہ*}
%destructor when_clause {sqlite3_اظہاریہ_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN اظہاریہ_2(X). { A = X; }

%قسم trigger_cmd_list {Trigger_قدم*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_قدم(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_آخری->p_اگلا = X;
  A->p_آخری = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->p_آخری = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= اشاریہ_دار BY nm. {
  sqlite3_Error_پیغام(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT اشاریہ_دار. {
  sqlite3_Error_پیغام(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%قسم trigger_cmd {Trigger_قدم*}
%destructor trigger_cmd {sqlite3_Delete_Trigger_قدم(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby سیٹ setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3_Trigger_Update_قدم(pParse, X, F, Y, Z, R, B.z, E);}

//داخل کرو
trigger_cmd(A) ::= scanpt(B) داخل_کرو_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_داخل_کرو_قدم(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3_Trigger_Delete_قدم(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3_Trigger_Select_قدم(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
اظہاریہ_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  اگر( A ){
    A->aff_اظہاریہ = OE_Ignore;
  }
}
اظہاریہ_2(A) ::= RAISE LP raisetype(T) COMMA اظہاریہ_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  اگر( A ) {
    A->aff_اظہاریہ = (حرف)T;
  }
}
%endif  !SQLITE_OMIT_TRIGGER

%قسم raisetype {صحیح}
raisetype(A) ::= ROLLBACK.  {A = OE_Rollback;}
raisetype(A) ::= ABORT.     {A = OE_Abort;}
raisetype(A) ::= FAIL.      {A = OE_Fail;}


////////////////////////  DROP TRIGGER statement //////////////////////////////
%ifndef SQLITE_OMIT_TRIGGER
cmd ::= DROP TRIGGER ifexists(NOERR) fullname(X). {
  sqlite3DropTrigger(pParse,X,NOERR);
}
%endif  !SQLITE_OMIT_TRIGGER

//////////////////////// ATTACH DATABASE file AS name /////////////////////////
%ifndef SQLITE_OMIT_ATTACH
cmd ::= ATTACH database_kw_opt اظہاریہ_2(F) AS اظہاریہ_2(D) کلید_opt(K). {
  sqlite3Attach(pParse, F, D, K);
}
cmd ::= DETACH database_kw_opt اظہاریہ_2(D). {
  sqlite3Detach(pParse, D);
}

%قسم کلید_opt {اظہاریہ*}
%destructor کلید_opt {sqlite3_اظہاریہ_Delete(pParse->db, $$);}
کلید_opt(A) ::= .                     { A = 0; }
کلید_opt(A) ::= کلید_2 اظہاریہ_2(X).          { A = X; }

database_kw_opt ::= DATABASE.
database_kw_opt ::= .
%endif SQLITE_OMIT_ATTACH

////////////////////////// REINDEX collation //////////////////////////////////
%ifndef SQLITE_OMIT_REINDEX
cmd ::= REINDEX.                {sqlite3Reindex(pParse, 0, 0);}
cmd ::= REINDEX nm(X) dbnm(Y).  {sqlite3Reindex(pParse, &X, &Y);}
%endif  SQLITE_OMIT_REINDEX

/////////////////////////////////// ANALYZE ///////////////////////////////////
%ifndef SQLITE_OMIT_ANALYZE
cmd ::= ANALYZE.                {sqlite3Analyze(pParse, 0, 0);}
cmd ::= ANALYZE nm(X) dbnm(Y).  {sqlite3Analyze(pParse, &X, &Y);}
%endif

//////////////////////// ALTER TABLE table ... ////////////////////////////////
%ifndef SQLITE_OMIT_ALTERTABLE 
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= ALTER جدول_3 fullname(X) RENAME مقصد_2 nm(Z). {
  sqlite3_Alter_Rename_جدول(pParse,X,&Z);
}

// The ALTER TABLE ADD COLUMN command. This is broken into two sections so
// that sqlite3AlterBeginAddColumn() is called before parsing the various
// constraints and so on (carglist) attached to the new column definition.
cmd ::= alter_جوڑو(Y) carglist. {
  Y.n = (صحیح)(pParse->s_آخری_Token.z-Y.z) + pParse->s_آخری_Token.n;
  sqlite3_Alter_اختتام_جوڑو_عمود(pParse, &Y);
}
alter_جوڑو(A) ::= ALTER جدول_3 fullname(X) جوڑو kwcolumn_opt nm(Y) typetoken(Z). {
  disableLookaside(pParse);
  sqlite3_Alter_Begin_جوڑو_عمود(pParse, X);
  sqlite3_جوڑو_عمود(pParse, Y, Z);
  A = Y;
}

cmd ::= ALTER جدول_3 fullname(X) DROP kwcolumn_opt nm(Y). {
  sqlite3_Alter_Drop_عمود(pParse, X, &Y);
}
cmd ::= ALTER جدول_3 fullname(X) RENAME kwcolumn_opt nm(Y) مقصد_2 nm(Z). {
  sqlite3_Alter_Rename_عمود(pParse, X, &Y, &Z);
}
cmd ::= ALTER جدول_3 fullname(X) DROP CONSTRAINT nm(Y). {
  sqlite3AlterDropConstraint(pParse, X, &Y, 0);
}
cmd ::= ALTER جدول_3 fullname(X) ALTER kwcolumn_opt nm(Y) DROP NOT تہی. {
  sqlite3AlterDropConstraint(pParse, X, 0, &Y);
}
cmd ::= ALTER جدول_3 fullname(X) ALTER kwcolumn_opt nm(Y) سیٹ NOT(Z) تہی onconf. {
  sqlite3_Alter_سیٹ_Not_Null(pParse, X, &Y, &Z);
}
cmd ::= ALTER جدول_3 fullname(X) جوڑو CONSTRAINT(Y) nm(Z) CHECK LP(A) اظہاریہ_2(E) RP(B) onconf. {
  sqlite3_Alter_جوڑو_Constraint(pParse, X, &Y, &Z, A.z+1, (B.z-A.z-1), E);
}
cmd ::= ALTER جدول_3 fullname(X) جوڑو CHECK(Y) LP(A) اظہاریہ_2(E) RP(B) onconf. {
  sqlite3_Alter_جوڑو_Constraint(pParse, X, &Y, 0, A.z+1, (B.z-A.z-1), E);
}

kwcolumn_opt ::= .
kwcolumn_opt ::= COLUMNKW.

%endif SQLITE_OMIT_VIRTUALTABLE
%endif SQLITE_OMIT_ALTERTABLE

//////////////////////// CREATE VIRTUAL TABLE ... /////////////////////////////
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= create_vtab.                       {sqlite3_Vtab_اختتام_Parse(pParse,0);}
cmd ::= create_vtab LP vtabarglist RP(X).  {sqlite3_Vtab_اختتام_Parse(pParse,&X);}
create_vtab ::= createkw VIRTUAL جدول_3 ifnotexists(E)
                nm(X) dbnm(Y) USING nm(Z). {
    sqlite3VtabBeginParse(pParse, &X, &Y, &Z, E);
}
vtabarglist ::= vtabarg.
vtabarglist ::= vtabarglist COMMA vtabarg.
vtabarg ::= .                       {sqlite3VtabArgInit(pParse);}
vtabarg ::= vtabarg vtabargtoken.
vtabargtoken ::= ANY(X).            {sqlite3VtabArgExtend(pParse,&X);}
vtabargtoken ::= lp anylist RP(X).  {sqlite3VtabArgExtend(pParse,&X);}
lp ::= LP(X).                       {sqlite3VtabArgExtend(pParse,&X);}
anylist ::= .
anylist ::= anylist LP anylist RP.
anylist ::= anylist ANY.
%endif  SQLITE_OMIT_VIRTUALTABLE


//////////////////////// COMMON TABLE EXPRESSIONS ////////////////////////////
%قسم wqlist {With*}
%destructor wqlist {sqlite3WithDelete(pParse->db, $$);}
%قسم wqitem {Cte*}
// %destructor wqitem {sqlite3CteDelete(pParse->db, $$);} // not reachable

with ::= .
%ifndef SQLITE_OMIT_CTE
with ::= WITH wqlist(W).              { sqlite3_With_ڈالو(pParse, W, 1); }
with ::= WITH RECURSIVE wqlist(W).    { sqlite3_With_ڈالو(pParse, W, 1); }

%قسم wqas {u8}
wqas(A)   ::= AS.                  {A = M10d_Any;}
wqas(A)   ::= AS MATERIALIZED.     {A = M10d_Yes;}
wqas(A)   ::= AS NOT MATERIALIZED. {A = M10d_No;}
wqitem(A) ::= withnm(X) eidlist_opt(Y) wqas(M) LP select(Z) RP. {
  A = sqlite3CteNew(pParse, &X, Y, Z, M); /*A-overwrites-X*/
}
withnm(A) ::= nm(A). {pParse->bHasWith = 1;}
wqlist(A) ::= wqitem(X). {
  A = sqlite3_With_جوڑو(pParse, 0, X); /*A-overwrites-X*/
}
wqlist(A) ::= wqlist(A) COMMA wqitem(X). {
  A = sqlite3_With_جوڑو(pParse, A, X);
}
%endif  SQLITE_OMIT_CTE

//////////////////////// WINDOW FUNCTION EXPRESSIONS /////////////////////////
// These must be at the end of this file. Specifically, the rules that
// introduce tokens WINDOW, OVER and FILTER must appear last. This causes 
// the integer values assigned to these tokens to be larger than all other 
// tokens that may be output by the tokenizer except TK_SPACE, TK_COMMENT,
// and TK_ILLEGAL.
//
%ifndef SQLITE_OMIT_WINDOWFUNC
%قسم windowdefn_list {کھڑکی*}
%destructor windowdefn_list {sqlite3_کھڑکی_List_Delete(pParse->db, $$);}
windowdefn_list(A) ::= windowdefn(A).
windowdefn_list(A) ::= windowdefn_list(Y) COMMA windowdefn(Z). {
  أكد( Z!=0 );
  sqlite3_کھڑکی_Chain(pParse, Z, Y);
  Z->p_اگلا_Win = Y;
  A = Z;
}

%قسم windowdefn {کھڑکی*}
%destructor windowdefn {sqlite3_کھڑکی_Delete(pParse->db, $$);}
windowdefn(A) ::= nm(X) AS LP کھڑکی_2(Y) RP. {
  اگر( ALWAYS(Y) ){
    Y->zName = sqlite3DbStrNDup(pParse->db, X.z, X.n);
  }
  A = Y;
}

%قسم کھڑکی_2 {کھڑکی*}
%destructor کھڑکی_2 {sqlite3_کھڑکی_Delete(pParse->db, $$);}

%قسم چوکھٹا_opt {کھڑکی*}
%destructor چوکھٹا_opt {sqlite3_کھڑکی_Delete(pParse->db, $$);}

%قسم part_opt {اظہاریہ_List*}
%destructor part_opt {sqlite3_اظہاریہ_List_Delete(pParse->db, $$);}

%قسم filter_clause {اظہاریہ*}
%destructor filter_clause {sqlite3_اظہاریہ_Delete(pParse->db, $$);}

%قسم over_clause {کھڑکی*}
%destructor over_clause {sqlite3_کھڑکی_Delete(pParse->db, $$);}

%قسم filter_over {کھڑکی*}
%destructor filter_over {sqlite3_کھڑکی_Delete(pParse->db, $$);}

%قسم range_or_صفیں {صحیح}

%قسم چوکھٹا_bound {ساخت چوکھٹا_Bound}
%destructor چوکھٹا_bound {sqlite3_اظہاریہ_Delete(pParse->db, $$.p_اظہاریہ);}
%قسم چوکھٹا_bound_s {ساخت چوکھٹا_Bound}
%destructor چوکھٹا_bound_s {sqlite3_اظہاریہ_Delete(pParse->db, $$.p_اظہاریہ);}
%قسم چوکھٹا_bound_e {ساخت چوکھٹا_Bound}
%destructor چوکھٹا_bound_e {sqlite3_اظہاریہ_Delete(pParse->db, $$.p_اظہاریہ);}

کھڑکی_2(A) ::= تقسیم BY nexprlist(X) orderby_opt(Y) چوکھٹا_opt(Z). {
  A = sqlite3_کھڑکی_Assemble(pParse, Z, X, Y, 0);
}
کھڑکی_2(A) ::= nm(W) تقسیم BY nexprlist(X) orderby_opt(Y) چوکھٹا_opt(Z). {
  A = sqlite3_کھڑکی_Assemble(pParse, Z, X, Y, &W);
}
کھڑکی_2(A) ::= ترتیب BY sortlist(Y) چوکھٹا_opt(Z). {
  A = sqlite3_کھڑکی_Assemble(pParse, Z, 0, Y, 0);
}
کھڑکی_2(A) ::= nm(W) ترتیب BY sortlist(Y) چوکھٹا_opt(Z). {
  A = sqlite3_کھڑکی_Assemble(pParse, Z, 0, Y, &W);
}
کھڑکی_2(A) ::= چوکھٹا_opt(A).
کھڑکی_2(A) ::= nm(W) چوکھٹا_opt(Z). {
  A = sqlite3_کھڑکی_Assemble(pParse, Z, 0, 0, &W);
}

چوکھٹا_opt(A) ::= .                             { 
  A = sqlite3_کھڑکی_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
چوکھٹا_opt(A) ::= range_or_صفیں(X) چوکھٹا_bound_s(Y) چوکھٹا_exclude_opt(Z). { 
  A = sqlite3_کھڑکی_Alloc(pParse, X, Y.eType, Y.p_اظہاریہ, TK_CURRENT, 0, Z);
}
چوکھٹا_opt(A) ::= range_or_صفیں(X) BETWEEN چوکھٹا_bound_s(Y) AND
                          چوکھٹا_bound_e(Z) چوکھٹا_exclude_opt(W). { 
  A = sqlite3_کھڑکی_Alloc(pParse, X, Y.eType, Y.p_اظہاریہ, Z.eType, Z.p_اظہاریہ, W);
}

range_or_صفیں(A) ::= RANGE|صفیں|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

چوکھٹا_bound_s(A) ::= چوکھٹا_bound(X).         {A = X;}
چوکھٹا_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_اظہاریہ = 0;}
چوکھٹا_bound_e(A) ::= چوکھٹا_bound(X).         {A = X;}
چوکھٹا_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_اظہاریہ = 0;}

چوکھٹا_bound(A) ::= اظہاریہ_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_اظہاریہ = X;}
چوکھٹا_bound(A) ::= CURRENT(X) صف.           {A.eType = @X; A.p_اظہاریہ = 0;}

%قسم چوکھٹا_exclude_opt {u8}
چوکھٹا_exclude_opt(A) ::= . {A = 0;}
چوکھٹا_exclude_opt(A) ::= EXCLUDE چوکھٹا_exclude(X). {A = X;}

%قسم چوکھٹا_exclude {u8}
چوکھٹا_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
چوکھٹا_exclude(A) ::= CURRENT(X) صف. {A = @X; /*A-overwrites-X*/}
چوکھٹا_exclude(A) ::= گروہ|TIES(X).  {A = @X; /*A-overwrites-X*/}


%قسم کھڑکی_clause {کھڑکی*}
%destructor کھڑکی_clause {sqlite3_کھڑکی_List_Delete(pParse->db, $$);}
کھڑکی_clause(A) ::= کھڑکی_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  اگر( O ){
    O->pFilter = F;
  }ورنہ{
    sqlite3_اظہاریہ_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (کھڑکی*)sqlite3DbMallocZero(pParse->db, حجم(کھڑکی));
  اگر( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }ورنہ{
    sqlite3_اظہاریہ_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP کھڑکی_2(Z) RP. {
  A = Z;
  أكد( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (کھڑکی*)sqlite3DbMallocZero(pParse->db, حجم(کھڑکی));
  اگر( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE اظہاریہ_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%token
  عمود_2          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_عمود      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  رجسٹر        /* Reference to a VDBE register */
  سمتیہ          /*سمتیہ*/
  SELECT_عمود   /* Choose a single column from a multi-column SELECT */
  IF_NULL_صف     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  وسعت            /* The span operator */
  ERROR           /* An expression containing an error */
.

رکن(A) ::= QNUMBER(X). {
  A=token_اظہاریہ(pParse,@X,X);
  sqlite3_Dequote_نمبر(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#اگر TK_وسعت>255
# error too many علامات in the grammar
#اگر_ختم
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%token SPACE COMMENT ILLEGAL.
