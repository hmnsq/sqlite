//

%ਕਿਸਮ ਵਿਅੰਜਕ_2 {ਵਿਅੰਜਕ*}
%destructor ਵਿਅੰਜਕ_2 {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
%ਕਿਸਮ ਪਦ {ਵਿਅੰਜਕ*}
%destructor ਪਦ {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  ਸਥਿਰ ਵਿਅੰਜਕ *token_ਵਿਅੰਜਕ(Parse *pParse, ਪੂਰਨ op, Token t){
    ਵਿਅੰਜਕ *p = sqlite3DbMallocRawNN(pParse->db, ਆਕਾਰ(ਵਿਅੰਜਕ)+t.n+1);
    ਜੇ( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_ਵਿਅੰਜਕ = 0;
      p->flags = EP_ਪੱਤੀ;
      ਵਿਅੰਜਕ_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_ਖੱਬਾ = p->p_ਸੱਜਾ = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, ਆਕਾਰ(p->x));
      memset(&p->y, 0, ਆਕਾਰ(p->y));
      p->op2 = 0;
      p->i_ਸਾਰਣੀ = 0;
      p->i_ਕਾਲਮ = 0;
      p->u.zToken = (ਅੱਖਰ*)&p[1];
      ਸਮ੍ਰਿਤੀ_ਨਕਲ(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (ਪੂਰਨ)(t.z - pParse->z_ਪੂਛ);
      ਜੇ( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_ਵਿਅੰਜਕ(p);
      }
#ਜੇ SQLITE_MAX_ਵਿਅੰਜਕ_ਡੂੰਘਾਈ>0
      p->n_ਉਚਾਈ = 1;
#ਜੇ_ਅੰਤ  
      ਜੇ( ਵਿੱਚ_RENAME_OBJECT ){
        ਵਾਪਸ (ਵਿਅੰਜਕ*)sqlite3RenameTokenMap(pParse, (ਖਾਲੀ*)p, &t);
      }
    }
    ਵਾਪਸ p;
  }

}

ਵਿਅੰਜਕ_2(A) ::= ਪਦ(A).
ਵਿਅੰਜਕ_2(A) ::= LP ਵਿਅੰਜਕ_2(X) RP. {A = X;}
ਵਿਅੰਜਕ_2(A) ::= idj(X).          {A=token_ਵਿਅੰਜਕ(pParse,TK_ID,X); /*A-overwrites-X*/}
ਵਿਅੰਜਕ_2(A) ::= nm(X) DOT nm(Y). {
  ਵਿਅੰਜਕ *temp1 = token_ਵਿਅੰਜਕ(pParse,TK_ID,X);
  ਵਿਅੰਜਕ *temp2 = token_ਵਿਅੰਜਕ(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
ਵਿਅੰਜਕ_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  ਵਿਅੰਜਕ *temp1 = token_ਵਿਅੰਜਕ(pParse,TK_ID,X);
  ਵਿਅੰਜਕ *temp2 = token_ਵਿਅੰਜਕ(pParse,TK_ID,Y);
  ਵਿਅੰਜਕ *temp3 = token_ਵਿਅੰਜਕ(pParse,TK_ID,Z);
  ਵਿਅੰਜਕ *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  ਜੇ( ਵਿੱਚ_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
ਪਦ(A) ::= ਨਿਰਾ|FLOAT|BLOB(X). {A=token_ਵਿਅੰਜਕ(pParse,@X,X); /*A-overwrites-X*/}
ਪਦ(A) ::= STRING(X).          {A=token_ਵਿਅੰਜਕ(pParse,@X,X); /*A-overwrites-X*/}
ਪਦ(A) ::= INTEGER(X). {
  ਪੂਰਨ i_ਮੁੱਲ;
  ਜੇ( sqlite3GetInt32(X.z, &i_ਮੁੱਲ)==0 ){
    A = sqlite3_ਵਿਅੰਜਕ_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }ਨਹੀਂਤਾਂ{
    A = sqlite3_ਵਿਅੰਜਕ_Int32(pParse->db, i_ਮੁੱਲ);
  }
  ਜੇ( A ) A->w.iOfst = (ਪੂਰਨ)(X.z - pParse->z_ਪੂਛ);
}
ਵਿਅੰਜਕ_2(A) ::= VARIABLE(X).     {
  ਜੇ( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_ਵਿਅੰਜਕ(pParse, TK_VARIABLE, X);
    sqlite3_ਵਿਅੰਜਕ_ਸੌਂਪੋ_Var_ਸੰਖਿਆ(pParse, A, n);
  }ਨਹੀਂਤਾਂ{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    ਪ੍ਰਤਿਜ੍ਞਾ( t.n>=2 );
    ਜੇ( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }ਨਹੀਂਤਾਂ{
      A = sqlite3PExpr(pParse, TK_ਰਜਿਸਟਰ, 0, 0);
      ਜੇ( A ) sqlite3GetInt32(&t.z[1], &A->i_ਸਾਰਣੀ);
    }
  }
}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) COLLATE ids(C). {
  A = sqlite3_ਵਿਅੰਜਕ_ਜੋੜੋ_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
ਵਿਅੰਜਕ_2(A) ::= CAST LP ਵਿਅੰਜਕ_2(E) AS typetoken(T) RP. {
  A = sqlite3_ਵਿਅੰਜਕ_Alloc(pParse->db, TK_CAST, &T, 1);
