%endif

//////////////////////// ALTER TABLE table ... ////////////////////////////////
%ifndef SQLITE_OMIT_ALTERTABLE 
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) RENAME ಗಮ್ಯ_2 nm(Z). {
  sqlite3_Alter_Rename_ಕೋಷ್ಟಕ(pParse,X,&Z);
}

// The ALTER TABLE ADD COLUMN command. This is broken into two sections so
// that sqlite3AlterBeginAddColumn() is called before parsing the various
// constraints and so on (carglist) attached to the new column definition.
cmd ::= alter_ಕೂಡಿಸು(Y) carglist. {
  Y.n = (ಪೂರ್ಣಾಂಕ)(pParse->s_ಕೊನೆಯ_Token.z-Y.z) + pParse->s_ಕೊನೆಯ_Token.n;
  sqlite3_Alter_ಮುಕ್ತಾಯ_ಕೂಡಿಸು_ಸ್ತಂಭ(pParse, &Y);
}
alter_ಕೂಡಿಸು(A) ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) ಕೂಡಿಸು kwcolumn_opt nm(Y) typetoken(Z). {
  disableLookaside(pParse);
  sqlite3_Alter_Begin_ಕೂಡಿಸು_ಸ್ತಂಭ(pParse, X);
  sqlite3_ಕೂಡಿಸು_ಸ್ತಂಭ(pParse, Y, Z);
  A = Y;
}

cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) DROP kwcolumn_opt nm(Y). {
  sqlite3_Alter_Drop_ಸ್ತಂಭ(pParse, X, &Y);
}
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) RENAME kwcolumn_opt nm(Y) ಗಮ್ಯ_2 nm(Z). {
  sqlite3_Alter_Rename_ಸ್ತಂಭ(pParse, X, &Y, &Z);
}
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) DROP CONSTRAINT nm(Y). {
  sqlite3AlterDropConstraint(pParse, X, &Y, 0);
}
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) ALTER kwcolumn_opt nm(Y) DROP NOT ಖಾಲಿ. {
  sqlite3AlterDropConstraint(pParse, X, 0, &Y);
}
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) ALTER kwcolumn_opt nm(Y) ಗಣ NOT(Z) ಖಾಲಿ onconf. {
  sqlite3_Alter_ಗಣ_Not_Null(pParse, X, &Y, &Z);
}
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) ಕೂಡಿಸು CONSTRAINT(Y) nm(Z) CHECK LP(A) ಅಭಿವ್ಯಕ್ತಿ_2(E) RP(B) onconf. {
  sqlite3_Alter_ಕೂಡಿಸು_Constraint(pParse, X, &Y, &Z, A.z+1, (B.z-A.z-1), E);
}
cmd ::= ALTER ಕೋಷ್ಟಕ_3 fullname(X) ಕೂಡಿಸು CHECK(Y) LP(A) ಅಭಿವ್ಯಕ್ತಿ_2(E) RP(B) onconf. {
  sqlite3_Alter_ಕೂಡಿಸು_Constraint(pParse, X, &Y, 0, A.z+1, (B.z-A.z-1), E);
}

kwcolumn_opt ::= .
kwcolumn_opt ::= COLUMNKW.

%endif SQLITE_OMIT_VIRTUALTABLE
%endif SQLITE_OMIT_ALTERTABLE

//////////////////////// CREATE VIRTUAL TABLE ... /////////////////////////////
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= create_vtab.                       {sqlite3_Vtab_ಮುಕ್ತಾಯ_Parse(pParse,0);}
cmd ::= create_vtab LP vtabarglist RP(X).  {sqlite3_Vtab_ಮುಕ್ತಾಯ_Parse(pParse,&X);}
create_vtab ::= createkw VIRTUAL ಕೋಷ್ಟಕ_3 ifnotexists(E)
                nm(X) dbnm(Y) USING nm(Z). {
    sqlite3VtabBeginParse(pParse, &X, &Y, &Z, E);
}
vtabarglist ::= vtabarg.
vtabarglist ::= vtabarglist COMMA vtabarg.
vtabarg ::= .                       {sqlite3VtabArgInit(pParse);}
vtabarg ::= vtabarg vtabargtoken.
vtabargtoken ::= ANY(X).            {sqlite3VtabArgExtend(pParse,&X);}
vtabargtoken ::= lp anylist RP(X).  {sqlite3VtabArgExtend(pParse,&X);}
lp ::= LP(X).                       {sqlite3VtabArgExtend(pParse,&X);}
anylist ::= .
anylist ::= anylist LP anylist RP.
anylist ::= anylist ANY.
%endif  SQLITE_OMIT_VIRTUALTABLE


//////////////////////// COMMON TABLE EXPRESSIONS ////////////////////////////
%ಪ್ರಕಾರ wqlist {With*}
%destructor wqlist {sqlite3WithDelete(pParse->db, $$);}
%ಪ್ರಕಾರ wqitem {Cte*}
// %destructor wqitem {sqlite3CteDelete(pParse->db, $$);} // not reachable

with ::= .
%ifndef SQLITE_OMIT_CTE
with ::= WITH wqlist(W).              { sqlite3_With_ತಳ್ಳು(pParse, W, 1); }
with ::= WITH RECURSIVE wqlist(W).    { sqlite3_With_ತಳ್ಳು(pParse, W, 1); }

%ಪ್ರಕಾರ wqas {u8}
wqas(A)   ::= AS.                  {A = M10d_Any;}
wqas(A)   ::= AS MATERIALIZED.     {A = M10d_Yes;}
wqas(A)   ::= AS NOT MATERIALIZED. {A = M10d_No;}
wqitem(A) ::= withnm(X) eidlist_opt(Y) wqas(M) LP select(Z) RP. {
  A = sqlite3CteNew(pParse, &X, Y, Z, M); /*A-overwrites-X*/
}
withnm(A) ::= nm(A). {pParse->bHasWith = 1;}
wqlist(A) ::= wqitem(X). {
  A = sqlite3_With_ಕೂಡಿಸು(pParse, 0, X); /*A-overwrites-X*/
}
wqlist(A) ::= wqlist(A) COMMA wqitem(X). {
  A = sqlite3_With_ಕೂಡಿಸು(pParse, A, X);
}
%endif  SQLITE_OMIT_CTE

//////////////////////// WINDOW FUNCTION EXPRESSIONS /////////////////////////
// These must be at the end of this file. Specifically, the rules that
// introduce tokens WINDOW, OVER and FILTER must appear last. This causes 
// the integer values assigned to these tokens to be larger than all other 
// tokens that may be output by the tokenizer except TK_SPACE, TK_COMMENT,
// and TK_ILLEGAL.
//
%ifndef SQLITE_OMIT_WINDOWFUNC
%ಪ್ರಕಾರ windowdefn_list {ಕಿಟಕಿ*}
%destructor windowdefn_list {sqlite3_ಕಿಟಕಿ_List_Delete(pParse->db, $$);}
windowdefn_list(A) ::= windowdefn(A).
windowdefn_list(A) ::= windowdefn_list(Y) COMMA windowdefn(Z). {
  ಪ್ರತಿಜ್ಞಾ( Z!=0 );
  sqlite3_ಕಿಟಕಿ_Chain(pParse, Z, Y);
  Z->p_ಮುಂದಿನ_Win = Y;
  A = Z;
}

%ಪ್ರಕಾರ windowdefn {ಕಿಟಕಿ*}
%destructor windowdefn {sqlite3_ಕಿಟಕಿ_Delete(pParse->db, $$);}
windowdefn(A) ::= nm(X) AS LP ಕಿಟಕಿ_2(Y) RP. {
  ಆದರೆ( ALWAYS(Y) ){
    Y->zName = sqlite3DbStrNDup(pParse->db, X.z, X.n);
  }
  A = Y;
}

%ಪ್ರಕಾರ ಕಿಟಕಿ_2 {ಕಿಟಕಿ*}
%destructor ಕಿಟಕಿ_2 {sqlite3_ಕಿಟಕಿ_Delete(pParse->db, $$);}

%ಪ್ರಕಾರ ಚೌಕಟ್ಟು_opt {ಕಿಟಕಿ*}
%destructor ಚೌಕಟ್ಟು_opt {sqlite3_ಕಿಟಕಿ_Delete(pParse->db, $$);}

%ಪ್ರಕಾರ part_opt {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor part_opt {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}

%ಪ್ರಕಾರ filter_clause {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor filter_clause {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}

%ಪ್ರಕಾರ over_clause {ಕಿಟಕಿ*}
%destructor over_clause {sqlite3_ಕಿಟಕಿ_Delete(pParse->db, $$);}

%ಪ್ರಕಾರ filter_over {ಕಿಟಕಿ*}
%destructor filter_over {sqlite3_ಕಿಟಕಿ_Delete(pParse->db, $$);}

%ಪ್ರಕಾರ range_or_ಅಡ್ಡಸಾಲುಗಳು {ಪೂರ್ಣಾಂಕ}

%ಪ್ರಕಾರ ಚೌಕಟ್ಟು_bound {ರಚನೆ ಚೌಕಟ್ಟು_Bound}
%destructor ಚೌಕಟ್ಟು_bound {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$.p_ಅಭಿವ್ಯಕ್ತಿ);}
%ಪ್ರಕಾರ ಚೌಕಟ್ಟು_bound_s {ರಚನೆ ಚೌಕಟ್ಟು_Bound}
%destructor ಚೌಕಟ್ಟು_bound_s {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$.p_ಅಭಿವ್ಯಕ್ತಿ);}
%ಪ್ರಕಾರ ಚೌಕಟ್ಟು_bound_e {ರಚನೆ ಚೌಕಟ್ಟು_Bound}
%destructor ಚೌಕಟ್ಟು_bound_e {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$.p_ಅಭಿವ್ಯಕ್ತಿ);}

ಕಿಟಕಿ_2(A) ::= ವಿಭಜನೆ BY nexprlist(X) orderby_opt(Y) ಚೌಕಟ್ಟು_opt(Z). {
  A = sqlite3_ಕಿಟಕಿ_Assemble(pParse, Z, X, Y, 0);
}
ಕಿಟಕಿ_2(A) ::= nm(W) ವಿಭಜನೆ BY nexprlist(X) orderby_opt(Y) ಚೌಕಟ್ಟು_opt(Z). {
  A = sqlite3_ಕಿಟಕಿ_Assemble(pParse, Z, X, Y, &W);
}
ಕಿಟಕಿ_2(A) ::= ಕ್ರಮ BY sortlist(Y) ಚೌಕಟ್ಟು_opt(Z). {
  A = sqlite3_ಕಿಟಕಿ_Assemble(pParse, Z, 0, Y, 0);
}
ಕಿಟಕಿ_2(A) ::= nm(W) ಕ್ರಮ BY sortlist(Y) ಚೌಕಟ್ಟು_opt(Z). {
  A = sqlite3_ಕಿಟಕಿ_Assemble(pParse, Z, 0, Y, &W);
}
ಕಿಟಕಿ_2(A) ::= ಚೌಕಟ್ಟು_opt(A).
ಕಿಟಕಿ_2(A) ::= nm(W) ಚೌಕಟ್ಟು_opt(Z). {
  A = sqlite3_ಕಿಟಕಿ_Assemble(pParse, Z, 0, 0, &W);
}

ಚೌಕಟ್ಟು_opt(A) ::= .                             { 
  A = sqlite3_ಕಿಟಕಿ_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
ಚೌಕಟ್ಟು_opt(A) ::= range_or_ಅಡ್ಡಸಾಲುಗಳು(X) ಚೌಕಟ್ಟು_bound_s(Y) ಚೌಕಟ್ಟು_exclude_opt(Z). { 
  A = sqlite3_ಕಿಟಕಿ_Alloc(pParse, X, Y.eType, Y.p_ಅಭಿವ್ಯಕ್ತಿ, TK_CURRENT, 0, Z);
}
ಚೌಕಟ್ಟು_opt(A) ::= range_or_ಅಡ್ಡಸಾಲುಗಳು(X) BETWEEN ಚೌಕಟ್ಟು_bound_s(Y) AND
                          ಚೌಕಟ್ಟು_bound_e(Z) ಚೌಕಟ್ಟು_exclude_opt(W). { 
  A = sqlite3_ಕಿಟಕಿ_Alloc(pParse, X, Y.eType, Y.p_ಅಭಿವ್ಯಕ್ತಿ, Z.eType, Z.p_ಅಭಿವ್ಯಕ್ತಿ, W);
}

range_or_ಅಡ್ಡಸಾಲುಗಳು(A) ::= RANGE|ಅಡ್ಡಸಾಲುಗಳು|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

ಚೌಕಟ್ಟು_bound_s(A) ::= ಚೌಕಟ್ಟು_bound(X).         {A = X;}
ಚೌಕಟ್ಟು_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_ಅಭಿವ್ಯಕ್ತಿ = 0;}
ಚೌಕಟ್ಟು_bound_e(A) ::= ಚೌಕಟ್ಟು_bound(X).         {A = X;}
ಚೌಕಟ್ಟು_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_ಅಭಿವ್ಯಕ್ತಿ = 0;}

ಚೌಕಟ್ಟು_bound(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_ಅಭಿವ್ಯಕ್ತಿ = X;}
ಚೌಕಟ್ಟು_bound(A) ::= CURRENT(X) ಅಡ್ಡಸಾಲು.           {A.eType = @X; A.p_ಅಭಿವ್ಯಕ್ತಿ = 0;}

%ಪ್ರಕಾರ ಚೌಕಟ್ಟು_exclude_opt {u8}
ಚೌಕಟ್ಟು_exclude_opt(A) ::= . {A = 0;}
ಚೌಕಟ್ಟು_exclude_opt(A) ::= EXCLUDE ಚೌಕಟ್ಟು_exclude(X). {A = X;}

%ಪ್ರಕಾರ ಚೌಕಟ್ಟು_exclude {u8}
ಚೌಕಟ್ಟು_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
ಚೌಕಟ್ಟು_exclude(A) ::= CURRENT(X) ಅಡ್ಡಸಾಲು. {A = @X; /*A-overwrites-X*/}
ಚೌಕಟ್ಟು_exclude(A) ::= ಗುಂಪು|TIES(X).  {A = @X; /*A-overwrites-X*/}


%ಪ್ರಕಾರ ಕಿಟಕಿ_clause {ಕಿಟಕಿ*}
%destructor ಕಿಟಕಿ_clause {sqlite3_ಕಿಟಕಿ_List_Delete(pParse->db, $$);}
ಕಿಟಕಿ_clause(A) ::= ಕಿಟಕಿ_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  ಆದರೆ( O ){
    O->pFilter = F;
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (ಕಿಟಕಿ*)sqlite3DbMallocZero(pParse->db, ಗಾತ್ರ(ಕಿಟಕಿ));
  ಆದರೆ( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP ಕಿಟಕಿ_2(Z) RP. {
  A = Z;
  ಪ್ರತಿಜ್ಞಾ( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (ಕಿಟಕಿ*)sqlite3DbMallocZero(pParse->db, ಗಾತ್ರ(ಕಿಟಕಿ));
  ಆದರೆ( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE ಅಭಿವ್ಯಕ್ತಿ_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%token
  ಸ್ತಂಭ_2          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_ಸ್ತಂಭ      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  ರಿಜಿಸ್ಟರ್        /* Reference to a VDBE register */
  ಸದಿಶ          /*ಸದಿಶ*/
  SELECT_ಸ್ತಂಭ   /* Choose a single column from a multi-column SELECT */
  IF_NULL_ಅಡ್ಡಸಾಲು     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  ಹರವು            /* The span operator */
  ERROR           /* An expression containing an error */
.

ಪದ(A) ::= QNUMBER(X). {
  A=token_ಅಭಿವ್ಯಕ್ತಿ(pParse,@X,X);
  sqlite3_Dequote_ಸಂಖ್ಯೆ(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#ಆದರೆ TK_ಹರವು>255
# error too many ಟೋಕನುಗಳು in the grammar
#ಆದರೆ_ಅಂತ್ಯ
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%token SPACE COMMENT ILLEGAL.
