%প্রকার between_op {পূর্ণাঙ্ক}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) between_op(N) ৰাশিমালা_2(X) AND ৰাশিমালা_2(Y). [BETWEEN] {
  ৰাশিমালা_List *pList = sqlite3_ৰাশিমালা_List_Append(pParse,0, X);
  pList = sqlite3_ৰাশিমালা_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
