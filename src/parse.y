%ఒకవేళ SQLITE_ENABLE_UPDATE_DELETE_హద్దు || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with DELETE FROM xfullname(X) సూచీకృత_opt(I) where_opt_ret(W)
        orderby_opt(O) హద్దు_opt(L). {
  sqlite3_Src_List_సూచీకృత_By(pParse, X, &I);
#నిర్వచితం_కాకపోతే SQLITE_ENABLE_UPDATE_DELETE_హద్దు
  ఒకవేళ( O || L ){
    update_Delete_హద్దు_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#అయితే_ముగింపు
  sqlite3DeleteFrom(pParse,X,W,O,L);
}
%లేకపోతే
cmd ::= with DELETE FROM xfullname(X) సూచీకృత_opt(I) where_opt_ret(W). {
