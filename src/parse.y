ৰাশিমালা_2(A) ::= LP nexprlist(X) COMMA ৰাশিমালা_2(Y) RP. {
  ৰাশিমালা_List *pList = sqlite3_ৰাশিমালা_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_VECTOR, 0, 0);
  যদি( A ){
    পূর্ণাঙ্ক i;
    A->x.pList = pList;
    বাবে(i=0; i<pList->n_ৰাশিমালা; i++){
      প্রতিজ্ঞা( pList->a[i].p_ৰাশিমালা!=0 );
      A->flags |= pList->a[i].p_ৰাশিমালা->flags & EP_Propagate;
    }
  }অন্যথা{
    sqlite3_ৰাশিমালা_List_Delete(pParse->db, pList);
  }
}

ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) AND ৰাশিমালা_2(Y).        {A=sqlite3_ৰাশিমালা_And(pParse,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) OR(OP) ৰাশিমালা_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) LT|GT|GE|LE(OP) ৰাশিমালা_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) EQ|NE(OP) ৰাশিমালা_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) ৰাশিমালা_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) PLUS|MINUS(OP) ৰাশিমালা_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) STAR|SLASH|REM(OP) ৰাশিমালা_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) CONCAT(OP) ৰাশিমালা_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%প্রকার likeop {Token}
likeop(A) ::= LIKE_KW|MATCH(A).
likeop(A) ::= NOT LIKE_KW|MATCH(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) likeop(OP) ৰাশিমালা_2(Y).  [LIKE_KW]  {
  ৰাশিমালা_List *pList;
