ਪਦ(A) ::= CTIME_KW(OP). {
  A = sqlite3_ਵਿਅੰਜਕ_Function(pParse, 0, &OP, 0);
}

ਵਿਅੰਜਕ_2(A) ::= LP nexprlist(X) COMMA ਵਿਅੰਜਕ_2(Y) RP. {
  ਵਿਅੰਜਕ_List *pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_ਸਦਿਸ਼, 0, 0);
  ਜੇ( A ){
    ਪੂਰਨ i;
    A->x.pList = pList;
    ਲਈ(i=0; i<pList->n_ਵਿਅੰਜਕ; i++){
      ਪ੍ਰਤਿਜ੍ਞਾ( pList->a[i].p_ਵਿਅੰਜਕ!=0 );
      A->flags |= pList->a[i].p_ਵਿਅੰਜਕ->flags & EP_Propagate;
    }
  }ਨਹੀਂਤਾਂ{
    sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, pList);
  }
}

ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) AND ਵਿਅੰਜਕ_2(Y).        {A=sqlite3_ਵਿਅੰਜਕ_And(pParse,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) OR(OP) ਵਿਅੰਜਕ_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) LT|GT|GE|LE(OP) ਵਿਅੰਜਕ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) EQ|NE(OP) ਵਿਅੰਜਕ_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) ਵਿਅੰਜਕ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) PLUS|MINUS(OP) ਵਿਅੰਜਕ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) ਤਾਰਾ|SLASH|REM(OP) ਵਿਅੰਜਕ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) CONCAT(OP) ਵਿਅੰਜਕ_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%ਕਿਸਮ likeop {Token}
likeop(A) ::= LIKE_KW|ਮੇਲ_2(A).
likeop(A) ::= NOT LIKE_KW|ਮੇਲ_2(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) likeop(OP) ਵਿਅੰਜਕ_2(Y).  [LIKE_KW]  {
  ਵਿਅੰਜਕ_List *pList;
  ਪੂਰਨ bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,0, Y);
  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,pList, A);
  A = sqlite3_ਵਿਅੰਜਕ_Function(pParse, pList, &OP, 0);
  ਜੇ( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  ਜੇ( A ) A->flags |= EP_InfixFunc;
}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) likeop(OP) ਵਿਅੰਜਕ_2(Y) ESCAPE ਵਿਅੰਜਕ_2(E).  [LIKE_KW]  {
  ਵਿਅੰਜਕ_List *pList;
  ਪੂਰਨ bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,0, Y);
  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,pList, A);
  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,pList, E);
  A = sqlite3_ਵਿਅੰਜਕ_Function(pParse, pList, &OP, 0);
  ਜੇ( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  ਜੇ( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  ਸਥਿਰ ਵਿਅੰਜਕ *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    ਪੂਰਨ op,         /* TK_ISNULL or TK_NOTNULL */
    ਵਿਅੰਜਕ *p_ਖੱਬਾ     /*ਸੰਕਾਰਜ*/
  ){
    ਵਿਅੰਜਕ *p = p_ਖੱਬਾ;
    ਪ੍ਰਤਿਜ੍ਞਾ( op==TK_ISNULL || op==TK_NOTNULL );
    ਪ੍ਰਤਿਜ੍ਞਾ( p_ਖੱਬਾ!=0 );
    ਜਦੋਂ( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_ਖੱਬਾ;
      ਪ੍ਰਤਿਜ੍ਞਾ( p!=0 );
    }
    ਚੋਣ( p->op ){
      ਹਾਲਤ TK_INTEGER:
      ਹਾਲਤ TK_STRING:
      ਹਾਲਤ TK_FLOAT:
      ਹਾਲਤ TK_BLOB: 
        sqlite3_ਵਿਅੰਜਕ_Deferred_Delete(pParse, p_ਖੱਬਾ);
        p = sqlite3_ਵਿਅੰਜਕ_Int32(pParse->db, op==TK_NOTNULL);
        ਜੇ( p ) p->op2 = 1;
        ਵਾਪਸ p;
      ਮੂਲ:
        ਰੋਕੋ;
    }
    ਵਾਪਸ sqlite3PExpr(pParse, op, p_ਖੱਬਾ, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  ਸਥਿਰ ਵਿਅੰਜਕ *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    ਪੂਰਨ op,         /* TK_IS or TK_ISNOT */
    ਵਿਅੰਜਕ *p_ਖੱਬਾ,    /* Left operand */
    ਵਿਅੰਜਕ *p_ਸੱਜਾ    /* Right operand */
  ){
    ਜੇ( p_ਸੱਜਾ && p_ਸੱਜਾ->op==TK_NULL ){
      sqlite3_ਵਿਅੰਜਕ_Deferred_Delete(pParse, p_ਸੱਜਾ);
      ਵਾਪਸ sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_ਖੱਬਾ);
    }
    ਵਾਪਸ sqlite3PExpr(pParse, op, p_ਖੱਬਾ, p_ਸੱਜਾ);
  }
}

ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
