%include {

  /* Construct a new Expr object from a single token */
  ساکن اظہاریہ *token_اظہاریہ(Parse *pParse, صحیح op, Token t){
    اظہاریہ *p = sqlite3DbMallocRawNN(pParse->db, حجم(اظہاریہ)+t.n+1);
    اگر( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_اظہاریہ = 0;
      p->flags = EP_برگ;
      اظہاریہ_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_بایاں = p->p_دایاں = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, حجم(p->x));
      memset(&p->y, 0, حجم(p->y));
      p->op2 = 0;
      p->i_جدول = 0;
      p->i_عمود = 0;
      p->u.zToken = (حرف*)&p[1];
      حافظہ_نقل(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (صحیح)(t.z - pParse->z_دم);
      اگر( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_اظہاریہ(p);
      }
#اگر SQLITE_MAX_اظہاریہ_گہرائی>0
      p->n_اونچائی = 1;
#اگر_ختم  
      اگر( اندر_RENAME_OBJECT ){
        واپس (اظہاریہ*)sqlite3RenameTokenMap(pParse, (خالی*)p, &t);
      }
    }
    واپس p;
  }

}

اظہاریہ_2(A) ::= رکن(A).
اظہاریہ_2(A) ::= LP اظہاریہ_2(X) RP. {A = X;}
اظہاریہ_2(A) ::= idj(X).          {A=token_اظہاریہ(pParse,TK_ID,X); /*A-overwrites-X*/}
اظہاریہ_2(A) ::= nm(X) DOT nm(Y). {
  اظہاریہ *temp1 = token_اظہاریہ(pParse,TK_ID,X);
  اظہاریہ *temp2 = token_اظہاریہ(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
اظہاریہ_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  اظہاریہ *temp1 = token_اظہاریہ(pParse,TK_ID,X);
  اظہاریہ *temp2 = token_اظہاریہ(pParse,TK_ID,Y);
  اظہاریہ *temp3 = token_اظہاریہ(pParse,TK_ID,Z);
  اظہاریہ *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  اگر( اندر_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
رکن(A) ::= تہی|FLOAT|BLOB(X). {A=token_اظہاریہ(pParse,@X,X); /*A-overwrites-X*/}
رکن(A) ::= STRING(X).          {A=token_اظہاریہ(pParse,@X,X); /*A-overwrites-X*/}
رکن(A) ::= INTEGER(X). {
  صحیح i_قدر;
  اگر( sqlite3GetInt32(X.z, &i_قدر)==0 ){
    A = sqlite3_اظہاریہ_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }ورنہ{
    A = sqlite3_اظہاریہ_Int32(pParse->db, i_قدر);
  }
  اگر( A ) A->w.iOfst = (صحیح)(X.z - pParse->z_دم);
}
اظہاریہ_2(A) ::= VARIABLE(X).     {
  اگر( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_اظہاریہ(pParse, TK_VARIABLE, X);
    sqlite3_اظہاریہ_تفویض_Var_نمبر(pParse, A, n);
  }ورنہ{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    أكد( t.n>=2 );
    اگر( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }ورنہ{
      A = sqlite3PExpr(pParse, TK_رجسٹر, 0, 0);
      اگر( A ) sqlite3GetInt32(&t.z[1], &A->i_جدول);
    }
  }
}
اظہاریہ_2(A) ::= اظہاریہ_2(A) COLLATE ids(C). {
  A = sqlite3_اظہاریہ_جوڑو_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
اظہاریہ_2(A) ::= CAST LP اظہاریہ_2(E) AS typetoken(T) RP. {
  A = sqlite3_اظہاریہ_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_اظہاریہ_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


اظہاریہ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_اظہاریہ_Function(pParse, Y, &X, D);
}
اظہاریہ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ترتیب BY sortlist(O) RP. {
  A = sqlite3_اظہاریہ_Function(pParse, Y, &X, D);
  sqlite3_اظہاریہ_جوڑو_Function_ترتیب_By(pParse, A, O);
}
اظہاریہ_2(A) ::= idj(X) LP ستارہ RP. {
  A = sqlite3_اظہاریہ_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_سیٹ_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  ساکن اظہاریہ *sqlite3_اظہاریہ_جوڑو_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    صحیح isDistinct,        /* DISTINCT or ALL qualifier */
    اظہاریہ_List *pOrig,       /* Arguments to the function */
    اظہاریہ *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    اظہاریہ_List *p;           /* Modified argument list */
    اظہاریہ *p_اظہاریہ;           /* Final result */
    p = sqlite3_اظہاریہ_List_Append(pParse, 0, pOrderby);
    اگر( pOrig ){
      صحیح i;
      برائے(i=0; i<pOrig->n_اظہاریہ; i++){
        p = sqlite3_اظہاریہ_List_Append(pParse, p, pOrig->a[i].p_اظہاریہ);
        pOrig->a[i].p_اظہاریہ = 0;
      }
      sqlite3_اظہاریہ_List_Delete(pParse->db, pOrig);
    }
    p_اظہاریہ = sqlite3_اظہاریہ_Function(pParse, p, pFuncname, 0);
    اگر( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      أكد( p_اظہاریہ!=0 );  /* Because otherwise pParse->nErr would not be zero */
      أكد( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3_ڈھونڈو_Function(pParse->db, p_اظہاریہ->u.zToken, -2, enc, 0);
      اگر( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_پیغام(pParse, "%#T() is not an ordered-set aggregate", p_اظہاریہ);
      }ورنہ اگر( isDistinct==SF_Distinct ){
        sqlite3_Error_پیغام(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    واپس p_اظہاریہ;
  }
}
اظہاریہ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN گروہ LP ترتیب BY اظہاریہ_2(E) RP. {
  A = sqlite3_اظہاریہ_جوڑو_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_سیٹ_AGGREGATES

%ifndef SQLITE_OMIT_WINDOWFUNC
اظہاریہ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP filter_over(Z). {
  A = sqlite3_اظہاریہ_Function(pParse, Y, &X, D);
  sqlite3_کھڑکی_Attach(pParse, A, Z);
}
اظہاریہ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ترتیب BY sortlist(O) RP filter_over(Z). {
  A = sqlite3_اظہاریہ_Function(pParse, Y, &X, D);
  sqlite3_کھڑکی_Attach(pParse, A, Z);
  sqlite3_اظہاریہ_جوڑو_Function_ترتیب_By(pParse, A, O);
}
اظہاریہ_2(A) ::= idj(X) LP ستارہ RP filter_over(Z). {
  A = sqlite3_اظہاریہ_Function(pParse, 0, &X, 0);
  sqlite3_کھڑکی_Attach(pParse, A, Z);
}
%ifdef SQLITE_ENABLE_ORDERED_سیٹ_AGGREGATES
اظہاریہ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN گروہ LP ترتیب BY اظہاریہ_2(E) RP
            filter_over(Z). {
  A = sqlite3_اظہاریہ_جوڑو_Orderedset_Function(pParse, &X, D, Y, E);
  sqlite3_کھڑکی_Attach(pParse, A, Z);
}
%endif SQLITE_ENABLE_ORDERED_سیٹ_AGGREGATES

%endif SQLITE_OMIT_WINDOWFUNC

رکن(A) ::= CTIME_KW(OP). {
  A = sqlite3_اظہاریہ_Function(pParse, 0, &OP, 0);
}

اظہاریہ_2(A) ::= LP nexprlist(X) COMMA اظہاریہ_2(Y) RP. {
  اظہاریہ_List *pList = sqlite3_اظہاریہ_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_سمتیہ, 0, 0);
  اگر( A ){
    صحیح i;
    A->x.pList = pList;
    برائے(i=0; i<pList->n_اظہاریہ; i++){
      أكد( pList->a[i].p_اظہاریہ!=0 );
      A->flags |= pList->a[i].p_اظہاریہ->flags & EP_Propagate;
    }
  }ورنہ{
    sqlite3_اظہاریہ_List_Delete(pParse->db, pList);
  }
}

اظہاریہ_2(A) ::= اظہاریہ_2(A) AND اظہاریہ_2(Y).        {A=sqlite3_اظہاریہ_And(pParse,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) OR(OP) اظہاریہ_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) LT|GT|GE|LE(OP) اظہاریہ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) EQ|NE(OP) اظہاریہ_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) اظہاریہ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) PLUS|MINUS(OP) اظہاریہ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) ستارہ|SLASH|REM(OP) اظہاریہ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) CONCAT(OP) اظہاریہ_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%قسم likeop {Token}
likeop(A) ::= LIKE_KW|مطابقت_2(A).
likeop(A) ::= NOT LIKE_KW|مطابقت_2(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
اظہاریہ_2(A) ::= اظہاریہ_2(A) likeop(OP) اظہاریہ_2(Y).  [LIKE_KW]  {
  اظہاریہ_List *pList;
  صحیح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_اظہاریہ_List_Append(pParse,0, Y);
  pList = sqlite3_اظہاریہ_List_Append(pParse,pList, A);
  A = sqlite3_اظہاریہ_Function(pParse, pList, &OP, 0);
  اگر( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  اگر( A ) A->flags |= EP_InfixFunc;
}
اظہاریہ_2(A) ::= اظہاریہ_2(A) likeop(OP) اظہاریہ_2(Y) ESCAPE اظہاریہ_2(E).  [LIKE_KW]  {
  اظہاریہ_List *pList;
  صحیح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_اظہاریہ_List_Append(pParse,0, Y);
  pList = sqlite3_اظہاریہ_List_Append(pParse,pList, A);
  pList = sqlite3_اظہاریہ_List_Append(pParse,pList, E);
  A = sqlite3_اظہاریہ_Function(pParse, pList, &OP, 0);
  اگر( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  اگر( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  ساکن اظہاریہ *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    صحیح op,         /* TK_ISNULL or TK_NOTNULL */
    اظہاریہ *p_بایاں     /*عملیہ*/
  ){
    اظہاریہ *p = p_بایاں;
    أكد( op==TK_ISNULL || op==TK_NOTNULL );
    أكد( p_بایاں!=0 );
    جب( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_بایاں;
      أكد( p!=0 );
    }
    انتخاب( p->op ){
      حالت TK_INTEGER:
      حالت TK_STRING:
      حالت TK_FLOAT:
      حالت TK_BLOB: 
        sqlite3_اظہاریہ_Deferred_Delete(pParse, p_بایاں);
        p = sqlite3_اظہاریہ_Int32(pParse->db, op==TK_NOTNULL);
        اگر( p ) p->op2 = 1;
        واپس p;
      طےشدہ:
        توڑو;
    }
    واپس sqlite3PExpr(pParse, op, p_بایاں, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  ساکن اظہاریہ *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    صحیح op,         /* TK_IS or TK_ISNOT */
    اظہاریہ *p_بایاں,    /* Left operand */
    اظہاریہ *p_دایاں    /* Right operand */
  ){
    اگر( p_دایاں && p_دایاں->op==TK_NULL ){
      sqlite3_اظہاریہ_Deferred_Delete(pParse, p_دایاں);
      واپس sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_بایاں);
    }
    واپس sqlite3PExpr(pParse, op, p_بایاں, p_دایاں);
  }
}

اظہاریہ_2(A) ::= اظہاریہ_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
اظہاریہ_2(A) ::= اظہاریہ_2(A) NOT تہی.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
اظہاریہ_2(A) ::= اظہاریہ_2(A) IS اظہاریہ_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
اظہاریہ_2(A) ::= اظہاریہ_2(A) IS NOT اظہاریہ_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
اظہاریہ_2(A) ::= اظہاریہ_2(A) IS NOT DISTINCT FROM اظہاریہ_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
اظہاریہ_2(A) ::= اظہاریہ_2(A) IS DISTINCT FROM اظہاریہ_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

اظہاریہ_2(A) ::= NOT(B) اظہاریہ_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
اظہاریہ_2(A) ::= BITNOT(B) اظہاریہ_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
اظہاریہ_2(A) ::= PLUS|MINUS(B) اظہاریہ_2(X). [BITNOT] {
  اظہاریہ *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  أكد( TK_UPLUS>TK_PLUS );
  أكد( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  اگر( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }ورنہ{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

اظہاریہ_2(A) ::= اظہاریہ_2(B) PTR(C) اظہاریہ_2(D). {
  اظہاریہ_List *pList = sqlite3_اظہاریہ_List_Append(pParse, 0, B);
  pList = sqlite3_اظہاریہ_List_Append(pParse, pList, D);
  A = sqlite3_اظہاریہ_Function(pParse, pList, &C, 0);
}

%قسم between_op {صحیح}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
اظہاریہ_2(A) ::= اظہاریہ_2(A) between_op(N) اظہاریہ_2(X) AND اظہاریہ_2(Y). [BETWEEN] {
  اظہاریہ_List *pList = sqlite3_اظہاریہ_List_Append(pParse,0, X);
  pList = sqlite3_اظہاریہ_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  اگر( A ){
    A->x.pList = pList;
    sqlite3_اظہاریہ_سیٹ_اونچائی_And_Flags(pParse, A);
  }ورنہ{
    sqlite3_اظہاریہ_List_Delete(pParse->db, pList);
  } 
  اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %قسم اندر_op {صحیح}
  اندر_op(A) ::= اندر_2.      {A = 0;}
  اندر_op(A) ::= NOT اندر_2.  {A = 1;}
  اظہاریہ_2(A) ::= اظہاریہ_2(A) اندر_op(N) LP exprlist(Y) RP. [IN] {
    اگر( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      اظہاریہ *pB = sqlite3_اظہاریہ(pParse->db, TK_STRING, N ? "true" : "false");
      اگر( pB ) sqlite3_اظہاریہ_Id_مقصد_True_False(pB);
      اگر( !اظہاریہ_Has_Property(A, EP_HasFunc) ){
        sqlite3_اظہاریہ_Unmap_And_Delete(pParse, A);
        A = pB;
      }ورنہ{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }ورنہ{
      اظہاریہ *pRHS = Y->a[0].p_اظہاریہ;
      اگر( Y->n_اظہاریہ==1
       && sqlite3_اظہاریہ_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_سمتیہ
      ){
        Y->a[0].p_اظہاریہ = 0;
        sqlite3_اظہاریہ_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }ورنہ اگر( Y->n_اظہاریہ==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_اندر, A, 0);
        sqlite3_PExpr_جوڑو_Select(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_اظہاریہ_List_Delete(pParse->db, Y);
      }ورنہ{
        A = sqlite3PExpr(pParse, TK_اندر, A, 0);
        اگر( A==0 ){
          sqlite3_اظہاریہ_List_Delete(pParse->db, Y);
        }ورنہ اگر( A->p_بایاں->op==TK_سمتیہ ){
          صحیح n_اظہاریہ = A->p_بایاں->x.pList->n_اظہاریہ;
          Select *pSelectRHS = sqlite3_اظہاریہ_List_مقصد_اقدار(pParse, n_اظہاریہ, Y);
          اگر( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3_PExpr_جوڑو_Select(pParse, A, pSelectRHS);
          }
        }ورنہ{
          A->x.pList = Y;
          sqlite3_اظہاریہ_سیٹ_اونچائی_And_Flags(pParse, A);
        }
      }
      اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  اظہاریہ_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3_PExpr_جوڑو_Select(pParse, A, X);
  }
  اظہاریہ_2(A) ::= اظہاریہ_2(A) اندر_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_اندر, A, 0);
    sqlite3_PExpr_جوڑو_Select(pParse, A, Y);
    اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  اظہاریہ_2(A) ::= اظہاریہ_2(A) اندر_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    اگر( E )  sqlite3_Src_List_Func_دلائل(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_اندر, A, 0);
    sqlite3_PExpr_جوڑو_Select(pParse, A, pSelect);
    اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  اظہاریہ_2(A) ::= EXISTS LP select(Y) RP. {
    اظہاریہ *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_جوڑو_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
اظہاریہ_2(A) ::= CASE case_عملیہ(X) case_exprlist(Y) case_else(Z) انتہا. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  اگر( A ){
    A->x.pList = Z ? sqlite3_اظہاریہ_List_Append(pParse,Y,Z) : Y;
    sqlite3_اظہاریہ_سیٹ_اونچائی_And_Flags(pParse, A);
  }ورنہ{
    sqlite3_اظہاریہ_List_Delete(pParse->db, Y);
    sqlite3_اظہاریہ_Delete(pParse->db, Z);
  }
}
%قسم case_exprlist {اظہاریہ_List*}
%destructor case_exprlist {sqlite3_اظہاریہ_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN اظہاریہ_2(Y) THEN اظہاریہ_2(Z). {
  A = sqlite3_اظہاریہ_List_Append(pParse,A, Y);
  A = sqlite3_اظہاریہ_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN اظہاریہ_2(Y) THEN اظہاریہ_2(Z). {
  A = sqlite3_اظہاریہ_List_Append(pParse,0, Y);
  A = sqlite3_اظہاریہ_List_Append(pParse,A, Z);
}
%قسم case_else {اظہاریہ*}
%destructor case_else {sqlite3_اظہاریہ_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE اظہاریہ_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%قسم case_عملیہ {اظہاریہ*}
%destructor case_عملیہ {sqlite3_اظہاریہ_Delete(pParse->db, $$);}
case_عملیہ(A) ::= اظہاریہ_2(A).
case_عملیہ(A) ::= .                   {A = 0;} 

%قسم exprlist {اظہاریہ_List*}
%destructor exprlist {sqlite3_اظہاریہ_List_Delete(pParse->db, $$);}
%قسم nexprlist {اظہاریہ_List*}
%destructor nexprlist {sqlite3_اظہاریہ_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA اظہاریہ_2(Y).
    {A = sqlite3_اظہاریہ_List_Append(pParse,A,Y);}
nexprlist(A) ::= اظہاریہ_2(Y).
    {A = sqlite3_اظہاریہ_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%قسم paren_exprlist {اظہاریہ_List*}
%destructor paren_exprlist {sqlite3_اظہاریہ_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
