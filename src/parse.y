%نوع اظهار_2 {اظهار*}
%destructor اظهار_2 {sqlite3_اظهار_Delete(pParse->db, $$);}
%نوع رڪن {اظهار*}
%destructor رڪن {sqlite3_اظهار_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  ساكن اظهار *token_اظهار(Parse *pParse, صحيح op, Token t){
    اظهار *p = sqlite3DbMallocRawNN(pParse->db, حجم(اظهار)+t.n+1);
    إذا( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_اظهار = 0;
      p->flags = EP_پن;
      اظهار_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_کاٻو = p->p_ساڄو = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, حجم(p->x));
      memset(&p->y, 0, حجم(p->y));
      p->op2 = 0;
      p->i_جدول = 0;
      p->i_ڪالم = 0;
      p->u.zToken = (حرف*)&p[1];
      يادگيري_نقل(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (صحيح)(t.z - pParse->z_پڇ);
      إذا( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_اظهار(p);
      }
#إذا SQLITE_MAX_اظهار_اونهائي>0
      p->n_اوچائي = 1;
#جيڪڏهن_پورو  
      إذا( اندريون_RENAME_OBJECT ){
        أرجع (اظهار*)sqlite3RenameTokenMap(pParse, (فراغ*)p, &t);
      }
    }
    أرجع p;
  }

}

اظهار_2(A) ::= رڪن(A).
اظهار_2(A) ::= LP اظهار_2(X) RP. {A = X;}
اظهار_2(A) ::= idj(X).          {A=token_اظهار(pParse,TK_ID,X); /*A-overwrites-X*/}
اظهار_2(A) ::= nm(X) DOT nm(Y). {
  اظهار *temp1 = token_اظهار(pParse,TK_ID,X);
  اظهار *temp2 = token_اظهار(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
اظهار_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  اظهار *temp1 = token_اظهار(pParse,TK_ID,X);
  اظهار *temp2 = token_اظهار(pParse,TK_ID,Y);
  اظهار *temp3 = token_اظهار(pParse,TK_ID,Z);
  اظهار *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  إذا( اندريون_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
رڪن(A) ::= عدم|FLOAT|BLOB(X). {A=token_اظهار(pParse,@X,X); /*A-overwrites-X*/}
رڪن(A) ::= STRING(X).          {A=token_اظهار(pParse,@X,X); /*A-overwrites-X*/}
رڪن(A) ::= INTEGER(X). {
  صحيح i_قدر;
  إذا( sqlite3GetInt32(X.z, &i_قدر)==0 ){
    A = sqlite3_اظهار_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }وإلا{
    A = sqlite3_اظهار_Int32(pParse->db, i_قدر);
  }
  إذا( A ) A->w.iOfst = (صحيح)(X.z - pParse->z_پڇ);
}
اظهار_2(A) ::= VARIABLE(X).     {
  إذا( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_اظهار(pParse, TK_VARIABLE, X);
    sqlite3_اظهار_سونپيو_Var_عدد(pParse, A, n);
  }وإلا{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    أكد( t.n>=2 );
    إذا( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }وإلا{
      A = sqlite3PExpr(pParse, TK_رجسٽر, 0, 0);
      إذا( A ) sqlite3GetInt32(&t.z[1], &A->i_جدول);
    }
  }
}
اظهار_2(A) ::= اظهار_2(A) COLLATE ids(C). {
  A = sqlite3_اظهار_جوڙيو_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
اظهار_2(A) ::= CAST LP اظهار_2(E) AS typetoken(T) RP. {
  A = sqlite3_اظهار_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_اظهار_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


اظهار_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_اظهار_Function(pParse, Y, &X, D);
}
اظهار_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ترتيب BY sortlist(O) RP. {
  A = sqlite3_اظهار_Function(pParse, Y, &X, D);
  sqlite3_اظهار_جوڙيو_Function_ترتيب_By(pParse, A, O);
}
اظهار_2(A) ::= idj(X) LP تارو RP. {
  A = sqlite3_اظهار_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_سيٽ_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  ساكن اظهار *sqlite3_اظهار_جوڙيو_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    صحيح isDistinct,        /* DISTINCT or ALL qualifier */
    اظهار_List *pOrig,       /* Arguments to the function */
    اظهار *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    اظهار_List *p;           /* Modified argument list */
    اظهار *p_اظهار;           /* Final result */
    p = sqlite3_اظهار_List_Append(pParse, 0, pOrderby);
    إذا( pOrig ){
      صحيح i;
      لكل(i=0; i<pOrig->n_اظهار; i++){
        p = sqlite3_اظهار_List_Append(pParse, p, pOrig->a[i].p_اظهار);
        pOrig->a[i].p_اظهار = 0;
      }
      sqlite3_اظهار_List_Delete(pParse->db, pOrig);
    }
    p_اظهار = sqlite3_اظهار_Function(pParse, p, pFuncname, 0);
    إذا( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      أكد( p_اظهار!=0 );  /* Because otherwise pParse->nErr would not be zero */
      أكد( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3_ڳوليو_Function(pParse->db, p_اظهار->u.zToken, -2, enc, 0);
      إذا( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_نياپو(pParse, "%#T() is not an ordered-set aggregate", p_اظهار);
      }وإلا إذا( isDistinct==SF_Distinct ){
        sqlite3_Error_نياپو(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    أرجع p_اظهار;
  }
}
اظهار_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN گروهه LP ترتيب BY اظهار_2(E) RP. {
  A = sqlite3_اظهار_جوڙيو_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_سيٽ_AGGREGATES

%ifndef SQLITE_OMIT_WINDOWFUNC
اظهار_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP filter_over(Z). {
  A = sqlite3_اظهار_Function(pParse, Y, &X, D);
  sqlite3_دري_Attach(pParse, A, Z);
}
اظهار_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ترتيب BY sortlist(O) RP filter_over(Z). {
  A = sqlite3_اظهار_Function(pParse, Y, &X, D);
  sqlite3_دري_Attach(pParse, A, Z);
  sqlite3_اظهار_جوڙيو_Function_ترتيب_By(pParse, A, O);
}
اظهار_2(A) ::= idj(X) LP تارو RP filter_over(Z). {
  A = sqlite3_اظهار_Function(pParse, 0, &X, 0);
  sqlite3_دري_Attach(pParse, A, Z);
}
%ifdef SQLITE_ENABLE_ORDERED_سيٽ_AGGREGATES
اظهار_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN گروهه LP ترتيب BY اظهار_2(E) RP
            filter_over(Z). {
  A = sqlite3_اظهار_جوڙيو_Orderedset_Function(pParse, &X, D, Y, E);
  sqlite3_دري_Attach(pParse, A, Z);
}
%endif SQLITE_ENABLE_ORDERED_سيٽ_AGGREGATES

%endif SQLITE_OMIT_WINDOWFUNC

رڪن(A) ::= CTIME_KW(OP). {
  A = sqlite3_اظهار_Function(pParse, 0, &OP, 0);
}

اظهار_2(A) ::= LP nexprlist(X) COMMA اظهار_2(Y) RP. {
  اظهار_List *pList = sqlite3_اظهار_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_ويڪٽر, 0, 0);
  إذا( A ){
    صحيح i;
    A->x.pList = pList;
    لكل(i=0; i<pList->n_اظهار; i++){
      أكد( pList->a[i].p_اظهار!=0 );
      A->flags |= pList->a[i].p_اظهار->flags & EP_Propagate;
    }
  }وإلا{
    sqlite3_اظهار_List_Delete(pParse->db, pList);
  }
}

اظهار_2(A) ::= اظهار_2(A) AND اظهار_2(Y).        {A=sqlite3_اظهار_And(pParse,A,Y);}
اظهار_2(A) ::= اظهار_2(A) OR(OP) اظهار_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظهار_2(A) ::= اظهار_2(A) LT|GT|GE|LE(OP) اظهار_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظهار_2(A) ::= اظهار_2(A) EQ|NE(OP) اظهار_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظهار_2(A) ::= اظهار_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) اظهار_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظهار_2(A) ::= اظهار_2(A) PLUS|MINUS(OP) اظهار_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظهار_2(A) ::= اظهار_2(A) تارو|SLASH|REM(OP) اظهار_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
اظهار_2(A) ::= اظهار_2(A) CONCAT(OP) اظهار_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%نوع likeop {Token}
likeop(A) ::= LIKE_KW|ميلاپ_2(A).
likeop(A) ::= NOT LIKE_KW|ميلاپ_2(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
اظهار_2(A) ::= اظهار_2(A) likeop(OP) اظهار_2(Y).  [LIKE_KW]  {
  اظهار_List *pList;
  صحيح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_اظهار_List_Append(pParse,0, Y);
  pList = sqlite3_اظهار_List_Append(pParse,pList, A);
  A = sqlite3_اظهار_Function(pParse, pList, &OP, 0);
  إذا( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  إذا( A ) A->flags |= EP_InfixFunc;
}
اظهار_2(A) ::= اظهار_2(A) likeop(OP) اظهار_2(Y) ESCAPE اظهار_2(E).  [LIKE_KW]  {
  اظهار_List *pList;
  صحيح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_اظهار_List_Append(pParse,0, Y);
  pList = sqlite3_اظهار_List_Append(pParse,pList, A);
  pList = sqlite3_اظهار_List_Append(pParse,pList, E);
  A = sqlite3_اظهار_Function(pParse, pList, &OP, 0);
  إذا( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  إذا( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  ساكن اظهار *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    صحيح op,         /* TK_ISNULL or TK_NOTNULL */
    اظهار *p_کاٻو     /*عمليو*/
  ){
    اظهار *p = p_کاٻو;
    أكد( op==TK_ISNULL || op==TK_NOTNULL );
    أكد( p_کاٻو!=0 );
    طالما( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_کاٻو;
      أكد( p!=0 );
    }
    بدل( p->op ){
      حالة TK_INTEGER:
      حالة TK_STRING:
      حالة TK_FLOAT:
      حالة TK_BLOB: 
        sqlite3_اظهار_Deferred_Delete(pParse, p_کاٻو);
        p = sqlite3_اظهار_Int32(pParse->db, op==TK_NOTNULL);
        إذا( p ) p->op2 = 1;
        أرجع p;
      افتراضي:
        اكسر;
    }
    أرجع sqlite3PExpr(pParse, op, p_کاٻو, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  ساكن اظهار *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    صحيح op,         /* TK_IS or TK_ISNOT */
    اظهار *p_کاٻو,    /* Left operand */
    اظهار *p_ساڄو    /* Right operand */
  ){
    إذا( p_ساڄو && p_ساڄو->op==TK_NULL ){
      sqlite3_اظهار_Deferred_Delete(pParse, p_ساڄو);
      أرجع sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_کاٻو);
    }
    أرجع sqlite3PExpr(pParse, op, p_کاٻو, p_ساڄو);
  }
}

اظهار_2(A) ::= اظهار_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
اظهار_2(A) ::= اظهار_2(A) NOT عدم.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
اظهار_2(A) ::= اظهار_2(A) IS اظهار_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
اظهار_2(A) ::= اظهار_2(A) IS NOT اظهار_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
اظهار_2(A) ::= اظهار_2(A) IS NOT DISTINCT FROM اظهار_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
اظهار_2(A) ::= اظهار_2(A) IS DISTINCT FROM اظهار_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

اظهار_2(A) ::= NOT(B) اظهار_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
اظهار_2(A) ::= BITNOT(B) اظهار_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
اظهار_2(A) ::= PLUS|MINUS(B) اظهار_2(X). [BITNOT] {
  اظهار *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  أكد( TK_UPLUS>TK_PLUS );
  أكد( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  إذا( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }وإلا{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

اظهار_2(A) ::= اظهار_2(B) PTR(C) اظهار_2(D). {
  اظهار_List *pList = sqlite3_اظهار_List_Append(pParse, 0, B);
  pList = sqlite3_اظهار_List_Append(pParse, pList, D);
  A = sqlite3_اظهار_Function(pParse, pList, &C, 0);
}

%نوع between_op {صحيح}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
اظهار_2(A) ::= اظهار_2(A) between_op(N) اظهار_2(X) AND اظهار_2(Y). [BETWEEN] {
  اظهار_List *pList = sqlite3_اظهار_List_Append(pParse,0, X);
  pList = sqlite3_اظهار_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  إذا( A ){
    A->x.pList = pList;
    sqlite3_اظهار_سيٽ_اوچائي_And_Flags(pParse, A);
  }وإلا{
    sqlite3_اظهار_List_Delete(pParse->db, pList);
  } 
  إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %نوع اندريون_op {صحيح}
  اندريون_op(A) ::= اندريون_2.      {A = 0;}
  اندريون_op(A) ::= NOT اندريون_2.  {A = 1;}
  اظهار_2(A) ::= اظهار_2(A) اندريون_op(N) LP exprlist(Y) RP. [IN] {
    إذا( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      اظهار *pB = sqlite3_اظهار(pParse->db, TK_STRING, N ? "true" : "false");
      إذا( pB ) sqlite3_اظهار_Id_منزل_True_False(pB);
      إذا( !اظهار_Has_Property(A, EP_HasFunc) ){
        sqlite3_اظهار_Unmap_And_Delete(pParse, A);
        A = pB;
      }وإلا{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }وإلا{
      اظهار *pRHS = Y->a[0].p_اظهار;
      إذا( Y->n_اظهار==1
       && sqlite3_اظهار_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_ويڪٽر
      ){
        Y->a[0].p_اظهار = 0;
        sqlite3_اظهار_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }وإلا إذا( Y->n_اظهار==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_اندريون, A, 0);
        sqlite3_PExpr_جوڙيو_Select(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_اظهار_List_Delete(pParse->db, Y);
      }وإلا{
        A = sqlite3PExpr(pParse, TK_اندريون, A, 0);
        إذا( A==0 ){
          sqlite3_اظهار_List_Delete(pParse->db, Y);
        }وإلا إذا( A->p_کاٻو->op==TK_ويڪٽر ){
          صحيح n_اظهار = A->p_کاٻو->x.pList->n_اظهار;
          Select *pSelectRHS = sqlite3_اظهار_List_منزل_قدرون(pParse, n_اظهار, Y);
          إذا( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3_PExpr_جوڙيو_Select(pParse, A, pSelectRHS);
          }
        }وإلا{
          A->x.pList = Y;
          sqlite3_اظهار_سيٽ_اوچائي_And_Flags(pParse, A);
        }
      }
      إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  اظهار_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3_PExpr_جوڙيو_Select(pParse, A, X);
  }
  اظهار_2(A) ::= اظهار_2(A) اندريون_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_اندريون, A, 0);
    sqlite3_PExpr_جوڙيو_Select(pParse, A, Y);
    إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  اظهار_2(A) ::= اظهار_2(A) اندريون_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    إذا( E )  sqlite3_Src_List_Func_دليلون(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_اندريون, A, 0);
    sqlite3_PExpr_جوڙيو_Select(pParse, A, pSelect);
    إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  اظهار_2(A) ::= EXISTS LP select(Y) RP. {
    اظهار *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_جوڙيو_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
اظهار_2(A) ::= CASE case_عمليو(X) case_exprlist(Y) case_else(Z) پڇاڙي. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  إذا( A ){
    A->x.pList = Z ? sqlite3_اظهار_List_Append(pParse,Y,Z) : Y;
    sqlite3_اظهار_سيٽ_اوچائي_And_Flags(pParse, A);
  }وإلا{
    sqlite3_اظهار_List_Delete(pParse->db, Y);
    sqlite3_اظهار_Delete(pParse->db, Z);
  }
}
%نوع case_exprlist {اظهار_List*}
%destructor case_exprlist {sqlite3_اظهار_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN اظهار_2(Y) THEN اظهار_2(Z). {
  A = sqlite3_اظهار_List_Append(pParse,A, Y);
  A = sqlite3_اظهار_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN اظهار_2(Y) THEN اظهار_2(Z). {
  A = sqlite3_اظهار_List_Append(pParse,0, Y);
  A = sqlite3_اظهار_List_Append(pParse,A, Z);
}
%نوع case_else {اظهار*}
%destructor case_else {sqlite3_اظهار_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE اظهار_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%نوع case_عمليو {اظهار*}
%destructor case_عمليو {sqlite3_اظهار_Delete(pParse->db, $$);}
case_عمليو(A) ::= اظهار_2(A).
