%include {

  /* Construct a new Expr object from a single token */
  স্থির ৰাশিমালা *token_ৰাশিমালা(Parse *pParse, পূর্ণাঙ্ক op, Token t){
    ৰাশিমালা *p = sqlite3DbMallocRawNN(pParse->db, পরিমাণ(ৰাশিমালা)+t.n+1);
    যদি( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_ৰাশিমালা = 0;
      p->flags = EP_Leaf;
      ৰাশিমালা_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_বাম = p->p_ডান = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, পরিমাণ(p->x));
      memset(&p->y, 0, পরিমাণ(p->y));
      p->op2 = 0;
      p->iTable = 0;
      p->iColumn = 0;
      p->u.zToken = (ৱর্ণ*)&p[1];
      memcpy(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (পূর্ণাঙ্ক)(t.z - pParse->zTail);
      যদি( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_ৰাশিমালা(p);
      }
#যদি SQLITE_MAX_ৰাশিমালা_DEPTH>0
      p->nHeight = 1;
#endif  
      যদি( IN_RENAME_OBJECT ){
        ঘূৰাই (ৰাশিমালা*)sqlite3RenameTokenMap(pParse, (শূন্য*)p, &t);
      }
    }
    ঘূৰাই p;
  }

}

ৰাশিমালা_2(A) ::= term(A).
ৰাশিমালা_2(A) ::= LP ৰাশিমালা_2(X) RP. {A = X;}
ৰাশিমালা_2(A) ::= idj(X).          {A=token_ৰাশিমালা(pParse,TK_ID,X); /*A-overwrites-X*/}
ৰাশিমালা_2(A) ::= nm(X) DOT nm(Y). {
  ৰাশিমালা *temp1 = token_ৰাশিমালা(pParse,TK_ID,X);
  ৰাশিমালা *temp2 = token_ৰাশিমালা(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
ৰাশিমালা_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  ৰাশিমালা *temp1 = token_ৰাশিমালা(pParse,TK_ID,X);
  ৰাশিমালা *temp2 = token_ৰাশিমালা(pParse,TK_ID,Y);
  ৰাশিমালা *temp3 = token_ৰাশিমালা(pParse,TK_ID,Z);
  ৰাশিমালা *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  যদি( IN_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
term(A) ::= রিক্ত|FLOAT|BLOB(X). {A=token_ৰাশিমালা(pParse,@X,X); /*A-overwrites-X*/}
term(A) ::= STRING(X).          {A=token_ৰাশিমালা(pParse,@X,X); /*A-overwrites-X*/}
term(A) ::= INTEGER(X). {
  পূর্ণাঙ্ক i_মান;
  যদি( sqlite3GetInt32(X.z, &i_মান)==0 ){
    A = sqlite3_ৰাশিমালা_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }অন্যথা{
    A = sqlite3_ৰাশিমালা_Int32(pParse->db, i_মান);
  }
  যদি( A ) A->w.iOfst = (পূর্ণাঙ্ক)(X.z - pParse->zTail);
}
ৰাশিমালা_2(A) ::= VARIABLE(X).     {
  যদি( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_ৰাশিমালা(pParse, TK_VARIABLE, X);
    sqlite3_ৰাশিমালা_Assign_Var_সংখ্যা(pParse, A, n);
  }অন্যথা{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    প্রতিজ্ঞা( t.n>=2 );
    যদি( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }অন্যথা{
      A = sqlite3PExpr(pParse, TK_REGISTER, 0, 0);
      যদি( A ) sqlite3GetInt32(&t.z[1], &A->iTable);
    }
  }
}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) COLLATE ids(C). {
  A = sqlite3_ৰাশিমালা_Add_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
ৰাশিমালা_2(A) ::= CAST LP ৰাশিমালা_2(E) AS typetoken(T) RP. {
  A = sqlite3_ৰাশিমালা_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_ৰাশিমালা_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


ৰাশিমালা_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_ৰাশিমালা_Function(pParse, Y, &X, D);
}
ৰাশিমালা_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ORDER BY sortlist(O) RP. {
