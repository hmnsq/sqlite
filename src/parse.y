}
व्यंजक_2(A) ::= idj(X) LP STAR RP. {
  A = sqlite3_व्यंजक_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_SET_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  अटल व्यंजक *sqlite3_व्यंजक_Add_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    पूर्णांक isDistinct,        /* DISTINCT or ALL qualifier */
    व्यंजक_List *pOrig,       /* Arguments to the function */
    व्यंजक *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    व्यंजक_List *p;           /* Modified argument list */
    व्यंजक *p_व्यंजक;           /* Final result */
    p = sqlite3_व्यंजक_List_Append(pParse, 0, pOrderby);
    अगर( pOrig ){
      पूर्णांक i;
      क्रम(i=0; i<pOrig->n_व्यंजक; i++){
        p = sqlite3_व्यंजक_List_Append(pParse, p, pOrig->a[i].p_व्यंजक);
        pOrig->a[i].p_व्यंजक = 0;
      }
      sqlite3_व्यंजक_List_Delete(pParse->db, pOrig);
    }
    p_व्यंजक = sqlite3_व्यंजक_Function(pParse, p, pFuncname, 0);
    अगर( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      निश्चित( p_व्यंजक!=0 );  /* Because otherwise pParse->nErr would not be zero */
      निश्चित( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3FindFunction(pParse->db, p_व्यंजक->u.zToken, -2, enc, 0);
      अगर( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_संदेश(pParse, "%#T() is not an ordered-set aggregate", p_व्यंजक);
      }अन्यथा अगर( isDistinct==SF_Distinct ){
        sqlite3_Error_संदेश(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    वापस p_व्यंजक;
  }
}
व्यंजक_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN GROUP LP ORDER BY व्यंजक_2(E) RP. {
  A = sqlite3_व्यंजक_Add_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_SET_AGGREGATES

%ifndef SQLITE_OMIT_WINDOWFUNC
व्यंजक_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP filter_over(Z). {
  A = sqlite3_व्यंजक_Function(pParse, Y, &X, D);
  sqlite3WindowAttach(pParse, A, Z);
}
व्यंजक_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ORDER BY sortlist(O) RP filter_over(Z). {
  A = sqlite3_व्यंजक_Function(pParse, Y, &X, D);
  sqlite3WindowAttach(pParse, A, Z);
  sqlite3_व्यंजक_Add_Function_Order_By(pParse, A, O);
}
व्यंजक_2(A) ::= idj(X) LP STAR RP filter_over(Z). {
  A = sqlite3_व्यंजक_Function(pParse, 0, &X, 0);
  sqlite3WindowAttach(pParse, A, Z);
}
%ifdef SQLITE_ENABLE_ORDERED_SET_AGGREGATES
व्यंजक_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN GROUP LP ORDER BY व्यंजक_2(E) RP
            filter_over(Z). {
  A = sqlite3_व्यंजक_Add_Orderedset_Function(pParse, &X, D, Y, E);
  sqlite3WindowAttach(pParse, A, Z);
}
%endif SQLITE_ENABLE_ORDERED_SET_AGGREGATES

%endif SQLITE_OMIT_WINDOWFUNC

term(A) ::= CTIME_KW(OP). {
  A = sqlite3_व्यंजक_Function(pParse, 0, &OP, 0);
}

व्यंजक_2(A) ::= LP nexprlist(X) COMMA व्यंजक_2(Y) RP. {
  व्यंजक_List *pList = sqlite3_व्यंजक_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_VECTOR, 0, 0);
  अगर( A ){
    पूर्णांक i;
    A->x.pList = pList;
    क्रम(i=0; i<pList->n_व्यंजक; i++){
      निश्चित( pList->a[i].p_व्यंजक!=0 );
      A->flags |= pList->a[i].p_व्यंजक->flags & EP_Propagate;
    }
  }अन्यथा{
    sqlite3_व्यंजक_List_Delete(pParse->db, pList);
  }
}

व्यंजक_2(A) ::= व्यंजक_2(A) AND व्यंजक_2(Y).        {A=sqlite3_व्यंजक_And(pParse,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) OR(OP) व्यंजक_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) LT|GT|GE|LE(OP) व्यंजक_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) EQ|NE(OP) व्यंजक_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) व्यंजक_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) PLUS|MINUS(OP) व्यंजक_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) STAR|SLASH|REM(OP) व्यंजक_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यंजक_2(A) ::= व्यंजक_2(A) CONCAT(OP) व्यंजक_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%type likeop {Token}
likeop(A) ::= LIKE_KW|MATCH(A).
likeop(A) ::= NOT LIKE_KW|MATCH(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
व्यंजक_2(A) ::= व्यंजक_2(A) likeop(OP) व्यंजक_2(Y).  [LIKE_KW]  {
  व्यंजक_List *pList;
  पूर्णांक bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_व्यंजक_List_Append(pParse,0, Y);
  pList = sqlite3_व्यंजक_List_Append(pParse,pList, A);
  A = sqlite3_व्यंजक_Function(pParse, pList, &OP, 0);
  अगर( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  अगर( A ) A->flags |= EP_InfixFunc;
}
व्यंजक_2(A) ::= व्यंजक_2(A) likeop(OP) व्यंजक_2(Y) ESCAPE व्यंजक_2(E).  [LIKE_KW]  {
  व्यंजक_List *pList;
  पूर्णांक bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_व्यंजक_List_Append(pParse,0, Y);
  pList = sqlite3_व्यंजक_List_Append(pParse,pList, A);
  pList = sqlite3_व्यंजक_List_Append(pParse,pList, E);
  A = sqlite3_व्यंजक_Function(pParse, pList, &OP, 0);
  अगर( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  अगर( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  अटल व्यंजक *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    पूर्णांक op,         /* TK_ISNULL or TK_NOTNULL */
    व्यंजक *p_बायाँ     /* Operand */
  ){
    व्यंजक *p = p_बायाँ;
    निश्चित( op==TK_ISNULL || op==TK_NOTNULL );
    निश्चित( p_बायाँ!=0 );
    जबतक( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_बायाँ;
      निश्चित( p!=0 );
    }
    चयन( p->op ){
      हाल TK_INTEGER:
      हाल TK_STRING:
      हाल TK_FLOAT:
      हाल TK_BLOB: 
        sqlite3_व्यंजक_Deferred_Delete(pParse, p_बायाँ);
        p = sqlite3_व्यंजक_Int32(pParse->db, op==TK_NOTNULL);
        अगर( p ) p->op2 = 1;
        वापस p;
      शेष:
        अवरोध;
    }
    वापस sqlite3PExpr(pParse, op, p_बायाँ, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  अटल व्यंजक *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    पूर्णांक op,         /* TK_IS or TK_ISNOT */
    व्यंजक *p_बायाँ,    /* Left operand */
    व्यंजक *p_दायाँ    /* Right operand */
  ){
    अगर( p_दायाँ && p_दायाँ->op==TK_NULL ){
      sqlite3_व्यंजक_Deferred_Delete(pParse, p_दायाँ);
      वापस sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_बायाँ);
    }
    वापस sqlite3PExpr(pParse, op, p_बायाँ, p_दायाँ);
  }
}

व्यंजक_2(A) ::= व्यंजक_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
व्यंजक_2(A) ::= व्यंजक_2(A) NOT शून्य.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
व्यंजक_2(A) ::= व्यंजक_2(A) IS व्यंजक_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
व्यंजक_2(A) ::= व्यंजक_2(A) IS NOT व्यंजक_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
व्यंजक_2(A) ::= व्यंजक_2(A) IS NOT DISTINCT FROM व्यंजक_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
व्यंजक_2(A) ::= व्यंजक_2(A) IS DISTINCT FROM व्यंजक_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

व्यंजक_2(A) ::= NOT(B) व्यंजक_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
व्यंजक_2(A) ::= BITNOT(B) व्यंजक_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
व्यंजक_2(A) ::= PLUS|MINUS(B) व्यंजक_2(X). [BITNOT] {
  व्यंजक *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  निश्चित( TK_UPLUS>TK_PLUS );
  निश्चित( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  अगर( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }अन्यथा{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

व्यंजक_2(A) ::= व्यंजक_2(B) PTR(C) व्यंजक_2(D). {
  व्यंजक_List *pList = sqlite3_व्यंजक_List_Append(pParse, 0, B);
  pList = sqlite3_व्यंजक_List_Append(pParse, pList, D);
  A = sqlite3_व्यंजक_Function(pParse, pList, &C, 0);
}

%type between_op {पूर्णांक}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
व्यंजक_2(A) ::= व्यंजक_2(A) between_op(N) व्यंजक_2(X) AND व्यंजक_2(Y). [BETWEEN] {
  व्यंजक_List *pList = sqlite3_व्यंजक_List_Append(pParse,0, X);
  pList = sqlite3_व्यंजक_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  अगर( A ){
    A->x.pList = pList;
    sqlite3_व्यंजक_Set_Height_And_Flags(pParse, A);
  }अन्यथा{
    sqlite3_व्यंजक_List_Delete(pParse->db, pList);
  } 
  अगर( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %type in_op {पूर्णांक}
  in_op(A) ::= IN.      {A = 0;}
  in_op(A) ::= NOT IN.  {A = 1;}
  व्यंजक_2(A) ::= व्यंजक_2(A) in_op(N) LP exprlist(Y) RP. [IN] {
    अगर( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      व्यंजक *pB = sqlite3_व्यंजक(pParse->db, TK_STRING, N ? "true" : "false");
      अगर( pB ) sqlite3_व्यंजक_Id_To_True_False(pB);
      अगर( !व्यंजक_Has_Property(A, EP_HasFunc) ){
        sqlite3_व्यंजक_Unmap_And_Delete(pParse, A);
        A = pB;
      }अन्यथा{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }अन्यथा{
      व्यंजक *pRHS = Y->a[0].p_व्यंजक;
      अगर( Y->n_व्यंजक==1
       && sqlite3_व्यंजक_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_VECTOR
      ){
        Y->a[0].p_व्यंजक = 0;
        sqlite3_व्यंजक_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }अन्यथा अगर( Y->n_व्यंजक==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_IN, A, 0);
        sqlite3PExprAddSelect(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_व्यंजक_List_Delete(pParse->db, Y);
      }अन्यथा{
        A = sqlite3PExpr(pParse, TK_IN, A, 0);
        अगर( A==0 ){
          sqlite3_व्यंजक_List_Delete(pParse->db, Y);
        }अन्यथा अगर( A->p_बायाँ->op==TK_VECTOR ){
          पूर्णांक n_व्यंजक = A->p_बायाँ->x.pList->n_व्यंजक;
          Select *pSelectRHS = sqlite3_व्यंजक_List_To_मूल्यावली(pParse, n_व्यंजक, Y);
          अगर( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3PExprAddSelect(pParse, A, pSelectRHS);
          }
        }अन्यथा{
          A->x.pList = Y;
          sqlite3_व्यंजक_Set_Height_And_Flags(pParse, A);
        }
      }
      अगर( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  व्यंजक_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3PExprAddSelect(pParse, A, X);
  }
  व्यंजक_2(A) ::= व्यंजक_2(A) in_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_IN, A, 0);
    sqlite3PExprAddSelect(pParse, A, Y);
    अगर( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  व्यंजक_2(A) ::= व्यंजक_2(A) in_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    अगर( E )  sqlite3SrcListFuncArgs(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_IN, A, 0);
    sqlite3PExprAddSelect(pParse, A, pSelect);
    अगर( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  व्यंजक_2(A) ::= EXISTS LP select(Y) RP. {
    व्यंजक *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3PExprAddSelect(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
व्यंजक_2(A) ::= CASE case_operand(X) case_exprlist(Y) case_else(Z) END. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  अगर( A ){
    A->x.pList = Z ? sqlite3_व्यंजक_List_Append(pParse,Y,Z) : Y;
    sqlite3_व्यंजक_Set_Height_And_Flags(pParse, A);
  }अन्यथा{
    sqlite3_व्यंजक_List_Delete(pParse->db, Y);
    sqlite3_व्यंजक_Delete(pParse->db, Z);
  }
}
%type case_exprlist {व्यंजक_List*}
%destructor case_exprlist {sqlite3_व्यंजक_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN व्यंजक_2(Y) THEN व्यंजक_2(Z). {
  A = sqlite3_व्यंजक_List_Append(pParse,A, Y);
  A = sqlite3_व्यंजक_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN व्यंजक_2(Y) THEN व्यंजक_2(Z). {
  A = sqlite3_व्यंजक_List_Append(pParse,0, Y);
  A = sqlite3_व्यंजक_List_Append(pParse,A, Z);
}
%type case_else {व्यंजक*}
%destructor case_else {sqlite3_व्यंजक_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE व्यंजक_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%type case_operand {व्यंजक*}
%destructor case_operand {sqlite3_व्यंजक_Delete(pParse->db, $$);}
case_operand(A) ::= व्यंजक_2(A).
case_operand(A) ::= .                   {A = 0;} 

%type exprlist {व्यंजक_List*}
%destructor exprlist {sqlite3_व्यंजक_List_Delete(pParse->db, $$);}
%type nexprlist {व्यंजक_List*}
%destructor nexprlist {sqlite3_व्यंजक_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA व्यंजक_2(Y).
    {A = sqlite3_व्यंजक_List_Append(pParse,A,Y);}
nexprlist(A) ::= व्यंजक_2(Y).
    {A = sqlite3_व्यंजक_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%type paren_exprlist {व्यंजक_List*}
%destructor paren_exprlist {sqlite3_व्यंजक_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
%endif SQLITE_OMIT_SUBQUERY


///////////////////////////// The CREATE INDEX command ///////////////////////
//
cmd ::= createkw(S) uniqueflag(U) सूचकांक_2 ifnotexists(NE) nm(X) dbnm(D)
        ON nm(Y) LP sortlist(Z) RP where_opt(W). {
  sqlite3_Create_सूचकांक(pParse, &X, &D, 
                     sqlite3SrcListAppend(pParse,0,&Y,0), Z, U,
                      &S, W, SQLITE_SO_ASC, NE, SQLITE_IDXTYPE_APPDEF);
  अगर( IN_RENAME_OBJECT && pParse->p_New_सूचकांक ){
    sqlite3RenameTokenMap(pParse, pParse->p_New_सूचकांक->zName, &Y);
  }
}

%type uniqueflag {पूर्णांक}
uniqueflag(A) ::= UNIQUE.  {A = OE_Abort;}
uniqueflag(A) ::= .        {A = OE_None;}


// The eidlist non-terminal (Expression Id List) generates an ExprList
// from a list of identifiers.  The identifier names are in ExprList.a[].zName.
// This list is stored in an ExprList rather than an IdList so that it
// can be easily sent to sqlite3ColumnsExprList().
//
// eidlist is grouped with CREATE INDEX because it used to be the non-terminal
// used for the arguments to an index.  That is just an historical accident.
//
// IMPORTANT COMPATIBILITY NOTE:  Some prior versions of SQLite accepted
// COLLATE clauses and ASC or DESC keywords on ID lists in inappropriate
// places - places that might have been stored in the sqlite_schema table.
// Those extra features were ignored.  But because they might be in some
// (busted) old databases, we need to continue parsing them when loading
// historical schemas.
//
%type eidlist {व्यंजक_List*}
%destructor eidlist {sqlite3_व्यंजक_List_Delete(pParse->db, $$);}
%type eidlist_opt {व्यंजक_List*}
%destructor eidlist_opt {sqlite3_व्यंजक_List_Delete(pParse->db, $$);}

%include {
  /* Add a single new term to an ExprList that is used to store a
  ** list of identifiers.  Report an error if the ID list contains
  ** a COLLATE clause or an ASC or DESC keyword, except ignore the
  ** error while parsing a legacy schema.
  */
  अटल व्यंजक_List *parser_Add_व्यंजक_Id_List_Term(
    Parse *pParse,
    व्यंजक_List *pPrior,
    Token *pIdToken,
    पूर्णांक hasCollate,
    पूर्णांक sortOrder
  ){
    व्यंजक_List *p = sqlite3_व्यंजक_List_Append(pParse, pPrior, 0);
    अगर( (hasCollate || sortOrder!=SQLITE_SO_UNDEFINED)
        && pParse->db->init.busy==0
    ){
      sqlite3_Error_संदेश(pParse, "syntax error after column name \"%.*s\"",
                         pIdToken->n, pIdToken->z);
    }
    sqlite3_व्यंजक_List_Set_Name(pParse, p, pIdToken, 1);
    वापस p;
  }
} // end %include

eidlist_opt(A) ::= .                         {A = 0;}
eidlist_opt(A) ::= LP eidlist(X) RP.         {A = X;}
eidlist(A) ::= eidlist(A) COMMA nm(Y) collate(C) sortorder(Z).  {
  A = parser_Add_व्यंजक_Id_List_Term(pParse, A, &Y, C, Z);
}
eidlist(A) ::= nm(Y) collate(C) sortorder(Z). {
  A = parser_Add_व्यंजक_Id_List_Term(pParse, 0, &Y, C, Z); /*A-overwrites-Y*/
}

%type collate {पूर्णांक}
collate(C) ::= .              {C = 0;}
collate(C) ::= COLLATE ids.   {C = 1;}


///////////////////////////// The DROP INDEX command /////////////////////////
//
cmd ::= DROP सूचकांक_2 ifexists(E) fullname(X).   {sqlite3_Drop_सूचकांक(pParse, X, E);}

///////////////////////////// The VACUUM command /////////////////////////////
//
%अगर !SQLITE_OMIT_VACUUM && !SQLITE_OMIT_ATTACH
%type vinto {व्यंजक*}
%destructor vinto {sqlite3_व्यंजक_Delete(pParse->db, $$);}
cmd ::= VACUUM vinto(Y).                {sqlite3Vacuum(pParse,0,Y);}
cmd ::= VACUUM nm(X) vinto(Y).          {sqlite3Vacuum(pParse,&X,Y);}
vinto(A) ::= INTO व्यंजक_2(X).              {A = X;}
vinto(A) ::= .                          {A = 0;}
%endif

///////////////////////////// The PRAGMA command /////////////////////////////
//
%ifndef SQLITE_OMIT_PRAGMA
cmd ::= PRAGMA nm(X) dbnm(Z).                {sqlite3Pragma(pParse,&X,&Z,0,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ nmnum(Y).    {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP nmnum(Y) RP. {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ minus_अंक(Y). 
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP minus_अंक(Y) RP.
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_अंक(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class संख्या INTEGER|FLOAT.
plus_अंक(A) ::= PLUS संख्या(X).       {A = X;}
plus_अंक(A) ::= संख्या(A).
minus_अंक(A) ::= MINUS संख्या(X).     {A = X;}
//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) END(Z). {
  Token all;
  all.z = A.z;
  all.n = (पूर्णांक)(Z.z - A.z) + Z.n;
  sqlite3FinishTrigger(pParse, S, &all);
}

trigger_decl(A) ::= अस्थायी(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_time(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#अगर_घोषित SQLITE_DEBUG
  निश्चित( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#पूर्ण_अगर
}

%type trigger_time {पूर्णांक}
trigger_time(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_time(A) ::= INSTEAD OF.  { A = TK_INSTEAD;}
trigger_time(A) ::= .            { A = TK_BEFORE; }

%type trigger_event {काष्ठा TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|जोड़ो(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE OF idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH ROW.

%type when_clause {व्यंजक*}
%destructor when_clause {sqlite3_व्यंजक_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN व्यंजक_2(X). { A = X; }

%type trigger_cmd_list {TriggerStep*}
%destructor trigger_cmd_list {sqlite3DeleteTriggerStep(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->pLast->p_अग्र = X;
  A->pLast = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->pLast = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= INDEXED BY nm. {
  sqlite3_Error_संदेश(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT INDEXED. {
  sqlite3_Error_संदेश(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%type trigger_cmd {TriggerStep*}
%destructor trigger_cmd {sqlite3DeleteTriggerStep(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby SET setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3TriggerUpdateStep(pParse, X, F, Y, Z, R, B.z, E);}

//जोड़ो
trigger_cmd(A) ::= scanpt(B) जोड़ो_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_जोड़ो_Step(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3TriggerDeleteStep(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3TriggerSelectStep(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
व्यंजक_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  अगर( A ){
    A->aff_व्यंजक = OE_Ignore;
  }
}
व्यंजक_2(A) ::= RAISE LP raisetype(T) COMMA व्यंजक_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  अगर( A ) {
    A->aff_व्यंजक = (अक्षर)T;
  }
}
%endif  !SQLITE_OMIT_TRIGGER

%type raisetype {पूर्णांक}
raisetype(A) ::= ROLLBACK.  {A = OE_Rollback;}
raisetype(A) ::= ABORT.     {A = OE_Abort;}
raisetype(A) ::= FAIL.      {A = OE_Fail;}


