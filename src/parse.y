%ಪ್ರಕಾರ ಅಭಿವ್ಯಕ್ತಿ_2 {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor ಅಭಿವ್ಯಕ್ತಿ_2 {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}
%ಪ್ರಕಾರ ಪದ {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor ಪದ {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  ಸ್ಥಿರ ಅಭಿವ್ಯಕ್ತಿ *token_ಅಭಿವ್ಯಕ್ತಿ(Parse *pParse, ಪೂರ್ಣಾಂಕ op, Token t){
    ಅಭಿವ್ಯಕ್ತಿ *p = sqlite3DbMallocRawNN(pParse->db, ಗಾತ್ರ(ಅಭಿವ್ಯಕ್ತಿ)+t.n+1);
    ಆದರೆ( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_ಅಭಿವ್ಯಕ್ತಿ = 0;
      p->flags = EP_ಎಲೆ;
      ಅಭಿವ್ಯಕ್ತಿ_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_ಎಡ = p->p_ಬಲ = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, ಗಾತ್ರ(p->x));
      memset(&p->y, 0, ಗಾತ್ರ(p->y));
      p->op2 = 0;
      p->i_ಕೋಷ್ಟಕ = 0;
      p->i_ಸ್ತಂಭ = 0;
      p->u.zToken = (ಅಕ್ಷರ*)&p[1];
      ಸ್ಮರಣೆ_ನಕಲು(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (ಪೂರ್ಣಾಂಕ)(t.z - pParse->z_ಬಾಲ);
      ಆದರೆ( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_ಅಭಿವ್ಯಕ್ತಿ(p);
      }
#ಆದರೆ SQLITE_MAX_ಅಭಿವ್ಯಕ್ತಿ_ಆಳ>0
      p->n_ಎತ್ತರ = 1;
#ಆದರೆ_ಅಂತ್ಯ  
      ಆದರೆ( ಒಳ_RENAME_OBJECT ){
        ಹಿಂತಿರುಗಿ (ಅಭಿವ್ಯಕ್ತಿ*)sqlite3RenameTokenMap(pParse, (ಶೂನ್ಯ*)p, &t);
      }
    }
    ಹಿಂತಿರುಗಿ p;
  }

}

ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಪದ(A).
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= LP ಅಭಿವ್ಯಕ್ತಿ_2(X) RP. {A = X;}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X).          {A=token_ಅಭಿವ್ಯಕ್ತಿ(pParse,TK_ID,X); /*A-overwrites-X*/}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= nm(X) DOT nm(Y). {
  ಅಭಿವ್ಯಕ್ತಿ *temp1 = token_ಅಭಿವ್ಯಕ್ತಿ(pParse,TK_ID,X);
  ಅಭಿವ್ಯಕ್ತಿ *temp2 = token_ಅಭಿವ್ಯಕ್ತಿ(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  ಅಭಿವ್ಯಕ್ತಿ *temp1 = token_ಅಭಿವ್ಯಕ್ತಿ(pParse,TK_ID,X);
  ಅಭಿವ್ಯಕ್ತಿ *temp2 = token_ಅಭಿವ್ಯಕ್ತಿ(pParse,TK_ID,Y);
  ಅಭಿವ್ಯಕ್ತಿ *temp3 = token_ಅಭಿವ್ಯಕ್ತಿ(pParse,TK_ID,Z);
  ಅಭಿವ್ಯಕ್ತಿ *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  ಆದರೆ( ಒಳ_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
ಪದ(A) ::= ಖಾಲಿ|FLOAT|BLOB(X). {A=token_ಅಭಿವ್ಯಕ್ತಿ(pParse,@X,X); /*A-overwrites-X*/}
ಪದ(A) ::= STRING(X).          {A=token_ಅಭಿವ್ಯಕ್ತಿ(pParse,@X,X); /*A-overwrites-X*/}
ಪದ(A) ::= INTEGER(X). {
  ಪೂರ್ಣಾಂಕ i_ಮೌಲ್ಯ;
  ಆದರೆ( sqlite3GetInt32(X.z, &i_ಮೌಲ್ಯ)==0 ){
    A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }ಇಲ್ಲದಿದ್ದರೆ{
    A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Int32(pParse->db, i_ಮೌಲ್ಯ);
  }
  ಆದರೆ( A ) A->w.iOfst = (ಪೂರ್ಣಾಂಕ)(X.z - pParse->z_ಬಾಲ);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= VARIABLE(X).     {
  ಆದರೆ( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_ಅಭಿವ್ಯಕ್ತಿ(pParse, TK_VARIABLE, X);
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ನಿಯೋಜಿಸು_Var_ಸಂಖ್ಯೆ(pParse, A, n);
  }ಇಲ್ಲದಿದ್ದರೆ{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    ಪ್ರತಿಜ್ಞಾ( t.n>=2 );
    ಆದರೆ( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }ಇಲ್ಲದಿದ್ದರೆ{
      A = sqlite3PExpr(pParse, TK_ರಿಜಿಸ್ಟರ್, 0, 0);
      ಆದರೆ( A ) sqlite3GetInt32(&t.z[1], &A->i_ಕೋಷ್ಟಕ);
    }
  }
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) COLLATE ids(C). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಕೂಡಿಸು_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= CAST LP ಅಭಿವ್ಯಕ್ತಿ_2(E) AS typetoken(T) RP. {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, Y, &X, D);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ಕ್ರಮ BY sortlist(O) RP. {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, Y, &X, D);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಕೂಡಿಸು_Function_ಕ್ರಮ_By(pParse, A, O);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP ನಕ್ಷತ್ರ RP. {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_ಗಣ_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  ಸ್ಥಿರ ಅಭಿವ್ಯಕ್ತಿ *sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಕೂಡಿಸು_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    ಪೂರ್ಣಾಂಕ isDistinct,        /* DISTINCT or ALL qualifier */
    ಅಭಿವ್ಯಕ್ತಿ_List *pOrig,       /* Arguments to the function */
    ಅಭಿವ್ಯಕ್ತಿ *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    ಅಭಿವ್ಯಕ್ತಿ_List *p;           /* Modified argument list */
    ಅಭಿವ್ಯಕ್ತಿ *p_ಅಭಿವ್ಯಕ್ತಿ;           /* Final result */
    p = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, 0, pOrderby);
    ಆದರೆ( pOrig ){
      ಪೂರ್ಣಾಂಕ i;
      ಗಾಗಿ(i=0; i<pOrig->n_ಅಭಿವ್ಯಕ್ತಿ; i++){
        p = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, p, pOrig->a[i].p_ಅಭಿವ್ಯಕ್ತಿ);
        pOrig->a[i].p_ಅಭಿವ್ಯಕ್ತಿ = 0;
      }
      sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, pOrig);
    }
    p_ಅಭಿವ್ಯಕ್ತಿ = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, p, pFuncname, 0);
    ಆದರೆ( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      ಪ್ರತಿಜ್ಞಾ( p_ಅಭಿವ್ಯಕ್ತಿ!=0 );  /* Because otherwise pParse->nErr would not be zero */
      ಪ್ರತಿಜ್ಞಾ( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3_ಕಂಡುಹಿಡಿ_Function(pParse->db, p_ಅಭಿವ್ಯಕ್ತಿ->u.zToken, -2, enc, 0);
      ಆದರೆ( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_ಸಂದೇಶ(pParse, "%#T() is not an ordered-set aggregate", p_ಅಭಿವ್ಯಕ್ತಿ);
      }ಇಲ್ಲದಿದ್ದರೆ ಆದರೆ( isDistinct==SF_Distinct ){
        sqlite3_Error_ಸಂದೇಶ(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    ಹಿಂತಿರುಗಿ p_ಅಭಿವ್ಯಕ್ತಿ;
  }
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN ಗುಂಪು LP ಕ್ರಮ BY ಅಭಿವ್ಯಕ್ತಿ_2(E) RP. {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಕೂಡಿಸು_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_ಗಣ_AGGREGATES

%ifndef SQLITE_OMIT_WINDOWFUNC
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP filter_over(Z). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, Y, &X, D);
  sqlite3_ಕಿಟಕಿ_Attach(pParse, A, Z);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ಕ್ರಮ BY sortlist(O) RP filter_over(Z). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, Y, &X, D);
  sqlite3_ಕಿಟಕಿ_Attach(pParse, A, Z);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಕೂಡಿಸು_Function_ಕ್ರಮ_By(pParse, A, O);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP ನಕ್ಷತ್ರ RP filter_over(Z). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, 0, &X, 0);
  sqlite3_ಕಿಟಕಿ_Attach(pParse, A, Z);
}
%ifdef SQLITE_ENABLE_ORDERED_ಗಣ_AGGREGATES
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN ಗುಂಪು LP ಕ್ರಮ BY ಅಭಿವ್ಯಕ್ತಿ_2(E) RP
            filter_over(Z). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಕೂಡಿಸು_Orderedset_Function(pParse, &X, D, Y, E);
  sqlite3_ಕಿಟಕಿ_Attach(pParse, A, Z);
}
%endif SQLITE_ENABLE_ORDERED_ಗಣ_AGGREGATES

%endif SQLITE_OMIT_WINDOWFUNC

ಪದ(A) ::= CTIME_KW(OP). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, 0, &OP, 0);
}

ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= LP nexprlist(X) COMMA ಅಭಿವ್ಯಕ್ತಿ_2(Y) RP. {
  ಅಭಿವ್ಯಕ್ತಿ_List *pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_ಸದಿಶ, 0, 0);
  ಆದರೆ( A ){
    ಪೂರ್ಣಾಂಕ i;
    A->x.pList = pList;
    ಗಾಗಿ(i=0; i<pList->n_ಅಭಿವ್ಯಕ್ತಿ; i++){
      ಪ್ರತಿಜ್ಞಾ( pList->a[i].p_ಅಭಿವ್ಯಕ್ತಿ!=0 );
      A->flags |= pList->a[i].p_ಅಭಿವ್ಯಕ್ತಿ->flags & EP_Propagate;
    }
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, pList);
  }
}

ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) AND ಅಭಿವ್ಯಕ್ತಿ_2(Y).        {A=sqlite3_ಅಭಿವ್ಯಕ್ತಿ_And(pParse,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) OR(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) LT|GT|GE|LE(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) EQ|NE(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) PLUS|MINUS(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) ನಕ್ಷತ್ರ|SLASH|REM(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) CONCAT(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%ಪ್ರಕಾರ likeop {Token}
likeop(A) ::= LIKE_KW|ಹೊಂದಿಕೆ_2(A).
likeop(A) ::= NOT LIKE_KW|ಹೊಂದಿಕೆ_2(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) likeop(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y).  [LIKE_KW]  {
  ಅಭಿವ್ಯಕ್ತಿ_List *pList;
  ಪೂರ್ಣಾಂಕ bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,0, Y);
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,pList, A);
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, pList, &OP, 0);
  ಆದರೆ( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  ಆದರೆ( A ) A->flags |= EP_InfixFunc;
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) likeop(OP) ಅಭಿವ್ಯಕ್ತಿ_2(Y) ESCAPE ಅಭಿವ್ಯಕ್ತಿ_2(E).  [LIKE_KW]  {
  ಅಭಿವ್ಯಕ್ತಿ_List *pList;
  ಪೂರ್ಣಾಂಕ bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,0, Y);
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,pList, A);
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,pList, E);
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, pList, &OP, 0);
  ಆದರೆ( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  ಆದರೆ( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  ಸ್ಥಿರ ಅಭಿವ್ಯಕ್ತಿ *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    ಪೂರ್ಣಾಂಕ op,         /* TK_ISNULL or TK_NOTNULL */
    ಅಭಿವ್ಯಕ್ತಿ *p_ಎಡ     /*ಕಾರ್ಯಾಂಶ*/
  ){
    ಅಭಿವ್ಯಕ್ತಿ *p = p_ಎಡ;
    ಪ್ರತಿಜ್ಞಾ( op==TK_ISNULL || op==TK_NOTNULL );
    ಪ್ರತಿಜ್ಞಾ( p_ಎಡ!=0 );
    ಆಗ( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_ಎಡ;
      ಪ್ರತಿಜ್ಞಾ( p!=0 );
    }
    ಆಯ್ಕೆ( p->op ){
      ಸ್ಥಿತಿ TK_INTEGER:
      ಸ್ಥಿತಿ TK_STRING:
      ಸ್ಥಿತಿ TK_FLOAT:
      ಸ್ಥಿತಿ TK_BLOB: 
        sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Deferred_Delete(pParse, p_ಎಡ);
        p = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Int32(pParse->db, op==TK_NOTNULL);
        ಆದರೆ( p ) p->op2 = 1;
        ಹಿಂತಿರುಗಿ p;
      ಪೂರ್ವನಿಯೋಜಿತ:
        ನಿಲ್ಲಿಸು;
    }
    ಹಿಂತಿರುಗಿ sqlite3PExpr(pParse, op, p_ಎಡ, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  ಸ್ಥಿರ ಅಭಿವ್ಯಕ್ತಿ *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    ಪೂರ್ಣಾಂಕ op,         /* TK_IS or TK_ISNOT */
    ಅಭಿವ್ಯಕ್ತಿ *p_ಎಡ,    /* Left operand */
    ಅಭಿವ್ಯಕ್ತಿ *p_ಬಲ    /* Right operand */
  ){
    ಆದರೆ( p_ಬಲ && p_ಬಲ->op==TK_NULL ){
      sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Deferred_Delete(pParse, p_ಬಲ);
      ಹಿಂತಿರುಗಿ sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_ಎಡ);
    }
    ಹಿಂತಿರುಗಿ sqlite3PExpr(pParse, op, p_ಎಡ, p_ಬಲ);
  }
}

ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) NOT ಖಾಲಿ.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) IS ಅಭಿವ್ಯಕ್ತಿ_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) IS NOT ಅಭಿವ್ಯಕ್ತಿ_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) IS NOT DISTINCT FROM ಅಭಿವ್ಯಕ್ತಿ_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) IS DISTINCT FROM ಅಭಿವ್ಯಕ್ತಿ_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= NOT(B) ಅಭಿವ್ಯಕ್ತಿ_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= BITNOT(B) ಅಭಿವ್ಯಕ್ತಿ_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= PLUS|MINUS(B) ಅಭಿವ್ಯಕ್ತಿ_2(X). [BITNOT] {
  ಅಭಿವ್ಯಕ್ತಿ *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  ಪ್ರತಿಜ್ಞಾ( TK_UPLUS>TK_PLUS );
  ಪ್ರತಿಜ್ಞಾ( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  ಆದರೆ( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }ಇಲ್ಲದಿದ್ದರೆ{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(B) PTR(C) ಅಭಿವ್ಯಕ್ತಿ_2(D). {
  ಅಭಿವ್ಯಕ್ತಿ_List *pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, 0, B);
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, pList, D);
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Function(pParse, pList, &C, 0);
}

%ಪ್ರಕಾರ between_op {ಪೂರ್ಣಾಂಕ}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) between_op(N) ಅಭಿವ್ಯಕ್ತಿ_2(X) AND ಅಭಿವ್ಯಕ್ತಿ_2(Y). [BETWEEN] {
  ಅಭಿವ್ಯಕ್ತಿ_List *pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,0, X);
  pList = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  ಆದರೆ( A ){
    A->x.pList = pList;
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಗಣ_ಎತ್ತರ_And_Flags(pParse, A);
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, pList);
  } 
  ಆದರೆ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %ಪ್ರಕಾರ ಒಳ_op {ಪೂರ್ಣಾಂಕ}
  ಒಳ_op(A) ::= ಒಳ_2.      {A = 0;}
  ಒಳ_op(A) ::= NOT ಒಳ_2.  {A = 1;}
  ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) ಒಳ_op(N) LP exprlist(Y) RP. [IN] {
    ಆದರೆ( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      ಅಭಿವ್ಯಕ್ತಿ *pB = sqlite3_ಅಭಿವ್ಯಕ್ತಿ(pParse->db, TK_STRING, N ? "true" : "false");
      ಆದರೆ( pB ) sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Id_ಗಮ್ಯ_True_False(pB);
      ಆದರೆ( !ಅಭಿವ್ಯಕ್ತಿ_Has_Property(A, EP_HasFunc) ){
        sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Unmap_And_Delete(pParse, A);
        A = pB;
      }ಇಲ್ಲದಿದ್ದರೆ{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }ಇಲ್ಲದಿದ್ದರೆ{
      ಅಭಿವ್ಯಕ್ತಿ *pRHS = Y->a[0].p_ಅಭಿವ್ಯಕ್ತಿ;
      ಆದರೆ( Y->n_ಅಭಿವ್ಯಕ್ತಿ==1
       && sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_ಸದಿಶ
      ){
        Y->a[0].p_ಅಭಿವ್ಯಕ್ತಿ = 0;
        sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }ಇಲ್ಲದಿದ್ದರೆ ಆದರೆ( Y->n_ಅಭಿವ್ಯಕ್ತಿ==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_ಒಳ, A, 0);
        sqlite3_PExpr_ಕೂಡಿಸು_Select(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, Y);
      }ಇಲ್ಲದಿದ್ದರೆ{
        A = sqlite3PExpr(pParse, TK_ಒಳ, A, 0);
        ಆದರೆ( A==0 ){
          sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, Y);
        }ಇಲ್ಲದಿದ್ದರೆ ಆದರೆ( A->p_ಎಡ->op==TK_ಸದಿಶ ){
          ಪೂರ್ಣಾಂಕ n_ಅಭಿವ್ಯಕ್ತಿ = A->p_ಎಡ->x.pList->n_ಅಭಿವ್ಯಕ್ತಿ;
          Select *pSelectRHS = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_ಗಮ್ಯ_ಮೌಲ್ಯಗಳು(pParse, n_ಅಭಿವ್ಯಕ್ತಿ, Y);
          ಆದರೆ( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3_PExpr_ಕೂಡಿಸು_Select(pParse, A, pSelectRHS);
          }
        }ಇಲ್ಲದಿದ್ದರೆ{
          A->x.pList = Y;
          sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಗಣ_ಎತ್ತರ_And_Flags(pParse, A);
        }
      }
      ಆದರೆ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3_PExpr_ಕೂಡಿಸು_Select(pParse, A, X);
  }
  ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) ಒಳ_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_ಒಳ, A, 0);
    sqlite3_PExpr_ಕೂಡಿಸು_Select(pParse, A, Y);
    ಆದರೆ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A) ಒಳ_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    ಆದರೆ( E )  sqlite3_Src_List_Func_ವಾದಗಳು(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_ಒಳ, A, 0);
    sqlite3_PExpr_ಕೂಡಿಸು_Select(pParse, A, pSelect);
    ಆದರೆ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= EXISTS LP select(Y) RP. {
    ಅಭಿವ್ಯಕ್ತಿ *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_ಕೂಡಿಸು_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= CASE case_ಕಾರ್ಯಾಂಶ(X) case_exprlist(Y) case_else(Z) ಕೊನೆ. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  ಆದರೆ( A ){
    A->x.pList = Z ? sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,Y,Z) : Y;
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಗಣ_ಎತ್ತರ_And_Flags(pParse, A);
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, Y);
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, Z);
  }
}
%ಪ್ರಕಾರ case_exprlist {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor case_exprlist {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN ಅಭಿವ್ಯಕ್ತಿ_2(Y) THEN ಅಭಿವ್ಯಕ್ತಿ_2(Z). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,A, Y);
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN ಅಭಿವ್ಯಕ್ತಿ_2(Y) THEN ಅಭಿವ್ಯಕ್ತಿ_2(Z). {
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,0, Y);
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,A, Z);
}
%ಪ್ರಕಾರ case_else {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor case_else {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE ಅಭಿವ್ಯಕ್ತಿ_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%ಪ್ರಕಾರ case_ಕಾರ್ಯಾಂಶ {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor case_ಕಾರ್ಯಾಂಶ {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}
case_ಕಾರ್ಯಾಂಶ(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(A).
case_ಕಾರ್ಯಾಂಶ(A) ::= .                   {A = 0;} 

%ಪ್ರಕಾರ exprlist {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor exprlist {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}
%ಪ್ರಕಾರ nexprlist {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor nexprlist {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA ಅಭಿವ್ಯಕ್ತಿ_2(Y).
    {A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,A,Y);}
nexprlist(A) ::= ಅಭಿವ್ಯಕ್ತಿ_2(Y).
    {A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%ಪ್ರಕಾರ paren_exprlist {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor paren_exprlist {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
%endif SQLITE_OMIT_SUBQUERY


///////////////////////////// The CREATE INDEX command ///////////////////////
//
cmd ::= createkw(S) uniqueflag(U) ಸೂಚ್ಯಂಕ_2 ifnotexists(NE) nm(X) dbnm(D)
        ON nm(Y) LP sortlist(Z) RP where_opt(W). {
  sqlite3_Create_ಸೂಚ್ಯಂಕ(pParse, &X, &D, 
                     sqlite3SrcListAppend(pParse,0,&Y,0), Z, U,
                      &S, W, SQLITE_SO_ASC, NE, SQLITE_IDXTYPE_APPDEF);
  ಆದರೆ( ಒಳ_RENAME_OBJECT && pParse->p_New_ಸೂಚ್ಯಂಕ ){
    sqlite3RenameTokenMap(pParse, pParse->p_New_ಸೂಚ್ಯಂಕ->zName, &Y);
  }
}

%ಪ್ರಕಾರ uniqueflag {ಪೂರ್ಣಾಂಕ}
uniqueflag(A) ::= UNIQUE.  {A = OE_Abort;}
uniqueflag(A) ::= .        {A = OE_None;}


// The eidlist non-terminal (Expression Id List) generates an ExprList
// from a list of identifiers.  The identifier names are in ExprList.a[].zName.
// This list is stored in an ExprList rather than an IdList so that it
// can be easily sent to sqlite3ColumnsExprList().
//
// eidlist is grouped with CREATE INDEX because it used to be the non-terminal
// used for the arguments to an index.  That is just an historical accident.
//
// IMPORTANT COMPATIBILITY NOTE:  Some prior versions of SQLite accepted
// COLLATE clauses and ASC or DESC keywords on ID lists in inappropriate
// places - places that might have been stored in the sqlite_schema table.
// Those extra features were ignored.  But because they might be in some
// (busted) old databases, we need to continue parsing them when loading
// historical schemas.
//
%ಪ್ರಕಾರ eidlist {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor eidlist {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}
%ಪ್ರಕಾರ eidlist_opt {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor eidlist_opt {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}

%include {
  /* Add a single new term to an ExprList that is used to store a
  ** list of identifiers.  Report an error if the ID list contains
  ** a COLLATE clause or an ASC or DESC keyword, except ignore the
  ** error while parsing a legacy schema.
  */
  ಸ್ಥಿರ ಅಭಿವ್ಯಕ್ತಿ_List *parser_ಕೂಡಿಸು_ಅಭಿವ್ಯಕ್ತಿ_Id_List_ಪದ(
    Parse *pParse,
    ಅಭಿವ್ಯಕ್ತಿ_List *p_ಪೂರ್ವ,
    Token *pIdToken,
    ಪೂರ್ಣಾಂಕ hasCollate,
    ಪೂರ್ಣಾಂಕ ವಿಂಗಡಿಸು_ಕ್ರಮ
  ){
    ಅಭಿವ್ಯಕ್ತಿ_List *p = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, p_ಪೂರ್ವ, 0);
    ಆದರೆ( (hasCollate || ವಿಂಗಡಿಸು_ಕ್ರಮ!=SQLITE_SO_UNDEFINED)
        && pParse->db->init.busy==0
    ){
      sqlite3_Error_ಸಂದೇಶ(pParse, "syntax error after column name \"%.*s\"",
                         pIdToken->n, pIdToken->z);
    }
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_ಗಣ_Name(pParse, p, pIdToken, 1);
    ಹಿಂತಿರುಗಿ p;
  }
} // end %include

eidlist_opt(A) ::= .                         {A = 0;}
eidlist_opt(A) ::= LP eidlist(X) RP.         {A = X;}
eidlist(A) ::= eidlist(A) COMMA nm(Y) collate(C) sortorder(Z).  {
  A = parser_ಕೂಡಿಸು_ಅಭಿವ್ಯಕ್ತಿ_Id_List_ಪದ(pParse, A, &Y, C, Z);
}
eidlist(A) ::= nm(Y) collate(C) sortorder(Z). {
  A = parser_ಕೂಡಿಸು_ಅಭಿವ್ಯಕ್ತಿ_Id_List_ಪದ(pParse, 0, &Y, C, Z); /*A-overwrites-Y*/
}

%ಪ್ರಕಾರ collate {ಪೂರ್ಣಾಂಕ}
collate(C) ::= .              {C = 0;}
collate(C) ::= COLLATE ids.   {C = 1;}


///////////////////////////// The DROP INDEX command /////////////////////////
//
cmd ::= DROP ಸೂಚ್ಯಂಕ_2 ifexists(E) fullname(X).   {sqlite3_Drop_ಸೂಚ್ಯಂಕ(pParse, X, E);}

///////////////////////////// The VACUUM command /////////////////////////////
//
%ಆದರೆ !SQLITE_OMIT_VACUUM && !SQLITE_OMIT_ATTACH
%ಪ್ರಕಾರ vinto {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor vinto {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}
cmd ::= VACUUM vinto(Y).                {sqlite3Vacuum(pParse,0,Y);}
cmd ::= VACUUM nm(X) vinto(Y).          {sqlite3Vacuum(pParse,&X,Y);}
vinto(A) ::= INTO ಅಭಿವ್ಯಕ್ತಿ_2(X).              {A = X;}
vinto(A) ::= .                          {A = 0;}
%endif

///////////////////////////// The PRAGMA command /////////////////////////////
//
%ifndef SQLITE_OMIT_PRAGMA
cmd ::= PRAGMA nm(X) dbnm(Z).                {sqlite3Pragma(pParse,&X,&Z,0,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ nmnum(Y).    {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP nmnum(Y) RP. {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ minus_ಅಂಕೆ(Y). 
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP minus_ಅಂಕೆ(Y) RP.
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_ಅಂಕೆ(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class ಸಂಖ್ಯೆ INTEGER|FLOAT.
plus_ಅಂಕೆ(A) ::= PLUS ಸಂಖ್ಯೆ(X).       {A = X;}
plus_ಅಂಕೆ(A) ::= ಸಂಖ್ಯೆ(A).
minus_ಅಂಕೆ(A) ::= MINUS ಸಂಖ್ಯೆ(X).     {A = X;}
//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) ಕೊನೆ(Z). {
  Token all;
  all.z = A.z;
  all.n = (ಪೂರ್ಣಾಂಕ)(Z.z - A.z) + Z.n;
  sqlite3_ಮುಕ್ತಾಯ_Trigger(pParse, S, &all);
}

trigger_decl(A) ::= ತಾತ್ಕಾಲಿಕ(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_ಸಮಯ(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#ವ್ಯಾಖ್ಯಾನಿತವಾದರೆ SQLITE_DEBUG
  ಪ್ರತಿಜ್ಞಾ( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#ಆದರೆ_ಅಂತ್ಯ
}

%ಪ್ರಕಾರ trigger_ಸಮಯ {ಪೂರ್ಣಾಂಕ}
trigger_ಸಮಯ(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_ಸಮಯ(A) ::= INSTEAD ದ_2.  { A = TK_INSTEAD;}
trigger_ಸಮಯ(A) ::= .            { A = TK_BEFORE; }

%ಪ್ರಕಾರ trigger_event {ರಚನೆ TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|ಸೇರಿಸು(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE ದ_2 idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH ಅಡ್ಡಸಾಲು.

%ಪ್ರಕಾರ when_clause {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor when_clause {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN ಅಭಿವ್ಯಕ್ತಿ_2(X). { A = X; }

%ಪ್ರಕಾರ trigger_cmd_list {Trigger_ಹೆಜ್ಜೆ*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_ಹೆಜ್ಜೆ(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_ಕೊನೆಯ->p_ಮುಂದಿನ = X;
  A->p_ಕೊನೆಯ = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->p_ಕೊನೆಯ = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= ಸೂಚ್ಯಂಕಿತ BY nm. {
  sqlite3_Error_ಸಂದೇಶ(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT ಸೂಚ್ಯಂಕಿತ. {
  sqlite3_Error_ಸಂದೇಶ(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%ಪ್ರಕಾರ trigger_cmd {Trigger_ಹೆಜ್ಜೆ*}
%destructor trigger_cmd {sqlite3_Delete_Trigger_ಹೆಜ್ಜೆ(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby ಗಣ setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3_Trigger_Update_ಹೆಜ್ಜೆ(pParse, X, F, Y, Z, R, B.z, E);}

//ಸೇರಿಸು
trigger_cmd(A) ::= scanpt(B) ಸೇರಿಸು_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_ಸೇರಿಸು_ಹೆಜ್ಜೆ(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3_Trigger_Delete_ಹೆಜ್ಜೆ(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3_Trigger_Select_ಹೆಜ್ಜೆ(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  ಆದರೆ( A ){
    A->aff_ಅಭಿವ್ಯಕ್ತಿ = OE_Ignore;
  }
}
ಅಭಿವ್ಯಕ್ತಿ_2(A) ::= RAISE LP raisetype(T) COMMA ಅಭಿವ್ಯಕ್ತಿ_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  ಆದರೆ( A ) {
    A->aff_ಅಭಿವ್ಯಕ್ತಿ = (ಅಕ್ಷರ)T;
  }
}
%endif  !SQLITE_OMIT_TRIGGER

%ಪ್ರಕಾರ raisetype {ಪೂರ್ಣಾಂಕ}
raisetype(A) ::= ROLLBACK.  {A = OE_Rollback;}
raisetype(A) ::= ABORT.     {A = OE_Abort;}
raisetype(A) ::= FAIL.      {A = OE_Fail;}


////////////////////////  DROP TRIGGER statement //////////////////////////////
%ifndef SQLITE_OMIT_TRIGGER
cmd ::= DROP TRIGGER ifexists(NOERR) fullname(X). {
  sqlite3DropTrigger(pParse,X,NOERR);
}
%endif  !SQLITE_OMIT_TRIGGER

//////////////////////// ATTACH DATABASE file AS name /////////////////////////
%ifndef SQLITE_OMIT_ATTACH
cmd ::= ATTACH database_kw_opt ಅಭಿವ್ಯಕ್ತಿ_2(F) AS ಅಭಿವ್ಯಕ್ತಿ_2(D) ಕೀಲಿ_opt(K). {
  sqlite3Attach(pParse, F, D, K);
}
cmd ::= DETACH database_kw_opt ಅಭಿವ್ಯಕ್ತಿ_2(D). {
  sqlite3Detach(pParse, D);
}

%ಪ್ರಕಾರ ಕೀಲಿ_opt {ಅಭಿವ್ಯಕ್ತಿ*}
%destructor ಕೀಲಿ_opt {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, $$);}
ಕೀಲಿ_opt(A) ::= .                     { A = 0; }
ಕೀಲಿ_opt(A) ::= ಕೀಲಿ_2 ಅಭಿವ್ಯಕ್ತಿ_2(X).          { A = X; }

database_kw_opt ::= DATABASE.
database_kw_opt ::= .
%endif SQLITE_OMIT_ATTACH

////////////////////////// REINDEX collation //////////////////////////////////
%ifndef SQLITE_OMIT_REINDEX
cmd ::= REINDEX.                {sqlite3Reindex(pParse, 0, 0);}
cmd ::= REINDEX nm(X) dbnm(Y).  {sqlite3Reindex(pParse, &X, &Y);}
%endif  SQLITE_OMIT_REINDEX

/////////////////////////////////// ANALYZE ///////////////////////////////////
%ifndef SQLITE_OMIT_ANALYZE
cmd ::= ANALYZE.                {sqlite3Analyze(pParse, 0, 0);}
