// Setup for the parser stack
%stack_size        50                        // Initial stack size
%stack_size_limit  parser_ਢੇਰ_ਮਾਪ_ਹੱਦਬੰਦੀ      // Function returning max stack size
%realloc           parser_ਢੇਰ_Realloc        // realloc() for the stack
%ਮੁਕਤ              parser_ਢੇਰ_Free           // free() for the stack

// All token codes are small integers with #defines that begin with "TK_"
%token_prefix TK_

// The type of the data attached to each token is Token.  This is also the
// default type for non-terminals.
//
%token_type {Token}
%default_type {Token}

// An extra argument to the constructor for the parser, which is available
// to all actions.
%extra_context {Parse *pParse}

// This code runs whenever there is a syntax error
//
%syntax_error {
  ਅਣਵਰਤਿਆ_PARAMETER(yymajor);  /* Silence some compiler warnings */
  ਜੇ( TOKEN.z[0] ){
    parserSyntaxError(pParse, &TOKEN);
  }ਨਹੀਂਤਾਂ{
    sqlite3_Error_ਸੁਨੇਹਾ(pParse, "incomplete input");
  }
}
%stack_overflow {
  ਜੇ( pParse->nErr==0 ) sqlite3_Error_ਸੁਨੇਹਾ(pParse, "Recursion limit");
}

// The name of the generated procedure that implements the parser
// is as follows:
%name sqlite3Parser

// The following text is included near the beginning of the C source
// code file that implements the parser.
//
%include {
#ਅਨ੍ਤਰ੍ਭਾਵ "sqliteInt.h"

/*
** Verify that the pParse->isCreate field is set
*/
#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ ASSERT_IS_CREATE   ਪ੍ਰਤਿਜ੍ਞਾ(pParse->isCreate)

/*
** Disable all error recovery processing in the parser push-down
** automaton.
*/
#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ YYNOERRORRECOVERY 1

/*
** Make yytestcase() the same as testcase()
*/
#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ yytestcase(X) testcase(X)

/*
** Indicate that sqlite3ParserFree() will never be called with a null
** pointer.
*/
#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ YYPARSEFREENEVERNULL 1

/*
** In the amalgamation, the parse.c file generated by lemon and the
** tokenize.c file are concatenated.  In that case, sqlite3RunParser()
** has access to the the size of the yyParser object and so the parser
** engine can be allocated from stack.  In that case, only the
** sqlite3ParserInit() and sqlite3ParserFinalize() routines are invoked
** and the sqlite3ParserAlloc() and sqlite3ParserFree() routines can be
** omitted.
*/
#ਜੇ_ਪਰਿਭਾਸ਼ਿਤ SQLITE_AMALGAMATION
# define sqlite3Parser_ENGINEALWAYSONSTACK 1
#ਜੇ_ਅੰਤ

/*
** Alternative datatype for the argument to the malloc() routine passed
** into sqlite3ParserAlloc().  The default is size_t.
*/
#ਪਰਿਭਾਸ਼ਿਤ_ਕਰੋ YYMALLOCARGTYPE  u64

/*
** An instance of the following structure describes the event of a
** TRIGGER.  "a" is the event type, one of TK_UPDATE, TK_INSERT,
** TK_DELETE, or TK_INSTEAD.  If the event is of the form
**
**      UPDATE ON (a,b,c)
**
** Then the "b" IdList records the list "a,b,c".
*/
ਬਣਤਰ TrigEvent { ਪੂਰਨ a; IdList * b; };

ਬਣਤਰ ਚੌਖਟਾ_Bound     { ਪੂਰਨ eType; ਵਿਅੰਜਕ *p_ਵਿਅੰਜਕ; };

/*
** Generate a syntax error
*/
ਸਥਿਰ ਖਾਲੀ parserSyntaxError(Parse *pParse, Token *p){
  sqlite3_Error_ਸੁਨੇਹਾ(pParse, "near \"%T\": syntax error", p);
}

/*
** Disable lookaside memory allocation for objects that might be
** shared across database connections.
*/
ਸਥਿਰ ਖਾਲੀ disableLookaside(Parse *pParse){
  sqlite3 *db = pParse->db;
  pParse->disableLookaside++;
#ਜੇ_ਪਰਿਭਾਸ਼ਿਤ SQLITE_DEBUG
  pParse->isCreate = 1;
#ਜੇ_ਅੰਤ
  memset(&pParse->u1.cr, 0, ਆਕਾਰ(pParse->u1.cr));
  DisableLookaside;
}

#ਜੇ !defined(SQLITE_ENABLE_UPDATE_DELETE_ਹੱਦਬੰਦੀ) \
 && defined(SQLITE_UDL_CAPABLE_PARSER)
/*
** Issue an error message if an ORDER BY or LIMIT clause occurs on an
** UPDATE or DELETE statement.
*/
ਸਥਿਰ ਖਾਲੀ update_Delete_ਹੱਦਬੰਦੀ_Error(
  Parse *pParse,
  ਵਿਅੰਜਕ_List *p_ਕ੍ਰਮ_By,
  ਵਿਅੰਜਕ *p_ਹੱਦਬੰਦੀ
){
  ਜੇ( p_ਕ੍ਰਮ_By ){
    sqlite3_Error_ਸੁਨੇਹਾ(pParse, "syntax error near \"ORDER BY\"");
  }ਨਹੀਂਤਾਂ{
    sqlite3_Error_ਸੁਨੇਹਾ(pParse, "syntax error near \"LIMIT\"");
  }
  sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, p_ਕ੍ਰਮ_By);
  sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, p_ਹੱਦਬੰਦੀ);
}
#ਜੇ_ਅੰਤ /* SQLITE_ENABLE_UPDATE_DELETE_LIMIT */

} // end %include

// Input is a single SQL command
ਨਿਵੇਸ਼ ::= cmdlist.
cmdlist ::= cmdlist ecmd.
cmdlist ::= ecmd.
ecmd ::= SEMI.
ecmd ::= cmdx SEMI.
%ifndef SQLITE_OMIT_EXPLAIN
ecmd ::= explain cmdx SEMI.       {NEVER-REDUCE}
explain ::= EXPLAIN.              { ਜੇ( pParse->pReprepare==0 ) pParse->explain = 1; }
explain ::= EXPLAIN QUERY PLAN.   { ਜੇ( pParse->pReprepare==0 ) pParse->explain = 2; }
%endif  SQLITE_OMIT_EXPLAIN
cmdx ::= cmd.           { sqlite3_ਅੰਤ_Coding(pParse); }

///////////////////// Begin and end transactions. ////////////////////////////
//

cmd ::= BEGIN transtype(Y) trans_opt.  {sqlite3BeginTransaction(pParse, Y);}
trans_opt ::= .
trans_opt ::= TRANSACTION.
trans_opt ::= TRANSACTION nm.
%ਕਿਸਮ transtype {ਪੂਰਨ}
transtype(A) ::= .             {A = TK_DEFERRED;}
transtype(A) ::= DEFERRED(X).  {A = @X; /*A-overwrites-X*/}
transtype(A) ::= ਤੁਰੰਤ(X). {A = @X; /*A-overwrites-X*/}
transtype(A) ::= EXCLUSIVE(X). {A = @X; /*A-overwrites-X*/}
cmd ::= COMMIT|ਸਿਰਾ(X) trans_opt.   {sqlite3_ਸਿਰਾ_Transaction(pParse,@X);}
cmd ::= ROLLBACK(X) trans_opt.     {sqlite3_ਸਿਰਾ_Transaction(pParse,@X);}

savepoint_opt ::= SAVEPOINT.
savepoint_opt ::= .
cmd ::= SAVEPOINT nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_BEGIN, &X);
}
cmd ::= RELEASE savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_RELEASE, &X);
}
cmd ::= ROLLBACK trans_opt ਮੰਜ਼ਿਲ_2 savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_ROLLBACK, &X);
}

///////////////////// The CREATE TABLE statement ////////////////////////////
//
cmd ::= create_ਸਾਰਣੀ create_ਸਾਰਣੀ_ਦਲੀਲਾਂ.
create_ਸਾਰਣੀ ::= createkw ਆਰਜ਼ੀ(T) ਸਾਰਣੀ_3 ifnotexists(E) nm(Y) dbnm(Z). {
   sqlite3_ਸ਼ੁਰੂ_ਸਾਰਣੀ(pParse,&Y,&Z,T,0,0,E);
}
createkw(A) ::= CREATE(A).  {
  disableLookaside(pParse);
}

%ਕਿਸਮ ifnotexists {ਪੂਰਨ}
ifnotexists(A) ::= .              {A = 0;}
ifnotexists(A) ::= IF NOT EXISTS. {A = 1;}
%ਕਿਸਮ ਆਰਜ਼ੀ {ਪੂਰਨ}
%ifndef SQLITE_OMIT_TEMPDB
ਆਰਜ਼ੀ(A) ::= ਆਰਜ਼ੀ_2.  {A = pParse->db->init.busy==0;}
%endif  SQLITE_OMIT_TEMPDB
ਆਰਜ਼ੀ(A) ::= .      {A = 0;}
create_ਸਾਰਣੀ_ਦਲੀਲਾਂ ::= LP columnlist conslist_opt(X) RP(E) ਸਾਰਣੀ_option_ਸੈੱਟ(F). {
  sqlite3_ਸਿਰਾ_ਸਾਰਣੀ(pParse,&X,&E,F,0);
}
create_ਸਾਰਣੀ_ਦਲੀਲਾਂ ::= AS select(S). {
  sqlite3_ਸਿਰਾ_ਸਾਰਣੀ(pParse,0,0,0,S);
  sqlite3SelectDelete(pParse->db, S);
}
%ਕਿਸਮ ਸਾਰਣੀ_option_ਸੈੱਟ {u32}
%ਕਿਸਮ ਸਾਰਣੀ_option {u32}
ਸਾਰਣੀ_option_ਸੈੱਟ(A) ::= .    {A = 0;}
ਸਾਰਣੀ_option_ਸੈੱਟ(A) ::= ਸਾਰਣੀ_option(A).
ਸਾਰਣੀ_option_ਸੈੱਟ(A) ::= ਸਾਰਣੀ_option_ਸੈੱਟ(X) COMMA ਸਾਰਣੀ_option(Y). {A = X|Y;}
ਸਾਰਣੀ_option(A) ::= WITHOUT nm(X). {
  ਜੇ( X.n==5 && sqlite3_strnicmp(X.z,"rowid",5)==0 ){
    A = TF_WithoutRowid | TF_NoVisibleRowid;
  }ਨਹੀਂਤਾਂ{
    A = 0;
    sqlite3_Error_ਸੁਨੇਹਾ(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
ਸਾਰਣੀ_option(A) ::= nm(X). {
  ਜੇ( X.n==6 && sqlite3_strnicmp(X.z,"strict",6)==0 ){
    A = TF_Strict;
  }ਨਹੀਂਤਾਂ{
    A = 0;
    sqlite3_Error_ਸੁਨੇਹਾ(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
columnlist ::= columnlist COMMA columnname carglist.
columnlist ::= columnname carglist.
columnname(A) ::= nm(A) typetoken(Y). {sqlite3_ਜੋੜੋ_ਕਾਲਮ(pParse,A,Y);}

// Declare some tokens early in order to influence their values, to 
// improve performance and reduce the executable size.  The goal here is
// to get the "jump" operations in ISNULL through ESCAPE to have numeric
// values that are early enough so that all jump operations are clustered
// at the beginning.  Also, operators like NE and EQ need to be adjacent,
// and all of the comparison operators need to be clustered together.
// Various assert() statements throughout the code enforce these restrictions.
//
%token ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST.
%token CONFLICT DATABASE DEFERRED DESC DETACH EACH ਸਿਰਾ EXCLUSIVE EXPLAIN FAIL.
%token OR AND NOT IS ISNOT ਮੇਲ_2 LIKE_KW BETWEEN ਵਿੱਚ_2 ISNULL NOTNULL NE EQ.
%token GT LE LT GE ESCAPE.

// The following directive causes tokens ABORT, AFTER, ASC, etc. to
// fallback to ID if they will not parse as their original value.
// This obviates the need for the "id" nonterminal.
//
%fallback ID
  ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST COLUMNKW
  CONFLICT DATABASE DEFERRED DESC DETACH DO
  EACH ਸਿਰਾ EXCLUSIVE EXPLAIN FAIL FOR
  IGNORE ਤੁਰੰਤ INITIALLY INSTEAD LIKE_KW ਮੇਲ_2 NO PLAN
  QUERY ਕੁੰਜੀ_2 ਦਾ_2 ਵਿੱਥ_3 PRAGMA RAISE RECURSIVE RELEASE REPLACE RESTRICT ਪੰਕਤੀ ਪੰਕਤੀਆਂ
  ROLLBACK SAVEPOINT ਆਰਜ਼ੀ_2 TRIGGER VACUUM VIEW VIRTUAL WITH WITHOUT
  NULLS ਪਹਿਲਾ_2 ਆਖਰੀ
%ifdef SQLITE_OMIT_COMPOUND_SELECT
  EXCEPT INTERSECT UNION
%endif SQLITE_OMIT_COMPOUND_SELECT
%ifndef SQLITE_OMIT_WINDOWFUNC
  CURRENT FOLLOWING ਹਿੱਸੇ_ਕਰੋ PRECEDING RANGE UNBOUNDED
  EXCLUDE GROUPS OTHERS TIES
%endif SQLITE_OMIT_WINDOWFUNC
%ifdef SQLITE_ENABLE_ORDERED_ਸੈੱਟ_AGGREGATES
  WITHIN
%endif SQLITE_ENABLE_ORDERED_ਸੈੱਟ_AGGREGATES
%ifndef SQLITE_OMIT_GENERATED_COLUMNS
  GENERATED ALWAYS
%endif
  MATERIALIZED
  REINDEX RENAME CTIME_KW IF
  .
%wildcard ANY.

// Define operator precedence early so that this is the first occurrence
// of the operator tokens in the grammar.  Keeping the operators together
// causes them to be assigned integer values that are close together,
// which keeps parser tables smaller.
//
// The token values assigned to these symbols is determined by the order
// in which lemon first sees them.  It must be the case that ISNULL/NOTNULL,
// NE/EQ, GT/LE, and GE/LT are separated by only a single value.  See
// the sqlite3ExprIfFalse() routine for additional information on this
// constraint.
//
%ਖੱਬੇ OR.
%ਖੱਬੇ AND.
%ਸੱਜੇ NOT.
%ਖੱਬੇ IS ਮੇਲ_2 LIKE_KW BETWEEN ਵਿੱਚ_2 ISNULL NOTNULL NE EQ.
%ਖੱਬੇ GT LE LT GE.
%ਸੱਜੇ ESCAPE.
%ਖੱਬੇ BITAND BITOR LSHIFT RSHIFT.
%ਖੱਬੇ PLUS MINUS.
%ਖੱਬੇ ਤਾਰਾ SLASH REM.
%ਖੱਬੇ CONCAT PTR.
%ਖੱਬੇ COLLATE.
%ਸੱਜੇ BITNOT.
%nonassoc ON.

// An IDENTIFIER can be a generic identifier, or one of several
// keywords.  Any non-standard keyword can also be an identifier.
//
%token_class id  ID|ਸੂਚਕਾਂਕਿਤ.

// And "ids" is an identifier-or-string.
//
%token_class ids  ID|STRING.

// An identifier or a join-keyword
//
%token_class idj  ID|ਸੂਚਕਾਂਕਿਤ|JOIN_KW.

// The name of a column or table can be any of the following:
//
%ਕਿਸਮ nm {Token}
nm(A) ::= idj(A).
nm(A) ::= STRING(A).

// A typetoken is really zero or more tokens that form a type name such
// as can be found after the column name in a CREATE TABLE statement.
// Multiple tokens are concatenated to form the value of the typetoken.
//
%ਕਿਸਮ typetoken {Token}
typetoken(A) ::= .   {A.n = 0; A.z = 0;}
typetoken(A) ::= typename(A).
typetoken(A) ::= typename(A) LP ਨਿਸ਼ਾਨੀਵਾਲਾ RP(Y). {
  A.n = (ਪੂਰਨ)(&Y.z[Y.n] - A.z);
}
typetoken(A) ::= typename(A) LP ਨਿਸ਼ਾਨੀਵਾਲਾ COMMA ਨਿਸ਼ਾਨੀਵਾਲਾ RP(Y). {
  A.n = (ਪੂਰਨ)(&Y.z[Y.n] - A.z);
}
%ਕਿਸਮ typename {Token}
typename(A) ::= ids(A).
typename(A) ::= typename(A) ids(Y). {A.n=Y.n+(ਪੂਰਨ)(Y.z-A.z);}
ਨਿਸ਼ਾਨੀਵਾਲਾ ::= plus_ਅੰਕ.
ਨਿਸ਼ਾਨੀਵਾਲਾ ::= minus_ਅੰਕ.

// The scanpt non-terminal takes a value which is a pointer to the
// input text just past the last token that has been shifted into
// the parser.  By surrounding some phrase in the grammar with two
// scanpt non-terminals, we can capture the input text for that phrase.
// For example:
//
//      something ::= .... scanpt(A) phrase scanpt(Z).
//
// The text that is parsed as "phrase" is a string starting at A
// and containing (int)(Z-A) characters.  There might be some extra
// whitespace on either end of the text, but that can be removed in
// post-processing, if needed.
//
%ਕਿਸਮ scanpt {ਅਚਲ ਅੱਖਰ*}
scanpt(A) ::= . {
  ਪ੍ਰਤਿਜ੍ਞਾ( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken.z;
}
scantok(A) ::= . {
  ਪ੍ਰਤਿਜ੍ਞਾ( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken;
}

// "carglist" is a list of additional constraints that come after the
// column name and column type in a CREATE TABLE statement.
//
carglist ::= carglist ccons.
carglist ::= .
ccons ::= CONSTRAINT nm(X). {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
ccons ::= DEFAULT scantok(A) ਪਦ(X).
                            {sqlite3_ਜੋੜੋ_Default_ਮੁੱਲ(pParse,X,A.z,&A.z[A.n]);}
ccons ::= DEFAULT LP(A) ਵਿਅੰਜਕ_2(X) RP(Z).
                            {sqlite3_ਜੋੜੋ_Default_ਮੁੱਲ(pParse,X,A.z+1,Z.z);}
ccons ::= DEFAULT PLUS(A) scantok(Z) ਪਦ(X).
                            {sqlite3_ਜੋੜੋ_Default_ਮੁੱਲ(pParse,X,A.z,&Z.z[Z.n]);}
ccons ::= DEFAULT MINUS(A) scantok(Z) ਪਦ(X). {
  ਵਿਅੰਜਕ *p = sqlite3PExpr(pParse, TK_UMINUS, X, 0);
  sqlite3_ਜੋੜੋ_Default_ਮੁੱਲ(pParse,p,A.z,&Z.z[Z.n]);
}
ccons ::= DEFAULT scantok id(X).       {
  ਵਿਅੰਜਕ *p = token_ਵਿਅੰਜਕ(pParse, TK_STRING, X);
  ਜੇ( p ){
    sqlite3_ਵਿਅੰਜਕ_Id_ਮੰਜ਼ਿਲ_True_False(p);
    testcase( p->op==TK_TRUEFALSE && sqlite3_ਵਿਅੰਜਕ_Truth_ਮੁੱਲ(p) );
  }
    sqlite3_ਜੋੜੋ_Default_ਮੁੱਲ(pParse,p,X.z,X.z+X.n);
}

// In addition to the type name, we also care about the primary key and
// UNIQUE constraints.
//
ccons ::= ਨਿਰਾ onconf.
ccons ::= NOT ਨਿਰਾ onconf(R).    {sqlite3_ਜੋੜੋ_Not_Null(pParse, R);}
ccons ::= PRIMARY ਕੁੰਜੀ_2 sortorder(Z) onconf(R) autoinc(I).
                                 {sqlite3_ਜੋੜੋ_Primary_ਕੁੰਜੀ(pParse,0,R,I,Z);}
ccons ::= UNIQUE onconf(R).      {sqlite3_Create_ਸੂਚਕਾਂਕ(pParse,0,0,0,0,R,0,0,0,0,
                                   SQLITE_IDXTYPE_UNIQUE);}
ccons ::= CHECK LP(A) ਵਿਅੰਜਕ_2(X) RP(B).  {sqlite3_ਜੋੜੋ_Check_Constraint(pParse,X,A.z,B.z);}
ccons ::= REFERENCES nm(T) eidlist_opt(TA) refargs(R).
                                 {sqlite3_Create_Foreign_ਕੁੰਜੀ(pParse,0,&T,TA,R);}
ccons ::= defer_subclause(D).    {sqlite3_Defer_Foreign_ਕੁੰਜੀ(pParse,D);}
ccons ::= COLLATE ids(C).        {sqlite3_ਜੋੜੋ_Collate_Type(pParse, &C);}
ccons ::= GENERATED ALWAYS AS generated.
ccons ::= AS generated.
generated ::= LP ਵਿਅੰਜਕ_2(E) RP.          {sqlite3_ਜੋੜੋ_Generated(pParse,E,0);}
generated ::= LP ਵਿਅੰਜਕ_2(E) RP ID(TYPE). {sqlite3_ਜੋੜੋ_Generated(pParse,E,&TYPE);}

// The optional AUTOINCREMENT keyword
%ਕਿਸਮ autoinc {ਪੂਰਨ}
autoinc(X) ::= .          {X = 0;}
autoinc(X) ::= AUTOINCR.  {X = 1;}

// The next group of rules parses the arguments to a REFERENCES clause
// that determine if the referential integrity checking is deferred or
// or immediate and which determine what action to take if a ref-integ
// check fails.
//
%ਕਿਸਮ refargs {ਪੂਰਨ}
refargs(A) ::= .                  { A = OE_None*0x0101; /* EV: R-19803-45884 */}
refargs(A) ::= refargs(A) refarg(Y). { A = (A & ~Y.ਨਕਾਬ) | Y.ਮੁੱਲ; }
%ਕਿਸਮ refarg {ਬਣਤਰ {ਪੂਰਨ ਮੁੱਲ; ਪੂਰਨ ਨਕਾਬ;}}
refarg(A) ::= ਮੇਲ_2 nm.              { A.ਮੁੱਲ = 0;     A.ਨਕਾਬ = 0x000000; }
refarg(A) ::= ON ਪਾਓ refact.      { A.ਮੁੱਲ = 0;     A.ਨਕਾਬ = 0x000000; }
refarg(A) ::= ON DELETE refact(X).   { A.ਮੁੱਲ = X;     A.ਨਕਾਬ = 0x0000ff; }
refarg(A) ::= ON UPDATE refact(X).   { A.ਮੁੱਲ = X<<8;  A.ਨਕਾਬ = 0x00ff00; }
%ਕਿਸਮ refact {ਪੂਰਨ}
refact(A) ::= ਸੈੱਟ ਨਿਰਾ.              { A = OE_ਸੈੱਟ_Null;  /* EV: R-33326-45252 */}
refact(A) ::= ਸੈੱਟ DEFAULT.           { A = OE_ਸੈੱਟ_Dflt;  /* EV: R-33326-45252 */}
refact(A) ::= CASCADE.               { A = OE_Cascade;  /* EV: R-33326-45252 */}
refact(A) ::= RESTRICT.              { A = OE_Restrict; /* EV: R-33326-45252 */}
refact(A) ::= NO ACTION.             { A = OE_None;     /* EV: R-33326-45252 */}
%ਕਿਸਮ defer_subclause {ਪੂਰਨ}
defer_subclause(A) ::= NOT DEFERRABLE init_deferred_pred_opt.     {A = 0;}
defer_subclause(A) ::= DEFERRABLE init_deferred_pred_opt(X).      {A = X;}
%ਕਿਸਮ init_deferred_pred_opt {ਪੂਰਨ}
init_deferred_pred_opt(A) ::= .                       {A = 0;}
init_deferred_pred_opt(A) ::= INITIALLY DEFERRED.     {A = 1;}
init_deferred_pred_opt(A) ::= INITIALLY ਤੁਰੰਤ.    {A = 0;}

conslist_opt(A) ::= .                         {A.n = 0; A.z = 0;}
conslist_opt(A) ::= COMMA(A) conslist.
conslist ::= conslist tconscomma tcons.
conslist ::= tcons.
tconscomma ::= COMMA.          {ASSERT_IS_CREATE; pParse->u1.cr.constraintName.n = 0;}
tconscomma ::= .
tcons ::= CONSTRAINT nm(X).    {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
tcons ::= PRIMARY ਕੁੰਜੀ_2 LP sortlist(X) autoinc(I) RP onconf(R).
                                 {sqlite3_ਜੋੜੋ_Primary_ਕੁੰਜੀ(pParse,X,R,I,0);}
tcons ::= UNIQUE LP sortlist(X) RP onconf(R).
                                 {sqlite3_Create_ਸੂਚਕਾਂਕ(pParse,0,0,0,X,R,0,0,0,0,
                                       SQLITE_IDXTYPE_UNIQUE);}
tcons ::= CHECK LP(A) ਵਿਅੰਜਕ_2(E) RP(B) onconf.
                                 {sqlite3_ਜੋੜੋ_Check_Constraint(pParse,E,A.z,B.z);}
tcons ::= FOREIGN ਕੁੰਜੀ_2 LP eidlist(FA) RP
          REFERENCES nm(T) eidlist_opt(TA) refargs(R) defer_subclause_opt(D). {
    sqlite3_Create_Foreign_ਕੁੰਜੀ(pParse, FA, &T, TA, R);
    sqlite3_Defer_Foreign_ਕੁੰਜੀ(pParse, D);
}
%ਕਿਸਮ defer_subclause_opt {ਪੂਰਨ}
defer_subclause_opt(A) ::= .                    {A = 0;}
defer_subclause_opt(A) ::= defer_subclause(A).

// The following is a non-standard extension that allows us to declare the
// default behavior when there is a constraint conflict.
//
%ਕਿਸਮ onconf {ਪੂਰਨ}
%ਕਿਸਮ orconf {ਪੂਰਨ}
%ਕਿਸਮ resolvetype {ਪੂਰਨ}
onconf(A) ::= .                              {A = OE_Default;}
onconf(A) ::= ON CONFLICT resolvetype(X).    {A = X;}
orconf(A) ::= .                              {A = OE_Default;}
orconf(A) ::= OR resolvetype(X).             {A = X;}
resolvetype(A) ::= raisetype(A).
resolvetype(A) ::= IGNORE.                   {A = OE_Ignore;}
resolvetype(A) ::= REPLACE.                  {A = OE_Replace;}

////////////////////////// The DROP TABLE /////////////////////////////////////
//
cmd ::= DROP ਸਾਰਣੀ_3 ifexists(E) fullname(X). {
  sqlite3_Drop_ਸਾਰਣੀ(pParse, X, 0, E);
}
%ਕਿਸਮ ifexists {ਪੂਰਨ}
ifexists(A) ::= IF EXISTS.   {A = 1;}
ifexists(A) ::= .            {A = 0;}

///////////////////// The CREATE VIEW statement /////////////////////////////
//
%ifndef SQLITE_OMIT_VIEW
cmd ::= createkw(X) ਆਰਜ਼ੀ(T) VIEW ifnotexists(E) nm(Y) dbnm(Z) eidlist_opt(C)
          AS select(S). {
  sqlite3CreateView(pParse, &X, &Y, &Z, C, S, T, E);
}
cmd ::= DROP VIEW ifexists(E) fullname(X). {
  sqlite3_Drop_ਸਾਰਣੀ(pParse, X, 1, E);
}
%endif  SQLITE_OMIT_VIEW

//////////////////////// The SELECT statement /////////////////////////////////
//
cmd ::= select(X).  {
  SelectDest dest = {SRT_Output, 0, 0, 0, 0, 0, 0};
  ਜੇ( (pParse->db->mDbFlags & DBFLAG_EncodingFixed)!=0
   || sqlite3ReadSchema(pParse)==SQLITE_OK
  ){
    sqlite3Select(pParse, X, &dest);
  }
  sqlite3SelectDelete(pParse->db, X);
}

%ਕਿਸਮ select {Select*}
%destructor select {sqlite3SelectDelete(pParse->db, $$);}
%ਕਿਸਮ selectnowith {Select*}
%destructor selectnowith {sqlite3SelectDelete(pParse->db, $$);}
%ਕਿਸਮ oneselect {Select*}
%destructor oneselect {sqlite3SelectDelete(pParse->db, $$);}

%include {
  /*
  ** For a compound SELECT statement, make sure p->pPrior->pNext==p for
  ** all elements in the list.  And make sure list length does not exceed
  ** SQLITE_LIMIT_COMPOUND_SELECT.
  */
  ਸਥਿਰ ਖਾਲੀ parserDoubleLinkSelect(Parse *pParse, Select *p){
    ਪ੍ਰਤਿਜ੍ਞਾ( p!=0 );
    ਜੇ( p->p_ਪੂਰਵ ){
      Select *p_ਅਗਲਾ = 0, *pLoop = p;
      ਪੂਰਨ mxSelect, cnt = 1;
      ਜਦੋਂ(1){
        pLoop->p_ਅਗਲਾ = p_ਅਗਲਾ;
        pLoop->selFlags |= SF_Compound;
        p_ਅਗਲਾ = pLoop;
        pLoop = pLoop->p_ਪੂਰਵ;
        ਜੇ( pLoop==0 ) ਰੋਕੋ;
        cnt++;        
        ਜੇ( pLoop->p_ਕ੍ਰਮ_By || pLoop->p_ਹੱਦਬੰਦੀ ){
          sqlite3_Error_ਸੁਨੇਹਾ(pParse,"%s clause should come after %s not before",
             pLoop->p_ਕ੍ਰਮ_By!=0 ? "ORDER BY" : "LIMIT",
             sqlite3SelectOpName(p_ਅਗਲਾ->op));
          ਰੋਕੋ;
        }
      }
      ਜੇ( (p->selFlags & (SF_Multi_ਮੁੱਲ|SF_ਮੁੱਲਾਂ))==0
       && (mxSelect = pParse->db->a_ਹੱਦਬੰਦੀ[SQLITE_LIMIT_COMPOUND_SELECT])>0
       && cnt>mxSelect
      ){
        sqlite3_Error_ਸੁਨੇਹਾ(pParse, "too many terms in compound SELECT");
      }
    }
  }

  /* Attach a With object describing the WITH clause to a Select
  ** object describing the query for which the WITH clause is a prefix.
  */
  ਸਥਿਰ Select *attach_With_ਮੰਜ਼ਿਲ_Select(Parse *pParse, Select *pSelect, With *pWith){
    ਜੇ( pSelect ){
      pSelect->pWith = pWith;
      parserDoubleLinkSelect(pParse, pSelect);
    }ਨਹੀਂਤਾਂ{
      sqlite3WithDelete(pParse->db, pWith);
    }
    ਵਾਪਸ pSelect;
  }

  /* Memory allocator for parser stack resizing.  This is a thin wrapper around
  ** sqlite3_realloc() that includes a call to sqlite3FaultSim() to facilitate
  ** testing.
  */
  ਸਥਿਰ ਖਾਲੀ *parser_ਢੇਰ_Realloc(
    ਖਾਲੀ *pOld,               /* Prior allocation */
    sqlite3_uint64 new_ਮਾਪ_2,   /* Requested new alloation size */
    Parse *pParse             /* Parsing context */
  ){
    ਖਾਲੀ *p = sqlite3FaultSim(700) ? 0 : sqlite3_realloc(pOld, new_ਮਾਪ_2);
    ਜੇ( p==0 ) sqlite3OomFault(pParse->db);
    ਵਾਪਸ p;
  }
  ਸਥਿਰ ਖਾਲੀ parser_ਢੇਰ_Free(ਖਾਲੀ *pOld, Parse *pParse){
    (ਖਾਲੀ)pParse;
    sqlite3_free(pOld); 
  }

  /* Return an integer that is the maximum allowed stack size */
  ਸਥਿਰ ਪੂਰਨ parser_ਢੇਰ_ਮਾਪ_ਹੱਦਬੰਦੀ(Parse *pParse){
    ਵਾਪਸ pParse->db->a_ਹੱਦਬੰਦੀ[SQLITE_LIMIT_PARSER_DEPTH];
  }
}

%ifndef SQLITE_OMIT_CTE
select(A) ::= WITH wqlist(W) selectnowith(X). {A = attach_With_ਮੰਜ਼ਿਲ_Select(pParse,X,W);}
select(A) ::= WITH RECURSIVE wqlist(W) selectnowith(X).
                                              {A = attach_With_ਮੰਜ਼ਿਲ_Select(pParse,X,W);}

%endif /* SQLITE_OMIT_CTE */
select(A) ::= selectnowith(A). {
  Select *p = A;
  ਜੇ( p ){
    parserDoubleLinkSelect(pParse, p);
  }
}

selectnowith(A) ::= oneselect(A).
%ifndef SQLITE_OMIT_COMPOUND_SELECT
selectnowith(A) ::= selectnowith(A) multiselect_op(Y) oneselect(Z).  {
  Select *pRhs = Z;
  Select *pLhs = A;
  ਜੇ( pRhs && pRhs->p_ਪੂਰਵ ){
    SrcList *pFrom;
    Token x;
    x.n = 0;
    parserDoubleLinkSelect(pParse, pRhs);
    pFrom = sqlite3_Src_List_Append_From_ਪਦ(pParse,0,0,0,&x,pRhs,0);
    pRhs = sqlite3SelectNew(pParse,0,pFrom,0,0,0,0,0,0);
  }
  ਜੇ( pRhs ){
    pRhs->op = (u8)Y;
    pRhs->p_ਪੂਰਵ = pLhs;
    ਜੇ( ALWAYS(pLhs) ) pLhs->selFlags &= ~(u32)SF_Multi_ਮੁੱਲ;
    pRhs->selFlags &= ~(u32)SF_Multi_ਮੁੱਲ;
    ਜੇ( Y!=TK_ALL ) pParse->hasCompound = 1;
  }ਨਹੀਂਤਾਂ{
    sqlite3SelectDelete(pParse->db, pLhs);
  }
  A = pRhs;
}
%ਕਿਸਮ multiselect_op {ਪੂਰਨ}
multiselect_op(A) ::= UNION(OP).             {A = @OP; /*A-overwrites-OP*/}
multiselect_op(A) ::= UNION ALL.             {A = TK_ALL;}
multiselect_op(A) ::= EXCEPT|INTERSECT(OP).  {A = @OP; /*A-overwrites-OP*/}
%endif SQLITE_OMIT_COMPOUND_SELECT

oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) 
                 orderby_opt(Z) ਹੱਦਬੰਦੀ_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
}
%ifndef SQLITE_OMIT_WINDOWFUNC
oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) ਖਿੜਕੀ_clause(R)
                 orderby_opt(Z) ਹੱਦਬੰਦੀ_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
  ਜੇ( A ){
    A->pWinDefn = R;
  }ਨਹੀਂਤਾਂ{
    sqlite3_ਖਿੜਕੀ_List_Delete(pParse->db, R);
  }
}
%endif


// Single row VALUES clause.
//
%ਕਿਸਮ ਮੁੱਲਾਂ {Select*}
oneselect(A) ::= ਮੁੱਲਾਂ(A).
%destructor ਮੁੱਲਾਂ {sqlite3SelectDelete(pParse->db, $$);}
ਮੁੱਲਾਂ(A) ::= ਮੁੱਲਾਂ_2 LP nexprlist(X) RP. {
  A = sqlite3SelectNew(pParse,X,0,0,0,0,0,SF_ਮੁੱਲਾਂ,0);
}

// Multiple row VALUES clause.
//
%ਕਿਸਮ mvalues {Select*}
oneselect(A) ::= mvalues(A). {
  sqlite3_Multi_ਮੁੱਲਾਂ_ਸਿਰਾ(pParse, A);
}
%destructor mvalues {sqlite3SelectDelete(pParse->db, $$);}
mvalues(A) ::= ਮੁੱਲਾਂ(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_ਮੁੱਲਾਂ(pParse, A, Y);
}
mvalues(A) ::= mvalues(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_ਮੁੱਲਾਂ(pParse, A, Y);
}

// The "distinct" nonterminal is true (1) if the DISTINCT keyword is
// present and false (0) if it is not.
//
%ਕਿਸਮ distinct {ਪੂਰਨ}
distinct(A) ::= DISTINCT.   {A = SF_Distinct;}
distinct(A) ::= ALL.        {A = SF_All;}
distinct(A) ::= .           {A = 0;}

// selcollist is a list of expressions that are to become the return
// values of the SELECT statement.  The "*" in statements like
// "SELECT * FROM ..." is encoded as a special expression with an
// opcode of TK_ASTERISK.
//
%ਕਿਸਮ selcollist {ਵਿਅੰਜਕ_List*}
%destructor selcollist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
%ਕਿਸਮ sclp {ਵਿਅੰਜਕ_List*}
%destructor sclp {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
sclp(A) ::= selcollist(A) COMMA.
sclp(A) ::= .                                {A = 0;}
selcollist(A) ::= sclp(A) scanpt(B) ਵਿਅੰਜਕ_2(X) scanpt(Z) as(Y).     {
   A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, A, X);
   ਜੇ( Y.n>0 ) sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_Name(pParse, A, &Y, 1);
   sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_ਵਿਸਤਾਰ(pParse,A,B,Z);
}
selcollist(A) ::= sclp(A) scanpt ਤਾਰਾ(X). {
  ਵਿਅੰਜਕ *p = sqlite3_ਵਿਅੰਜਕ(pParse->db, TK_ASTERISK, 0);
  sqlite3_ਵਿਅੰਜਕ_ਸੈੱਟ_Error_ਵਿੱਥ(p, (ਪੂਰਨ)(X.z - pParse->z_ਪੂਛ));
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, A, p);
}
selcollist(A) ::= sclp(A) scanpt nm(X) DOT ਤਾਰਾ(Y). {
  ਵਿਅੰਜਕ *p_ਸੱਜਾ, *p_ਖੱਬਾ, *pDot;
  p_ਸੱਜਾ = sqlite3PExpr(pParse, TK_ASTERISK, 0, 0);
  sqlite3_ਵਿਅੰਜਕ_ਸੈੱਟ_Error_ਵਿੱਥ(p_ਸੱਜਾ, (ਪੂਰਨ)(Y.z - pParse->z_ਪੂਛ));
  p_ਖੱਬਾ = token_ਵਿਅੰਜਕ(pParse, TK_ID, X);
  pDot = sqlite3PExpr(pParse, TK_DOT, p_ਖੱਬਾ, p_ਸੱਜਾ);
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,A, pDot);
}

// An option "AS <id>" phrase that can follow one of the expressions that
// define the result set, or one of the tables in the FROM clause.
//
%ਕਿਸਮ as {Token}
as(X) ::= AS nm(Y).    {X = Y;}
as(X) ::= ids(X).
as(X) ::= .            {X.n = 0; X.z = 0;}


%ਕਿਸਮ seltablist {SrcList*}
%destructor seltablist {sqlite3SrcListDelete(pParse->db, $$);}
%ਕਿਸਮ stl_ਅਗੇਤਰ {SrcList*}
%destructor stl_ਅਗੇਤਰ {sqlite3SrcListDelete(pParse->db, $$);}
%ਕਿਸਮ from {SrcList*}
%destructor from {sqlite3SrcListDelete(pParse->db, $$);}

// A complete FROM clause.
//
from(A) ::= .                {A = 0;}
from(A) ::= FROM seltablist(X). {
  A = X;
  sqlite3_Src_List_ਖਿਸਕਾਓ_Join_Type(pParse,A);
}

// "seltablist" is a "Select Table List" - the content of the FROM clause
// in a SELECT statement.  "stl_prefix" is a prefix of this list.
//
stl_ਅਗੇਤਰ(A) ::= seltablist(A) joinop(Y).    {
   ਜੇ( ALWAYS(A && A->nSrc>0) ) A->a[A->nSrc-1].fg.jointype = (u8)Y;
}
stl_ਅਗੇਤਰ(A) ::= .                           {A = 0;}
seltablist(A) ::= stl_ਅਗੇਤਰ(A) nm(Y) dbnm(D) as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_ਪਦ(pParse,A,&Y,&D,&Z,0,&N);
}
seltablist(A) ::= stl_ਅਗੇਤਰ(A) nm(Y) dbnm(D) as(Z) ਸੂਚਕਾਂਕਿਤ_by(I) on_using(N). {
  A = sqlite3_Src_List_Append_From_ਪਦ(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_ਸੂਚਕਾਂਕਿਤ_By(pParse, A, &I);
}
seltablist(A) ::= stl_ਅਗੇਤਰ(A) nm(Y) dbnm(D) LP exprlist(E) RP as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_ਪਦ(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_Func_ਦਲੀਲਾਂ(pParse, A, E);
}
%ifndef SQLITE_OMIT_SUBQUERY
  seltablist(A) ::= stl_ਅਗੇਤਰ(A) LP select(S) RP as(Z) on_using(N). {
    A = sqlite3_Src_List_Append_From_ਪਦ(pParse,A,0,0,&Z,S,&N);
  }
  seltablist(A) ::= stl_ਅਗੇਤਰ(A) LP seltablist(F) RP as(Z) on_using(N). {
    ਜੇ( A==0 && Z.n==0 && N.pOn==0 && N.pUsing==0 ){
      A = F;
    }ਨਹੀਂਤਾਂ ਜੇ( ALWAYS(F!=0) && F->nSrc==1 ){
      A = sqlite3_Src_List_Append_From_ਪਦ(pParse,A,0,0,&Z,0,&N);
      ਜੇ( A ){
        Src_ਵਸਤੂ *pNew = &A->a[A->nSrc-1];
        Src_ਵਸਤੂ *pOld = F->a;
        ਪ੍ਰਤਿਜ੍ਞਾ( pOld->fg.fixedSchema==0 );
        pNew->zName = pOld->zName;
        pOld->zName = 0;
        ਪ੍ਰਤਿਜ੍ਞਾ( pOld->fg.fixedSchema==0 );
        ਜੇ( pOld->fg.isSubquery ){
          pNew->fg.isSubquery = 1;
          pNew->u4.pSubq = pOld->u4.pSubq;
          pOld->u4.pSubq = 0;
          pOld->fg.isSubquery = 0;
          ਪ੍ਰਤਿਜ੍ਞਾ( pNew->u4.pSubq!=0 && pNew->u4.pSubq->pSelect!=0 );
          ਜੇ( (pNew->u4.pSubq->pSelect->selFlags & SF_NestedFrom)!=0 ){
            pNew->fg.isNestedFrom = 1;
          }
        }ਨਹੀਂਤਾਂ{
          pNew->u4.zDatabase = pOld->u4.zDatabase;
          pOld->u4.zDatabase = 0;
        }
        ਜੇ( pOld->fg.isTabFunc ){
          pNew->u1.pFuncArg = pOld->u1.pFuncArg;
          pOld->u1.pFuncArg = 0;
          pOld->fg.isTabFunc = 0;
          pNew->fg.isTabFunc = 1;
        }ਨਹੀਂਤਾਂ ਜੇ( pOld->fg.is_ਸੂਚਕਾਂਕਿਤ_By ){
          pNew->u1.z_ਸੂਚਕਾਂਕਿਤ_By = pOld->u1.z_ਸੂਚਕਾਂਕਿਤ_By;
          pOld->u1.z_ਸੂਚਕਾਂਕਿਤ_By = 0;
          pOld->fg.is_ਸੂਚਕਾਂਕਿਤ_By = 0;
          pNew->fg.is_ਸੂਚਕਾਂਕਿਤ_By = 1;
        }
        pNew->fg.not_ਸੂਚਕਾਂਕਿਤ = pOld->fg.not_ਸੂਚਕਾਂਕਿਤ;
      }
      sqlite3SrcListDelete(pParse->db, F);
    }ਨਹੀਂਤਾਂ{
      Select *pSubquery;
      sqlite3_Src_List_ਖਿਸਕਾਓ_Join_Type(pParse,F);
      pSubquery = sqlite3SelectNew(pParse,0,F,0,0,0,0,SF_NestedFrom,0);
      A = sqlite3_Src_List_Append_From_ਪਦ(pParse,A,0,0,&Z,pSubquery,&N);
    }
  }
%endif  SQLITE_OMIT_SUBQUERY

%ਕਿਸਮ dbnm {Token}
dbnm(A) ::= .          {A.z=0; A.n=0;}
dbnm(A) ::= DOT nm(X). {A = X;}

%ਕਿਸਮ fullname {SrcList*}
%destructor fullname {sqlite3SrcListDelete(pParse->db, $$);}
fullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  ਜੇ( ਵਿੱਚ_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
fullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  ਜੇ( ਵਿੱਚ_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}

%ਕਿਸਮ xfullname {SrcList*}
%destructor xfullname {sqlite3SrcListDelete(pParse->db, $$);}
xfullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  ਜੇ( ਵਿੱਚ_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
xfullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  ਜੇ( ਵਿੱਚ_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}
xfullname(A) ::= nm(X) AS nm(Z).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  ਜੇ( A ){
    ਜੇ( ਵਿੱਚ_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
    }ਨਹੀਂਤਾਂ{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}
xfullname(A) ::= nm(X) DOT nm(Y) AS nm(Z). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  ਜੇ( A ){
    ਜੇ( ਵਿੱਚ_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
    }ਨਹੀਂਤਾਂ{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}


%ਕਿਸਮ joinop {ਪੂਰਨ}
joinop(X) ::= COMMA|JOIN.              { X = JT_INNER; }
joinop(X) ::= JOIN_KW(A) JOIN.
                  {X = sqlite3JoinType(pParse,&A,0,0);  /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,0); /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) nm(C) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,&C);/*X-overwrites-A*/}

// There is a parsing ambiguity in an upsert statement that uses a
// SELECT on the RHS of a the INSERT:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb ON CONFLICT ...
//                                        here ----^^
//
// When the ON token is encountered, the parser does not know if it is
// the beginning of an ON CONFLICT clause, or the beginning of an ON
// clause associated with the JOIN.  The conflict is resolved in favor
// of the JOIN.  If an ON CONFLICT clause is intended, insert a dummy
// WHERE clause in between, like this:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb WHERE true ON CONFLICT ...
//
// The [AND] and [OR] precedence marks in the rules for on_using cause the
// ON in this context to always be interpreted as belonging to the JOIN.
//
%ਕਿਸਮ on_using {OnOrUsing}
//%destructor on_using {sqlite3ClearOnOrUsing(pParse->db, &$$);}
on_using(N) ::= ON ਵਿਅੰਜਕ_2(E).            {N.pOn = E; N.pUsing = 0;}
on_using(N) ::= USING LP idlist(L) RP. {N.pOn = 0; N.pUsing = L;}
on_using(N) ::= .                 [OR] {N.pOn = 0; N.pUsing = 0;}

// Note that this block abuses the Token type just a little. If there is
// no "INDEXED BY" clause, the returned token is empty (z==0 && n==0). If
// there is an INDEXED BY clause, then the token is populated as per normal,
// with z pointing to the token data and n containing the number of bytes
// in the token.
//
// If there is a "NOT INDEXED" clause, then (z==0 && n==1), which is 
// normally illegal. The sqlite3SrcListIndexedBy() function 
// recognizes and interprets this as a special case.
//
%ਕਿਸਮ ਸੂਚਕਾਂਕਿਤ_opt {Token}
%ਕਿਸਮ ਸੂਚਕਾਂਕਿਤ_by  {Token}
ਸੂਚਕਾਂਕਿਤ_opt(A) ::= .                 {A.z=0; A.n=0;}
ਸੂਚਕਾਂਕਿਤ_opt(A) ::= ਸੂਚਕਾਂਕਿਤ_by(A).
ਸੂਚਕਾਂਕਿਤ_by(A)  ::= ਸੂਚਕਾਂਕਿਤ BY nm(X). {A = X;}
ਸੂਚਕਾਂਕਿਤ_by(A)  ::= NOT ਸੂਚਕਾਂਕਿਤ.      {A.z=0; A.n=1;}

%ਕਿਸਮ orderby_opt {ਵਿਅੰਜਕ_List*}
%destructor orderby_opt {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}

// the sortlist non-terminal stores a list of expression where each
// expression is optionally followed by ASC or DESC to indicate the
// sort order.
//
%ਕਿਸਮ sortlist {ਵਿਅੰਜਕ_List*}
%destructor sortlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}

orderby_opt(A) ::= .                          {A = 0;}
orderby_opt(A) ::= ਕ੍ਰਮ BY sortlist(X).      {A = X;}
sortlist(A) ::= sortlist(A) COMMA ਵਿਅੰਜਕ_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,A,Y);
  sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_ਛਾਂਟੋ_ਕ੍ਰਮ(A,Z,X);
}
sortlist(A) ::= ਵਿਅੰਜਕ_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,0,Y); /*A-overwrites-Y*/
  sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_ਛਾਂਟੋ_ਕ੍ਰਮ(A,Z,X);
}

%ਕਿਸਮ sortorder {ਪੂਰਨ}

sortorder(A) ::= ASC.           {A = SQLITE_SO_ASC;}
sortorder(A) ::= DESC.          {A = SQLITE_SO_DESC;}
sortorder(A) ::= .              {A = SQLITE_SO_UNDEFINED;}

%ਕਿਸਮ nulls {ਪੂਰਨ}
nulls(A) ::= NULLS ਪਹਿਲਾ_2.       {A = SQLITE_SO_ASC;}
nulls(A) ::= NULLS ਆਖਰੀ.        {A = SQLITE_SO_DESC;}
nulls(A) ::= .                  {A = SQLITE_SO_UNDEFINED;}

%ਕਿਸਮ groupby_opt {ਵਿਅੰਜਕ_List*}
%destructor groupby_opt {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
groupby_opt(A) ::= .                      {A = 0;}
groupby_opt(A) ::= ਸਮੂਹ BY nexprlist(X). {A = X;}

%ਕਿਸਮ having_opt {ਵਿਅੰਜਕ*}
%destructor having_opt {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
having_opt(A) ::= .                {A = 0;}
having_opt(A) ::= HAVING ਵਿਅੰਜਕ_2(X).  {A = X;}

%ਕਿਸਮ ਹੱਦਬੰਦੀ_opt {ਵਿਅੰਜਕ*}

// The destructor for limit_opt will never fire in the current grammar.
// The limit_opt non-terminal only occurs at the end of a single production
// rule for SELECT statements.  As soon as the rule that create the 
// limit_opt non-terminal reduces, the SELECT statement rule will also
// reduce.  So there is never a limit_opt non-terminal on the stack 
// except as a transient.  So there is never anything to destroy.
//
//%destructor limit_opt {sqlite3ExprDelete(pParse->db, $$);}
ਹੱਦਬੰਦੀ_opt(A) ::= .       {A = 0;}
ਹੱਦਬੰਦੀ_opt(A) ::= ਹੱਦਬੰਦੀ_2 ਵਿਅੰਜਕ_2(X).
                         {A = sqlite3PExpr(pParse,TK_ਹੱਦਬੰਦੀ,X,0);}
ਹੱਦਬੰਦੀ_opt(A) ::= ਹੱਦਬੰਦੀ_2 ਵਿਅੰਜਕ_2(X) ਵਿੱਥ_3 ਵਿਅੰਜਕ_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_ਹੱਦਬੰਦੀ,X,Y);}
ਹੱਦਬੰਦੀ_opt(A) ::= ਹੱਦਬੰਦੀ_2 ਵਿਅੰਜਕ_2(X) COMMA ਵਿਅੰਜਕ_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_ਹੱਦਬੰਦੀ,Y,X);}

/////////////////////////// The DELETE statement /////////////////////////////
//
%ਜੇ SQLITE_ENABLE_UPDATE_DELETE_ਹੱਦਬੰਦੀ || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with DELETE FROM xfullname(X) ਸੂਚਕਾਂਕਿਤ_opt(I) where_opt_ret(W)
        orderby_opt(O) ਹੱਦਬੰਦੀ_opt(L). {
  sqlite3_Src_List_ਸੂਚਕਾਂਕਿਤ_By(pParse, X, &I);
#ਜੇ_ਅਪਰਿਭਾਸ਼ਿਤ SQLITE_ENABLE_UPDATE_DELETE_ਹੱਦਬੰਦੀ
  ਜੇ( O || L ){
    update_Delete_ਹੱਦਬੰਦੀ_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#ਜੇ_ਅੰਤ
  sqlite3DeleteFrom(pParse,X,W,O,L);
}
%ਨਹੀਂਤਾਂ
cmd ::= with DELETE FROM xfullname(X) ਸੂਚਕਾਂਕਿਤ_opt(I) where_opt_ret(W). {
  sqlite3_Src_List_ਸੂਚਕਾਂਕਿਤ_By(pParse, X, &I);
  sqlite3DeleteFrom(pParse,X,W,0,0);
}
