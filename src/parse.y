%اگر SQLITE_ENABLE_UPDATE_DELETE_حد_بندی || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with UPDATE orconf(R) xfullname(X) اشاریہ_دار_opt(I) سیٹ setlist(Y) from(F)
        where_opt_ret(W) orderby_opt(O) حد_بندی_opt(L).  {
  sqlite3_Src_List_اشاریہ_دار_By(pParse, X, &I);
  اگر( F ){
    SrcList *pFromClause = F;
    اگر( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_رکن(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3_اظہاریہ_List_Check_لمبائی(pParse,Y,"set list"); 
#اگر_غیر_تعریف_شدہ SQLITE_ENABLE_UPDATE_DELETE_حد_بندی
  اگر( O || L ){
    update_Delete_حد_بندی_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#اگر_ختم
  sqlite3Update(pParse,X,Y,W,R,O,L,0);
}
