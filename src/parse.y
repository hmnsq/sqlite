// Setup for the parser stack
%stack_size        50                        // Initial stack size
%stack_size_limit  parser_ರಾಶಿ_ಗಾತ್ರ_ಎಲ್ಲೆ      // Function returning max stack size
%realloc           parser_ರಾಶಿ_Realloc        // realloc() for the stack
%ಬಿಡುಗಡೆ              parser_ರಾಶಿ_Free           // free() for the stack

// All token codes are small integers with #defines that begin with "TK_"
%token_prefix TK_

// The type of the data attached to each token is Token.  This is also the
// default type for non-terminals.
//
%token_type {Token}
%default_type {Token}

// An extra argument to the constructor for the parser, which is available
// to all actions.
%extra_context {Parse *pParse}

// This code runs whenever there is a syntax error
//
%syntax_error {
  ಬಳಸದ_PARAMETER(yymajor);  /* Silence some compiler warnings */
  ಆದರೆ( TOKEN.z[0] ){
    parserSyntaxError(pParse, &TOKEN);
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_Error_ಸಂದೇಶ(pParse, "incomplete input");
  }
}
%stack_overflow {
  ಆದರೆ( pParse->nErr==0 ) sqlite3_Error_ಸಂದೇಶ(pParse, "Recursion limit");
}

// The name of the generated procedure that implements the parser
// is as follows:
%name sqlite3Parser

// The following text is included near the beginning of the C source
// code file that implements the parser.
//
%include {
#ಅನ್ತರ್ಭಾವ "sqliteInt.h"

/*
** Verify that the pParse->isCreate field is set
*/
#ವ್ಯಾಖ್ಯಾನಿಸು ASSERT_IS_CREATE   ಪ್ರತಿಜ್ಞಾ(pParse->isCreate)

/*
** Disable all error recovery processing in the parser push-down
** automaton.
*/
#ವ್ಯಾಖ್ಯಾನಿಸು YYNOERRORRECOVERY 1

/*
** Make yytestcase() the same as testcase()
*/
#ವ್ಯಾಖ್ಯಾನಿಸು yytestcase(X) testcase(X)

/*
** Indicate that sqlite3ParserFree() will never be called with a null
** pointer.
*/
#ವ್ಯಾಖ್ಯಾನಿಸು YYPARSEFREENEVERNULL 1

/*
** In the amalgamation, the parse.c file generated by lemon and the
** tokenize.c file are concatenated.  In that case, sqlite3RunParser()
** has access to the the size of the yyParser object and so the parser
** engine can be allocated from stack.  In that case, only the
** sqlite3ParserInit() and sqlite3ParserFinalize() routines are invoked
** and the sqlite3ParserAlloc() and sqlite3ParserFree() routines can be
** omitted.
*/
#ವ್ಯಾಖ್ಯಾನಿತವಾದರೆ SQLITE_AMALGAMATION
# define sqlite3Parser_ENGINEALWAYSONSTACK 1
#ಆದರೆ_ಅಂತ್ಯ

/*
** Alternative datatype for the argument to the malloc() routine passed
** into sqlite3ParserAlloc().  The default is size_t.
*/
#ವ್ಯಾಖ್ಯಾನಿಸು YYMALLOCARGTYPE  u64

/*
** An instance of the following structure describes the event of a
** TRIGGER.  "a" is the event type, one of TK_UPDATE, TK_INSERT,
** TK_DELETE, or TK_INSTEAD.  If the event is of the form
**
**      UPDATE ON (a,b,c)
**
** Then the "b" IdList records the list "a,b,c".
*/
ರಚನೆ TrigEvent { ಪೂರ್ಣಾಂಕ a; IdList * b; };

ರಚನೆ ಚೌಕಟ್ಟು_Bound     { ಪೂರ್ಣಾಂಕ eType; ಅಭಿವ್ಯಕ್ತಿ *p_ಅಭಿವ್ಯಕ್ತಿ; };

/*
** Generate a syntax error
*/
ಸ್ಥಿರ ಶೂನ್ಯ parserSyntaxError(Parse *pParse, Token *p){
  sqlite3_Error_ಸಂದೇಶ(pParse, "near \"%T\": syntax error", p);
}

/*
** Disable lookaside memory allocation for objects that might be
** shared across database connections.
*/
ಸ್ಥಿರ ಶೂನ್ಯ disableLookaside(Parse *pParse){
  sqlite3 *db = pParse->db;
  pParse->disableLookaside++;
#ವ್ಯಾಖ್ಯಾನಿತವಾದರೆ SQLITE_DEBUG
  pParse->isCreate = 1;
#ಆದರೆ_ಅಂತ್ಯ
  memset(&pParse->u1.cr, 0, ಗಾತ್ರ(pParse->u1.cr));
  DisableLookaside;
}

#ಆದರೆ !defined(SQLITE_ENABLE_UPDATE_DELETE_ಎಲ್ಲೆ) \
 && defined(SQLITE_UDL_CAPABLE_PARSER)
/*
** Issue an error message if an ORDER BY or LIMIT clause occurs on an
** UPDATE or DELETE statement.
*/
ಸ್ಥಿರ ಶೂನ್ಯ update_Delete_ಎಲ್ಲೆ_Error(
  Parse *pParse,
  ಅಭಿವ್ಯಕ್ತಿ_List *p_ಕ್ರಮ_By,
  ಅಭಿವ್ಯಕ್ತಿ *p_ಎಲ್ಲೆ
){
  ಆದರೆ( p_ಕ್ರಮ_By ){
    sqlite3_Error_ಸಂದೇಶ(pParse, "syntax error near \"ORDER BY\"");
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_Error_ಸಂದೇಶ(pParse, "syntax error near \"LIMIT\"");
  }
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, p_ಕ್ರಮ_By);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Delete(pParse->db, p_ಎಲ್ಲೆ);
}
#ಆದರೆ_ಅಂತ್ಯ /* SQLITE_ENABLE_UPDATE_DELETE_LIMIT */

} // end %include

// Input is a single SQL command
ಒಳಹರಿವು ::= cmdlist.
cmdlist ::= cmdlist ecmd.
cmdlist ::= ecmd.
ecmd ::= SEMI.
ecmd ::= cmdx SEMI.
%ifndef SQLITE_OMIT_EXPLAIN
ecmd ::= explain cmdx SEMI.       {NEVER-REDUCE}
explain ::= EXPLAIN.              { ಆದರೆ( pParse->pReprepare==0 ) pParse->explain = 1; }
explain ::= EXPLAIN QUERY PLAN.   { ಆದರೆ( pParse->pReprepare==0 ) pParse->explain = 2; }
%endif  SQLITE_OMIT_EXPLAIN
cmdx ::= cmd.           { sqlite3_ಮುಕ್ತಾಯ_Coding(pParse); }

///////////////////// Begin and end transactions. ////////////////////////////
//

cmd ::= BEGIN transtype(Y) trans_opt.  {sqlite3BeginTransaction(pParse, Y);}
trans_opt ::= .
trans_opt ::= TRANSACTION.
trans_opt ::= TRANSACTION nm.
%ಪ್ರಕಾರ transtype {ಪೂರ್ಣಾಂಕ}
transtype(A) ::= .             {A = TK_DEFERRED;}
transtype(A) ::= DEFERRED(X).  {A = @X; /*A-overwrites-X*/}
transtype(A) ::= ತಕ್ಷಣ(X). {A = @X; /*A-overwrites-X*/}
transtype(A) ::= EXCLUSIVE(X). {A = @X; /*A-overwrites-X*/}
cmd ::= COMMIT|ಕೊನೆ(X) trans_opt.   {sqlite3_ಕೊನೆ_Transaction(pParse,@X);}
cmd ::= ROLLBACK(X) trans_opt.     {sqlite3_ಕೊನೆ_Transaction(pParse,@X);}

savepoint_opt ::= SAVEPOINT.
savepoint_opt ::= .
cmd ::= SAVEPOINT nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_BEGIN, &X);
}
cmd ::= RELEASE savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_RELEASE, &X);
}
cmd ::= ROLLBACK trans_opt ಗಮ್ಯ_2 savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_ROLLBACK, &X);
}

///////////////////// The CREATE TABLE statement ////////////////////////////
//
cmd ::= create_ಕೋಷ್ಟಕ create_ಕೋಷ್ಟಕ_ವಾದಗಳು.
create_ಕೋಷ್ಟಕ ::= createkw ತಾತ್ಕಾಲಿಕ(T) ಕೋಷ್ಟಕ_3 ifnotexists(E) nm(Y) dbnm(Z). {
   sqlite3_ಆರಂಭ_ಕೋಷ್ಟಕ(pParse,&Y,&Z,T,0,0,E);
}
createkw(A) ::= CREATE(A).  {
  disableLookaside(pParse);
}

%ಪ್ರಕಾರ ifnotexists {ಪೂರ್ಣಾಂಕ}
ifnotexists(A) ::= .              {A = 0;}
ifnotexists(A) ::= IF NOT EXISTS. {A = 1;}
%ಪ್ರಕಾರ ತಾತ್ಕಾಲಿಕ {ಪೂರ್ಣಾಂಕ}
%ifndef SQLITE_OMIT_TEMPDB
ತಾತ್ಕಾಲಿಕ(A) ::= ತಾತ್ಕಾಲಿಕ_2.  {A = pParse->db->init.busy==0;}
%endif  SQLITE_OMIT_TEMPDB
ತಾತ್ಕಾಲಿಕ(A) ::= .      {A = 0;}
create_ಕೋಷ್ಟಕ_ವಾದಗಳು ::= LP columnlist conslist_opt(X) RP(E) ಕೋಷ್ಟಕ_option_ಗಣ(F). {
  sqlite3_ಕೊನೆ_ಕೋಷ್ಟಕ(pParse,&X,&E,F,0);
}
create_ಕೋಷ್ಟಕ_ವಾದಗಳು ::= AS select(S). {
  sqlite3_ಕೊನೆ_ಕೋಷ್ಟಕ(pParse,0,0,0,S);
  sqlite3SelectDelete(pParse->db, S);
}
%ಪ್ರಕಾರ ಕೋಷ್ಟಕ_option_ಗಣ {u32}
%ಪ್ರಕಾರ ಕೋಷ್ಟಕ_option {u32}
ಕೋಷ್ಟಕ_option_ಗಣ(A) ::= .    {A = 0;}
ಕೋಷ್ಟಕ_option_ಗಣ(A) ::= ಕೋಷ್ಟಕ_option(A).
ಕೋಷ್ಟಕ_option_ಗಣ(A) ::= ಕೋಷ್ಟಕ_option_ಗಣ(X) COMMA ಕೋಷ್ಟಕ_option(Y). {A = X|Y;}
ಕೋಷ್ಟಕ_option(A) ::= WITHOUT nm(X). {
  ಆದರೆ( X.n==5 && sqlite3_strnicmp(X.z,"rowid",5)==0 ){
    A = TF_WithoutRowid | TF_NoVisibleRowid;
  }ಇಲ್ಲದಿದ್ದರೆ{
    A = 0;
    sqlite3_Error_ಸಂದೇಶ(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
ಕೋಷ್ಟಕ_option(A) ::= nm(X). {
  ಆದರೆ( X.n==6 && sqlite3_strnicmp(X.z,"strict",6)==0 ){
    A = TF_Strict;
  }ಇಲ್ಲದಿದ್ದರೆ{
    A = 0;
    sqlite3_Error_ಸಂದೇಶ(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
columnlist ::= columnlist COMMA columnname carglist.
columnlist ::= columnname carglist.
columnname(A) ::= nm(A) typetoken(Y). {sqlite3_ಕೂಡಿಸು_ಸ್ತಂಭ(pParse,A,Y);}

// Declare some tokens early in order to influence their values, to 
// improve performance and reduce the executable size.  The goal here is
// to get the "jump" operations in ISNULL through ESCAPE to have numeric
// values that are early enough so that all jump operations are clustered
// at the beginning.  Also, operators like NE and EQ need to be adjacent,
// and all of the comparison operators need to be clustered together.
// Various assert() statements throughout the code enforce these restrictions.
//
%token ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST.
%token CONFLICT DATABASE DEFERRED DESC DETACH EACH ಕೊನೆ EXCLUSIVE EXPLAIN FAIL.
%token OR AND NOT IS ISNOT ಹೊಂದಿಕೆ_2 LIKE_KW BETWEEN ಒಳ_2 ISNULL NOTNULL NE EQ.
%token GT LE LT GE ESCAPE.

// The following directive causes tokens ABORT, AFTER, ASC, etc. to
// fallback to ID if they will not parse as their original value.
// This obviates the need for the "id" nonterminal.
//
%fallback ID
  ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST COLUMNKW
  CONFLICT DATABASE DEFERRED DESC DETACH DO
  EACH ಕೊನೆ EXCLUSIVE EXPLAIN FAIL FOR
  IGNORE ತಕ್ಷಣ INITIALLY INSTEAD LIKE_KW ಹೊಂದಿಕೆ_2 NO PLAN
  QUERY ಕೀಲಿ_2 ದ_2 ಸ್ಥಾನಾಂತರ_3 PRAGMA RAISE RECURSIVE RELEASE REPLACE RESTRICT ಅಡ್ಡಸಾಲು ಅಡ್ಡಸಾಲುಗಳು
  ROLLBACK SAVEPOINT ತಾತ್ಕಾಲಿಕ_2 TRIGGER VACUUM VIEW VIRTUAL WITH WITHOUT
  NULLS ಮೊದಲ_2 ಕೊನೆಯ
%ifdef SQLITE_OMIT_COMPOUND_SELECT
  EXCEPT INTERSECT UNION
%endif SQLITE_OMIT_COMPOUND_SELECT
%ifndef SQLITE_OMIT_WINDOWFUNC
  CURRENT FOLLOWING ವಿಭಜನೆ PRECEDING RANGE UNBOUNDED
  EXCLUDE GROUPS OTHERS TIES
%endif SQLITE_OMIT_WINDOWFUNC
%ifdef SQLITE_ENABLE_ORDERED_ಗಣ_AGGREGATES
  WITHIN
%endif SQLITE_ENABLE_ORDERED_ಗಣ_AGGREGATES
%ifndef SQLITE_OMIT_GENERATED_COLUMNS
  GENERATED ALWAYS
%endif
  MATERIALIZED
  REINDEX RENAME CTIME_KW IF
  .
%wildcard ANY.

// Define operator precedence early so that this is the first occurrence
// of the operator tokens in the grammar.  Keeping the operators together
// causes them to be assigned integer values that are close together,
// which keeps parser tables smaller.
//
// The token values assigned to these symbols is determined by the order
// in which lemon first sees them.  It must be the case that ISNULL/NOTNULL,
// NE/EQ, GT/LE, and GE/LT are separated by only a single value.  See
// the sqlite3ExprIfFalse() routine for additional information on this
// constraint.
//
%ಎಡ OR.
%ಎಡ AND.
%ಬಲ NOT.
%ಎಡ IS ಹೊಂದಿಕೆ_2 LIKE_KW BETWEEN ಒಳ_2 ISNULL NOTNULL NE EQ.
%ಎಡ GT LE LT GE.
%ಬಲ ESCAPE.
%ಎಡ BITAND BITOR LSHIFT RSHIFT.
%ಎಡ PLUS MINUS.
%ಎಡ ನಕ್ಷತ್ರ SLASH REM.
%ಎಡ CONCAT PTR.
%ಎಡ COLLATE.
%ಬಲ BITNOT.
%nonassoc ON.

// An IDENTIFIER can be a generic identifier, or one of several
// keywords.  Any non-standard keyword can also be an identifier.
//
%token_class id  ID|ಸೂಚ್ಯಂಕಿತ.

// And "ids" is an identifier-or-string.
//
%token_class ids  ID|STRING.

// An identifier or a join-keyword
//
%token_class idj  ID|ಸೂಚ್ಯಂಕಿತ|JOIN_KW.

// The name of a column or table can be any of the following:
//
%ಪ್ರಕಾರ nm {Token}
nm(A) ::= idj(A).
nm(A) ::= STRING(A).

// A typetoken is really zero or more tokens that form a type name such
// as can be found after the column name in a CREATE TABLE statement.
// Multiple tokens are concatenated to form the value of the typetoken.
//
%ಪ್ರಕಾರ typetoken {Token}
typetoken(A) ::= .   {A.n = 0; A.z = 0;}
typetoken(A) ::= typename(A).
typetoken(A) ::= typename(A) LP ಚಿಹ್ನೆಯುಳ್ಳ RP(Y). {
  A.n = (ಪೂರ್ಣಾಂಕ)(&Y.z[Y.n] - A.z);
}
typetoken(A) ::= typename(A) LP ಚಿಹ್ನೆಯುಳ್ಳ COMMA ಚಿಹ್ನೆಯುಳ್ಳ RP(Y). {
  A.n = (ಪೂರ್ಣಾಂಕ)(&Y.z[Y.n] - A.z);
}
%ಪ್ರಕಾರ typename {Token}
typename(A) ::= ids(A).
typename(A) ::= typename(A) ids(Y). {A.n=Y.n+(ಪೂರ್ಣಾಂಕ)(Y.z-A.z);}
ಚಿಹ್ನೆಯುಳ್ಳ ::= plus_ಅಂಕೆ.
ಚಿಹ್ನೆಯುಳ್ಳ ::= minus_ಅಂಕೆ.

// The scanpt non-terminal takes a value which is a pointer to the
// input text just past the last token that has been shifted into
// the parser.  By surrounding some phrase in the grammar with two
// scanpt non-terminals, we can capture the input text for that phrase.
// For example:
//
//      something ::= .... scanpt(A) phrase scanpt(Z).
//
// The text that is parsed as "phrase" is a string starting at A
// and containing (int)(Z-A) characters.  There might be some extra
// whitespace on either end of the text, but that can be removed in
// post-processing, if needed.
//
%ಪ್ರಕಾರ scanpt {ಸ್ಥಿರಾಂಕ ಅಕ್ಷರ*}
scanpt(A) ::= . {
  ಪ್ರತಿಜ್ಞಾ( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken.z;
}
scantok(A) ::= . {
  ಪ್ರತಿಜ್ಞಾ( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken;
}

// "carglist" is a list of additional constraints that come after the
// column name and column type in a CREATE TABLE statement.
//
carglist ::= carglist ccons.
carglist ::= .
ccons ::= CONSTRAINT nm(X). {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
ccons ::= DEFAULT scantok(A) ಪದ(X).
                            {sqlite3_ಕೂಡಿಸು_Default_ಮೌಲ್ಯ(pParse,X,A.z,&A.z[A.n]);}
ccons ::= DEFAULT LP(A) ಅಭಿವ್ಯಕ್ತಿ_2(X) RP(Z).
                            {sqlite3_ಕೂಡಿಸು_Default_ಮೌಲ್ಯ(pParse,X,A.z+1,Z.z);}
ccons ::= DEFAULT PLUS(A) scantok(Z) ಪದ(X).
                            {sqlite3_ಕೂಡಿಸು_Default_ಮೌಲ್ಯ(pParse,X,A.z,&Z.z[Z.n]);}
ccons ::= DEFAULT MINUS(A) scantok(Z) ಪದ(X). {
  ಅಭಿವ್ಯಕ್ತಿ *p = sqlite3PExpr(pParse, TK_UMINUS, X, 0);
  sqlite3_ಕೂಡಿಸು_Default_ಮೌಲ್ಯ(pParse,p,A.z,&Z.z[Z.n]);
}
ccons ::= DEFAULT scantok id(X).       {
  ಅಭಿವ್ಯಕ್ತಿ *p = token_ಅಭಿವ್ಯಕ್ತಿ(pParse, TK_STRING, X);
  ಆದರೆ( p ){
    sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Id_ಗಮ್ಯ_True_False(p);
    testcase( p->op==TK_TRUEFALSE && sqlite3_ಅಭಿವ್ಯಕ್ತಿ_Truth_ಮೌಲ್ಯ(p) );
  }
    sqlite3_ಕೂಡಿಸು_Default_ಮೌಲ್ಯ(pParse,p,X.z,X.z+X.n);
}

// In addition to the type name, we also care about the primary key and
// UNIQUE constraints.
//
ccons ::= ಖಾಲಿ onconf.
ccons ::= NOT ಖಾಲಿ onconf(R).    {sqlite3_ಕೂಡಿಸು_Not_Null(pParse, R);}
ccons ::= PRIMARY ಕೀಲಿ_2 sortorder(Z) onconf(R) autoinc(I).
                                 {sqlite3_ಕೂಡಿಸು_Primary_ಕೀಲಿ(pParse,0,R,I,Z);}
ccons ::= UNIQUE onconf(R).      {sqlite3_Create_ಸೂಚ್ಯಂಕ(pParse,0,0,0,0,R,0,0,0,0,
                                   SQLITE_IDXTYPE_UNIQUE);}
ccons ::= CHECK LP(A) ಅಭಿವ್ಯಕ್ತಿ_2(X) RP(B).  {sqlite3_ಕೂಡಿಸು_Check_Constraint(pParse,X,A.z,B.z);}
ccons ::= REFERENCES nm(T) eidlist_opt(TA) refargs(R).
                                 {sqlite3_Create_Foreign_ಕೀಲಿ(pParse,0,&T,TA,R);}
ccons ::= defer_subclause(D).    {sqlite3_Defer_Foreign_ಕೀಲಿ(pParse,D);}
ccons ::= COLLATE ids(C).        {sqlite3_ಕೂಡಿಸು_Collate_Type(pParse, &C);}
ccons ::= GENERATED ALWAYS AS generated.
ccons ::= AS generated.
generated ::= LP ಅಭಿವ್ಯಕ್ತಿ_2(E) RP.          {sqlite3_ಕೂಡಿಸು_Generated(pParse,E,0);}
generated ::= LP ಅಭಿವ್ಯಕ್ತಿ_2(E) RP ID(TYPE). {sqlite3_ಕೂಡಿಸು_Generated(pParse,E,&TYPE);}

// The optional AUTOINCREMENT keyword
%ಪ್ರಕಾರ autoinc {ಪೂರ್ಣಾಂಕ}
autoinc(X) ::= .          {X = 0;}
autoinc(X) ::= AUTOINCR.  {X = 1;}

// The next group of rules parses the arguments to a REFERENCES clause
// that determine if the referential integrity checking is deferred or
// or immediate and which determine what action to take if a ref-integ
// check fails.
//
%ಪ್ರಕಾರ refargs {ಪೂರ್ಣಾಂಕ}
refargs(A) ::= .                  { A = OE_None*0x0101; /* EV: R-19803-45884 */}
refargs(A) ::= refargs(A) refarg(Y). { A = (A & ~Y.ಮುಖವಾಡ) | Y.ಮೌಲ್ಯ; }
%ಪ್ರಕಾರ refarg {ರಚನೆ {ಪೂರ್ಣಾಂಕ ಮೌಲ್ಯ; ಪೂರ್ಣಾಂಕ ಮುಖವಾಡ;}}
refarg(A) ::= ಹೊಂದಿಕೆ_2 nm.              { A.ಮೌಲ್ಯ = 0;     A.ಮುಖವಾಡ = 0x000000; }
refarg(A) ::= ON ಸೇರಿಸು refact.      { A.ಮೌಲ್ಯ = 0;     A.ಮುಖವಾಡ = 0x000000; }
refarg(A) ::= ON DELETE refact(X).   { A.ಮೌಲ್ಯ = X;     A.ಮುಖವಾಡ = 0x0000ff; }
refarg(A) ::= ON UPDATE refact(X).   { A.ಮೌಲ್ಯ = X<<8;  A.ಮುಖವಾಡ = 0x00ff00; }
%ಪ್ರಕಾರ refact {ಪೂರ್ಣಾಂಕ}
refact(A) ::= ಗಣ ಖಾಲಿ.              { A = OE_ಗಣ_Null;  /* EV: R-33326-45252 */}
refact(A) ::= ಗಣ DEFAULT.           { A = OE_ಗಣ_Dflt;  /* EV: R-33326-45252 */}
refact(A) ::= CASCADE.               { A = OE_Cascade;  /* EV: R-33326-45252 */}
refact(A) ::= RESTRICT.              { A = OE_Restrict; /* EV: R-33326-45252 */}
refact(A) ::= NO ACTION.             { A = OE_None;     /* EV: R-33326-45252 */}
%ಪ್ರಕಾರ defer_subclause {ಪೂರ್ಣಾಂಕ}
defer_subclause(A) ::= NOT DEFERRABLE init_deferred_pred_opt.     {A = 0;}
defer_subclause(A) ::= DEFERRABLE init_deferred_pred_opt(X).      {A = X;}
%ಪ್ರಕಾರ init_deferred_pred_opt {ಪೂರ್ಣಾಂಕ}
init_deferred_pred_opt(A) ::= .                       {A = 0;}
init_deferred_pred_opt(A) ::= INITIALLY DEFERRED.     {A = 1;}
init_deferred_pred_opt(A) ::= INITIALLY ತಕ್ಷಣ.    {A = 0;}

conslist_opt(A) ::= .                         {A.n = 0; A.z = 0;}
conslist_opt(A) ::= COMMA(A) conslist.
conslist ::= conslist tconscomma tcons.
conslist ::= tcons.
tconscomma ::= COMMA.          {ASSERT_IS_CREATE; pParse->u1.cr.constraintName.n = 0;}
tconscomma ::= .
tcons ::= CONSTRAINT nm(X).    {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
tcons ::= PRIMARY ಕೀಲಿ_2 LP sortlist(X) autoinc(I) RP onconf(R).
                                 {sqlite3_ಕೂಡಿಸು_Primary_ಕೀಲಿ(pParse,X,R,I,0);}
tcons ::= UNIQUE LP sortlist(X) RP onconf(R).
                                 {sqlite3_Create_ಸೂಚ್ಯಂಕ(pParse,0,0,0,X,R,0,0,0,0,
                                       SQLITE_IDXTYPE_UNIQUE);}
tcons ::= CHECK LP(A) ಅಭಿವ್ಯಕ್ತಿ_2(E) RP(B) onconf.
                                 {sqlite3_ಕೂಡಿಸು_Check_Constraint(pParse,E,A.z,B.z);}
tcons ::= FOREIGN ಕೀಲಿ_2 LP eidlist(FA) RP
          REFERENCES nm(T) eidlist_opt(TA) refargs(R) defer_subclause_opt(D). {
    sqlite3_Create_Foreign_ಕೀಲಿ(pParse, FA, &T, TA, R);
    sqlite3_Defer_Foreign_ಕೀಲಿ(pParse, D);
}
%ಪ್ರಕಾರ defer_subclause_opt {ಪೂರ್ಣಾಂಕ}
defer_subclause_opt(A) ::= .                    {A = 0;}
defer_subclause_opt(A) ::= defer_subclause(A).

// The following is a non-standard extension that allows us to declare the
// default behavior when there is a constraint conflict.
//
%ಪ್ರಕಾರ onconf {ಪೂರ್ಣಾಂಕ}
%ಪ್ರಕಾರ orconf {ಪೂರ್ಣಾಂಕ}
%ಪ್ರಕಾರ resolvetype {ಪೂರ್ಣಾಂಕ}
onconf(A) ::= .                              {A = OE_Default;}
onconf(A) ::= ON CONFLICT resolvetype(X).    {A = X;}
orconf(A) ::= .                              {A = OE_Default;}
orconf(A) ::= OR resolvetype(X).             {A = X;}
resolvetype(A) ::= raisetype(A).
resolvetype(A) ::= IGNORE.                   {A = OE_Ignore;}
resolvetype(A) ::= REPLACE.                  {A = OE_Replace;}

////////////////////////// The DROP TABLE /////////////////////////////////////
//
cmd ::= DROP ಕೋಷ್ಟಕ_3 ifexists(E) fullname(X). {
  sqlite3_Drop_ಕೋಷ್ಟಕ(pParse, X, 0, E);
}
%ಪ್ರಕಾರ ifexists {ಪೂರ್ಣಾಂಕ}
ifexists(A) ::= IF EXISTS.   {A = 1;}
ifexists(A) ::= .            {A = 0;}

///////////////////// The CREATE VIEW statement /////////////////////////////
//
%ifndef SQLITE_OMIT_VIEW
cmd ::= createkw(X) ತಾತ್ಕಾಲಿಕ(T) VIEW ifnotexists(E) nm(Y) dbnm(Z) eidlist_opt(C)
          AS select(S). {
  sqlite3CreateView(pParse, &X, &Y, &Z, C, S, T, E);
}
cmd ::= DROP VIEW ifexists(E) fullname(X). {
  sqlite3_Drop_ಕೋಷ್ಟಕ(pParse, X, 1, E);
}
%endif  SQLITE_OMIT_VIEW

//////////////////////// The SELECT statement /////////////////////////////////
//
cmd ::= select(X).  {
  SelectDest dest = {SRT_Output, 0, 0, 0, 0, 0, 0};
  ಆದರೆ( (pParse->db->mDbFlags & DBFLAG_EncodingFixed)!=0
   || sqlite3ReadSchema(pParse)==SQLITE_OK
  ){
    sqlite3Select(pParse, X, &dest);
  }
  sqlite3SelectDelete(pParse->db, X);
}

%ಪ್ರಕಾರ select {Select*}
%destructor select {sqlite3SelectDelete(pParse->db, $$);}
%ಪ್ರಕಾರ selectnowith {Select*}
%destructor selectnowith {sqlite3SelectDelete(pParse->db, $$);}
%ಪ್ರಕಾರ oneselect {Select*}
%destructor oneselect {sqlite3SelectDelete(pParse->db, $$);}

%include {
  /*
  ** For a compound SELECT statement, make sure p->pPrior->pNext==p for
  ** all elements in the list.  And make sure list length does not exceed
  ** SQLITE_LIMIT_COMPOUND_SELECT.
  */
  ಸ್ಥಿರ ಶೂನ್ಯ parserDoubleLinkSelect(Parse *pParse, Select *p){
    ಪ್ರತಿಜ್ಞಾ( p!=0 );
    ಆದರೆ( p->p_ಪೂರ್ವ ){
      Select *p_ಮುಂದಿನ = 0, *pLoop = p;
      ಪೂರ್ಣಾಂಕ mxSelect, cnt = 1;
      ಆಗ(1){
        pLoop->p_ಮುಂದಿನ = p_ಮುಂದಿನ;
        pLoop->selFlags |= SF_Compound;
        p_ಮುಂದಿನ = pLoop;
        pLoop = pLoop->p_ಪೂರ್ವ;
        ಆದರೆ( pLoop==0 ) ನಿಲ್ಲಿಸು;
        cnt++;        
        ಆದರೆ( pLoop->p_ಕ್ರಮ_By || pLoop->p_ಎಲ್ಲೆ ){
          sqlite3_Error_ಸಂದೇಶ(pParse,"%s clause should come after %s not before",
             pLoop->p_ಕ್ರಮ_By!=0 ? "ORDER BY" : "LIMIT",
             sqlite3SelectOpName(p_ಮುಂದಿನ->op));
          ನಿಲ್ಲಿಸು;
        }
      }
      ಆದರೆ( (p->selFlags & (SF_Multi_ಮೌಲ್ಯ|SF_ಮೌಲ್ಯಗಳು))==0
       && (mxSelect = pParse->db->a_ಎಲ್ಲೆ[SQLITE_LIMIT_COMPOUND_SELECT])>0
       && cnt>mxSelect
      ){
        sqlite3_Error_ಸಂದೇಶ(pParse, "too many terms in compound SELECT");
      }
    }
  }

  /* Attach a With object describing the WITH clause to a Select
  ** object describing the query for which the WITH clause is a prefix.
  */
  ಸ್ಥಿರ Select *attach_With_ಗಮ್ಯ_Select(Parse *pParse, Select *pSelect, With *pWith){
    ಆದರೆ( pSelect ){
      pSelect->pWith = pWith;
      parserDoubleLinkSelect(pParse, pSelect);
    }ಇಲ್ಲದಿದ್ದರೆ{
      sqlite3WithDelete(pParse->db, pWith);
    }
    ಹಿಂತಿರುಗಿ pSelect;
  }

  /* Memory allocator for parser stack resizing.  This is a thin wrapper around
  ** sqlite3_realloc() that includes a call to sqlite3FaultSim() to facilitate
  ** testing.
  */
  ಸ್ಥಿರ ಶೂನ್ಯ *parser_ರಾಶಿ_Realloc(
    ಶೂನ್ಯ *pOld,               /* Prior allocation */
    sqlite3_uint64 new_ಗಾತ್ರ_2,   /* Requested new alloation size */
    Parse *pParse             /* Parsing context */
  ){
    ಶೂನ್ಯ *p = sqlite3FaultSim(700) ? 0 : sqlite3_realloc(pOld, new_ಗಾತ್ರ_2);
    ಆದರೆ( p==0 ) sqlite3OomFault(pParse->db);
    ಹಿಂತಿರುಗಿ p;
  }
  ಸ್ಥಿರ ಶೂನ್ಯ parser_ರಾಶಿ_Free(ಶೂನ್ಯ *pOld, Parse *pParse){
    (ಶೂನ್ಯ)pParse;
    sqlite3_free(pOld); 
  }

  /* Return an integer that is the maximum allowed stack size */
  ಸ್ಥಿರ ಪೂರ್ಣಾಂಕ parser_ರಾಶಿ_ಗಾತ್ರ_ಎಲ್ಲೆ(Parse *pParse){
    ಹಿಂತಿರುಗಿ pParse->db->a_ಎಲ್ಲೆ[SQLITE_LIMIT_PARSER_DEPTH];
  }
}

%ifndef SQLITE_OMIT_CTE
select(A) ::= WITH wqlist(W) selectnowith(X). {A = attach_With_ಗಮ್ಯ_Select(pParse,X,W);}
select(A) ::= WITH RECURSIVE wqlist(W) selectnowith(X).
                                              {A = attach_With_ಗಮ್ಯ_Select(pParse,X,W);}

%endif /* SQLITE_OMIT_CTE */
select(A) ::= selectnowith(A). {
  Select *p = A;
  ಆದರೆ( p ){
    parserDoubleLinkSelect(pParse, p);
  }
}

selectnowith(A) ::= oneselect(A).
%ifndef SQLITE_OMIT_COMPOUND_SELECT
selectnowith(A) ::= selectnowith(A) multiselect_op(Y) oneselect(Z).  {
  Select *pRhs = Z;
  Select *pLhs = A;
  ಆದರೆ( pRhs && pRhs->p_ಪೂರ್ವ ){
    SrcList *pFrom;
    Token x;
    x.n = 0;
    parserDoubleLinkSelect(pParse, pRhs);
    pFrom = sqlite3_Src_List_Append_From_ಪದ(pParse,0,0,0,&x,pRhs,0);
    pRhs = sqlite3SelectNew(pParse,0,pFrom,0,0,0,0,0,0);
  }
  ಆದರೆ( pRhs ){
    pRhs->op = (u8)Y;
    pRhs->p_ಪೂರ್ವ = pLhs;
    ಆದರೆ( ALWAYS(pLhs) ) pLhs->selFlags &= ~(u32)SF_Multi_ಮೌಲ್ಯ;
    pRhs->selFlags &= ~(u32)SF_Multi_ಮೌಲ್ಯ;
    ಆದರೆ( Y!=TK_ALL ) pParse->hasCompound = 1;
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3SelectDelete(pParse->db, pLhs);
  }
  A = pRhs;
}
%ಪ್ರಕಾರ multiselect_op {ಪೂರ್ಣಾಂಕ}
multiselect_op(A) ::= UNION(OP).             {A = @OP; /*A-overwrites-OP*/}
multiselect_op(A) ::= UNION ALL.             {A = TK_ALL;}
multiselect_op(A) ::= EXCEPT|INTERSECT(OP).  {A = @OP; /*A-overwrites-OP*/}
%endif SQLITE_OMIT_COMPOUND_SELECT

oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) 
                 orderby_opt(Z) ಎಲ್ಲೆ_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
}
%ifndef SQLITE_OMIT_WINDOWFUNC
oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) ಕಿಟಕಿ_clause(R)
                 orderby_opt(Z) ಎಲ್ಲೆ_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
  ಆದರೆ( A ){
    A->pWinDefn = R;
  }ಇಲ್ಲದಿದ್ದರೆ{
    sqlite3_ಕಿಟಕಿ_List_Delete(pParse->db, R);
  }
}
%endif


// Single row VALUES clause.
//
%ಪ್ರಕಾರ ಮೌಲ್ಯಗಳು {Select*}
oneselect(A) ::= ಮೌಲ್ಯಗಳು(A).
%destructor ಮೌಲ್ಯಗಳು {sqlite3SelectDelete(pParse->db, $$);}
ಮೌಲ್ಯಗಳು(A) ::= ಮೌಲ್ಯಗಳು_2 LP nexprlist(X) RP. {
  A = sqlite3SelectNew(pParse,X,0,0,0,0,0,SF_ಮೌಲ್ಯಗಳು,0);
}

// Multiple row VALUES clause.
//
%ಪ್ರಕಾರ mvalues {Select*}
oneselect(A) ::= mvalues(A). {
  sqlite3_Multi_ಮೌಲ್ಯಗಳು_ಕೊನೆ(pParse, A);
}
%destructor mvalues {sqlite3SelectDelete(pParse->db, $$);}
mvalues(A) ::= ಮೌಲ್ಯಗಳು(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_ಮೌಲ್ಯಗಳು(pParse, A, Y);
}
mvalues(A) ::= mvalues(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_ಮೌಲ್ಯಗಳು(pParse, A, Y);
}

// The "distinct" nonterminal is true (1) if the DISTINCT keyword is
// present and false (0) if it is not.
//
%ಪ್ರಕಾರ distinct {ಪೂರ್ಣಾಂಕ}
distinct(A) ::= DISTINCT.   {A = SF_Distinct;}
distinct(A) ::= ALL.        {A = SF_All;}
distinct(A) ::= .           {A = 0;}

// selcollist is a list of expressions that are to become the return
// values of the SELECT statement.  The "*" in statements like
// "SELECT * FROM ..." is encoded as a special expression with an
// opcode of TK_ASTERISK.
//
%ಪ್ರಕಾರ selcollist {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor selcollist {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}
%ಪ್ರಕಾರ sclp {ಅಭಿವ್ಯಕ್ತಿ_List*}
%destructor sclp {sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Delete(pParse->db, $$);}
sclp(A) ::= selcollist(A) COMMA.
sclp(A) ::= .                                {A = 0;}
selcollist(A) ::= sclp(A) scanpt(B) ಅಭಿವ್ಯಕ್ತಿ_2(X) scanpt(Z) as(Y).     {
   A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, A, X);
   ಆದರೆ( Y.n>0 ) sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_ಗಣ_Name(pParse, A, &Y, 1);
   sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_ಗಣ_ಹರವು(pParse,A,B,Z);
}
selcollist(A) ::= sclp(A) scanpt ನಕ್ಷತ್ರ(X). {
  ಅಭಿವ್ಯಕ್ತಿ *p = sqlite3_ಅಭಿವ್ಯಕ್ತಿ(pParse->db, TK_ASTERISK, 0);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಗಣ_Error_ಸ್ಥಾನಾಂತರ(p, (ಪೂರ್ಣಾಂಕ)(X.z - pParse->z_ಬಾಲ));
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse, A, p);
}
selcollist(A) ::= sclp(A) scanpt nm(X) DOT ನಕ್ಷತ್ರ(Y). {
  ಅಭಿವ್ಯಕ್ತಿ *p_ಬಲ, *p_ಎಡ, *pDot;
  p_ಬಲ = sqlite3PExpr(pParse, TK_ASTERISK, 0, 0);
  sqlite3_ಅಭಿವ್ಯಕ್ತಿ_ಗಣ_Error_ಸ್ಥಾನಾಂತರ(p_ಬಲ, (ಪೂರ್ಣಾಂಕ)(Y.z - pParse->z_ಬಾಲ));
  p_ಎಡ = token_ಅಭಿವ್ಯಕ್ತಿ(pParse, TK_ID, X);
  pDot = sqlite3PExpr(pParse, TK_DOT, p_ಎಡ, p_ಬಲ);
  A = sqlite3_ಅಭಿವ್ಯಕ್ತಿ_List_Append(pParse,A, pDot);
}

// An option "AS <id>" phrase that can follow one of the expressions that
// define the result set, or one of the tables in the FROM clause.
//
%ಪ್ರಕಾರ as {Token}
as(X) ::= AS nm(Y).    {X = Y;}
as(X) ::= ids(X).
as(X) ::= .            {X.n = 0; X.z = 0;}


%ಪ್ರಕಾರ seltablist {SrcList*}
%destructor seltablist {sqlite3SrcListDelete(pParse->db, $$);}
%ಪ್ರಕಾರ stl_ಪೂರ್ವಪ್ರತ್ಯಯ {SrcList*}
%destructor stl_ಪೂರ್ವಪ್ರತ್ಯಯ {sqlite3SrcListDelete(pParse->db, $$);}
%ಪ್ರಕಾರ from {SrcList*}
%destructor from {sqlite3SrcListDelete(pParse->db, $$);}

// A complete FROM clause.
//
from(A) ::= .                {A = 0;}
from(A) ::= FROM seltablist(X). {
  A = X;
  sqlite3_Src_List_ಸರಿಸು_Join_Type(pParse,A);
}

// "seltablist" is a "Select Table List" - the content of the FROM clause
// in a SELECT statement.  "stl_prefix" is a prefix of this list.
//
stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) ::= seltablist(A) joinop(Y).    {
   ಆದರೆ( ALWAYS(A && A->nSrc>0) ) A->a[A->nSrc-1].fg.jointype = (u8)Y;
}
stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) ::= .                           {A = 0;}
seltablist(A) ::= stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) nm(Y) dbnm(D) as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_ಪದ(pParse,A,&Y,&D,&Z,0,&N);
}
seltablist(A) ::= stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) nm(Y) dbnm(D) as(Z) ಸೂಚ್ಯಂಕಿತ_by(I) on_using(N). {
  A = sqlite3_Src_List_Append_From_ಪದ(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_ಸೂಚ್ಯಂಕಿತ_By(pParse, A, &I);
}
seltablist(A) ::= stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) nm(Y) dbnm(D) LP exprlist(E) RP as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_ಪದ(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_Func_ವಾದಗಳು(pParse, A, E);
}
%ifndef SQLITE_OMIT_SUBQUERY
  seltablist(A) ::= stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) LP select(S) RP as(Z) on_using(N). {
    A = sqlite3_Src_List_Append_From_ಪದ(pParse,A,0,0,&Z,S,&N);
  }
  seltablist(A) ::= stl_ಪೂರ್ವಪ್ರತ್ಯಯ(A) LP seltablist(F) RP as(Z) on_using(N). {
    ಆದರೆ( A==0 && Z.n==0 && N.pOn==0 && N.pUsing==0 ){
      A = F;
    }ಇಲ್ಲದಿದ್ದರೆ ಆದರೆ( ALWAYS(F!=0) && F->nSrc==1 ){
      A = sqlite3_Src_List_Append_From_ಪದ(pParse,A,0,0,&Z,0,&N);
      ಆದರೆ( A ){
        Src_ಅಂಶ *pNew = &A->a[A->nSrc-1];
        Src_ಅಂಶ *pOld = F->a;
        ಪ್ರತಿಜ್ಞಾ( pOld->fg.fixedSchema==0 );
        pNew->zName = pOld->zName;
        pOld->zName = 0;
        ಪ್ರತಿಜ್ಞಾ( pOld->fg.fixedSchema==0 );
        ಆದರೆ( pOld->fg.isSubquery ){
          pNew->fg.isSubquery = 1;
          pNew->u4.pSubq = pOld->u4.pSubq;
          pOld->u4.pSubq = 0;
          pOld->fg.isSubquery = 0;
          ಪ್ರತಿಜ್ಞಾ( pNew->u4.pSubq!=0 && pNew->u4.pSubq->pSelect!=0 );
          ಆದರೆ( (pNew->u4.pSubq->pSelect->selFlags & SF_NestedFrom)!=0 ){
            pNew->fg.isNestedFrom = 1;
          }
        }ಇಲ್ಲದಿದ್ದರೆ{
          pNew->u4.zDatabase = pOld->u4.zDatabase;
          pOld->u4.zDatabase = 0;
        }
        ಆದರೆ( pOld->fg.isTabFunc ){
          pNew->u1.pFuncArg = pOld->u1.pFuncArg;
          pOld->u1.pFuncArg = 0;
          pOld->fg.isTabFunc = 0;
          pNew->fg.isTabFunc = 1;
        }ಇಲ್ಲದಿದ್ದರೆ ಆದರೆ( pOld->fg.is_ಸೂಚ್ಯಂಕಿತ_By ){
          pNew->u1.z_ಸೂಚ್ಯಂಕಿತ_By = pOld->u1.z_ಸೂಚ್ಯಂಕಿತ_By;
          pOld->u1.z_ಸೂಚ್ಯಂಕಿತ_By = 0;
          pOld->fg.is_ಸೂಚ್ಯಂಕಿತ_By = 0;
          pNew->fg.is_ಸೂಚ್ಯಂಕಿತ_By = 1;
        }
        pNew->fg.not_ಸೂಚ್ಯಂಕಿತ = pOld->fg.not_ಸೂಚ್ಯಂಕಿತ;
      }
      sqlite3SrcListDelete(pParse->db, F);
    }ಇಲ್ಲದಿದ್ದರೆ{
      Select *pSubquery;
      sqlite3_Src_List_ಸರಿಸು_Join_Type(pParse,F);
      pSubquery = sqlite3SelectNew(pParse,0,F,0,0,0,0,SF_NestedFrom,0);
      A = sqlite3_Src_List_Append_From_ಪದ(pParse,A,0,0,&Z,pSubquery,&N);
    }
  }
%endif  SQLITE_OMIT_SUBQUERY

