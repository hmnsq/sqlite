%ಪ್ರಕಾರ upsert {Upsert*}

// Because upsert only occurs at the tip end of the INSERT rule for cmd,
// there is never a case where the value of the upsert pointer will not
// be destroyed by the cmd action.  So comment-out the destructor to
// avoid unreachable code.
//%destructor upsert {sqlite3UpsertDelete(pParse->db,$$);}
upsert(A) ::= . { A = 0; }
upsert(A) ::= RETURNING selcollist(X).  { A = 0; sqlite3_ಕೂಡಿಸು_Returning(pParse,X); }
upsert(A) ::= ON CONFLICT LP sortlist(T) RP where_opt(TW)
              DO UPDATE ಗಣ setlist(Z) where_opt(W) upsert(N).
              { A = sqlite3UpsertNew(pParse->db,T,TW,Z,W,N);}
upsert(A) ::= ON CONFLICT LP sortlist(T) RP where_opt(TW) DO NOTHING upsert(N).
              { A = sqlite3UpsertNew(pParse->db,T,TW,0,0,N); }
upsert(A) ::= ON CONFLICT DO NOTHING returning.
              { A = sqlite3UpsertNew(pParse->db,0,0,0,0,0); }
upsert(A) ::= ON CONFLICT DO UPDATE ಗಣ setlist(Z) where_opt(W) returning.
              { A = sqlite3UpsertNew(pParse->db,0,0,Z,W,0);}

returning ::= RETURNING selcollist(X).  {sqlite3_ಕೂಡಿಸು_Returning(pParse,X);}
returning ::= .

%ಪ್ರಕಾರ ಸೇರಿಸು_cmd {ಪೂರ್ಣಾಂಕ}
ಸೇರಿಸು_cmd(A) ::= ಸೇರಿಸು orconf(R).   {A = R;}
ಸೇರಿಸು_cmd(A) ::= REPLACE.            {A = OE_Replace;}

%ಪ್ರಕಾರ idlist_opt {IdList*}
