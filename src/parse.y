////////////////////////// The UPDATE command ////////////////////////////////
//
%ఒకవేళ SQLITE_ENABLE_UPDATE_DELETE_హద్దు || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with UPDATE orconf(R) xfullname(X) సూచీకృత_opt(I) సమితి setlist(Y) from(F)
        where_opt_ret(W) orderby_opt(O) హద్దు_opt(L).  {
  sqlite3_Src_List_సూచీకృత_By(pParse, X, &I);
  ఒకవేళ( F ){
    SrcList *pFromClause = F;
    ఒకవేళ( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_పదం(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3_సమాసం_List_Check_నిడివి(pParse,Y,"set list"); 
#నిర్వచితం_కాకపోతే SQLITE_ENABLE_UPDATE_DELETE_హద్దు
  ఒకవేళ( O || L ){
    update_Delete_హద్దు_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#అయితే_ముగింపు
  sqlite3Update(pParse,X,Y,W,R,O,L,0);
}
%లేకపోతే
cmd ::= with UPDATE orconf(R) xfullname(X) సూచీకృత_opt(I) సమితి setlist(Y) from(F)
        where_opt_ret(W). {
  sqlite3_Src_List_సూచీకృత_By(pParse, X, &I);
  sqlite3_సమాసం_List_Check_నిడివి(pParse,Y,"set list"); 
  ఒకవేళ( F ){
    SrcList *pFromClause = F;
    ఒకవేళ( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_పదం(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3Update(pParse,X,Y,W,R,0,0,0);
}
%endif



%రకం setlist {సమాసం_List*}
%destructor setlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}

