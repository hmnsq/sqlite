//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) پڇاڙي(Z). {
  Token all;
  all.z = A.z;
  all.n = (صحيح)(Z.z - A.z) + Z.n;
  sqlite3_پڄاڻي_Trigger(pParse, S, &all);
}

trigger_decl(A) ::= عارضي(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_وقت(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#جيڪڏهن_وصف_ٿيل SQLITE_DEBUG
  أكد( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#جيڪڏهن_پورو
}

%نوع trigger_وقت {صحيح}
trigger_وقت(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_وقت(A) ::= INSTEAD جو_2.  { A = TK_INSTEAD;}
trigger_وقت(A) ::= .            { A = TK_BEFORE; }

%نوع trigger_event {بنية TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|وجهو(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE جو_2 idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH صف.

%نوع when_clause {اظهار*}
%destructor when_clause {sqlite3_اظهار_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN اظهار_2(X). { A = X; }

%نوع trigger_cmd_list {Trigger_قدم*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_قدم(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_آخري->p_ايندڙ = X;
  A->p_آخري = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->p_آخري = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= اشاريي_وارو BY nm. {
  sqlite3_Error_نياپو(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT اشاريي_وارو. {
  sqlite3_Error_نياپو(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%نوع trigger_cmd {Trigger_قدم*}
%destructor trigger_cmd {sqlite3_Delete_Trigger_قدم(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby سيٽ setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3_Trigger_Update_قدم(pParse, X, F, Y, Z, R, B.z, E);}

//وجهو
trigger_cmd(A) ::= scanpt(B) وجهو_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_وجهو_قدم(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3_Trigger_Delete_قدم(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3_Trigger_Select_قدم(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
اظهار_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  إذا( A ){
    A->aff_اظهار = OE_Ignore;
  }
}
اظهار_2(A) ::= RAISE LP raisetype(T) COMMA اظهار_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  إذا( A ) {
    A->aff_اظهار = (حرف)T;
  }
}
