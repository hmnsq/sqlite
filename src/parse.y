%ifdef SQLITE_ENABLE_ORDERED_SET_AGGREGATES
ৰাশিমালা_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN GROUP LP ORDER BY ৰাশিমালা_2(E) RP
