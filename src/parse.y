//////////////////////// ALTER TABLE table ... ////////////////////////////////
%ifndef SQLITE_OMIT_ALTERTABLE 
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= ALTER جدول_3 fullname(X) RENAME مقصد_2 nm(Z). {
  sqlite3_Alter_Rename_جدول(pParse,X,&Z);
}

// The ALTER TABLE ADD COLUMN command. This is broken into two sections so
// that sqlite3AlterBeginAddColumn() is called before parsing the various
// constraints and so on (carglist) attached to the new column definition.
cmd ::= alter_جمع_کن(Y) carglist. {
  Y.n = (صحيح)(pParse->s_آخرین_Token.z-Y.z) + pParse->s_آخرین_Token.n;
  sqlite3_Alter_پایان_جمع_کن_ستونی(pParse, &Y);
}
alter_جمع_کن(A) ::= ALTER جدول_3 fullname(X) جمع_کن kwcolumn_opt nm(Y) typetoken(Z). {
  disableLookaside(pParse);
  sqlite3_Alter_Begin_جمع_کن_ستونی(pParse, X);
  sqlite3_جمع_کن_ستونی(pParse, Y, Z);
  A = Y;
}

cmd ::= ALTER جدول_3 fullname(X) DROP kwcolumn_opt nm(Y). {
  sqlite3_Alter_Drop_ستونی(pParse, X, &Y);
}
cmd ::= ALTER جدول_3 fullname(X) RENAME kwcolumn_opt nm(Y) مقصد_2 nm(Z). {
  sqlite3_Alter_Rename_ستونی(pParse, X, &Y, &Z);
}
cmd ::= ALTER جدول_3 fullname(X) DROP CONSTRAINT nm(Y). {
  sqlite3AlterDropConstraint(pParse, X, &Y, 0);
}
cmd ::= ALTER جدول_3 fullname(X) ALTER kwcolumn_opt nm(Y) DROP NOT عدم. {
  sqlite3AlterDropConstraint(pParse, X, 0, &Y);
}
cmd ::= ALTER جدول_3 fullname(X) ALTER kwcolumn_opt nm(Y) مجموعه NOT(Z) عدم onconf. {
  sqlite3_Alter_مجموعه_Not_Null(pParse, X, &Y, &Z);
}
cmd ::= ALTER جدول_3 fullname(X) جمع_کن CONSTRAINT(Y) nm(Z) CHECK LP(A) عبارت_2(E) RP(B) onconf. {
  sqlite3_Alter_جمع_کن_Constraint(pParse, X, &Y, &Z, A.z+1, (B.z-A.z-1), E);
}
cmd ::= ALTER جدول_3 fullname(X) جمع_کن CHECK(Y) LP(A) عبارت_2(E) RP(B) onconf. {
  sqlite3_Alter_جمع_کن_Constraint(pParse, X, &Y, 0, A.z+1, (B.z-A.z-1), E);
}

kwcolumn_opt ::= .
kwcolumn_opt ::= COLUMNKW.

%endif SQLITE_OMIT_VIRTUALTABLE
%endif SQLITE_OMIT_ALTERTABLE

//////////////////////// CREATE VIRTUAL TABLE ... /////////////////////////////
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= create_vtab.                       {sqlite3_Vtab_پایان_Parse(pParse,0);}
cmd ::= create_vtab LP vtabarglist RP(X).  {sqlite3_Vtab_پایان_Parse(pParse,&X);}
create_vtab ::= createkw VIRTUAL جدول_3 ifnotexists(E)
                nm(X) dbnm(Y) USING nm(Z). {
    sqlite3VtabBeginParse(pParse, &X, &Y, &Z, E);
}
vtabarglist ::= vtabarg.
vtabarglist ::= vtabarglist COMMA vtabarg.
vtabarg ::= .                       {sqlite3VtabArgInit(pParse);}
vtabarg ::= vtabarg vtabargtoken.
vtabargtoken ::= ANY(X).            {sqlite3VtabArgExtend(pParse,&X);}
vtabargtoken ::= lp anylist RP(X).  {sqlite3VtabArgExtend(pParse,&X);}
lp ::= LP(X).                       {sqlite3VtabArgExtend(pParse,&X);}
anylist ::= .
anylist ::= anylist LP anylist RP.
anylist ::= anylist ANY.
%endif  SQLITE_OMIT_VIRTUALTABLE


//////////////////////// COMMON TABLE EXPRESSIONS ////////////////////////////
%نوع wqlist {With*}
%destructor wqlist {sqlite3WithDelete(pParse->db, $$);}
%نوع wqitem {Cte*}
// %destructor wqitem {sqlite3CteDelete(pParse->db, $$);} // not reachable

with ::= .
%ifndef SQLITE_OMIT_CTE
with ::= WITH wqlist(W).              { sqlite3_With_افزودن(pParse, W, 1); }
with ::= WITH RECURSIVE wqlist(W).    { sqlite3_With_افزودن(pParse, W, 1); }

%نوع wqas {u8}
wqas(A)   ::= AS.                  {A = M10d_Any;}
wqas(A)   ::= AS MATERIALIZED.     {A = M10d_Yes;}
wqas(A)   ::= AS NOT MATERIALIZED. {A = M10d_No;}
wqitem(A) ::= withnm(X) eidlist_opt(Y) wqas(M) LP select(Z) RP. {
  A = sqlite3CteNew(pParse, &X, Y, Z, M); /*A-overwrites-X*/
}
withnm(A) ::= nm(A). {pParse->bHasWith = 1;}
wqlist(A) ::= wqitem(X). {
  A = sqlite3_With_جمع_کن(pParse, 0, X); /*A-overwrites-X*/
}
wqlist(A) ::= wqlist(A) COMMA wqitem(X). {
  A = sqlite3_With_جمع_کن(pParse, A, X);
}
%endif  SQLITE_OMIT_CTE

//////////////////////// WINDOW FUNCTION EXPRESSIONS /////////////////////////
// These must be at the end of this file. Specifically, the rules that
// introduce tokens WINDOW, OVER and FILTER must appear last. This causes 
// the integer values assigned to these tokens to be larger than all other 
// tokens that may be output by the tokenizer except TK_SPACE, TK_COMMENT,
// and TK_ILLEGAL.
//
%ifndef SQLITE_OMIT_WINDOWFUNC
%نوع windowdefn_list {پنجره*}
%destructor windowdefn_list {sqlite3_پنجره_List_Delete(pParse->db, $$);}
windowdefn_list(A) ::= windowdefn(A).
windowdefn_list(A) ::= windowdefn_list(Y) COMMA windowdefn(Z). {
  أكد( Z!=0 );
  sqlite3_پنجره_Chain(pParse, Z, Y);
  Z->p_بعدی_Win = Y;
  A = Z;
}

%نوع windowdefn {پنجره*}
%destructor windowdefn {sqlite3_پنجره_Delete(pParse->db, $$);}
windowdefn(A) ::= nm(X) AS LP پنجره_2(Y) RP. {
  إذا( ALWAYS(Y) ){
    Y->zName = sqlite3DbStrNDup(pParse->db, X.z, X.n);
  }
  A = Y;
}

%نوع پنجره_2 {پنجره*}
%destructor پنجره_2 {sqlite3_پنجره_Delete(pParse->db, $$);}

%نوع قاب_opt {پنجره*}
%destructor قاب_opt {sqlite3_پنجره_Delete(pParse->db, $$);}

%نوع part_opt {عبارت_List*}
%destructor part_opt {sqlite3_عبارت_List_Delete(pParse->db, $$);}

%نوع filter_clause {عبارت*}
%destructor filter_clause {sqlite3_عبارت_Delete(pParse->db, $$);}

%نوع over_clause {پنجره*}
%destructor over_clause {sqlite3_پنجره_Delete(pParse->db, $$);}

%نوع filter_over {پنجره*}
%destructor filter_over {sqlite3_پنجره_Delete(pParse->db, $$);}

%نوع range_or_ردیفها {صحيح}

%نوع قاب_bound {بنية قاب_Bound}
%destructor قاب_bound {sqlite3_عبارت_Delete(pParse->db, $$.p_عبارت);}
%نوع قاب_bound_s {بنية قاب_Bound}
%destructor قاب_bound_s {sqlite3_عبارت_Delete(pParse->db, $$.p_عبارت);}
%نوع قاب_bound_e {بنية قاب_Bound}
%destructor قاب_bound_e {sqlite3_عبارت_Delete(pParse->db, $$.p_عبارت);}

پنجره_2(A) ::= افراز BY nexprlist(X) orderby_opt(Y) قاب_opt(Z). {
  A = sqlite3_پنجره_Assemble(pParse, Z, X, Y, 0);
}
پنجره_2(A) ::= nm(W) افراز BY nexprlist(X) orderby_opt(Y) قاب_opt(Z). {
  A = sqlite3_پنجره_Assemble(pParse, Z, X, Y, &W);
}
پنجره_2(A) ::= ترتیب BY sortlist(Y) قاب_opt(Z). {
  A = sqlite3_پنجره_Assemble(pParse, Z, 0, Y, 0);
}
پنجره_2(A) ::= nm(W) ترتیب BY sortlist(Y) قاب_opt(Z). {
  A = sqlite3_پنجره_Assemble(pParse, Z, 0, Y, &W);
}
پنجره_2(A) ::= قاب_opt(A).
پنجره_2(A) ::= nm(W) قاب_opt(Z). {
  A = sqlite3_پنجره_Assemble(pParse, Z, 0, 0, &W);
}

قاب_opt(A) ::= .                             { 
  A = sqlite3_پنجره_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
قاب_opt(A) ::= range_or_ردیفها(X) قاب_bound_s(Y) قاب_exclude_opt(Z). { 
  A = sqlite3_پنجره_Alloc(pParse, X, Y.eType, Y.p_عبارت, TK_CURRENT, 0, Z);
}
قاب_opt(A) ::= range_or_ردیفها(X) BETWEEN قاب_bound_s(Y) AND
                          قاب_bound_e(Z) قاب_exclude_opt(W). { 
  A = sqlite3_پنجره_Alloc(pParse, X, Y.eType, Y.p_عبارت, Z.eType, Z.p_عبارت, W);
}

range_or_ردیفها(A) ::= RANGE|ردیفها|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

قاب_bound_s(A) ::= قاب_bound(X).         {A = X;}
قاب_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_عبارت = 0;}
قاب_bound_e(A) ::= قاب_bound(X).         {A = X;}
قاب_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_عبارت = 0;}

قاب_bound(A) ::= عبارت_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_عبارت = X;}
قاب_bound(A) ::= CURRENT(X) ردیف.           {A.eType = @X; A.p_عبارت = 0;}

%نوع قاب_exclude_opt {u8}
قاب_exclude_opt(A) ::= . {A = 0;}
قاب_exclude_opt(A) ::= EXCLUDE قاب_exclude(X). {A = X;}

%نوع قاب_exclude {u8}
قاب_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
قاب_exclude(A) ::= CURRENT(X) ردیف. {A = @X; /*A-overwrites-X*/}
قاب_exclude(A) ::= گروه|TIES(X).  {A = @X; /*A-overwrites-X*/}


%نوع پنجره_clause {پنجره*}
%destructor پنجره_clause {sqlite3_پنجره_List_Delete(pParse->db, $$);}
پنجره_clause(A) ::= پنجره_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  إذا( O ){
    O->pFilter = F;
  }وإلا{
    sqlite3_عبارت_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (پنجره*)sqlite3DbMallocZero(pParse->db, حجم(پنجره));
  إذا( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }وإلا{
    sqlite3_عبارت_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP پنجره_2(Z) RP. {
  A = Z;
  أكد( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (پنجره*)sqlite3DbMallocZero(pParse->db, حجم(پنجره));
  إذا( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE عبارت_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%token
  ستونی_2          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_ستونی      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  ثبات        /* Reference to a VDBE register */
  وکتور          /*وکتور*/
  SELECT_ستونی   /* Choose a single column from a multi-column SELECT */
  IF_NULL_ردیف     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  بازه            /* The span operator */
  ERROR           /* An expression containing an error */
.

جمله(A) ::= QNUMBER(X). {
  A=token_عبارت(pParse,@X,X);
  sqlite3_Dequote_عدد(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#إذا TK_بازه>255
# error too many نشانهها in the grammar
#پایان_اگر
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%token SPACE COMMENT ILLEGAL.
