// Setup for the parser stack
%stack_size        50                        // Initial stack size
%stack_size_limit  parser_राशिः_आकार_सीमा      // Function returning max stack size
%realloc           parser_राशिः_Realloc        // realloc() for the stack
%मुक्त              parser_राशिः_Free           // free() for the stack

// All token codes are small integers with #defines that begin with "TK_"
%token_prefix TK_

// The type of the data attached to each token is Token.  This is also the
// default type for non-terminals.
//
%token_type {Token}
%default_type {Token}

// An extra argument to the constructor for the parser, which is available
// to all actions.
%extra_context {Parse *pParse}

// This code runs whenever there is a syntax error
//
%syntax_error {
  अप्रयुक्तम्_PARAMETER(yymajor);  /* Silence some compiler warnings */
  यदि( TOKEN.z[0] ){
    parserSyntaxError(pParse, &TOKEN);
  }अन्यथा{
    sqlite3_Error_सन्देशः(pParse, "incomplete input");
  }
}
%stack_overflow {
  यदि( pParse->nErr==0 ) sqlite3_Error_सन्देशः(pParse, "Recursion limit");
}

// The name of the generated procedure that implements the parser
// is as follows:
%name sqlite3Parser

// The following text is included near the beginning of the C source
// code file that implements the parser.
//
%include {
#अन्तर्भाव "sqliteInt.h"

/*
** Verify that the pParse->isCreate field is set
*/
#परिभाषय ASSERT_IS_CREATE   प्रतिज्ञा(pParse->isCreate)

/*
** Disable all error recovery processing in the parser push-down
** automaton.
*/
#परिभाषय YYNOERRORRECOVERY 1

/*
** Make yytestcase() the same as testcase()
*/
#परिभाषय yytestcase(X) testcase(X)

/*
** Indicate that sqlite3ParserFree() will never be called with a null
** pointer.
*/
#परिभाषय YYPARSEFREENEVERNULL 1

/*
** In the amalgamation, the parse.c file generated by lemon and the
** tokenize.c file are concatenated.  In that case, sqlite3RunParser()
** has access to the the size of the yyParser object and so the parser
** engine can be allocated from stack.  In that case, only the
** sqlite3ParserInit() and sqlite3ParserFinalize() routines are invoked
** and the sqlite3ParserAlloc() and sqlite3ParserFree() routines can be
** omitted.
*/
#यदि_परिभाषितम् SQLITE_AMALGAMATION
# define sqlite3Parser_ENGINEALWAYSONSTACK 1
#यदि_अन्तः

/*
** Alternative datatype for the argument to the malloc() routine passed
** into sqlite3ParserAlloc().  The default is size_t.
*/
#परिभाषय YYMALLOCARGTYPE  u64

/*
** An instance of the following structure describes the event of a
** TRIGGER.  "a" is the event type, one of TK_UPDATE, TK_INSERT,
** TK_DELETE, or TK_INSTEAD.  If the event is of the form
**
**      UPDATE ON (a,b,c)
**
** Then the "b" IdList records the list "a,b,c".
*/
संरचना TrigEvent { पूर्णाङ्क a; IdList * b; };

संरचना FrameBound     { पूर्णाङ्क eType; व्यञ्जकम् *p_व्यञ्जकम्; };

/*
** Generate a syntax error
*/
स्थिर शून्य parserSyntaxError(Parse *pParse, Token *p){
  sqlite3_Error_सन्देशः(pParse, "near \"%T\": syntax error", p);
}

/*
** Disable lookaside memory allocation for objects that might be
** shared across database connections.
*/
स्थिर शून्य disableLookaside(Parse *pParse){
  sqlite3 *db = pParse->db;
  pParse->disableLookaside++;
#यदि_परिभाषितम् SQLITE_DEBUG
  pParse->isCreate = 1;
#यदि_अन्तः
  स्मृतिं_पूरय(&pParse->u1.cr, 0, परिमाण(pParse->u1.cr));
  DisableLookaside;
}

#यदि !defined(SQLITE_ENABLE_UPDATE_DELETE_सीमा) \
 && defined(SQLITE_UDL_CAPABLE_PARSER)
/*
** Issue an error message if an ORDER BY or LIMIT clause occurs on an
** UPDATE or DELETE statement.
*/
स्थिर शून्य update_Delete_सीमा_Error(
  Parse *pParse,
  व्यञ्जकम्_List *p_क्रमः_By,
  व्यञ्जकम् *p_सीमा
){
  यदि( p_क्रमः_By ){
    sqlite3_Error_सन्देशः(pParse, "syntax error near \"ORDER BY\"");
  }अन्यथा{
    sqlite3_Error_सन्देशः(pParse, "syntax error near \"LIMIT\"");
  }
  sqlite3_व्यञ्जकम्_List_Delete(pParse->db, p_क्रमः_By);
  sqlite3_व्यञ्जकम्_Delete(pParse->db, p_सीमा);
}
#यदि_अन्तः /* SQLITE_ENABLE_UPDATE_DELETE_LIMIT */

} // end %include

// Input is a single SQL command
निवेशः ::= cmdlist.
cmdlist ::= cmdlist ecmd.
cmdlist ::= ecmd.
ecmd ::= SEMI.
ecmd ::= cmdx SEMI.
%ifndef SQLITE_OMIT_EXPLAIN
ecmd ::= explain cmdx SEMI.       {NEVER-REDUCE}
explain ::= EXPLAIN.              { यदि( pParse->pReprepare==0 ) pParse->explain = 1; }
explain ::= EXPLAIN QUERY PLAN.   { यदि( pParse->pReprepare==0 ) pParse->explain = 2; }
%endif  SQLITE_OMIT_EXPLAIN
cmdx ::= cmd.           { sqlite3FinishCoding(pParse); }

///////////////////// Begin and end transactions. ////////////////////////////
//

cmd ::= BEGIN transtype(Y) trans_opt.  {sqlite3BeginTransaction(pParse, Y);}
trans_opt ::= .
trans_opt ::= TRANSACTION.
trans_opt ::= TRANSACTION nm.
%प्रकार transtype {पूर्णाङ्क}
transtype(A) ::= .             {A = TK_DEFERRED;}
transtype(A) ::= DEFERRED(X).  {A = @X; /*A-overwrites-X*/}
transtype(A) ::= तात्कालिकम्(X). {A = @X; /*A-overwrites-X*/}
transtype(A) ::= EXCLUSIVE(X). {A = @X; /*A-overwrites-X*/}
cmd ::= COMMIT|अन्तः(X) trans_opt.   {sqlite3_अन्तः_Transaction(pParse,@X);}
cmd ::= ROLLBACK(X) trans_opt.     {sqlite3_अन्तः_Transaction(pParse,@X);}

savepoint_opt ::= SAVEPOINT.
savepoint_opt ::= .
cmd ::= SAVEPOINT nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_BEGIN, &X);
}
cmd ::= RELEASE savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_RELEASE, &X);
}
cmd ::= ROLLBACK trans_opt गन्तव्यम्_2 savepoint_opt nm(X). {
  sqlite3Savepoint(pParse, SAVEPOINT_ROLLBACK, &X);
}

///////////////////// The CREATE TABLE statement ////////////////////////////
//
cmd ::= create_सारणी create_सारणी_तर्काः.
create_सारणी ::= createkw अस्थायी(T) सारणी_3 ifnotexists(E) nm(Y) dbnm(Z). {
   sqlite3_Start_सारणी(pParse,&Y,&Z,T,0,0,E);
}
createkw(A) ::= CREATE(A).  {
  disableLookaside(pParse);
}

%प्रकार ifnotexists {पूर्णाङ्क}
ifnotexists(A) ::= .              {A = 0;}
ifnotexists(A) ::= IF NOT EXISTS. {A = 1;}
%प्रकार अस्थायी {पूर्णाङ्क}
%ifndef SQLITE_OMIT_TEMPDB
अस्थायी(A) ::= अस्थायी_2.  {A = pParse->db->init.busy==0;}
%endif  SQLITE_OMIT_TEMPDB
अस्थायी(A) ::= .      {A = 0;}
create_सारणी_तर्काः ::= LP columnlist conslist_opt(X) RP(E) सारणी_option_समुच्चयः(F). {
  sqlite3_अन्तः_सारणी(pParse,&X,&E,F,0);
}
create_सारणी_तर्काः ::= AS select(S). {
  sqlite3_अन्तः_सारणी(pParse,0,0,0,S);
  sqlite3SelectDelete(pParse->db, S);
}
%प्रकार सारणी_option_समुच्चयः {u32}
%प्रकार सारणी_option {u32}
सारणी_option_समुच्चयः(A) ::= .    {A = 0;}
सारणी_option_समुच्चयः(A) ::= सारणी_option(A).
सारणी_option_समुच्चयः(A) ::= सारणी_option_समुच्चयः(X) COMMA सारणी_option(Y). {A = X|Y;}
सारणी_option(A) ::= WITHOUT nm(X). {
  यदि( X.n==5 && sqlite3_strnicmp(X.z,"rowid",5)==0 ){
    A = TF_WithoutRowid | TF_NoVisibleRowid;
  }अन्यथा{
    A = 0;
    sqlite3_Error_सन्देशः(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
सारणी_option(A) ::= nm(X). {
  यदि( X.n==6 && sqlite3_strnicmp(X.z,"strict",6)==0 ){
    A = TF_Strict;
  }अन्यथा{
    A = 0;
    sqlite3_Error_सन्देशः(pParse, "unknown table option: %.*s", X.n, X.z);
  }
}
columnlist ::= columnlist COMMA columnname carglist.
columnlist ::= columnname carglist.
columnname(A) ::= nm(A) typetoken(Y). {sqlite3_सङ्कलय_Column(pParse,A,Y);}

// Declare some tokens early in order to influence their values, to 
// improve performance and reduce the executable size.  The goal here is
// to get the "jump" operations in ISNULL through ESCAPE to have numeric
// values that are early enough so that all jump operations are clustered
// at the beginning.  Also, operators like NE and EQ need to be adjacent,
// and all of the comparison operators need to be clustered together.
// Various assert() statements throughout the code enforce these restrictions.
//
%शब्दांशः ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST.
%शब्दांशः CONFLICT DATABASE DEFERRED DESC DETACH EACH अन्तः EXCLUSIVE EXPLAIN FAIL.
%शब्दांशः OR AND NOT IS ISNOT मेलनम्_2 LIKE_KW BETWEEN अन्तर्_2 ISNULL NOTNULL NE EQ.
%शब्दांशः GT LE LT GE ESCAPE.

// The following directive causes tokens ABORT, AFTER, ASC, etc. to
// fallback to ID if they will not parse as their original value.
// This obviates the need for the "id" nonterminal.
//
%fallback ID
  ABORT ACTION AFTER ANALYZE ASC ATTACH BEFORE BEGIN BY CASCADE CAST COLUMNKW
  CONFLICT DATABASE DEFERRED DESC DETACH DO
  EACH अन्तः EXCLUSIVE EXPLAIN FAIL FOR
  IGNORE तात्कालिकम् INITIALLY INSTEAD LIKE_KW मेलनम्_2 NO PLAN
  QUERY कुञ्चिका_2 सम्बन्धि_2 विस्थापनम्_3 PRAGMA RAISE RECURSIVE RELEASE REPLACE RESTRICT ROW पङ्क्तिकाः
  ROLLBACK SAVEPOINT अस्थायी_2 TRIGGER VACUUM VIEW VIRTUAL WITH WITHOUT
  NULLS FIRST चरमः
%ifdef SQLITE_OMIT_COMPOUND_SELECT
  EXCEPT INTERSECT UNION
%endif SQLITE_OMIT_COMPOUND_SELECT
%ifndef SQLITE_OMIT_WINDOWFUNC
  CURRENT FOLLOWING PARTITION PRECEDING RANGE UNBOUNDED
  EXCLUDE GROUPS OTHERS TIES
%endif SQLITE_OMIT_WINDOWFUNC
%ifdef SQLITE_ENABLE_ORDERED_समुच्चयः_AGGREGATES
  WITHIN
%endif SQLITE_ENABLE_ORDERED_समुच्चयः_AGGREGATES
%ifndef SQLITE_OMIT_GENERATED_COLUMNS
  GENERATED ALWAYS
%endif
  MATERIALIZED
  REINDEX RENAME CTIME_KW IF
  .
%wildcard ANY.

// Define operator precedence early so that this is the first occurrence
// of the operator tokens in the grammar.  Keeping the operators together
// causes them to be assigned integer values that are close together,
// which keeps parser tables smaller.
//
// The token values assigned to these symbols is determined by the order
// in which lemon first sees them.  It must be the case that ISNULL/NOTNULL,
// NE/EQ, GT/LE, and GE/LT are separated by only a single value.  See
// the sqlite3ExprIfFalse() routine for additional information on this
// constraint.
//
%वामतः OR.
%वामतः AND.
%दक्षिणतः NOT.
%वामतः IS मेलनम्_2 LIKE_KW BETWEEN अन्तर्_2 ISNULL NOTNULL NE EQ.
%वामतः GT LE LT GE.
%दक्षिणतः ESCAPE.
%वामतः BITAND BITOR LSHIFT RSHIFT.
%वामतः PLUS MINUS.
%वामतः तारकम् SLASH REM.
%वामतः CONCAT PTR.
%वामतः COLLATE.
%दक्षिणतः BITNOT.
%असाहचर्य ON.

// An IDENTIFIER can be a generic identifier, or one of several
// keywords.  Any non-standard keyword can also be an identifier.
//
%token_class id  ID|अनुक्रमितम्.

// And "ids" is an identifier-or-string.
//
%token_class ids  ID|STRING.

// An identifier or a join-keyword
//
%token_class idj  ID|अनुक्रमितम्|JOIN_KW.

// The name of a column or table can be any of the following:
//
%प्रकार nm {Token}
nm(A) ::= idj(A).
nm(A) ::= STRING(A).

// A typetoken is really zero or more tokens that form a type name such
// as can be found after the column name in a CREATE TABLE statement.
// Multiple tokens are concatenated to form the value of the typetoken.
//
%प्रकार typetoken {Token}
typetoken(A) ::= .   {A.n = 0; A.z = 0;}
typetoken(A) ::= typename(A).
typetoken(A) ::= typename(A) LP चिह्नित RP(Y). {
  A.n = (पूर्णाङ्क)(&Y.z[Y.n] - A.z);
}
typetoken(A) ::= typename(A) LP चिह्नित COMMA चिह्नित RP(Y). {
  A.n = (पूर्णाङ्क)(&Y.z[Y.n] - A.z);
}
%प्रकार typename {Token}
typename(A) ::= ids(A).
typename(A) ::= typename(A) ids(Y). {A.n=Y.n+(पूर्णाङ्क)(Y.z-A.z);}
चिह्नित ::= plus_अङ्कः.
चिह्नित ::= minus_अङ्कः.

// The scanpt non-terminal takes a value which is a pointer to the
// input text just past the last token that has been shifted into
// the parser.  By surrounding some phrase in the grammar with two
// scanpt non-terminals, we can capture the input text for that phrase.
// For example:
//
//      something ::= .... scanpt(A) phrase scanpt(Z).
//
// The text that is parsed as "phrase" is a string starting at A
// and containing (int)(Z-A) characters.  There might be some extra
// whitespace on either end of the text, but that can be removed in
// post-processing, if needed.
//
%प्रकार scanpt {ध्रुव वर्ण*}
scanpt(A) ::= . {
  प्रतिज्ञा( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken.z;
}
scantok(A) ::= . {
  प्रतिज्ञा( yyLookahead!=YYNOCODE );
  A = yyLookaheadToken;
}

// "carglist" is a list of additional constraints that come after the
// column name and column type in a CREATE TABLE statement.
//
carglist ::= carglist ccons.
carglist ::= .
ccons ::= CONSTRAINT nm(X). {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
ccons ::= DEFAULT scantok(A) पदांशः(X).
                            {sqlite3_सङ्कलय_Default_मानम्(pParse,X,A.z,&A.z[A.n]);}
ccons ::= DEFAULT LP(A) व्यञ्जकम्_2(X) RP(Z).
                            {sqlite3_सङ्कलय_Default_मानम्(pParse,X,A.z+1,Z.z);}
ccons ::= DEFAULT PLUS(A) scantok(Z) पदांशः(X).
                            {sqlite3_सङ्कलय_Default_मानम्(pParse,X,A.z,&Z.z[Z.n]);}
ccons ::= DEFAULT MINUS(A) scantok(Z) पदांशः(X). {
  व्यञ्जकम् *p = sqlite3PExpr(pParse, TK_UMINUS, X, 0);
  sqlite3_सङ्कलय_Default_मानम्(pParse,p,A.z,&Z.z[Z.n]);
}
ccons ::= DEFAULT scantok id(X).       {
  व्यञ्जकम् *p = token_व्यञ्जकम्(pParse, TK_STRING, X);
  यदि( p ){
    sqlite3_व्यञ्जकम्_Id_गन्तव्यम्_True_False(p);
    testcase( p->op==TK_TRUEFALSE && sqlite3_व्यञ्जकम्_Truth_मानम्(p) );
  }
    sqlite3_सङ्कलय_Default_मानम्(pParse,p,X.z,X.z+X.n);
}

// In addition to the type name, we also care about the primary key and
// UNIQUE constraints.
//
ccons ::= रिक्त onconf.
ccons ::= NOT रिक्त onconf(R).    {sqlite3_सङ्कलय_Not_Null(pParse, R);}
ccons ::= PRIMARY कुञ्चिका_2 sortorder(Z) onconf(R) autoinc(I).
                                 {sqlite3_सङ्कलय_Primary_कुञ्चिका(pParse,0,R,I,Z);}
ccons ::= UNIQUE onconf(R).      {sqlite3_Create_सूचकांक(pParse,0,0,0,0,R,0,0,0,0,
                                   SQLITE_IDXTYPE_UNIQUE);}
ccons ::= CHECK LP(A) व्यञ्जकम्_2(X) RP(B).  {sqlite3_सङ्कलय_Check_Constraint(pParse,X,A.z,B.z);}
ccons ::= REFERENCES nm(T) eidlist_opt(TA) refargs(R).
                                 {sqlite3_Create_Foreign_कुञ्चिका(pParse,0,&T,TA,R);}
ccons ::= defer_subclause(D).    {sqlite3_Defer_Foreign_कुञ्चिका(pParse,D);}
ccons ::= COLLATE ids(C).        {sqlite3_सङ्कलय_Collate_Type(pParse, &C);}
ccons ::= GENERATED ALWAYS AS generated.
ccons ::= AS generated.
generated ::= LP व्यञ्जकम्_2(E) RP.          {sqlite3_सङ्कलय_Generated(pParse,E,0);}
generated ::= LP व्यञ्जकम्_2(E) RP ID(TYPE). {sqlite3_सङ्कलय_Generated(pParse,E,&TYPE);}

// The optional AUTOINCREMENT keyword
%प्रकार autoinc {पूर्णाङ्क}
autoinc(X) ::= .          {X = 0;}
autoinc(X) ::= AUTOINCR.  {X = 1;}

// The next group of rules parses the arguments to a REFERENCES clause
// that determine if the referential integrity checking is deferred or
// or immediate and which determine what action to take if a ref-integ
// check fails.
//
%प्रकार refargs {पूर्णाङ्क}
refargs(A) ::= .                  { A = OE_None*0x0101; /* EV: R-19803-45884 */}
refargs(A) ::= refargs(A) refarg(Y). { A = (A & ~Y.आवरणम्) | Y.मानम्; }
%प्रकार refarg {संरचना {पूर्णाङ्क मानम्; पूर्णाङ्क आवरणम्;}}
refarg(A) ::= मेलनम्_2 nm.              { A.मानम् = 0;     A.आवरणम् = 0x000000; }
refarg(A) ::= ON निवेशय refact.      { A.मानम् = 0;     A.आवरणम् = 0x000000; }
refarg(A) ::= ON DELETE refact(X).   { A.मानम् = X;     A.आवरणम् = 0x0000ff; }
refarg(A) ::= ON UPDATE refact(X).   { A.मानम् = X<<8;  A.आवरणम् = 0x00ff00; }
%प्रकार refact {पूर्णाङ्क}
refact(A) ::= समुच्चयः रिक्त.              { A = OE_समुच्चयः_Null;  /* EV: R-33326-45252 */}
refact(A) ::= समुच्चयः DEFAULT.           { A = OE_समुच्चयः_Dflt;  /* EV: R-33326-45252 */}
refact(A) ::= CASCADE.               { A = OE_Cascade;  /* EV: R-33326-45252 */}
refact(A) ::= RESTRICT.              { A = OE_Restrict; /* EV: R-33326-45252 */}
refact(A) ::= NO ACTION.             { A = OE_None;     /* EV: R-33326-45252 */}
%प्रकार defer_subclause {पूर्णाङ्क}
defer_subclause(A) ::= NOT DEFERRABLE init_deferred_pred_opt.     {A = 0;}
defer_subclause(A) ::= DEFERRABLE init_deferred_pred_opt(X).      {A = X;}
%प्रकार init_deferred_pred_opt {पूर्णाङ्क}
init_deferred_pred_opt(A) ::= .                       {A = 0;}
init_deferred_pred_opt(A) ::= INITIALLY DEFERRED.     {A = 1;}
init_deferred_pred_opt(A) ::= INITIALLY तात्कालिकम्.    {A = 0;}

conslist_opt(A) ::= .                         {A.n = 0; A.z = 0;}
conslist_opt(A) ::= COMMA(A) conslist.
conslist ::= conslist tconscomma tcons.
conslist ::= tcons.
tconscomma ::= COMMA.          {ASSERT_IS_CREATE; pParse->u1.cr.constraintName.n = 0;}
tconscomma ::= .
tcons ::= CONSTRAINT nm(X).    {ASSERT_IS_CREATE; pParse->u1.cr.constraintName = X;}
tcons ::= PRIMARY कुञ्चिका_2 LP sortlist(X) autoinc(I) RP onconf(R).
                                 {sqlite3_सङ्कलय_Primary_कुञ्चिका(pParse,X,R,I,0);}
tcons ::= UNIQUE LP sortlist(X) RP onconf(R).
                                 {sqlite3_Create_सूचकांक(pParse,0,0,0,X,R,0,0,0,0,
                                       SQLITE_IDXTYPE_UNIQUE);}
tcons ::= CHECK LP(A) व्यञ्जकम्_2(E) RP(B) onconf.
                                 {sqlite3_सङ्कलय_Check_Constraint(pParse,E,A.z,B.z);}
tcons ::= FOREIGN कुञ्चिका_2 LP eidlist(FA) RP
          REFERENCES nm(T) eidlist_opt(TA) refargs(R) defer_subclause_opt(D). {
    sqlite3_Create_Foreign_कुञ्चिका(pParse, FA, &T, TA, R);
    sqlite3_Defer_Foreign_कुञ्चिका(pParse, D);
}
%प्रकार defer_subclause_opt {पूर्णाङ्क}
defer_subclause_opt(A) ::= .                    {A = 0;}
defer_subclause_opt(A) ::= defer_subclause(A).

// The following is a non-standard extension that allows us to declare the
// default behavior when there is a constraint conflict.
//
%प्रकार onconf {पूर्णाङ्क}
%प्रकार orconf {पूर्णाङ्क}
%प्रकार resolvetype {पूर्णाङ्क}
onconf(A) ::= .                              {A = OE_Default;}
onconf(A) ::= ON CONFLICT resolvetype(X).    {A = X;}
orconf(A) ::= .                              {A = OE_Default;}
orconf(A) ::= OR resolvetype(X).             {A = X;}
resolvetype(A) ::= raisetype(A).
resolvetype(A) ::= IGNORE.                   {A = OE_Ignore;}
resolvetype(A) ::= REPLACE.                  {A = OE_Replace;}

