}

// The ALTER TABLE ADD COLUMN command. This is broken into two sections so
// that sqlite3AlterBeginAddColumn() is called before parsing the various
// constraints and so on (carglist) attached to the new column definition.
cmd ::= alter_جوڙيو(Y) carglist. {
  Y.n = (صحيح)(pParse->s_آخري_Token.z-Y.z) + pParse->s_آخري_Token.n;
  sqlite3_Alter_پڄاڻي_جوڙيو_ڪالم(pParse, &Y);
}
alter_جوڙيو(A) ::= ALTER جدول_3 fullname(X) جوڙيو kwcolumn_opt nm(Y) typetoken(Z). {
  disableLookaside(pParse);
  sqlite3_Alter_Begin_جوڙيو_ڪالم(pParse, X);
  sqlite3_جوڙيو_ڪالم(pParse, Y, Z);
  A = Y;
}

cmd ::= ALTER جدول_3 fullname(X) DROP kwcolumn_opt nm(Y). {
  sqlite3_Alter_Drop_ڪالم(pParse, X, &Y);
}
cmd ::= ALTER جدول_3 fullname(X) RENAME kwcolumn_opt nm(Y) منزل_2 nm(Z). {
  sqlite3_Alter_Rename_ڪالم(pParse, X, &Y, &Z);
}
cmd ::= ALTER جدول_3 fullname(X) DROP CONSTRAINT nm(Y). {
  sqlite3AlterDropConstraint(pParse, X, &Y, 0);
}
cmd ::= ALTER جدول_3 fullname(X) ALTER kwcolumn_opt nm(Y) DROP NOT عدم. {
  sqlite3AlterDropConstraint(pParse, X, 0, &Y);
}
cmd ::= ALTER جدول_3 fullname(X) ALTER kwcolumn_opt nm(Y) سيٽ NOT(Z) عدم onconf. {
  sqlite3_Alter_سيٽ_Not_Null(pParse, X, &Y, &Z);
}
cmd ::= ALTER جدول_3 fullname(X) جوڙيو CONSTRAINT(Y) nm(Z) CHECK LP(A) اظهار_2(E) RP(B) onconf. {
  sqlite3_Alter_جوڙيو_Constraint(pParse, X, &Y, &Z, A.z+1, (B.z-A.z-1), E);
}
cmd ::= ALTER جدول_3 fullname(X) جوڙيو CHECK(Y) LP(A) اظهار_2(E) RP(B) onconf. {
  sqlite3_Alter_جوڙيو_Constraint(pParse, X, &Y, 0, A.z+1, (B.z-A.z-1), E);
}

kwcolumn_opt ::= .
kwcolumn_opt ::= COLUMNKW.

%endif SQLITE_OMIT_VIRTUALTABLE
%endif SQLITE_OMIT_ALTERTABLE

//////////////////////// CREATE VIRTUAL TABLE ... /////////////////////////////
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= create_vtab.                       {sqlite3_Vtab_پڄاڻي_Parse(pParse,0);}
cmd ::= create_vtab LP vtabarglist RP(X).  {sqlite3_Vtab_پڄاڻي_Parse(pParse,&X);}
create_vtab ::= createkw VIRTUAL جدول_3 ifnotexists(E)
                nm(X) dbnm(Y) USING nm(Z). {
    sqlite3VtabBeginParse(pParse, &X, &Y, &Z, E);
}
vtabarglist ::= vtabarg.
vtabarglist ::= vtabarglist COMMA vtabarg.
vtabarg ::= .                       {sqlite3VtabArgInit(pParse);}
vtabarg ::= vtabarg vtabargtoken.
vtabargtoken ::= ANY(X).            {sqlite3VtabArgExtend(pParse,&X);}
vtabargtoken ::= lp anylist RP(X).  {sqlite3VtabArgExtend(pParse,&X);}
lp ::= LP(X).                       {sqlite3VtabArgExtend(pParse,&X);}
anylist ::= .
anylist ::= anylist LP anylist RP.
anylist ::= anylist ANY.
%endif  SQLITE_OMIT_VIRTUALTABLE


//////////////////////// COMMON TABLE EXPRESSIONS ////////////////////////////
%نوع wqlist {With*}
%destructor wqlist {sqlite3WithDelete(pParse->db, $$);}
%نوع wqitem {Cte*}
// %destructor wqitem {sqlite3CteDelete(pParse->db, $$);} // not reachable

with ::= .
%ifndef SQLITE_OMIT_CTE
with ::= WITH wqlist(W).              { sqlite3_With_ڌڪو(pParse, W, 1); }
with ::= WITH RECURSIVE wqlist(W).    { sqlite3_With_ڌڪو(pParse, W, 1); }

%نوع wqas {u8}
wqas(A)   ::= AS.                  {A = M10d_Any;}
wqas(A)   ::= AS MATERIALIZED.     {A = M10d_Yes;}
wqas(A)   ::= AS NOT MATERIALIZED. {A = M10d_No;}
wqitem(A) ::= withnm(X) eidlist_opt(Y) wqas(M) LP select(Z) RP. {
  A = sqlite3CteNew(pParse, &X, Y, Z, M); /*A-overwrites-X*/
}
withnm(A) ::= nm(A). {pParse->bHasWith = 1;}
wqlist(A) ::= wqitem(X). {
  A = sqlite3_With_جوڙيو(pParse, 0, X); /*A-overwrites-X*/
}
wqlist(A) ::= wqlist(A) COMMA wqitem(X). {
  A = sqlite3_With_جوڙيو(pParse, A, X);
}
%endif  SQLITE_OMIT_CTE

//////////////////////// WINDOW FUNCTION EXPRESSIONS /////////////////////////
// These must be at the end of this file. Specifically, the rules that
// introduce tokens WINDOW, OVER and FILTER must appear last. This causes 
// the integer values assigned to these tokens to be larger than all other 
// tokens that may be output by the tokenizer except TK_SPACE, TK_COMMENT,
// and TK_ILLEGAL.
//
%ifndef SQLITE_OMIT_WINDOWFUNC
%نوع windowdefn_list {دري*}
%destructor windowdefn_list {sqlite3_دري_List_Delete(pParse->db, $$);}
windowdefn_list(A) ::= windowdefn(A).
windowdefn_list(A) ::= windowdefn_list(Y) COMMA windowdefn(Z). {
  أكد( Z!=0 );
  sqlite3_دري_Chain(pParse, Z, Y);
  Z->p_ايندڙ_Win = Y;
  A = Z;
}

%نوع windowdefn {دري*}
%destructor windowdefn {sqlite3_دري_Delete(pParse->db, $$);}
windowdefn(A) ::= nm(X) AS LP دري_2(Y) RP. {
  إذا( ALWAYS(Y) ){
    Y->zName = sqlite3DbStrNDup(pParse->db, X.z, X.n);
  }
  A = Y;
}

%نوع دري_2 {دري*}
%destructor دري_2 {sqlite3_دري_Delete(pParse->db, $$);}

%نوع چوکٺو_opt {دري*}
%destructor چوکٺو_opt {sqlite3_دري_Delete(pParse->db, $$);}

%نوع part_opt {اظهار_List*}
%destructor part_opt {sqlite3_اظهار_List_Delete(pParse->db, $$);}

%نوع filter_clause {اظهار*}
%destructor filter_clause {sqlite3_اظهار_Delete(pParse->db, $$);}

%نوع over_clause {دري*}
%destructor over_clause {sqlite3_دري_Delete(pParse->db, $$);}

%نوع filter_over {دري*}
%destructor filter_over {sqlite3_دري_Delete(pParse->db, $$);}

%نوع range_or_صفون {صحيح}

%نوع چوکٺو_bound {بنية چوکٺو_Bound}
%destructor چوکٺو_bound {sqlite3_اظهار_Delete(pParse->db, $$.p_اظهار);}
%نوع چوکٺو_bound_s {بنية چوکٺو_Bound}
%destructor چوکٺو_bound_s {sqlite3_اظهار_Delete(pParse->db, $$.p_اظهار);}
%نوع چوکٺو_bound_e {بنية چوکٺو_Bound}
%destructor چوکٺو_bound_e {sqlite3_اظهار_Delete(pParse->db, $$.p_اظهار);}

دري_2(A) ::= حصا_ڪريو BY nexprlist(X) orderby_opt(Y) چوکٺو_opt(Z). {
  A = sqlite3_دري_Assemble(pParse, Z, X, Y, 0);
}
دري_2(A) ::= nm(W) حصا_ڪريو BY nexprlist(X) orderby_opt(Y) چوکٺو_opt(Z). {
  A = sqlite3_دري_Assemble(pParse, Z, X, Y, &W);
}
دري_2(A) ::= ترتيب BY sortlist(Y) چوکٺو_opt(Z). {
  A = sqlite3_دري_Assemble(pParse, Z, 0, Y, 0);
}
دري_2(A) ::= nm(W) ترتيب BY sortlist(Y) چوکٺو_opt(Z). {
  A = sqlite3_دري_Assemble(pParse, Z, 0, Y, &W);
}
دري_2(A) ::= چوکٺو_opt(A).
دري_2(A) ::= nm(W) چوکٺو_opt(Z). {
  A = sqlite3_دري_Assemble(pParse, Z, 0, 0, &W);
}

چوکٺو_opt(A) ::= .                             { 
  A = sqlite3_دري_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
چوکٺو_opt(A) ::= range_or_صفون(X) چوکٺو_bound_s(Y) چوکٺو_exclude_opt(Z). { 
  A = sqlite3_دري_Alloc(pParse, X, Y.eType, Y.p_اظهار, TK_CURRENT, 0, Z);
}
چوکٺو_opt(A) ::= range_or_صفون(X) BETWEEN چوکٺو_bound_s(Y) AND
                          چوکٺو_bound_e(Z) چوکٺو_exclude_opt(W). { 
  A = sqlite3_دري_Alloc(pParse, X, Y.eType, Y.p_اظهار, Z.eType, Z.p_اظهار, W);
}

range_or_صفون(A) ::= RANGE|صفون|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

چوکٺو_bound_s(A) ::= چوکٺو_bound(X).         {A = X;}
چوکٺو_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_اظهار = 0;}
چوکٺو_bound_e(A) ::= چوکٺو_bound(X).         {A = X;}
چوکٺو_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_اظهار = 0;}

چوکٺو_bound(A) ::= اظهار_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_اظهار = X;}
چوکٺو_bound(A) ::= CURRENT(X) صف.           {A.eType = @X; A.p_اظهار = 0;}

%نوع چوکٺو_exclude_opt {u8}
چوکٺو_exclude_opt(A) ::= . {A = 0;}
چوکٺو_exclude_opt(A) ::= EXCLUDE چوکٺو_exclude(X). {A = X;}

%نوع چوکٺو_exclude {u8}
چوکٺو_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
چوکٺو_exclude(A) ::= CURRENT(X) صف. {A = @X; /*A-overwrites-X*/}
چوکٺو_exclude(A) ::= گروهه|TIES(X).  {A = @X; /*A-overwrites-X*/}


%نوع دري_clause {دري*}
%destructor دري_clause {sqlite3_دري_List_Delete(pParse->db, $$);}
دري_clause(A) ::= دري_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  إذا( O ){
    O->pFilter = F;
  }وإلا{
    sqlite3_اظهار_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (دري*)sqlite3DbMallocZero(pParse->db, حجم(دري));
  إذا( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }وإلا{
    sqlite3_اظهار_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP دري_2(Z) RP. {
  A = Z;
  أكد( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (دري*)sqlite3DbMallocZero(pParse->db, حجم(دري));
  إذا( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE اظهار_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%token
  ڪالم_2          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_ڪالم      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  رجسٽر        /* Reference to a VDBE register */
  ويڪٽر          /*ويڪٽر*/
  SELECT_ڪالم   /* Choose a single column from a multi-column SELECT */
  IF_NULL_صف     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  وسعت            /* The span operator */
  ERROR           /* An expression containing an error */
.

رڪن(A) ::= QNUMBER(X). {
  A=token_اظهار(pParse,@X,X);
  sqlite3_Dequote_عدد(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#إذا TK_وسعت>255
# error too many ٽوڪن in the grammar
#جيڪڏهن_پورو
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%token SPACE COMMENT ILLEGAL.
