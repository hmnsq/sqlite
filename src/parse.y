%రకం సమాసం_2 {సమాసం*}
%destructor సమాసం_2 {sqlite3_సమాసం_Delete(pParse->db, $$);}
%రకం పదం {సమాసం*}
%destructor పదం {sqlite3_సమాసం_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  స్థిర సమాసం *token_సమాసం(Parse *pParse, పూర్ణాంకం op, Token t){
    సమాసం *p = sqlite3DbMallocRawNN(pParse->db, పరిమాణం(సమాసం)+t.n+1);
    ఒకవేళ( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_సమాసం = 0;
      p->flags = EP_ఆకు;
      సమాసం_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_ఎడమ = p->p_కుడి = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, పరిమాణం(p->x));
      memset(&p->y, 0, పరిమాణం(p->y));
      p->op2 = 0;
      p->i_పట్టిక = 0;
      p->i_స్తంభం = 0;
      p->u.zToken = (అక్షరం*)&p[1];
      జ్ఞాపకం_నకలు(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (పూర్ణాంకం)(t.z - pParse->z_తోక);
      ఒకవేళ( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_సమాసం(p);
      }
#ఒకవేళ SQLITE_MAX_సమాసం_లోతు>0
      p->n_ఎత్తు = 1;
#అయితే_ముగింపు  
      ఒకవేళ( లోపల_RENAME_OBJECT ){
        తిరిగి (సమాసం*)sqlite3RenameTokenMap(pParse, (శూన్య*)p, &t);
      }
    }
    తిరిగి p;
  }

}

సమాసం_2(A) ::= పదం(A).
సమాసం_2(A) ::= LP సమాసం_2(X) RP. {A = X;}
సమాసం_2(A) ::= idj(X).          {A=token_సమాసం(pParse,TK_ID,X); /*A-overwrites-X*/}
సమాసం_2(A) ::= nm(X) DOT nm(Y). {
  సమాసం *temp1 = token_సమాసం(pParse,TK_ID,X);
  సమాసం *temp2 = token_సమాసం(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
సమాసం_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  సమాసం *temp1 = token_సమాసం(pParse,TK_ID,X);
  సమాసం *temp2 = token_సమాసం(pParse,TK_ID,Y);
  సమాసం *temp3 = token_సమాసం(pParse,TK_ID,Z);
  సమాసం *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  ఒకవేళ( లోపల_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
పదం(A) ::= ఖాళీ|FLOAT|BLOB(X). {A=token_సమాసం(pParse,@X,X); /*A-overwrites-X*/}
పదం(A) ::= STRING(X).          {A=token_సమాసం(pParse,@X,X); /*A-overwrites-X*/}
పదం(A) ::= INTEGER(X). {
  పూర్ణాంకం i_విలువ;
  ఒకవేళ( sqlite3GetInt32(X.z, &i_విలువ)==0 ){
    A = sqlite3_సమాసం_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }లేకపోతే{
    A = sqlite3_సమాసం_Int32(pParse->db, i_విలువ);
  }
  ఒకవేళ( A ) A->w.iOfst = (పూర్ణాంకం)(X.z - pParse->z_తోక);
}
సమాసం_2(A) ::= VARIABLE(X).     {
  ఒకవేళ( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_సమాసం(pParse, TK_VARIABLE, X);
    sqlite3_సమాసం_కేటాయించు_Var_సంఖ్య(pParse, A, n);
  }లేకపోతే{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    ప్రతిజ్ఞా( t.n>=2 );
    ఒకవేళ( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }లేకపోతే{
      A = sqlite3PExpr(pParse, TK_రిజిస్టరు, 0, 0);
      ఒకవేళ( A ) sqlite3GetInt32(&t.z[1], &A->i_పట్టిక);
    }
  }
}
సమాసం_2(A) ::= సమాసం_2(A) COLLATE ids(C). {
