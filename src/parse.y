  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, pList, D);
  A = sqlite3_ਵਿਅੰਜਕ_Function(pParse, pList, &C, 0);
}

%ਕਿਸਮ between_op {ਪੂਰਨ}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) between_op(N) ਵਿਅੰਜਕ_2(X) AND ਵਿਅੰਜਕ_2(Y). [BETWEEN] {
  ਵਿਅੰਜਕ_List *pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,0, X);
  pList = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  ਜੇ( A ){
    A->x.pList = pList;
    sqlite3_ਵਿਅੰਜਕ_ਸੈੱਟ_ਉਚਾਈ_And_Flags(pParse, A);
  }ਨਹੀਂਤਾਂ{
    sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, pList);
  } 
  ਜੇ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %ਕਿਸਮ ਵਿੱਚ_op {ਪੂਰਨ}
  ਵਿੱਚ_op(A) ::= ਵਿੱਚ_2.      {A = 0;}
  ਵਿੱਚ_op(A) ::= NOT ਵਿੱਚ_2.  {A = 1;}
  ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) ਵਿੱਚ_op(N) LP exprlist(Y) RP. [IN] {
    ਜੇ( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      ਵਿਅੰਜਕ *pB = sqlite3_ਵਿਅੰਜਕ(pParse->db, TK_STRING, N ? "true" : "false");
      ਜੇ( pB ) sqlite3_ਵਿਅੰਜਕ_Id_ਮੰਜ਼ਿਲ_True_False(pB);
      ਜੇ( !ਵਿਅੰਜਕ_Has_Property(A, EP_HasFunc) ){
        sqlite3_ਵਿਅੰਜਕ_Unmap_And_Delete(pParse, A);
        A = pB;
      }ਨਹੀਂਤਾਂ{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }ਨਹੀਂਤਾਂ{
      ਵਿਅੰਜਕ *pRHS = Y->a[0].p_ਵਿਅੰਜਕ;
      ਜੇ( Y->n_ਵਿਅੰਜਕ==1
       && sqlite3_ਵਿਅੰਜਕ_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_ਸਦਿਸ਼
      ){
        Y->a[0].p_ਵਿਅੰਜਕ = 0;
        sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }ਨਹੀਂਤਾਂ ਜੇ( Y->n_ਵਿਅੰਜਕ==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_ਵਿੱਚ, A, 0);
        sqlite3_PExpr_ਜੋੜੋ_Select(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, Y);
      }ਨਹੀਂਤਾਂ{
        A = sqlite3PExpr(pParse, TK_ਵਿੱਚ, A, 0);
        ਜੇ( A==0 ){
          sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, Y);
        }ਨਹੀਂਤਾਂ ਜੇ( A->p_ਖੱਬਾ->op==TK_ਸਦਿਸ਼ ){
          ਪੂਰਨ n_ਵਿਅੰਜਕ = A->p_ਖੱਬਾ->x.pList->n_ਵਿਅੰਜਕ;
          Select *pSelectRHS = sqlite3_ਵਿਅੰਜਕ_List_ਮੰਜ਼ਿਲ_ਮੁੱਲਾਂ(pParse, n_ਵਿਅੰਜਕ, Y);
          ਜੇ( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3_PExpr_ਜੋੜੋ_Select(pParse, A, pSelectRHS);
          }
        }ਨਹੀਂਤਾਂ{
          A->x.pList = Y;
          sqlite3_ਵਿਅੰਜਕ_ਸੈੱਟ_ਉਚਾਈ_And_Flags(pParse, A);
        }
      }
      ਜੇ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  ਵਿਅੰਜਕ_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3_PExpr_ਜੋੜੋ_Select(pParse, A, X);
  }
  ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) ਵਿੱਚ_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_ਵਿੱਚ, A, 0);
    sqlite3_PExpr_ਜੋੜੋ_Select(pParse, A, Y);
    ਜੇ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(A) ਵਿੱਚ_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    ਜੇ( E )  sqlite3_Src_List_Func_ਦਲੀਲਾਂ(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_ਵਿੱਚ, A, 0);
    sqlite3_PExpr_ਜੋੜੋ_Select(pParse, A, pSelect);
    ਜੇ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  ਵਿਅੰਜਕ_2(A) ::= EXISTS LP select(Y) RP. {
    ਵਿਅੰਜਕ *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_ਜੋੜੋ_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
ਵਿਅੰਜਕ_2(A) ::= CASE case_ਸੰਕਾਰਜ(X) case_exprlist(Y) case_else(Z) ਸਿਰਾ. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  ਜੇ( A ){
    A->x.pList = Z ? sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,Y,Z) : Y;
    sqlite3_ਵਿਅੰਜਕ_ਸੈੱਟ_ਉਚਾਈ_And_Flags(pParse, A);
  }ਨਹੀਂਤਾਂ{
    sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, Y);
    sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, Z);
  }
}
%ਕਿਸਮ case_exprlist {ਵਿਅੰਜਕ_List*}
%destructor case_exprlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN ਵਿਅੰਜਕ_2(Y) THEN ਵਿਅੰਜਕ_2(Z). {
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,A, Y);
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN ਵਿਅੰਜਕ_2(Y) THEN ਵਿਅੰਜਕ_2(Z). {
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,0, Y);
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,A, Z);
}
%ਕਿਸਮ case_else {ਵਿਅੰਜਕ*}
%destructor case_else {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE ਵਿਅੰਜਕ_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%ਕਿਸਮ case_ਸੰਕਾਰਜ {ਵਿਅੰਜਕ*}
%destructor case_ਸੰਕਾਰਜ {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
case_ਸੰਕਾਰਜ(A) ::= ਵਿਅੰਜਕ_2(A).
case_ਸੰਕਾਰਜ(A) ::= .                   {A = 0;} 

%ਕਿਸਮ exprlist {ਵਿਅੰਜਕ_List*}
%destructor exprlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
%ਕਿਸਮ nexprlist {ਵਿਅੰਜਕ_List*}
%destructor nexprlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA ਵਿਅੰਜਕ_2(Y).
    {A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,A,Y);}
nexprlist(A) ::= ਵਿਅੰਜਕ_2(Y).
    {A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%ਕਿਸਮ paren_exprlist {ਵਿਅੰਜਕ_List*}
%destructor paren_exprlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
%endif SQLITE_OMIT_SUBQUERY


///////////////////////////// The CREATE INDEX command ///////////////////////
//
cmd ::= createkw(S) uniqueflag(U) ਸੂਚਕਾਂਕ_2 ifnotexists(NE) nm(X) dbnm(D)
        ON nm(Y) LP sortlist(Z) RP where_opt(W). {
  sqlite3_Create_ਸੂਚਕਾਂਕ(pParse, &X, &D, 
                     sqlite3SrcListAppend(pParse,0,&Y,0), Z, U,
                      &S, W, SQLITE_SO_ASC, NE, SQLITE_IDXTYPE_APPDEF);
  ਜੇ( ਵਿੱਚ_RENAME_OBJECT && pParse->p_New_ਸੂਚਕਾਂਕ ){
    sqlite3RenameTokenMap(pParse, pParse->p_New_ਸੂਚਕਾਂਕ->zName, &Y);
  }
}

%ਕਿਸਮ uniqueflag {ਪੂਰਨ}
uniqueflag(A) ::= UNIQUE.  {A = OE_Abort;}
uniqueflag(A) ::= .        {A = OE_None;}


// The eidlist non-terminal (Expression Id List) generates an ExprList
// from a list of identifiers.  The identifier names are in ExprList.a[].zName.
// This list is stored in an ExprList rather than an IdList so that it
// can be easily sent to sqlite3ColumnsExprList().
//
// eidlist is grouped with CREATE INDEX because it used to be the non-terminal
// used for the arguments to an index.  That is just an historical accident.
//
// IMPORTANT COMPATIBILITY NOTE:  Some prior versions of SQLite accepted
// COLLATE clauses and ASC or DESC keywords on ID lists in inappropriate
// places - places that might have been stored in the sqlite_schema table.
// Those extra features were ignored.  But because they might be in some
// (busted) old databases, we need to continue parsing them when loading
// historical schemas.
//
%ਕਿਸਮ eidlist {ਵਿਅੰਜਕ_List*}
%destructor eidlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}
%ਕਿਸਮ eidlist_opt {ਵਿਅੰਜਕ_List*}
%destructor eidlist_opt {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}

%include {
  /* Add a single new term to an ExprList that is used to store a
  ** list of identifiers.  Report an error if the ID list contains
  ** a COLLATE clause or an ASC or DESC keyword, except ignore the
  ** error while parsing a legacy schema.
  */
  ਸਥਿਰ ਵਿਅੰਜਕ_List *parser_ਜੋੜੋ_ਵਿਅੰਜਕ_Id_List_ਪਦ(
    Parse *pParse,
    ਵਿਅੰਜਕ_List *p_ਪੂਰਵ,
    Token *pIdToken,
    ਪੂਰਨ hasCollate,
    ਪੂਰਨ ਛਾਂਟੋ_ਕ੍ਰਮ
  ){
    ਵਿਅੰਜਕ_List *p = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, p_ਪੂਰਵ, 0);
    ਜੇ( (hasCollate || ਛਾਂਟੋ_ਕ੍ਰਮ!=SQLITE_SO_UNDEFINED)
        && pParse->db->init.busy==0
    ){
      sqlite3_Error_ਸੁਨੇਹਾ(pParse, "syntax error after column name \"%.*s\"",
                         pIdToken->n, pIdToken->z);
    }
    sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_Name(pParse, p, pIdToken, 1);
    ਵਾਪਸ p;
  }
} // end %include

eidlist_opt(A) ::= .                         {A = 0;}
eidlist_opt(A) ::= LP eidlist(X) RP.         {A = X;}
eidlist(A) ::= eidlist(A) COMMA nm(Y) collate(C) sortorder(Z).  {
  A = parser_ਜੋੜੋ_ਵਿਅੰਜਕ_Id_List_ਪਦ(pParse, A, &Y, C, Z);
}
eidlist(A) ::= nm(Y) collate(C) sortorder(Z). {
  A = parser_ਜੋੜੋ_ਵਿਅੰਜਕ_Id_List_ਪਦ(pParse, 0, &Y, C, Z); /*A-overwrites-Y*/
}

%ਕਿਸਮ collate {ਪੂਰਨ}
collate(C) ::= .              {C = 0;}
collate(C) ::= COLLATE ids.   {C = 1;}


///////////////////////////// The DROP INDEX command /////////////////////////
//
cmd ::= DROP ਸੂਚਕਾਂਕ_2 ifexists(E) fullname(X).   {sqlite3_Drop_ਸੂਚਕਾਂਕ(pParse, X, E);}

///////////////////////////// The VACUUM command /////////////////////////////
//
%ਜੇ !SQLITE_OMIT_VACUUM && !SQLITE_OMIT_ATTACH
%ਕਿਸਮ vinto {ਵਿਅੰਜਕ*}
%destructor vinto {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
cmd ::= VACUUM vinto(Y).                {sqlite3Vacuum(pParse,0,Y);}
cmd ::= VACUUM nm(X) vinto(Y).          {sqlite3Vacuum(pParse,&X,Y);}
vinto(A) ::= INTO ਵਿਅੰਜਕ_2(X).              {A = X;}
vinto(A) ::= .                          {A = 0;}
%endif

///////////////////////////// The PRAGMA command /////////////////////////////
//
%ifndef SQLITE_OMIT_PRAGMA
cmd ::= PRAGMA nm(X) dbnm(Z).                {sqlite3Pragma(pParse,&X,&Z,0,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ nmnum(Y).    {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP nmnum(Y) RP. {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ minus_ਅੰਕ(Y). 
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP minus_ਅੰਕ(Y) RP.
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_ਅੰਕ(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class ਸੰਖਿਆ INTEGER|FLOAT.
plus_ਅੰਕ(A) ::= PLUS ਸੰਖਿਆ(X).       {A = X;}
plus_ਅੰਕ(A) ::= ਸੰਖਿਆ(A).
minus_ਅੰਕ(A) ::= MINUS ਸੰਖਿਆ(X).     {A = X;}
//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) ਸਿਰਾ(Z). {
  Token all;
  all.z = A.z;
  all.n = (ਪੂਰਨ)(Z.z - A.z) + Z.n;
  sqlite3_ਅੰਤ_Trigger(pParse, S, &all);
}

trigger_decl(A) ::= ਆਰਜ਼ੀ(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_ਸਮਾਂ(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#ਜੇ_ਪਰਿਭਾਸ਼ਿਤ SQLITE_DEBUG
  ਪ੍ਰਤਿਜ੍ਞਾ( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#ਜੇ_ਅੰਤ
}

%ਕਿਸਮ trigger_ਸਮਾਂ {ਪੂਰਨ}
trigger_ਸਮਾਂ(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_ਸਮਾਂ(A) ::= INSTEAD ਦਾ_2.  { A = TK_INSTEAD;}
trigger_ਸਮਾਂ(A) ::= .            { A = TK_BEFORE; }

%ਕਿਸਮ trigger_event {ਬਣਤਰ TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|ਪਾਓ(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE ਦਾ_2 idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH ਪੰਕਤੀ.

%ਕਿਸਮ when_clause {ਵਿਅੰਜਕ*}
%destructor when_clause {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN ਵਿਅੰਜਕ_2(X). { A = X; }

%ਕਿਸਮ trigger_cmd_list {Trigger_ਕਦਮ*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_ਕਦਮ(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_ਆਖਰੀ->p_ਅਗਲਾ = X;
  A->p_ਆਖਰੀ = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->p_ਆਖਰੀ = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= ਸੂਚਕਾਂਕਿਤ BY nm. {
  sqlite3_Error_ਸੁਨੇਹਾ(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT ਸੂਚਕਾਂਕਿਤ. {
  sqlite3_Error_ਸੁਨੇਹਾ(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%ਕਿਸਮ trigger_cmd {Trigger_ਕਦਮ*}
%destructor trigger_cmd {sqlite3_Delete_Trigger_ਕਦਮ(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby ਸੈੱਟ setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3_Trigger_Update_ਕਦਮ(pParse, X, F, Y, Z, R, B.z, E);}

//ਪਾਓ
trigger_cmd(A) ::= scanpt(B) ਪਾਓ_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_ਪਾਓ_ਕਦਮ(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3_Trigger_Delete_ਕਦਮ(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3_Trigger_Select_ਕਦਮ(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
ਵਿਅੰਜਕ_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  ਜੇ( A ){
    A->aff_ਵਿਅੰਜਕ = OE_Ignore;
  }
}
ਵਿਅੰਜਕ_2(A) ::= RAISE LP raisetype(T) COMMA ਵਿਅੰਜਕ_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  ਜੇ( A ) {
    A->aff_ਵਿਅੰਜਕ = (ਅੱਖਰ)T;
  }
}
%endif  !SQLITE_OMIT_TRIGGER

%ਕਿਸਮ raisetype {ਪੂਰਨ}
raisetype(A) ::= ROLLBACK.  {A = OE_Rollback;}
raisetype(A) ::= ABORT.     {A = OE_Abort;}
raisetype(A) ::= FAIL.      {A = OE_Fail;}


////////////////////////  DROP TRIGGER statement //////////////////////////////
%ifndef SQLITE_OMIT_TRIGGER
cmd ::= DROP TRIGGER ifexists(NOERR) fullname(X). {
  sqlite3DropTrigger(pParse,X,NOERR);
}
%endif  !SQLITE_OMIT_TRIGGER

//////////////////////// ATTACH DATABASE file AS name /////////////////////////
%ifndef SQLITE_OMIT_ATTACH
cmd ::= ATTACH database_kw_opt ਵਿਅੰਜਕ_2(F) AS ਵਿਅੰਜਕ_2(D) ਕੁੰਜੀ_opt(K). {
  sqlite3Attach(pParse, F, D, K);
}
cmd ::= DETACH database_kw_opt ਵਿਅੰਜਕ_2(D). {
  sqlite3Detach(pParse, D);
}

%ਕਿਸਮ ਕੁੰਜੀ_opt {ਵਿਅੰਜਕ*}
%destructor ਕੁੰਜੀ_opt {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
ਕੁੰਜੀ_opt(A) ::= .                     { A = 0; }
ਕੁੰਜੀ_opt(A) ::= ਕੁੰਜੀ_2 ਵਿਅੰਜਕ_2(X).          { A = X; }

database_kw_opt ::= DATABASE.
database_kw_opt ::= .
%endif SQLITE_OMIT_ATTACH

////////////////////////// REINDEX collation //////////////////////////////////
%ifndef SQLITE_OMIT_REINDEX
cmd ::= REINDEX.                {sqlite3Reindex(pParse, 0, 0);}
cmd ::= REINDEX nm(X) dbnm(Y).  {sqlite3Reindex(pParse, &X, &Y);}
%endif  SQLITE_OMIT_REINDEX

/////////////////////////////////// ANALYZE ///////////////////////////////////
%ifndef SQLITE_OMIT_ANALYZE
cmd ::= ANALYZE.                {sqlite3Analyze(pParse, 0, 0);}
cmd ::= ANALYZE nm(X) dbnm(Y).  {sqlite3Analyze(pParse, &X, &Y);}
%endif

//////////////////////// ALTER TABLE table ... ////////////////////////////////
%ifndef SQLITE_OMIT_ALTERTABLE 
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) RENAME ਮੰਜ਼ਿਲ_2 nm(Z). {
  sqlite3_Alter_Rename_ਸਾਰਣੀ(pParse,X,&Z);
}

// The ALTER TABLE ADD COLUMN command. This is broken into two sections so
// that sqlite3AlterBeginAddColumn() is called before parsing the various
// constraints and so on (carglist) attached to the new column definition.
cmd ::= alter_ਜੋੜੋ(Y) carglist. {
  Y.n = (ਪੂਰਨ)(pParse->s_ਆਖਰੀ_Token.z-Y.z) + pParse->s_ਆਖਰੀ_Token.n;
  sqlite3_Alter_ਅੰਤ_ਜੋੜੋ_ਕਾਲਮ(pParse, &Y);
}
alter_ਜੋੜੋ(A) ::= ALTER ਸਾਰਣੀ_3 fullname(X) ਜੋੜੋ kwcolumn_opt nm(Y) typetoken(Z). {
  disableLookaside(pParse);
  sqlite3_Alter_Begin_ਜੋੜੋ_ਕਾਲਮ(pParse, X);
  sqlite3_ਜੋੜੋ_ਕਾਲਮ(pParse, Y, Z);
  A = Y;
}

cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) DROP kwcolumn_opt nm(Y). {
  sqlite3_Alter_Drop_ਕਾਲਮ(pParse, X, &Y);
}
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) RENAME kwcolumn_opt nm(Y) ਮੰਜ਼ਿਲ_2 nm(Z). {
  sqlite3_Alter_Rename_ਕਾਲਮ(pParse, X, &Y, &Z);
}
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) DROP CONSTRAINT nm(Y). {
  sqlite3AlterDropConstraint(pParse, X, &Y, 0);
}
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) ALTER kwcolumn_opt nm(Y) DROP NOT ਨਿਰਾ. {
  sqlite3AlterDropConstraint(pParse, X, 0, &Y);
}
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) ALTER kwcolumn_opt nm(Y) ਸੈੱਟ NOT(Z) ਨਿਰਾ onconf. {
  sqlite3_Alter_ਸੈੱਟ_Not_Null(pParse, X, &Y, &Z);
}
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) ਜੋੜੋ CONSTRAINT(Y) nm(Z) CHECK LP(A) ਵਿਅੰਜਕ_2(E) RP(B) onconf. {
  sqlite3_Alter_ਜੋੜੋ_Constraint(pParse, X, &Y, &Z, A.z+1, (B.z-A.z-1), E);
}
cmd ::= ALTER ਸਾਰਣੀ_3 fullname(X) ਜੋੜੋ CHECK(Y) LP(A) ਵਿਅੰਜਕ_2(E) RP(B) onconf. {
  sqlite3_Alter_ਜੋੜੋ_Constraint(pParse, X, &Y, 0, A.z+1, (B.z-A.z-1), E);
}

kwcolumn_opt ::= .
kwcolumn_opt ::= COLUMNKW.

%endif SQLITE_OMIT_VIRTUALTABLE
%endif SQLITE_OMIT_ALTERTABLE

//////////////////////// CREATE VIRTUAL TABLE ... /////////////////////////////
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= create_vtab.                       {sqlite3_Vtab_ਅੰਤ_Parse(pParse,0);}
cmd ::= create_vtab LP vtabarglist RP(X).  {sqlite3_Vtab_ਅੰਤ_Parse(pParse,&X);}
create_vtab ::= createkw VIRTUAL ਸਾਰਣੀ_3 ifnotexists(E)
                nm(X) dbnm(Y) USING nm(Z). {
    sqlite3VtabBeginParse(pParse, &X, &Y, &Z, E);
}
vtabarglist ::= vtabarg.
vtabarglist ::= vtabarglist COMMA vtabarg.
vtabarg ::= .                       {sqlite3VtabArgInit(pParse);}
vtabarg ::= vtabarg vtabargtoken.
vtabargtoken ::= ANY(X).            {sqlite3VtabArgExtend(pParse,&X);}
vtabargtoken ::= lp anylist RP(X).  {sqlite3VtabArgExtend(pParse,&X);}
lp ::= LP(X).                       {sqlite3VtabArgExtend(pParse,&X);}
anylist ::= .
anylist ::= anylist LP anylist RP.
anylist ::= anylist ANY.
%endif  SQLITE_OMIT_VIRTUALTABLE


//////////////////////// COMMON TABLE EXPRESSIONS ////////////////////////////
%ਕਿਸਮ wqlist {With*}
%destructor wqlist {sqlite3WithDelete(pParse->db, $$);}
%ਕਿਸਮ wqitem {Cte*}
// %destructor wqitem {sqlite3CteDelete(pParse->db, $$);} // not reachable

with ::= .
%ifndef SQLITE_OMIT_CTE
with ::= WITH wqlist(W).              { sqlite3_With_ਧੱਕੋ(pParse, W, 1); }
with ::= WITH RECURSIVE wqlist(W).    { sqlite3_With_ਧੱਕੋ(pParse, W, 1); }

%ਕਿਸਮ wqas {u8}
wqas(A)   ::= AS.                  {A = M10d_Any;}
wqas(A)   ::= AS MATERIALIZED.     {A = M10d_Yes;}
wqas(A)   ::= AS NOT MATERIALIZED. {A = M10d_No;}
wqitem(A) ::= withnm(X) eidlist_opt(Y) wqas(M) LP select(Z) RP. {
  A = sqlite3CteNew(pParse, &X, Y, Z, M); /*A-overwrites-X*/
}
withnm(A) ::= nm(A). {pParse->bHasWith = 1;}
wqlist(A) ::= wqitem(X). {
  A = sqlite3_With_ਜੋੜੋ(pParse, 0, X); /*A-overwrites-X*/
}
wqlist(A) ::= wqlist(A) COMMA wqitem(X). {
  A = sqlite3_With_ਜੋੜੋ(pParse, A, X);
}
%endif  SQLITE_OMIT_CTE

//////////////////////// WINDOW FUNCTION EXPRESSIONS /////////////////////////
// These must be at the end of this file. Specifically, the rules that
// introduce tokens WINDOW, OVER and FILTER must appear last. This causes 
// the integer values assigned to these tokens to be larger than all other 
// tokens that may be output by the tokenizer except TK_SPACE, TK_COMMENT,
// and TK_ILLEGAL.
//
%ifndef SQLITE_OMIT_WINDOWFUNC
%ਕਿਸਮ windowdefn_list {ਖਿੜਕੀ*}
%destructor windowdefn_list {sqlite3_ਖਿੜਕੀ_List_Delete(pParse->db, $$);}
windowdefn_list(A) ::= windowdefn(A).
windowdefn_list(A) ::= windowdefn_list(Y) COMMA windowdefn(Z). {
  ਪ੍ਰਤਿਜ੍ਞਾ( Z!=0 );
  sqlite3_ਖਿੜਕੀ_Chain(pParse, Z, Y);
  Z->p_ਅਗਲਾ_Win = Y;
  A = Z;
}

%ਕਿਸਮ windowdefn {ਖਿੜਕੀ*}
%destructor windowdefn {sqlite3_ਖਿੜਕੀ_Delete(pParse->db, $$);}
windowdefn(A) ::= nm(X) AS LP ਖਿੜਕੀ_2(Y) RP. {
  ਜੇ( ALWAYS(Y) ){
    Y->zName = sqlite3DbStrNDup(pParse->db, X.z, X.n);
  }
  A = Y;
}

%ਕਿਸਮ ਖਿੜਕੀ_2 {ਖਿੜਕੀ*}
%destructor ਖਿੜਕੀ_2 {sqlite3_ਖਿੜਕੀ_Delete(pParse->db, $$);}

%ਕਿਸਮ ਚੌਖਟਾ_opt {ਖਿੜਕੀ*}
%destructor ਚੌਖਟਾ_opt {sqlite3_ਖਿੜਕੀ_Delete(pParse->db, $$);}

%ਕਿਸਮ part_opt {ਵਿਅੰਜਕ_List*}
%destructor part_opt {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}

%ਕਿਸਮ filter_clause {ਵਿਅੰਜਕ*}
%destructor filter_clause {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}

%ਕਿਸਮ over_clause {ਖਿੜਕੀ*}
%destructor over_clause {sqlite3_ਖਿੜਕੀ_Delete(pParse->db, $$);}

%ਕਿਸਮ filter_over {ਖਿੜਕੀ*}
%destructor filter_over {sqlite3_ਖਿੜਕੀ_Delete(pParse->db, $$);}

%ਕਿਸਮ range_or_ਪੰਕਤੀਆਂ {ਪੂਰਨ}

%ਕਿਸਮ ਚੌਖਟਾ_bound {ਬਣਤਰ ਚੌਖਟਾ_Bound}
%destructor ਚੌਖਟਾ_bound {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$.p_ਵਿਅੰਜਕ);}
%ਕਿਸਮ ਚੌਖਟਾ_bound_s {ਬਣਤਰ ਚੌਖਟਾ_Bound}
%destructor ਚੌਖਟਾ_bound_s {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$.p_ਵਿਅੰਜਕ);}
%ਕਿਸਮ ਚੌਖਟਾ_bound_e {ਬਣਤਰ ਚੌਖਟਾ_Bound}
%destructor ਚੌਖਟਾ_bound_e {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$.p_ਵਿਅੰਜਕ);}

ਖਿੜਕੀ_2(A) ::= ਹਿੱਸੇ_ਕਰੋ BY nexprlist(X) orderby_opt(Y) ਚੌਖਟਾ_opt(Z). {
  A = sqlite3_ਖਿੜਕੀ_Assemble(pParse, Z, X, Y, 0);
}
ਖਿੜਕੀ_2(A) ::= nm(W) ਹਿੱਸੇ_ਕਰੋ BY nexprlist(X) orderby_opt(Y) ਚੌਖਟਾ_opt(Z). {
  A = sqlite3_ਖਿੜਕੀ_Assemble(pParse, Z, X, Y, &W);
}
ਖਿੜਕੀ_2(A) ::= ਕ੍ਰਮ BY sortlist(Y) ਚੌਖਟਾ_opt(Z). {
  A = sqlite3_ਖਿੜਕੀ_Assemble(pParse, Z, 0, Y, 0);
}
ਖਿੜਕੀ_2(A) ::= nm(W) ਕ੍ਰਮ BY sortlist(Y) ਚੌਖਟਾ_opt(Z). {
  A = sqlite3_ਖਿੜਕੀ_Assemble(pParse, Z, 0, Y, &W);
}
ਖਿੜਕੀ_2(A) ::= ਚੌਖਟਾ_opt(A).
ਖਿੜਕੀ_2(A) ::= nm(W) ਚੌਖਟਾ_opt(Z). {
  A = sqlite3_ਖਿੜਕੀ_Assemble(pParse, Z, 0, 0, &W);
}

ਚੌਖਟਾ_opt(A) ::= .                             { 
  A = sqlite3_ਖਿੜਕੀ_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
ਚੌਖਟਾ_opt(A) ::= range_or_ਪੰਕਤੀਆਂ(X) ਚੌਖਟਾ_bound_s(Y) ਚੌਖਟਾ_exclude_opt(Z). { 
  A = sqlite3_ਖਿੜਕੀ_Alloc(pParse, X, Y.eType, Y.p_ਵਿਅੰਜਕ, TK_CURRENT, 0, Z);
}
ਚੌਖਟਾ_opt(A) ::= range_or_ਪੰਕਤੀਆਂ(X) BETWEEN ਚੌਖਟਾ_bound_s(Y) AND
                          ਚੌਖਟਾ_bound_e(Z) ਚੌਖਟਾ_exclude_opt(W). { 
  A = sqlite3_ਖਿੜਕੀ_Alloc(pParse, X, Y.eType, Y.p_ਵਿਅੰਜਕ, Z.eType, Z.p_ਵਿਅੰਜਕ, W);
}

range_or_ਪੰਕਤੀਆਂ(A) ::= RANGE|ਪੰਕਤੀਆਂ|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

ਚੌਖਟਾ_bound_s(A) ::= ਚੌਖਟਾ_bound(X).         {A = X;}
ਚੌਖਟਾ_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_ਵਿਅੰਜਕ = 0;}
ਚੌਖਟਾ_bound_e(A) ::= ਚੌਖਟਾ_bound(X).         {A = X;}
ਚੌਖਟਾ_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_ਵਿਅੰਜਕ = 0;}

ਚੌਖਟਾ_bound(A) ::= ਵਿਅੰਜਕ_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_ਵਿਅੰਜਕ = X;}
ਚੌਖਟਾ_bound(A) ::= CURRENT(X) ਪੰਕਤੀ.           {A.eType = @X; A.p_ਵਿਅੰਜਕ = 0;}

%ਕਿਸਮ ਚੌਖਟਾ_exclude_opt {u8}
ਚੌਖਟਾ_exclude_opt(A) ::= . {A = 0;}
ਚੌਖਟਾ_exclude_opt(A) ::= EXCLUDE ਚੌਖਟਾ_exclude(X). {A = X;}

%ਕਿਸਮ ਚੌਖਟਾ_exclude {u8}
ਚੌਖਟਾ_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
ਚੌਖਟਾ_exclude(A) ::= CURRENT(X) ਪੰਕਤੀ. {A = @X; /*A-overwrites-X*/}
ਚੌਖਟਾ_exclude(A) ::= ਸਮੂਹ|TIES(X).  {A = @X; /*A-overwrites-X*/}


%ਕਿਸਮ ਖਿੜਕੀ_clause {ਖਿੜਕੀ*}
%destructor ਖਿੜਕੀ_clause {sqlite3_ਖਿੜਕੀ_List_Delete(pParse->db, $$);}
ਖਿੜਕੀ_clause(A) ::= ਖਿੜਕੀ_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  ਜੇ( O ){
    O->pFilter = F;
  }ਨਹੀਂਤਾਂ{
    sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (ਖਿੜਕੀ*)sqlite3DbMallocZero(pParse->db, ਆਕਾਰ(ਖਿੜਕੀ));
  ਜੇ( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }ਨਹੀਂਤਾਂ{
    sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP ਖਿੜਕੀ_2(Z) RP. {
  A = Z;
  ਪ੍ਰਤਿਜ੍ਞਾ( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (ਖਿੜਕੀ*)sqlite3DbMallocZero(pParse->db, ਆਕਾਰ(ਖਿੜਕੀ));
  ਜੇ( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE ਵਿਅੰਜਕ_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%token
  ਕਾਲਮ_2          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_ਕਾਲਮ      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  ਰਜਿਸਟਰ_2        /* Reference to a VDBE register */
  ਸਦਿਸ਼          /*ਸਦਿਸ਼*/
  SELECT_ਕਾਲਮ   /* Choose a single column from a multi-column SELECT */
  IF_NULL_ਪੰਕਤੀ     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  ਵਿਸਤਾਰ            /* The span operator */
  ERROR           /* An expression containing an error */
.

ਪਦ(A) ::= QNUMBER(X). {
  A=token_ਵਿਅੰਜਕ(pParse,@X,X);
  sqlite3_Dequote_ਸੰਖਿਆ(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#ਜੇ TK_ਵਿਸਤਾਰ>255
# error too many ਟੋਕਨ in the grammar
#ਜੇ_ਅੰਤ
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%token SPACE COMMENT ILLEGAL.
