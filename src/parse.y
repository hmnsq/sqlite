          A->x.pList = Y;
          sqlite3_ৰাশিমালা_Set_Height_And_Flags(pParse, A);
        }
      }
      যদি( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  ৰাশিমালা_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3PExprAddSelect(pParse, A, X);
  }
  ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) in_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_IN, A, 0);
    sqlite3PExprAddSelect(pParse, A, Y);
    যদি( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) in_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    যদি( E )  sqlite3SrcListFuncArgs(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_IN, A, 0);
    sqlite3PExprAddSelect(pParse, A, pSelect);
    যদি( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
