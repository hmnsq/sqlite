%نوع exprlist {اظهار_List*}
%destructor exprlist {sqlite3_اظهار_List_Delete(pParse->db, $$);}
%نوع nexprlist {اظهار_List*}
%destructor nexprlist {sqlite3_اظهار_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA اظهار_2(Y).
    {A = sqlite3_اظهار_List_Append(pParse,A,Y);}
nexprlist(A) ::= اظهار_2(Y).
    {A = sqlite3_اظهار_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

