%ਕਿਸਮ where_opt {ਵਿਅੰਜਕ*}
%destructor where_opt {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}
%ਕਿਸਮ where_opt_ret {ਵਿਅੰਜਕ*}
%destructor where_opt_ret {sqlite3_ਵਿਅੰਜਕ_Delete(pParse->db, $$);}

where_opt(A) ::= .                    {A = 0;}
where_opt(A) ::= WHERE ਵਿਅੰਜਕ_2(X).       {A = X;}
where_opt_ret(A) ::= .                                      {A = 0;}
where_opt_ret(A) ::= WHERE ਵਿਅੰਜਕ_2(X).                         {A = X;}
where_opt_ret(A) ::= RETURNING selcollist(X).               
       {sqlite3_ਜੋੜੋ_Returning(pParse,X); A = 0;}
where_opt_ret(A) ::= WHERE ਵਿਅੰਜਕ_2(X) RETURNING selcollist(Y).
       {sqlite3_ਜੋੜੋ_Returning(pParse,Y); A = X;}

////////////////////////// The UPDATE command ////////////////////////////////
//
%ਜੇ SQLITE_ENABLE_UPDATE_DELETE_ਹੱਦਬੰਦੀ || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with UPDATE orconf(R) xfullname(X) ਸੂਚਕਾਂਕਿਤ_opt(I) ਸੈੱਟ setlist(Y) from(F)
        where_opt_ret(W) orderby_opt(O) ਹੱਦਬੰਦੀ_opt(L).  {
  sqlite3_Src_List_ਸੂਚਕਾਂਕਿਤ_By(pParse, X, &I);
  ਜੇ( F ){
    SrcList *pFromClause = F;
    ਜੇ( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_ਪਦ(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3_ਵਿਅੰਜਕ_List_Check_ਲੰਮਾਈ(pParse,Y,"set list"); 
#ਜੇ_ਅਪਰਿਭਾਸ਼ਿਤ SQLITE_ENABLE_UPDATE_DELETE_ਹੱਦਬੰਦੀ
  ਜੇ( O || L ){
    update_Delete_ਹੱਦਬੰਦੀ_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#ਜੇ_ਅੰਤ
  sqlite3Update(pParse,X,Y,W,R,O,L,0);
}
%ਨਹੀਂਤਾਂ
cmd ::= with UPDATE orconf(R) xfullname(X) ਸੂਚਕਾਂਕਿਤ_opt(I) ਸੈੱਟ setlist(Y) from(F)
        where_opt_ret(W). {
  sqlite3_Src_List_ਸੂਚਕਾਂਕਿਤ_By(pParse, X, &I);
  sqlite3_ਵਿਅੰਜਕ_List_Check_ਲੰਮਾਈ(pParse,Y,"set list"); 
  ਜੇ( F ){
    SrcList *pFromClause = F;
    ਜੇ( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_ਪਦ(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3Update(pParse,X,Y,W,R,0,0,0);
}
%endif



%ਕਿਸਮ setlist {ਵਿਅੰਜਕ_List*}
%destructor setlist {sqlite3_ਵਿਅੰਜਕ_List_Delete(pParse->db, $$);}

setlist(A) ::= setlist(A) COMMA nm(X) EQ ਵਿਅੰਜਕ_2(Y). {
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, A, Y);
  sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_Name(pParse, A, &X, 1);
}
setlist(A) ::= setlist(A) COMMA LP idlist(X) RP EQ ਵਿਅੰਜਕ_2(Y). {
