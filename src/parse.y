xfullname(A) ::= nm(X) DOT nm(Y) AS nm(Z). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  यदि( A ){
    यदि( अन्तर्_RENAME_OBJECT ){
      sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
    }अन्यथा{
      A->a[0].zAlias = sqlite3NameFromToken(pParse->db, &Z);
    }
  }
}


%प्रकार joinop {पूर्णाङ्क}
joinop(X) ::= COMMA|JOIN.              { X = JT_INNER; }
joinop(X) ::= JOIN_KW(A) JOIN.
                  {X = sqlite3JoinType(pParse,&A,0,0);  /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,0); /*X-overwrites-A*/}
joinop(X) ::= JOIN_KW(A) nm(B) nm(C) JOIN.
                  {X = sqlite3JoinType(pParse,&A,&B,&C);/*X-overwrites-A*/}

// There is a parsing ambiguity in an upsert statement that uses a
// SELECT on the RHS of a the INSERT:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb ON CONFLICT ...
//                                        here ----^^
//
// When the ON token is encountered, the parser does not know if it is
// the beginning of an ON CONFLICT clause, or the beginning of an ON
// clause associated with the JOIN.  The conflict is resolved in favor
// of the JOIN.  If an ON CONFLICT clause is intended, insert a dummy
// WHERE clause in between, like this:
//
//      INSERT INTO tab SELECT * FROM aaa JOIN bbb WHERE true ON CONFLICT ...
//
// The [AND] and [OR] precedence marks in the rules for on_using cause the
// ON in this context to always be interpreted as belonging to the JOIN.
//
%प्रकार on_using {OnOrUsing}
//%destructor on_using {sqlite3ClearOnOrUsing(pParse->db, &$$);}
on_using(N) ::= ON व्यञ्जकम्_2(E).            {N.pOn = E; N.pUsing = 0;}
on_using(N) ::= USING LP idlist(L) RP. {N.pOn = 0; N.pUsing = L;}
on_using(N) ::= .                 [OR] {N.pOn = 0; N.pUsing = 0;}

// Note that this block abuses the Token type just a little. If there is
// no "INDEXED BY" clause, the returned token is empty (z==0 && n==0). If
// there is an INDEXED BY clause, then the token is populated as per normal,
// with z pointing to the token data and n containing the number of bytes
// in the token.
//
// If there is a "NOT INDEXED" clause, then (z==0 && n==1), which is 
// normally illegal. The sqlite3SrcListIndexedBy() function 
// recognizes and interprets this as a special case.
//
%प्रकार अनुक्रमितम्_opt {Token}
%प्रकार अनुक्रमितम्_by  {Token}
अनुक्रमितम्_opt(A) ::= .                 {A.z=0; A.n=0;}
अनुक्रमितम्_opt(A) ::= अनुक्रमितम्_by(A).
अनुक्रमितम्_by(A)  ::= अनुक्रमितम् BY nm(X). {A = X;}
अनुक्रमितम्_by(A)  ::= NOT अनुक्रमितम्.      {A.z=0; A.n=1;}

%प्रकार orderby_opt {व्यञ्जकम्_List*}
%destructor orderby_opt {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}

// the sortlist non-terminal stores a list of expression where each
// expression is optionally followed by ASC or DESC to indicate the
// sort order.
//
%प्रकार sortlist {व्यञ्जकम्_List*}
%destructor sortlist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}

orderby_opt(A) ::= .                          {A = 0;}
orderby_opt(A) ::= क्रमः BY sortlist(X).      {A = X;}
sortlist(A) ::= sortlist(A) COMMA व्यञ्जकम्_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,A,Y);
  sqlite3_व्यञ्जकम्_List_समुच्चयः_क्रमय_क्रमः(A,Z,X);
}
sortlist(A) ::= व्यञ्जकम्_2(Y) sortorder(Z) nulls(X). {
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,0,Y); /*A-overwrites-Y*/
  sqlite3_व्यञ्जकम्_List_समुच्चयः_क्रमय_क्रमः(A,Z,X);
}

%प्रकार sortorder {पूर्णाङ्क}

sortorder(A) ::= ASC.           {A = SQLITE_SO_ASC;}
sortorder(A) ::= DESC.          {A = SQLITE_SO_DESC;}
sortorder(A) ::= .              {A = SQLITE_SO_UNDEFINED;}

%प्रकार nulls {पूर्णाङ्क}
nulls(A) ::= NULLS FIRST.       {A = SQLITE_SO_ASC;}
nulls(A) ::= NULLS चरमः.        {A = SQLITE_SO_DESC;}
nulls(A) ::= .                  {A = SQLITE_SO_UNDEFINED;}

%प्रकार groupby_opt {व्यञ्जकम्_List*}
%destructor groupby_opt {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}
groupby_opt(A) ::= .                      {A = 0;}
groupby_opt(A) ::= गणः BY nexprlist(X). {A = X;}

%प्रकार having_opt {व्यञ्जकम्*}
%destructor having_opt {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}
having_opt(A) ::= .                {A = 0;}
having_opt(A) ::= HAVING व्यञ्जकम्_2(X).  {A = X;}

%प्रकार सीमा_opt {व्यञ्जकम्*}

// The destructor for limit_opt will never fire in the current grammar.
// The limit_opt non-terminal only occurs at the end of a single production
// rule for SELECT statements.  As soon as the rule that create the 
// limit_opt non-terminal reduces, the SELECT statement rule will also
// reduce.  So there is never a limit_opt non-terminal on the stack 
// except as a transient.  So there is never anything to destroy.
//
//%destructor limit_opt {sqlite3ExprDelete(pParse->db, $$);}
सीमा_opt(A) ::= .       {A = 0;}
सीमा_opt(A) ::= सीमा_2 व्यञ्जकम्_2(X).
                         {A = sqlite3PExpr(pParse,TK_सीमा,X,0);}
सीमा_opt(A) ::= सीमा_2 व्यञ्जकम्_2(X) विस्थापनम्_3 व्यञ्जकम्_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_सीमा,X,Y);}
सीमा_opt(A) ::= सीमा_2 व्यञ्जकम्_2(X) COMMA व्यञ्जकम्_2(Y). 
                         {A = sqlite3PExpr(pParse,TK_सीमा,Y,X);}

/////////////////////////// The DELETE statement /////////////////////////////
//
%यदि SQLITE_ENABLE_UPDATE_DELETE_सीमा || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with DELETE FROM xfullname(X) अनुक्रमितम्_opt(I) where_opt_ret(W)
        orderby_opt(O) सीमा_opt(L). {
  sqlite3_Src_List_अनुक्रमितम्_By(pParse, X, &I);
#यदि_अपरिभाषितम् SQLITE_ENABLE_UPDATE_DELETE_सीमा
  यदि( O || L ){
    update_Delete_सीमा_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#यदि_अन्तः
  sqlite3DeleteFrom(pParse,X,W,O,L);
}
%अन्यथा
cmd ::= with DELETE FROM xfullname(X) अनुक्रमितम्_opt(I) where_opt_ret(W). {
  sqlite3_Src_List_अनुक्रमितम्_By(pParse, X, &I);
  sqlite3DeleteFrom(pParse,X,W,0,0);
}
%endif

%प्रकार where_opt {व्यञ्जकम्*}
%destructor where_opt {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}
%प्रकार where_opt_ret {व्यञ्जकम्*}
%destructor where_opt_ret {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}

where_opt(A) ::= .                    {A = 0;}
where_opt(A) ::= WHERE व्यञ्जकम्_2(X).       {A = X;}
where_opt_ret(A) ::= .                                      {A = 0;}
where_opt_ret(A) ::= WHERE व्यञ्जकम्_2(X).                         {A = X;}
where_opt_ret(A) ::= RETURNING selcollist(X).               
       {sqlite3_सङ्कलय_Returning(pParse,X); A = 0;}
where_opt_ret(A) ::= WHERE व्यञ्जकम्_2(X) RETURNING selcollist(Y).
       {sqlite3_सङ्कलय_Returning(pParse,Y); A = X;}

////////////////////////// The UPDATE command ////////////////////////////////
//
%यदि SQLITE_ENABLE_UPDATE_DELETE_सीमा || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with UPDATE orconf(R) xfullname(X) अनुक्रमितम्_opt(I) समुच्चयः setlist(Y) from(F)
        where_opt_ret(W) orderby_opt(O) सीमा_opt(L).  {
  sqlite3_Src_List_अनुक्रमितम्_By(pParse, X, &I);
  यदि( F ){
    SrcList *pFromClause = F;
    यदि( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_पदांशः(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3_व्यञ्जकम्_List_Check_दीर्घता(pParse,Y,"set list"); 
#यदि_अपरिभाषितम् SQLITE_ENABLE_UPDATE_DELETE_सीमा
  यदि( O || L ){
    update_Delete_सीमा_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#यदि_अन्तः
  sqlite3Update(pParse,X,Y,W,R,O,L,0);
}
%अन्यथा
cmd ::= with UPDATE orconf(R) xfullname(X) अनुक्रमितम्_opt(I) समुच्चयः setlist(Y) from(F)
        where_opt_ret(W). {
  sqlite3_Src_List_अनुक्रमितम्_By(pParse, X, &I);
  sqlite3_व्यञ्जकम्_List_Check_दीर्घता(pParse,Y,"set list"); 
  यदि( F ){
    SrcList *pFromClause = F;
    यदि( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_पदांशः(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3Update(pParse,X,Y,W,R,0,0,0);
}
%endif



%प्रकार setlist {व्यञ्जकम्_List*}
%destructor setlist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}

setlist(A) ::= setlist(A) COMMA nm(X) EQ व्यञ्जकम्_2(Y). {
  A = sqlite3_व्यञ्जकम्_List_Append(pParse, A, Y);
  sqlite3_व्यञ्जकम्_List_समुच्चयः_Name(pParse, A, &X, 1);
}
setlist(A) ::= setlist(A) COMMA LP idlist(X) RP EQ व्यञ्जकम्_2(Y). {
  A = sqlite3_व्यञ्जकम्_List_Append_सदिशम्(pParse, A, X, Y);
}
setlist(A) ::= nm(X) EQ व्यञ्जकम्_2(Y). {
  A = sqlite3_व्यञ्जकम्_List_Append(pParse, 0, Y);
  sqlite3_व्यञ्जकम्_List_समुच्चयः_Name(pParse, A, &X, 1);
}
setlist(A) ::= LP idlist(X) RP EQ व्यञ्जकम्_2(Y). {
  A = sqlite3_व्यञ्जकम्_List_Append_सदिशम्(pParse, 0, X, Y);
}

