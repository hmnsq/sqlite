}
setlist(A) ::= nm(X) EQ ਵਿਅੰਜਕ_2(Y). {
  A = sqlite3_ਵਿਅੰਜਕ_List_Append(pParse, 0, Y);
  sqlite3_ਵਿਅੰਜਕ_List_ਸੈੱਟ_Name(pParse, A, &X, 1);
}
setlist(A) ::= LP idlist(X) RP EQ ਵਿਅੰਜਕ_2(Y). {
