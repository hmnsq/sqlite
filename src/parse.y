पदांशः(A) ::= CTIME_KW(OP). {
  A = sqlite3_व्यञ्जकम्_Function(pParse, 0, &OP, 0);
}

व्यञ्जकम्_2(A) ::= LP nexprlist(X) COMMA व्यञ्जकम्_2(Y) RP. {
  व्यञ्जकम्_List *pList = sqlite3_व्यञ्जकम्_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_सदिशम्, 0, 0);
  यदि( A ){
    पूर्णाङ्क i;
    A->x.pList = pList;
    प्रति(i=0; i<pList->n_व्यञ्जकम्; i++){
      प्रतिज्ञा( pList->a[i].p_व्यञ्जकम्!=0 );
      A->flags |= pList->a[i].p_व्यञ्जकम्->flags & EP_Propagate;
    }
  }अन्यथा{
    sqlite3_व्यञ्जकम्_List_Delete(pParse->db, pList);
  }
}

व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) AND व्यञ्जकम्_2(Y).        {A=sqlite3_व्यञ्जकम्_And(pParse,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) OR(OP) व्यञ्जकम्_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) LT|GT|GE|LE(OP) व्यञ्जकम्_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) EQ|NE(OP) व्यञ्जकम्_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) व्यञ्जकम्_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) PLUS|MINUS(OP) व्यञ्जकम्_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) तारकम्|SLASH|REM(OP) व्यञ्जकम्_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) CONCAT(OP) व्यञ्जकम्_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%प्रकार likeop {Token}
likeop(A) ::= LIKE_KW|मेलनम्_2(A).
likeop(A) ::= NOT LIKE_KW|मेलनम्_2(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) likeop(OP) व्यञ्जकम्_2(Y).  [LIKE_KW]  {
  व्यञ्जकम्_List *pList;
  पूर्णाङ्क bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse,0, Y);
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse,pList, A);
  A = sqlite3_व्यञ्जकम्_Function(pParse, pList, &OP, 0);
  यदि( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  यदि( A ) A->flags |= EP_InfixFunc;
}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) likeop(OP) व्यञ्जकम्_2(Y) ESCAPE व्यञ्जकम्_2(E).  [LIKE_KW]  {
  व्यञ्जकम्_List *pList;
  पूर्णाङ्क bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse,0, Y);
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse,pList, A);
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse,pList, E);
  A = sqlite3_व्यञ्जकम्_Function(pParse, pList, &OP, 0);
  यदि( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  यदि( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  स्थिर व्यञ्जकम् *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    पूर्णाङ्क op,         /* TK_ISNULL or TK_NOTNULL */
    व्यञ्जकम् *p_वामः     /*सङ्कार्यम्*/
  ){
    व्यञ्जकम् *p = p_वामः;
    प्रतिज्ञा( op==TK_ISNULL || op==TK_NOTNULL );
    प्रतिज्ञा( p_वामः!=0 );
    यावत्( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_वामः;
      प्रतिज्ञा( p!=0 );
    }
    विकल्प( p->op ){
      पक्ष TK_INTEGER:
      पक्ष TK_STRING:
      पक्ष TK_FLOAT:
      पक्ष TK_BLOB: 
        sqlite3_व्यञ्जकम्_Deferred_Delete(pParse, p_वामः);
        p = sqlite3_व्यञ्जकम्_Int32(pParse->db, op==TK_NOTNULL);
        यदि( p ) p->op2 = 1;
        प्रत्यागम p;
      स्वभाव:
        भङ्ग;
    }
    प्रत्यागम sqlite3PExpr(pParse, op, p_वामः, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  स्थिर व्यञ्जकम् *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    पूर्णाङ्क op,         /* TK_IS or TK_ISNOT */
    व्यञ्जकम् *p_वामः,    /* Left operand */
    व्यञ्जकम् *p_दक्षिणः    /* Right operand */
  ){
    यदि( p_दक्षिणः && p_दक्षिणः->op==TK_NULL ){
      sqlite3_व्यञ्जकम्_Deferred_Delete(pParse, p_दक्षिणः);
      प्रत्यागम sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_वामः);
    }
    प्रत्यागम sqlite3PExpr(pParse, op, p_वामः, p_दक्षिणः);
  }
}

व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) NOT रिक्त.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) IS व्यञ्जकम्_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) IS NOT व्यञ्जकम्_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) IS NOT DISTINCT FROM व्यञ्जकम्_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) IS DISTINCT FROM व्यञ्जकम्_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

व्यञ्जकम्_2(A) ::= NOT(B) व्यञ्जकम्_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
व्यञ्जकम्_2(A) ::= BITNOT(B) व्यञ्जकम्_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
व्यञ्जकम्_2(A) ::= PLUS|MINUS(B) व्यञ्जकम्_2(X). [BITNOT] {
  व्यञ्जकम् *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  प्रतिज्ञा( TK_UPLUS>TK_PLUS );
  प्रतिज्ञा( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  यदि( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }अन्यथा{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(B) PTR(C) व्यञ्जकम्_2(D). {
  व्यञ्जकम्_List *pList = sqlite3_व्यञ्जकम्_List_Append(pParse, 0, B);
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse, pList, D);
  A = sqlite3_व्यञ्जकम्_Function(pParse, pList, &C, 0);
}

%प्रकार between_op {पूर्णाङ्क}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) between_op(N) व्यञ्जकम्_2(X) AND व्यञ्जकम्_2(Y). [BETWEEN] {
  व्यञ्जकम्_List *pList = sqlite3_व्यञ्जकम्_List_Append(pParse,0, X);
  pList = sqlite3_व्यञ्जकम्_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  यदि( A ){
    A->x.pList = pList;
    sqlite3_व्यञ्जकम्_समुच्चयः_Height_And_Flags(pParse, A);
  }अन्यथा{
    sqlite3_व्यञ्जकम्_List_Delete(pParse->db, pList);
  } 
  यदि( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %प्रकार अन्तर्_op {पूर्णाङ्क}
  अन्तर्_op(A) ::= अन्तर्_2.      {A = 0;}
  अन्तर्_op(A) ::= NOT अन्तर्_2.  {A = 1;}
  व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) अन्तर्_op(N) LP exprlist(Y) RP. [IN] {
    यदि( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      व्यञ्जकम् *pB = sqlite3_व्यञ्जकम्(pParse->db, TK_STRING, N ? "true" : "false");
      यदि( pB ) sqlite3_व्यञ्जकम्_Id_गन्तव्यम्_True_False(pB);
      यदि( !व्यञ्जकम्_Has_Property(A, EP_HasFunc) ){
        sqlite3_व्यञ्जकम्_Unmap_And_Delete(pParse, A);
        A = pB;
      }अन्यथा{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }अन्यथा{
      व्यञ्जकम् *pRHS = Y->a[0].p_व्यञ्जकम्;
      यदि( Y->n_व्यञ्जकम्==1
       && sqlite3_व्यञ्जकम्_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_सदिशम्
      ){
        Y->a[0].p_व्यञ्जकम् = 0;
        sqlite3_व्यञ्जकम्_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }अन्यथा यदि( Y->n_व्यञ्जकम्==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_अन्तर्, A, 0);
        sqlite3_PExpr_सङ्कलय_Select(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_व्यञ्जकम्_List_Delete(pParse->db, Y);
      }अन्यथा{
        A = sqlite3PExpr(pParse, TK_अन्तर्, A, 0);
        यदि( A==0 ){
          sqlite3_व्यञ्जकम्_List_Delete(pParse->db, Y);
        }अन्यथा यदि( A->p_वामः->op==TK_सदिशम् ){
          पूर्णाङ्क n_व्यञ्जकम् = A->p_वामः->x.pList->n_व्यञ्जकम्;
          Select *pSelectRHS = sqlite3_व्यञ्जकम्_List_गन्तव्यम्_मानानि(pParse, n_व्यञ्जकम्, Y);
          यदि( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3_PExpr_सङ्कलय_Select(pParse, A, pSelectRHS);
          }
        }अन्यथा{
          A->x.pList = Y;
          sqlite3_व्यञ्जकम्_समुच्चयः_Height_And_Flags(pParse, A);
        }
      }
      यदि( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  व्यञ्जकम्_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3_PExpr_सङ्कलय_Select(pParse, A, X);
  }
  व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) अन्तर्_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_अन्तर्, A, 0);
    sqlite3_PExpr_सङ्कलय_Select(pParse, A, Y);
    यदि( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  व्यञ्जकम्_2(A) ::= व्यञ्जकम्_2(A) अन्तर्_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    यदि( E )  sqlite3_Src_List_Func_तर्काः(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_अन्तर्, A, 0);
    sqlite3_PExpr_सङ्कलय_Select(pParse, A, pSelect);
    यदि( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  व्यञ्जकम्_2(A) ::= EXISTS LP select(Y) RP. {
    व्यञ्जकम् *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_सङ्कलय_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
व्यञ्जकम्_2(A) ::= CASE case_सङ्कार्यम्(X) case_exprlist(Y) case_else(Z) अन्तः. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  यदि( A ){
    A->x.pList = Z ? sqlite3_व्यञ्जकम्_List_Append(pParse,Y,Z) : Y;
    sqlite3_व्यञ्जकम्_समुच्चयः_Height_And_Flags(pParse, A);
  }अन्यथा{
    sqlite3_व्यञ्जकम्_List_Delete(pParse->db, Y);
    sqlite3_व्यञ्जकम्_Delete(pParse->db, Z);
  }
}
%प्रकार case_exprlist {व्यञ्जकम्_List*}
%destructor case_exprlist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN व्यञ्जकम्_2(Y) THEN व्यञ्जकम्_2(Z). {
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,A, Y);
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN व्यञ्जकम्_2(Y) THEN व्यञ्जकम्_2(Z). {
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,0, Y);
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,A, Z);
}
%प्रकार case_else {व्यञ्जकम्*}
%destructor case_else {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE व्यञ्जकम्_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%प्रकार case_सङ्कार्यम् {व्यञ्जकम्*}
%destructor case_सङ्कार्यम् {sqlite3_व्यञ्जकम्_Delete(pParse->db, $$);}
case_सङ्कार्यम्(A) ::= व्यञ्जकम्_2(A).
case_सङ्कार्यम्(A) ::= .                   {A = 0;} 

%प्रकार exprlist {व्यञ्जकम्_List*}
%destructor exprlist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}
%प्रकार nexprlist {व्यञ्जकम्_List*}
%destructor nexprlist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA व्यञ्जकम्_2(Y).
    {A = sqlite3_व्यञ्जकम्_List_Append(pParse,A,Y);}
nexprlist(A) ::= व्यञ्जकम्_2(Y).
    {A = sqlite3_व्यञ्जकम्_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%प्रकार paren_exprlist {व्यञ्जकम्_List*}
%destructor paren_exprlist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
%endif SQLITE_OMIT_SUBQUERY


///////////////////////////// The CREATE INDEX command ///////////////////////
//
cmd ::= createkw(S) uniqueflag(U) सूचकांक_2 ifnotexists(NE) nm(X) dbnm(D)
        ON nm(Y) LP sortlist(Z) RP where_opt(W). {
  sqlite3_Create_सूचकांक(pParse, &X, &D, 
                     sqlite3SrcListAppend(pParse,0,&Y,0), Z, U,
                      &S, W, SQLITE_SO_ASC, NE, SQLITE_IDXTYPE_APPDEF);
  यदि( अन्तर्_RENAME_OBJECT && pParse->p_New_सूचकांक ){
    sqlite3RenameTokenMap(pParse, pParse->p_New_सूचकांक->zName, &Y);
  }
}

