      సమాసం *pB = sqlite3_సమాసం(pParse->db, TK_STRING, N ? "true" : "false");
      ఒకవేళ( pB ) sqlite3_సమాసం_Id_గమ్యం_True_False(pB);
      ఒకవేళ( !సమాసం_Has_Property(A, EP_HasFunc) ){
        sqlite3_సమాసం_Unmap_And_Delete(pParse, A);
