//////////////////////// The SELECT statement /////////////////////////////////
//
cmd ::= select(X).  {
  SelectDest dest = {SRT_Output, 0, 0, 0, 0, 0, 0};
  यदि( (pParse->db->mDbFlags & DBFLAG_EncodingFixed)!=0
   || sqlite3ReadSchema(pParse)==SQLITE_OK
  ){
    sqlite3Select(pParse, X, &dest);
  }
  sqlite3SelectDelete(pParse->db, X);
}

%प्रकार select {Select*}
%destructor select {sqlite3SelectDelete(pParse->db, $$);}
%प्रकार selectnowith {Select*}
%destructor selectnowith {sqlite3SelectDelete(pParse->db, $$);}
%प्रकार oneselect {Select*}
%destructor oneselect {sqlite3SelectDelete(pParse->db, $$);}

%include {
  /*
  ** For a compound SELECT statement, make sure p->pPrior->pNext==p for
  ** all elements in the list.  And make sure list length does not exceed
  ** SQLITE_LIMIT_COMPOUND_SELECT.
  */
  स्थिर शून्य parserDoubleLinkSelect(Parse *pParse, Select *p){
    प्रतिज्ञा( p!=0 );
    यदि( p->p_प्राक् ){
      Select *p_अग्र = 0, *pLoop = p;
      पूर्णाङ्क mxSelect, cnt = 1;
      यावत्(1){
        pLoop->p_अग्र = p_अग्र;
        pLoop->selFlags |= SF_Compound;
        p_अग्र = pLoop;
        pLoop = pLoop->p_प्राक्;
        यदि( pLoop==0 ) भङ्ग;
        cnt++;        
        यदि( pLoop->p_क्रमः_By || pLoop->p_सीमा ){
          sqlite3_Error_सन्देशः(pParse,"%s clause should come after %s not before",
             pLoop->p_क्रमः_By!=0 ? "ORDER BY" : "LIMIT",
             sqlite3SelectOpName(p_अग्र->op));
          भङ्ग;
        }
      }
      यदि( (p->selFlags & (SF_Multi_मानम्|SF_मानानि))==0
       && (mxSelect = pParse->db->a_सीमा[SQLITE_LIMIT_COMPOUND_SELECT])>0
       && cnt>mxSelect
      ){
        sqlite3_Error_सन्देशः(pParse, "too many terms in compound SELECT");
      }
    }
  }

  /* Attach a With object describing the WITH clause to a Select
  ** object describing the query for which the WITH clause is a prefix.
  */
  स्थिर Select *attach_With_गन्तव्यम्_Select(Parse *pParse, Select *pSelect, With *pWith){
    यदि( pSelect ){
      pSelect->pWith = pWith;
      parserDoubleLinkSelect(pParse, pSelect);
    }अन्यथा{
      sqlite3WithDelete(pParse->db, pWith);
    }
    प्रत्यागम pSelect;
  }

  /* Memory allocator for parser stack resizing.  This is a thin wrapper around
  ** sqlite3_realloc() that includes a call to sqlite3FaultSim() to facilitate
  ** testing.
  */
  स्थिर शून्य *parser_राशिः_Realloc(
    शून्य *pOld,               /* Prior allocation */
    sqlite3_uint64 new_आकार_2,   /* Requested new alloation size */
    Parse *pParse             /* Parsing context */
  ){
    शून्य *p = sqlite3FaultSim(700) ? 0 : sqlite3_realloc(pOld, new_आकार_2);
    यदि( p==0 ) sqlite3OomFault(pParse->db);
    प्रत्यागम p;
  }
  स्थिर शून्य parser_राशिः_Free(शून्य *pOld, Parse *pParse){
    (शून्य)pParse;
    sqlite3_free(pOld); 
  }

  /* Return an integer that is the maximum allowed stack size */
  स्थिर पूर्णाङ्क parser_राशिः_आकार_सीमा(Parse *pParse){
    प्रत्यागम pParse->db->a_सीमा[SQLITE_LIMIT_PARSER_DEPTH];
  }
}

%ifndef SQLITE_OMIT_CTE
select(A) ::= WITH wqlist(W) selectnowith(X). {A = attach_With_गन्तव्यम्_Select(pParse,X,W);}
select(A) ::= WITH RECURSIVE wqlist(W) selectnowith(X).
                                              {A = attach_With_गन्तव्यम्_Select(pParse,X,W);}

%endif /* SQLITE_OMIT_CTE */
select(A) ::= selectnowith(A). {
  Select *p = A;
  यदि( p ){
    parserDoubleLinkSelect(pParse, p);
  }
}

selectnowith(A) ::= oneselect(A).
%ifndef SQLITE_OMIT_COMPOUND_SELECT
selectnowith(A) ::= selectnowith(A) multiselect_op(Y) oneselect(Z).  {
  Select *pRhs = Z;
  Select *pLhs = A;
  यदि( pRhs && pRhs->p_प्राक् ){
    SrcList *pFrom;
    Token x;
    x.n = 0;
    parserDoubleLinkSelect(pParse, pRhs);
    pFrom = sqlite3_Src_List_Append_From_पदांशः(pParse,0,0,0,&x,pRhs,0);
    pRhs = sqlite3SelectNew(pParse,0,pFrom,0,0,0,0,0,0);
  }
  यदि( pRhs ){
    pRhs->op = (u8)Y;
    pRhs->p_प्राक् = pLhs;
    यदि( ALWAYS(pLhs) ) pLhs->selFlags &= ~(u32)SF_Multi_मानम्;
    pRhs->selFlags &= ~(u32)SF_Multi_मानम्;
    यदि( Y!=TK_ALL ) pParse->hasCompound = 1;
  }अन्यथा{
    sqlite3SelectDelete(pParse->db, pLhs);
  }
  A = pRhs;
}
%प्रकार multiselect_op {पूर्णाङ्क}
multiselect_op(A) ::= UNION(OP).             {A = @OP; /*A-overwrites-OP*/}
multiselect_op(A) ::= UNION ALL.             {A = TK_ALL;}
multiselect_op(A) ::= EXCEPT|INTERSECT(OP).  {A = @OP; /*A-overwrites-OP*/}
%endif SQLITE_OMIT_COMPOUND_SELECT

oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) 
                 orderby_opt(Z) सीमा_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
}
%ifndef SQLITE_OMIT_WINDOWFUNC
oneselect(A) ::= SELECT distinct(D) selcollist(W) from(X) where_opt(Y)
                 groupby_opt(P) having_opt(Q) गवाक्षः_clause(R)
                 orderby_opt(Z) सीमा_opt(L). {
  A = sqlite3SelectNew(pParse,W,X,Y,P,Q,Z,D,L);
  यदि( A ){
    A->pWinDefn = R;
  }अन्यथा{
    sqlite3_गवाक्षः_List_Delete(pParse->db, R);
  }
}
%endif


// Single row VALUES clause.
//
%प्रकार मानानि {Select*}
oneselect(A) ::= मानानि(A).
%destructor मानानि {sqlite3SelectDelete(pParse->db, $$);}
मानानि(A) ::= मानानि_2 LP nexprlist(X) RP. {
  A = sqlite3SelectNew(pParse,X,0,0,0,0,0,SF_मानानि,0);
}

// Multiple row VALUES clause.
//
%प्रकार mvalues {Select*}
oneselect(A) ::= mvalues(A). {
  sqlite3_Multi_मानानि_अन्तः(pParse, A);
}
%destructor mvalues {sqlite3SelectDelete(pParse->db, $$);}
mvalues(A) ::= मानानि(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_मानानि(pParse, A, Y);
}
mvalues(A) ::= mvalues(A) COMMA LP nexprlist(Y) RP. {
  A = sqlite3_Multi_मानानि(pParse, A, Y);
}

// The "distinct" nonterminal is true (1) if the DISTINCT keyword is
// present and false (0) if it is not.
//
%प्रकार distinct {पूर्णाङ्क}
distinct(A) ::= DISTINCT.   {A = SF_Distinct;}
distinct(A) ::= ALL.        {A = SF_All;}
distinct(A) ::= .           {A = 0;}

// selcollist is a list of expressions that are to become the return
// values of the SELECT statement.  The "*" in statements like
// "SELECT * FROM ..." is encoded as a special expression with an
// opcode of TK_ASTERISK.
//
%प्रकार selcollist {व्यञ्जकम्_List*}
%destructor selcollist {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}
%प्रकार sclp {व्यञ्जकम्_List*}
%destructor sclp {sqlite3_व्यञ्जकम्_List_Delete(pParse->db, $$);}
sclp(A) ::= selcollist(A) COMMA.
sclp(A) ::= .                                {A = 0;}
selcollist(A) ::= sclp(A) scanpt(B) व्यञ्जकम्_2(X) scanpt(Z) as(Y).     {
   A = sqlite3_व्यञ्जकम्_List_Append(pParse, A, X);
   यदि( Y.n>0 ) sqlite3_व्यञ्जकम्_List_समुच्चयः_Name(pParse, A, &Y, 1);
   sqlite3_व्यञ्जकम्_List_समुच्चयः_विस्तृतिः(pParse,A,B,Z);
}
selcollist(A) ::= sclp(A) scanpt तारकम्(X). {
  व्यञ्जकम् *p = sqlite3_व्यञ्जकम्(pParse->db, TK_ASTERISK, 0);
  sqlite3_व्यञ्जकम्_समुच्चयः_Error_विस्थापनम्(p, (पूर्णाङ्क)(X.z - pParse->z_पुच्छ));
  A = sqlite3_व्यञ्जकम्_List_Append(pParse, A, p);
}
selcollist(A) ::= sclp(A) scanpt nm(X) DOT तारकम्(Y). {
  व्यञ्जकम् *p_दक्षिणः, *p_वामः, *pDot;
  p_दक्षिणः = sqlite3PExpr(pParse, TK_ASTERISK, 0, 0);
  sqlite3_व्यञ्जकम्_समुच्चयः_Error_विस्थापनम्(p_दक्षिणः, (पूर्णाङ्क)(Y.z - pParse->z_पुच्छ));
  p_वामः = token_व्यञ्जकम्(pParse, TK_ID, X);
  pDot = sqlite3PExpr(pParse, TK_DOT, p_वामः, p_दक्षिणः);
  A = sqlite3_व्यञ्जकम्_List_Append(pParse,A, pDot);
}

// An option "AS <id>" phrase that can follow one of the expressions that
// define the result set, or one of the tables in the FROM clause.
//
%प्रकार as {Token}
as(X) ::= AS nm(Y).    {X = Y;}
as(X) ::= ids(X).
as(X) ::= .            {X.n = 0; X.z = 0;}


%प्रकार seltablist {SrcList*}
%destructor seltablist {sqlite3SrcListDelete(pParse->db, $$);}
%प्रकार stl_उपसर्गः {SrcList*}
%destructor stl_उपसर्गः {sqlite3SrcListDelete(pParse->db, $$);}
%प्रकार from {SrcList*}
%destructor from {sqlite3SrcListDelete(pParse->db, $$);}

// A complete FROM clause.
//
from(A) ::= .                {A = 0;}
from(A) ::= FROM seltablist(X). {
  A = X;
  sqlite3_Src_List_सरणम्_Join_Type(pParse,A);
}

// "seltablist" is a "Select Table List" - the content of the FROM clause
// in a SELECT statement.  "stl_prefix" is a prefix of this list.
//
stl_उपसर्गः(A) ::= seltablist(A) joinop(Y).    {
   यदि( ALWAYS(A && A->nSrc>0) ) A->a[A->nSrc-1].fg.jointype = (u8)Y;
}
stl_उपसर्गः(A) ::= .                           {A = 0;}
seltablist(A) ::= stl_उपसर्गः(A) nm(Y) dbnm(D) as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_पदांशः(pParse,A,&Y,&D,&Z,0,&N);
}
seltablist(A) ::= stl_उपसर्गः(A) nm(Y) dbnm(D) as(Z) अनुक्रमितम्_by(I) on_using(N). {
  A = sqlite3_Src_List_Append_From_पदांशः(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_अनुक्रमितम्_By(pParse, A, &I);
}
seltablist(A) ::= stl_उपसर्गः(A) nm(Y) dbnm(D) LP exprlist(E) RP as(Z) on_using(N). {
  A = sqlite3_Src_List_Append_From_पदांशः(pParse,A,&Y,&D,&Z,0,&N);
  sqlite3_Src_List_Func_तर्काः(pParse, A, E);
}
%ifndef SQLITE_OMIT_SUBQUERY
  seltablist(A) ::= stl_उपसर्गः(A) LP select(S) RP as(Z) on_using(N). {
    A = sqlite3_Src_List_Append_From_पदांशः(pParse,A,0,0,&Z,S,&N);
  }
  seltablist(A) ::= stl_उपसर्गः(A) LP seltablist(F) RP as(Z) on_using(N). {
    यदि( A==0 && Z.n==0 && N.pOn==0 && N.pUsing==0 ){
      A = F;
    }अन्यथा यदि( ALWAYS(F!=0) && F->nSrc==1 ){
      A = sqlite3_Src_List_Append_From_पदांशः(pParse,A,0,0,&Z,0,&N);
      यदि( A ){
        SrcItem *pNew = &A->a[A->nSrc-1];
        SrcItem *pOld = F->a;
        प्रतिज्ञा( pOld->fg.fixedSchema==0 );
        pNew->zName = pOld->zName;
        pOld->zName = 0;
        प्रतिज्ञा( pOld->fg.fixedSchema==0 );
        यदि( pOld->fg.isSubquery ){
          pNew->fg.isSubquery = 1;
          pNew->u4.pSubq = pOld->u4.pSubq;
          pOld->u4.pSubq = 0;
          pOld->fg.isSubquery = 0;
          प्रतिज्ञा( pNew->u4.pSubq!=0 && pNew->u4.pSubq->pSelect!=0 );
          यदि( (pNew->u4.pSubq->pSelect->selFlags & SF_NestedFrom)!=0 ){
            pNew->fg.isNestedFrom = 1;
          }
        }अन्यथा{
          pNew->u4.zDatabase = pOld->u4.zDatabase;
          pOld->u4.zDatabase = 0;
        }
        यदि( pOld->fg.isTabFunc ){
          pNew->u1.pFuncArg = pOld->u1.pFuncArg;
          pOld->u1.pFuncArg = 0;
          pOld->fg.isTabFunc = 0;
          pNew->fg.isTabFunc = 1;
        }अन्यथा यदि( pOld->fg.is_अनुक्रमितम्_By ){
          pNew->u1.z_अनुक्रमितम्_By = pOld->u1.z_अनुक्रमितम्_By;
          pOld->u1.z_अनुक्रमितम्_By = 0;
          pOld->fg.is_अनुक्रमितम्_By = 0;
          pNew->fg.is_अनुक्रमितम्_By = 1;
        }
        pNew->fg.not_अनुक्रमितम् = pOld->fg.not_अनुक्रमितम्;
      }
      sqlite3SrcListDelete(pParse->db, F);
    }अन्यथा{
      Select *pSubquery;
      sqlite3_Src_List_सरणम्_Join_Type(pParse,F);
      pSubquery = sqlite3SelectNew(pParse,0,F,0,0,0,0,SF_NestedFrom,0);
      A = sqlite3_Src_List_Append_From_पदांशः(pParse,A,0,0,&Z,pSubquery,&N);
    }
  }
%endif  SQLITE_OMIT_SUBQUERY

%प्रकार dbnm {Token}
dbnm(A) ::= .          {A.z=0; A.n=0;}
dbnm(A) ::= DOT nm(X). {A = X;}

%प्रकार fullname {SrcList*}
%destructor fullname {sqlite3SrcListDelete(pParse->db, $$);}
fullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  यदि( अन्तर्_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
fullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  यदि( अन्तर्_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}

%प्रकार xfullname {SrcList*}
%destructor xfullname {sqlite3SrcListDelete(pParse->db, $$);}
xfullname(A) ::= nm(X).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  यदि( अन्तर्_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &X);
}
xfullname(A) ::= nm(X) DOT nm(Y). {
  A = sqlite3SrcListAppend(pParse,0,&X,&Y);
  यदि( अन्तर्_RENAME_OBJECT && A ) sqlite3RenameTokenMap(pParse, A->a[0].zName, &Y);
}
xfullname(A) ::= nm(X) AS nm(Z).  {
  A = sqlite3SrcListAppend(pParse,0,&X,0);
  यदि( A ){
    यदि( अन्तर्_RENAME_OBJECT ){
