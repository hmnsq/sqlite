                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_انگ(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class عدد INTEGER|FLOAT.
plus_انگ(A) ::= PLUS عدد(X).       {A = X;}
plus_انگ(A) ::= عدد(A).
