%ifdef SQLITE_ENABLE_ORDERED_SET_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  স্থির ৰাশিমালা *sqlite3_ৰাশিমালা_Add_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    পূর্ণাঙ্ক isDistinct,        /* DISTINCT or ALL qualifier */
    ৰাশিমালা_List *pOrig,       /* Arguments to the function */
    ৰাশিমালা *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    ৰাশিমালা_List *p;           /* Modified argument list */
    ৰাশিমালা *p_ৰাশিমালা;           /* Final result */
    p = sqlite3_ৰাশিমালা_List_Append(pParse, 0, pOrderby);
    যদি( pOrig ){
      পূর্ণাঙ্ক i;
      বাবে(i=0; i<pOrig->n_ৰাশিমালা; i++){
        p = sqlite3_ৰাশিমালা_List_Append(pParse, p, pOrig->a[i].p_ৰাশিমালা);
        pOrig->a[i].p_ৰাশিমালা = 0;
      }
      sqlite3_ৰাশিমালা_List_Delete(pParse->db, pOrig);
    }
    p_ৰাশিমালা = sqlite3_ৰাশিমালা_Function(pParse, p, pFuncname, 0);
    যদি( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      প্রতিজ্ঞা( p_ৰাশিমালা!=0 );  /* Because otherwise pParse->nErr would not be zero */
      প্রতিজ্ঞা( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3FindFunction(pParse->db, p_ৰাশিমালা->u.zToken, -2, enc, 0);
      যদি( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_বাৰ্তা(pParse, "%#T() is not an ordered-set aggregate", p_ৰাশিমালা);
      }অন্যথা যদি( isDistinct==SF_Distinct ){
        sqlite3_Error_বাৰ্তা(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    ঘূৰাই p_ৰাশিমালা;
  }
}
ৰাশিমালা_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN GROUP LP ORDER BY ৰাশিমালা_2(E) RP. {
  A = sqlite3_ৰাশিমালা_Add_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_SET_AGGREGATES

