%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  స్థిర సమాసం *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    పూర్ణాంకం op,         /* TK_ISNULL or TK_NOTNULL */
    సమాసం *p_ఎడమ     /*నిర్వాహ్యం*/
  ){
    సమాసం *p = p_ఎడమ;
    ప్రతిజ్ఞా( op==TK_ISNULL || op==TK_NOTNULL );
    ప్రతిజ్ఞా( p_ఎడమ!=0 );
    అయితే( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_ఎడమ;
      ప్రతిజ్ఞా( p!=0 );
    }
    ఎంపిక( p->op ){
      స్థితి TK_INTEGER:
      స్థితి TK_STRING:
      స్థితి TK_FLOAT:
      స్థితి TK_BLOB: 
        sqlite3_సమాసం_Deferred_Delete(pParse, p_ఎడమ);
        p = sqlite3_సమాసం_Int32(pParse->db, op==TK_NOTNULL);
        ఒకవేళ( p ) p->op2 = 1;
        తిరిగి p;
      అప్రమేయ:
        ఆపు;
    }
    తిరిగి sqlite3PExpr(pParse, op, p_ఎడమ, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  స్థిర సమాసం *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    పూర్ణాంకం op,         /* TK_IS or TK_ISNOT */
    సమాసం *p_ఎడమ,    /* Left operand */
    సమాసం *p_కుడి    /* Right operand */
  ){
    ఒకవేళ( p_కుడి && p_కుడి->op==TK_NULL ){
      sqlite3_సమాసం_Deferred_Delete(pParse, p_కుడి);
      తిరిగి sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_ఎడమ);
    }
    తిరిగి sqlite3PExpr(pParse, op, p_ఎడమ, p_కుడి);
  }
}

