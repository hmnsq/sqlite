%نوع عبارت_2 {عبارت*}
%destructor عبارت_2 {sqlite3_عبارت_Delete(pParse->db, $$);}
%نوع جمله {عبارت*}
%destructor جمله {sqlite3_عبارت_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  ساكن عبارت *token_عبارت(Parse *pParse, صحيح op, Token t){
    عبارت *p = sqlite3DbMallocRawNN(pParse->db, حجم(عبارت)+t.n+1);
    إذا( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_عبارت = 0;
      p->flags = EP_برگ;
      عبارت_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_چپ = p->p_راست = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, حجم(p->x));
      memset(&p->y, 0, حجم(p->y));
      p->op2 = 0;
      p->i_جدول = 0;
      p->i_ستونی = 0;
      p->u.zToken = (حرف*)&p[1];
      کپی_حافظه(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (صحيح)(t.z - pParse->z_دم);
      إذا( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_عبارت(p);
      }
#إذا SQLITE_MAX_عبارت_عمق>0
      p->n_ارتفاع = 1;
#پایان_اگر  
      إذا( درون_RENAME_OBJECT ){
        أرجع (عبارت*)sqlite3RenameTokenMap(pParse, (فراغ*)p, &t);
      }
    }
    أرجع p;
  }

}

عبارت_2(A) ::= جمله(A).
عبارت_2(A) ::= LP عبارت_2(X) RP. {A = X;}
عبارت_2(A) ::= idj(X).          {A=token_عبارت(pParse,TK_ID,X); /*A-overwrites-X*/}
عبارت_2(A) ::= nm(X) DOT nm(Y). {
  عبارت *temp1 = token_عبارت(pParse,TK_ID,X);
  عبارت *temp2 = token_عبارت(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
عبارت_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  عبارت *temp1 = token_عبارت(pParse,TK_ID,X);
  عبارت *temp2 = token_عبارت(pParse,TK_ID,Y);
  عبارت *temp3 = token_عبارت(pParse,TK_ID,Z);
  عبارت *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  إذا( درون_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
جمله(A) ::= عدم|FLOAT|BLOB(X). {A=token_عبارت(pParse,@X,X); /*A-overwrites-X*/}
جمله(A) ::= STRING(X).          {A=token_عبارت(pParse,@X,X); /*A-overwrites-X*/}
جمله(A) ::= INTEGER(X). {
  صحيح i_مقدار;
  إذا( sqlite3GetInt32(X.z, &i_مقدار)==0 ){
    A = sqlite3_عبارت_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }وإلا{
    A = sqlite3_عبارت_Int32(pParse->db, i_مقدار);
  }
  إذا( A ) A->w.iOfst = (صحيح)(X.z - pParse->z_دم);
}
عبارت_2(A) ::= VARIABLE(X).     {
  إذا( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_عبارت(pParse, TK_VARIABLE, X);
    sqlite3_عبارت_تخصیص_بده_Var_عدد(pParse, A, n);
  }وإلا{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    أكد( t.n>=2 );
    إذا( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }وإلا{
      A = sqlite3PExpr(pParse, TK_ثبات, 0, 0);
      إذا( A ) sqlite3GetInt32(&t.z[1], &A->i_جدول);
    }
  }
}
عبارت_2(A) ::= عبارت_2(A) COLLATE ids(C). {
  A = sqlite3_عبارت_جمع_کن_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
عبارت_2(A) ::= CAST LP عبارت_2(E) AS typetoken(T) RP. {
  A = sqlite3_عبارت_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_عبارت_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
}
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ترتیب BY sortlist(O) RP. {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
  sqlite3_عبارت_جمع_کن_Function_ترتیب_By(pParse, A, O);
}
عبارت_2(A) ::= idj(X) LP ستاره RP. {
  A = sqlite3_عبارت_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_مجموعه_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  ساكن عبارت *sqlite3_عبارت_جمع_کن_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    صحيح isDistinct,        /* DISTINCT or ALL qualifier */
    عبارت_List *pOrig,       /* Arguments to the function */
    عبارت *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    عبارت_List *p;           /* Modified argument list */
    عبارت *p_عبارت;           /* Final result */
    p = sqlite3_عبارت_List_Append(pParse, 0, pOrderby);
    إذا( pOrig ){
      صحيح i;
      لكل(i=0; i<pOrig->n_عبارت; i++){
        p = sqlite3_عبارت_List_Append(pParse, p, pOrig->a[i].p_عبارت);
        pOrig->a[i].p_عبارت = 0;
      }
      sqlite3_عبارت_List_Delete(pParse->db, pOrig);
    }
    p_عبارت = sqlite3_عبارت_Function(pParse, p, pFuncname, 0);
    إذا( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      أكد( p_عبارت!=0 );  /* Because otherwise pParse->nErr would not be zero */
      أكد( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3_پیدا_کن_Function(pParse->db, p_عبارت->u.zToken, -2, enc, 0);
      إذا( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_پیام(pParse, "%#T() is not an ordered-set aggregate", p_عبارت);
      }وإلا إذا( isDistinct==SF_Distinct ){
        sqlite3_Error_پیام(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    أرجع p_عبارت;
  }
}
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN گروه LP ترتیب BY عبارت_2(E) RP. {
  A = sqlite3_عبارت_جمع_کن_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_مجموعه_AGGREGATES

%ifndef SQLITE_OMIT_WINDOWFUNC
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP filter_over(Z). {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
  sqlite3_پنجره_Attach(pParse, A, Z);
}
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ترتیب BY sortlist(O) RP filter_over(Z). {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
  sqlite3_پنجره_Attach(pParse, A, Z);
  sqlite3_عبارت_جمع_کن_Function_ترتیب_By(pParse, A, O);
}
عبارت_2(A) ::= idj(X) LP ستاره RP filter_over(Z). {
  A = sqlite3_عبارت_Function(pParse, 0, &X, 0);
  sqlite3_پنجره_Attach(pParse, A, Z);
}
%ifdef SQLITE_ENABLE_ORDERED_مجموعه_AGGREGATES
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN گروه LP ترتیب BY عبارت_2(E) RP
            filter_over(Z). {
  A = sqlite3_عبارت_جمع_کن_Orderedset_Function(pParse, &X, D, Y, E);
  sqlite3_پنجره_Attach(pParse, A, Z);
}
%endif SQLITE_ENABLE_ORDERED_مجموعه_AGGREGATES

%endif SQLITE_OMIT_WINDOWFUNC

جمله(A) ::= CTIME_KW(OP). {
  A = sqlite3_عبارت_Function(pParse, 0, &OP, 0);
}

عبارت_2(A) ::= LP nexprlist(X) COMMA عبارت_2(Y) RP. {
  عبارت_List *pList = sqlite3_عبارت_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_وکتور, 0, 0);
  إذا( A ){
    صحيح i;
    A->x.pList = pList;
    لكل(i=0; i<pList->n_عبارت; i++){
      أكد( pList->a[i].p_عبارت!=0 );
      A->flags |= pList->a[i].p_عبارت->flags & EP_Propagate;
    }
  }وإلا{
    sqlite3_عبارت_List_Delete(pParse->db, pList);
  }
}

عبارت_2(A) ::= عبارت_2(A) AND عبارت_2(Y).        {A=sqlite3_عبارت_And(pParse,A,Y);}
عبارت_2(A) ::= عبارت_2(A) OR(OP) عبارت_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) LT|GT|GE|LE(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) EQ|NE(OP) عبارت_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) PLUS|MINUS(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) ستاره|SLASH|REM(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) CONCAT(OP) عبارت_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%نوع likeop {Token}
likeop(A) ::= LIKE_KW|تطابق_2(A).
likeop(A) ::= NOT LIKE_KW|تطابق_2(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
عبارت_2(A) ::= عبارت_2(A) likeop(OP) عبارت_2(Y).  [LIKE_KW]  {
  عبارت_List *pList;
  صحيح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_عبارت_List_Append(pParse,0, Y);
  pList = sqlite3_عبارت_List_Append(pParse,pList, A);
  A = sqlite3_عبارت_Function(pParse, pList, &OP, 0);
  إذا( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  إذا( A ) A->flags |= EP_InfixFunc;
}
عبارت_2(A) ::= عبارت_2(A) likeop(OP) عبارت_2(Y) ESCAPE عبارت_2(E).  [LIKE_KW]  {
  عبارت_List *pList;
  صحيح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_عبارت_List_Append(pParse,0, Y);
  pList = sqlite3_عبارت_List_Append(pParse,pList, A);
  pList = sqlite3_عبارت_List_Append(pParse,pList, E);
  A = sqlite3_عبارت_Function(pParse, pList, &OP, 0);
  إذا( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  إذا( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  ساكن عبارت *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    صحيح op,         /* TK_ISNULL or TK_NOTNULL */
    عبارت *p_چپ     /*عملوند*/
  ){
    عبارت *p = p_چپ;
    أكد( op==TK_ISNULL || op==TK_NOTNULL );
    أكد( p_چپ!=0 );
    طالما( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_چپ;
      أكد( p!=0 );
    }
    بدل( p->op ){
      حالة TK_INTEGER:
      حالة TK_STRING:
      حالة TK_FLOAT:
      حالة TK_BLOB: 
        sqlite3_عبارت_Deferred_Delete(pParse, p_چپ);
        p = sqlite3_عبارت_Int32(pParse->db, op==TK_NOTNULL);
        إذا( p ) p->op2 = 1;
        أرجع p;
      افتراضي:
        اكسر;
    }
    أرجع sqlite3PExpr(pParse, op, p_چپ, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  ساكن عبارت *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    صحيح op,         /* TK_IS or TK_ISNOT */
    عبارت *p_چپ,    /* Left operand */
    عبارت *p_راست    /* Right operand */
  ){
    إذا( p_راست && p_راست->op==TK_NULL ){
      sqlite3_عبارت_Deferred_Delete(pParse, p_راست);
      أرجع sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_چپ);
    }
    أرجع sqlite3PExpr(pParse, op, p_چپ, p_راست);
  }
}

عبارت_2(A) ::= عبارت_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
عبارت_2(A) ::= عبارت_2(A) NOT عدم.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
عبارت_2(A) ::= عبارت_2(A) IS عبارت_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
عبارت_2(A) ::= عبارت_2(A) IS NOT عبارت_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
عبارت_2(A) ::= عبارت_2(A) IS NOT DISTINCT FROM عبارت_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
عبارت_2(A) ::= عبارت_2(A) IS DISTINCT FROM عبارت_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

عبارت_2(A) ::= NOT(B) عبارت_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
عبارت_2(A) ::= BITNOT(B) عبارت_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
عبارت_2(A) ::= PLUS|MINUS(B) عبارت_2(X). [BITNOT] {
  عبارت *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  أكد( TK_UPLUS>TK_PLUS );
  أكد( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  إذا( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }وإلا{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

عبارت_2(A) ::= عبارت_2(B) PTR(C) عبارت_2(D). {
  عبارت_List *pList = sqlite3_عبارت_List_Append(pParse, 0, B);
  pList = sqlite3_عبارت_List_Append(pParse, pList, D);
  A = sqlite3_عبارت_Function(pParse, pList, &C, 0);
}

%نوع between_op {صحيح}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
عبارت_2(A) ::= عبارت_2(A) between_op(N) عبارت_2(X) AND عبارت_2(Y). [BETWEEN] {
  عبارت_List *pList = sqlite3_عبارت_List_Append(pParse,0, X);
  pList = sqlite3_عبارت_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  إذا( A ){
    A->x.pList = pList;
    sqlite3_عبارت_مجموعه_ارتفاع_And_Flags(pParse, A);
  }وإلا{
    sqlite3_عبارت_List_Delete(pParse->db, pList);
  } 
  إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %نوع درون_op {صحيح}
  درون_op(A) ::= درون_2.      {A = 0;}
  درون_op(A) ::= NOT درون_2.  {A = 1;}
  عبارت_2(A) ::= عبارت_2(A) درون_op(N) LP exprlist(Y) RP. [IN] {
    إذا( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      عبارت *pB = sqlite3_عبارت(pParse->db, TK_STRING, N ? "true" : "false");
      إذا( pB ) sqlite3_عبارت_Id_مقصد_True_False(pB);
      إذا( !عبارت_Has_Property(A, EP_HasFunc) ){
        sqlite3_عبارت_Unmap_And_Delete(pParse, A);
        A = pB;
      }وإلا{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }وإلا{
      عبارت *pRHS = Y->a[0].p_عبارت;
      إذا( Y->n_عبارت==1
       && sqlite3_عبارت_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_وکتور
      ){
        Y->a[0].p_عبارت = 0;
        sqlite3_عبارت_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }وإلا إذا( Y->n_عبارت==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_درون, A, 0);
        sqlite3_PExpr_جمع_کن_Select(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_عبارت_List_Delete(pParse->db, Y);
      }وإلا{
        A = sqlite3PExpr(pParse, TK_درون, A, 0);
        إذا( A==0 ){
          sqlite3_عبارت_List_Delete(pParse->db, Y);
        }وإلا إذا( A->p_چپ->op==TK_وکتور ){
          صحيح n_عبارت = A->p_چپ->x.pList->n_عبارت;
          Select *pSelectRHS = sqlite3_عبارت_List_مقصد_مقادیر(pParse, n_عبارت, Y);
          إذا( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3_PExpr_جمع_کن_Select(pParse, A, pSelectRHS);
          }
        }وإلا{
          A->x.pList = Y;
          sqlite3_عبارت_مجموعه_ارتفاع_And_Flags(pParse, A);
        }
      }
      إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  عبارت_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3_PExpr_جمع_کن_Select(pParse, A, X);
  }
  عبارت_2(A) ::= عبارت_2(A) درون_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_درون, A, 0);
    sqlite3_PExpr_جمع_کن_Select(pParse, A, Y);
    إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  عبارت_2(A) ::= عبارت_2(A) درون_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    إذا( E )  sqlite3_Src_List_Func_آرگومانها(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_درون, A, 0);
    sqlite3_PExpr_جمع_کن_Select(pParse, A, pSelect);
    إذا( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  عبارت_2(A) ::= EXISTS LP select(Y) RP. {
    عبارت *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_جمع_کن_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
عبارت_2(A) ::= CASE case_عملوند(X) case_exprlist(Y) case_else(Z) انتها. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  إذا( A ){
    A->x.pList = Z ? sqlite3_عبارت_List_Append(pParse,Y,Z) : Y;
    sqlite3_عبارت_مجموعه_ارتفاع_And_Flags(pParse, A);
  }وإلا{
    sqlite3_عبارت_List_Delete(pParse->db, Y);
    sqlite3_عبارت_Delete(pParse->db, Z);
  }
}
%نوع case_exprlist {عبارت_List*}
%destructor case_exprlist {sqlite3_عبارت_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN عبارت_2(Y) THEN عبارت_2(Z). {
  A = sqlite3_عبارت_List_Append(pParse,A, Y);
  A = sqlite3_عبارت_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN عبارت_2(Y) THEN عبارت_2(Z). {
  A = sqlite3_عبارت_List_Append(pParse,0, Y);
  A = sqlite3_عبارت_List_Append(pParse,A, Z);
}
%نوع case_else {عبارت*}
%destructor case_else {sqlite3_عبارت_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE عبارت_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%نوع case_عملوند {عبارت*}
%destructor case_عملوند {sqlite3_عبارت_Delete(pParse->db, $$);}
case_عملوند(A) ::= عبارت_2(A).
case_عملوند(A) ::= .                   {A = 0;} 

%نوع exprlist {عبارت_List*}
%destructor exprlist {sqlite3_عبارت_List_Delete(pParse->db, $$);}
%نوع nexprlist {عبارت_List*}
%destructor nexprlist {sqlite3_عبارت_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA عبارت_2(Y).
    {A = sqlite3_عبارت_List_Append(pParse,A,Y);}
nexprlist(A) ::= عبارت_2(Y).
    {A = sqlite3_عبارت_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%نوع paren_exprlist {عبارت_List*}
%destructor paren_exprlist {sqlite3_عبارت_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
%endif SQLITE_OMIT_SUBQUERY


///////////////////////////// The CREATE INDEX command ///////////////////////
//
cmd ::= createkw(S) uniqueflag(U) شاخص_2 ifnotexists(NE) nm(X) dbnm(D)
        ON nm(Y) LP sortlist(Z) RP where_opt(W). {
  sqlite3_Create_شاخص(pParse, &X, &D, 
                     sqlite3SrcListAppend(pParse,0,&Y,0), Z, U,
                      &S, W, SQLITE_SO_ASC, NE, SQLITE_IDXTYPE_APPDEF);
  إذا( درون_RENAME_OBJECT && pParse->p_New_شاخص ){
    sqlite3RenameTokenMap(pParse, pParse->p_New_شاخص->zName, &Y);
  }
}

%نوع uniqueflag {صحيح}
uniqueflag(A) ::= UNIQUE.  {A = OE_Abort;}
uniqueflag(A) ::= .        {A = OE_None;}


// The eidlist non-terminal (Expression Id List) generates an ExprList
// from a list of identifiers.  The identifier names are in ExprList.a[].zName.
// This list is stored in an ExprList rather than an IdList so that it
// can be easily sent to sqlite3ColumnsExprList().
//
// eidlist is grouped with CREATE INDEX because it used to be the non-terminal
// used for the arguments to an index.  That is just an historical accident.
//
// IMPORTANT COMPATIBILITY NOTE:  Some prior versions of SQLite accepted
// COLLATE clauses and ASC or DESC keywords on ID lists in inappropriate
// places - places that might have been stored in the sqlite_schema table.
// Those extra features were ignored.  But because they might be in some
// (busted) old databases, we need to continue parsing them when loading
// historical schemas.
//
%نوع eidlist {عبارت_List*}
%destructor eidlist {sqlite3_عبارت_List_Delete(pParse->db, $$);}
%نوع eidlist_opt {عبارت_List*}
%destructor eidlist_opt {sqlite3_عبارت_List_Delete(pParse->db, $$);}

%include {
  /* Add a single new term to an ExprList that is used to store a
  ** list of identifiers.  Report an error if the ID list contains
  ** a COLLATE clause or an ASC or DESC keyword, except ignore the
  ** error while parsing a legacy schema.
  */
  ساكن عبارت_List *parser_جمع_کن_عبارت_Id_List_جمله(
    Parse *pParse,
    عبارت_List *p_پیشین,
    Token *pIdToken,
    صحيح hasCollate,
    صحيح مرتب_سازی_ترتیب
  ){
    عبارت_List *p = sqlite3_عبارت_List_Append(pParse, p_پیشین, 0);
    إذا( (hasCollate || مرتب_سازی_ترتیب!=SQLITE_SO_UNDEFINED)
        && pParse->db->init.busy==0
    ){
      sqlite3_Error_پیام(pParse, "syntax error after column name \"%.*s\"",
                         pIdToken->n, pIdToken->z);
    }
    sqlite3_عبارت_List_مجموعه_Name(pParse, p, pIdToken, 1);
    أرجع p;
  }
} // end %include

eidlist_opt(A) ::= .                         {A = 0;}
eidlist_opt(A) ::= LP eidlist(X) RP.         {A = X;}
eidlist(A) ::= eidlist(A) COMMA nm(Y) collate(C) sortorder(Z).  {
  A = parser_جمع_کن_عبارت_Id_List_جمله(pParse, A, &Y, C, Z);
}
eidlist(A) ::= nm(Y) collate(C) sortorder(Z). {
  A = parser_جمع_کن_عبارت_Id_List_جمله(pParse, 0, &Y, C, Z); /*A-overwrites-Y*/
}

%نوع collate {صحيح}
collate(C) ::= .              {C = 0;}
collate(C) ::= COLLATE ids.   {C = 1;}


///////////////////////////// The DROP INDEX command /////////////////////////
//
cmd ::= DROP شاخص_2 ifexists(E) fullname(X).   {sqlite3_Drop_شاخص(pParse, X, E);}

///////////////////////////// The VACUUM command /////////////////////////////
//
%إذا !SQLITE_OMIT_VACUUM && !SQLITE_OMIT_ATTACH
%نوع vinto {عبارت*}
%destructor vinto {sqlite3_عبارت_Delete(pParse->db, $$);}
cmd ::= VACUUM vinto(Y).                {sqlite3Vacuum(pParse,0,Y);}
cmd ::= VACUUM nm(X) vinto(Y).          {sqlite3Vacuum(pParse,&X,Y);}
vinto(A) ::= INTO عبارت_2(X).              {A = X;}
vinto(A) ::= .                          {A = 0;}
%endif

///////////////////////////// The PRAGMA command /////////////////////////////
//
%ifndef SQLITE_OMIT_PRAGMA
cmd ::= PRAGMA nm(X) dbnm(Z).                {sqlite3Pragma(pParse,&X,&Z,0,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ nmnum(Y).    {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP nmnum(Y) RP. {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ minus_رقم(Y). 
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP minus_رقم(Y) RP.
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_رقم(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class عدد INTEGER|FLOAT.
plus_رقم(A) ::= PLUS عدد(X).       {A = X;}
plus_رقم(A) ::= عدد(A).
minus_رقم(A) ::= MINUS عدد(X).     {A = X;}
//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) انتها(Z). {
  Token all;
  all.z = A.z;
  all.n = (صحيح)(Z.z - A.z) + Z.n;
  sqlite3_پایان_Trigger(pParse, S, &all);
}

trigger_decl(A) ::= موقت(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_زمان(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#اگر_تعریف_شده SQLITE_DEBUG
  أكد( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#پایان_اگر
}

%نوع trigger_زمان {صحيح}
trigger_زمان(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_زمان(A) ::= INSTEAD از_2.  { A = TK_INSTEAD;}
trigger_زمان(A) ::= .            { A = TK_BEFORE; }

%نوع trigger_event {بنية TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|درج(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE از_2 idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH ردیف.

%نوع when_clause {عبارت*}
%destructor when_clause {sqlite3_عبارت_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN عبارت_2(X). { A = X; }

%نوع trigger_cmd_list {Trigger_گام*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_گام(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_آخرین->p_بعدی = X;
  A->p_آخرین = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->p_آخرین = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= نمایهای BY nm. {
  sqlite3_Error_پیام(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT نمایهای. {
  sqlite3_Error_پیام(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%نوع trigger_cmd {Trigger_گام*}
%destructor trigger_cmd {sqlite3_Delete_Trigger_گام(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby مجموعه setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3_Trigger_Update_گام(pParse, X, F, Y, Z, R, B.z, E);}

//درج
trigger_cmd(A) ::= scanpt(B) درج_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_درج_گام(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3_Trigger_Delete_گام(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3_Trigger_Select_گام(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
عبارت_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  إذا( A ){
    A->aff_عبارت = OE_Ignore;
  }
}
عبارت_2(A) ::= RAISE LP raisetype(T) COMMA عبارت_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  إذا( A ) {
    A->aff_عبارت = (حرف)T;
  }
}
%endif  !SQLITE_OMIT_TRIGGER

%نوع raisetype {صحيح}
raisetype(A) ::= ROLLBACK.  {A = OE_Rollback;}
raisetype(A) ::= ABORT.     {A = OE_Abort;}
raisetype(A) ::= FAIL.      {A = OE_Fail;}


