  A = sqlite3_गवाक्षः_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
frame_opt(A) ::= range_or_पङ्क्तिकाः(X) frame_bound_s(Y) frame_exclude_opt(Z). { 
  A = sqlite3_गवाक्षः_Alloc(pParse, X, Y.eType, Y.p_व्यञ्जकम्, TK_CURRENT, 0, Z);
}
frame_opt(A) ::= range_or_पङ्क्तिकाः(X) BETWEEN frame_bound_s(Y) AND
                          frame_bound_e(Z) frame_exclude_opt(W). { 
  A = sqlite3_गवाक्षः_Alloc(pParse, X, Y.eType, Y.p_व्यञ्जकम्, Z.eType, Z.p_व्यञ्जकम्, W);
}

range_or_पङ्क्तिकाः(A) ::= RANGE|पङ्क्तिकाः|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

frame_bound_s(A) ::= frame_bound(X).         {A = X;}
frame_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_व्यञ्जकम् = 0;}
frame_bound_e(A) ::= frame_bound(X).         {A = X;}
frame_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_व्यञ्जकम् = 0;}

frame_bound(A) ::= व्यञ्जकम्_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_व्यञ्जकम् = X;}
frame_bound(A) ::= CURRENT(X) ROW.           {A.eType = @X; A.p_व्यञ्जकम् = 0;}

%प्रकार frame_exclude_opt {u8}
frame_exclude_opt(A) ::= . {A = 0;}
frame_exclude_opt(A) ::= EXCLUDE frame_exclude(X). {A = X;}

%प्रकार frame_exclude {u8}
frame_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
frame_exclude(A) ::= CURRENT(X) ROW. {A = @X; /*A-overwrites-X*/}
frame_exclude(A) ::= गणः|TIES(X).  {A = @X; /*A-overwrites-X*/}


%प्रकार गवाक्षः_clause {गवाक्षः*}
%destructor गवाक्षः_clause {sqlite3_गवाक्षः_List_Delete(pParse->db, $$);}
गवाक्षः_clause(A) ::= गवाक्षः_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  यदि( O ){
    O->pFilter = F;
  }अन्यथा{
    sqlite3_व्यञ्जकम्_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (गवाक्षः*)sqlite3DbMallocZero(pParse->db, परिमाण(गवाक्षः));
  यदि( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }अन्यथा{
    sqlite3_व्यञ्जकम्_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP गवाक्षः_2(Z) RP. {
  A = Z;
  प्रतिज्ञा( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (गवाक्षः*)sqlite3DbMallocZero(pParse->db, परिमाण(गवाक्षः));
  यदि( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE व्यञ्जकम्_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%शब्दांशः
  COLUMN          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_COLUMN      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  पञ्जिकाकोशः        /* Reference to a VDBE register */
  सदिशम्          /*सदिशम्*/
  SELECT_COLUMN   /* Choose a single column from a multi-column SELECT */
  IF_NULL_ROW     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  विस्तृतिः            /* The span operator */
  ERROR           /* An expression containing an error */
.

पदांशः(A) ::= QNUMBER(X). {
  A=token_व्यञ्जकम्(pParse,@X,X);
  sqlite3_Dequote_सङ्ख्या(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#यदि TK_विस्तृतिः>255
# error too many tokens in the grammar
#यदि_अन्तः
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%शब्दांशः SPACE COMMENT ILLEGAL.
