}

ਵਿਅੰਜਕ_2(A) ::= NOT(B) ਵਿਅੰਜਕ_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
ਵਿਅੰਜਕ_2(A) ::= BITNOT(B) ਵਿਅੰਜਕ_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
ਵਿਅੰਜਕ_2(A) ::= PLUS|MINUS(B) ਵਿਅੰਜਕ_2(X). [BITNOT] {
  ਵਿਅੰਜਕ *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  ਪ੍ਰਤਿਜ੍ਞਾ( TK_UPLUS>TK_PLUS );
  ਪ੍ਰਤਿਜ੍ਞਾ( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  ਜੇ( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }ਨਹੀਂਤਾਂ{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

ਵਿਅੰਜਕ_2(A) ::= ਵਿਅੰਜਕ_2(B) PTR(C) ਵਿਅੰਜਕ_2(D). {
