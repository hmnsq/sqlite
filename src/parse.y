%نوع عبارت_2 {عبارت*}
%destructor عبارت_2 {sqlite3_عبارت_Delete(pParse->db, $$);}
%نوع term {عبارت*}
%destructor term {sqlite3_عبارت_Delete(pParse->db, $$);}

%include {

  /* Construct a new Expr object from a single token */
  ایستا عبارت *token_عبارت(Parse *pParse, صحیح op, Token t){
    عبارت *p = sqlite3DbMallocRawNN(pParse->db, اندازه(عبارت)+t.n+1);
    اگر( p ){
      /* memset(p, 0, sizeof(Expr)); */
      p->op = (u8)op;
      p->aff_عبارت = 0;
      p->flags = EP_Leaf;
      عبارت_Clear_VVAProperties(p);
      /* p->iAgg = -1; // Not required */
      p->p_چپ = p->p_راست = 0;
      p->pAggInfo = 0;
      memset(&p->x, 0, اندازه(p->x));
      memset(&p->y, 0, اندازه(p->y));
      p->op2 = 0;
      p->iTable = 0;
      p->iColumn = 0;
      p->u.zToken = (نویسه*)&p[1];
      memcpy(p->u.zToken, t.z, t.n);
      p->u.zToken[t.n] = 0;
      p->w.iOfst = (صحیح)(t.z - pParse->zTail);
      اگر( sqlite3Isquote(p->u.zToken[0]) ){
        sqlite3_Dequote_عبارت(p);
      }
#اگر SQLITE_MAX_عبارت_DEPTH>0
      p->nHeight = 1;
#endif  
      اگر( IN_RENAME_OBJECT ){
        بازگشت (عبارت*)sqlite3RenameTokenMap(pParse, (تهی*)p, &t);
      }
    }
    بازگشت p;
  }

}

عبارت_2(A) ::= term(A).
عبارت_2(A) ::= LP عبارت_2(X) RP. {A = X;}
عبارت_2(A) ::= idj(X).          {A=token_عبارت(pParse,TK_ID,X); /*A-overwrites-X*/}
عبارت_2(A) ::= nm(X) DOT nm(Y). {
  عبارت *temp1 = token_عبارت(pParse,TK_ID,X);
  عبارت *temp2 = token_عبارت(pParse,TK_ID,Y);
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp2);
}
عبارت_2(A) ::= nm(X) DOT nm(Y) DOT nm(Z). {
  عبارت *temp1 = token_عبارت(pParse,TK_ID,X);
  عبارت *temp2 = token_عبارت(pParse,TK_ID,Y);
  عبارت *temp3 = token_عبارت(pParse,TK_ID,Z);
  عبارت *temp4 = sqlite3PExpr(pParse, TK_DOT, temp2, temp3);
  اگر( IN_RENAME_OBJECT ){
    sqlite3RenameTokenRemap(pParse, 0, temp1);
  }
  A = sqlite3PExpr(pParse, TK_DOT, temp1, temp4);
}
term(A) ::= پوچ|FLOAT|BLOB(X). {A=token_عبارت(pParse,@X,X); /*A-overwrites-X*/}
term(A) ::= STRING(X).          {A=token_عبارت(pParse,@X,X); /*A-overwrites-X*/}
term(A) ::= INTEGER(X). {
  صحیح i_مقدار;
  اگر( sqlite3GetInt32(X.z, &i_مقدار)==0 ){
    A = sqlite3_عبارت_Alloc(pParse->db, TK_INTEGER, &X, 0);
  }وگرنه{
    A = sqlite3_عبارت_Int32(pParse->db, i_مقدار);
  }
  اگر( A ) A->w.iOfst = (صحیح)(X.z - pParse->zTail);
}
عبارت_2(A) ::= VARIABLE(X).     {
  اگر( !(X.z[0]=='#' && sqlite3Isdigit(X.z[1])) ){
    u32 n = X.n;
    A = token_عبارت(pParse, TK_VARIABLE, X);
    sqlite3_عبارت_Assign_Var_عدد(pParse, A, n);
  }وگرنه{
    /* When doing a nested parse, one can include terms in an expression
    ** that look like this:   #1 #2 ...  These terms refer to registers
    ** in the virtual machine.  #N is the N-th register. */
    Token t = X; /*A-overwrites-X*/
    أكد( t.n>=2 );
    اگر( pParse->nested==0 ){
      parserSyntaxError(pParse, &t);
      A = 0;
    }وگرنه{
      A = sqlite3PExpr(pParse, TK_REGISTER, 0, 0);
      اگر( A ) sqlite3GetInt32(&t.z[1], &A->iTable);
    }
  }
}
عبارت_2(A) ::= عبارت_2(A) COLLATE ids(C). {
  A = sqlite3_عبارت_Add_Collate_Token(pParse, A, &C, 1);
}
%ifndef SQLITE_OMIT_CAST
عبارت_2(A) ::= CAST LP عبارت_2(E) AS typetoken(T) RP. {
  A = sqlite3_عبارت_Alloc(pParse->db, TK_CAST, &T, 1);
  sqlite3_عبارت_Attach_Subtrees(pParse->db, A, E, 0);
}
%endif  SQLITE_OMIT_CAST


عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP. {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
}
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ORDER BY sortlist(O) RP. {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
  sqlite3_عبارت_Add_Function_Order_By(pParse, A, O);
}
عبارت_2(A) ::= idj(X) LP STAR RP. {
  A = sqlite3_عبارت_Function(pParse, 0, &X, 0);
}

%ifdef SQLITE_ENABLE_ORDERED_SET_AGGREGATES
%include {
  /* Generate an expression node that represents an ordered-set aggregate function.
  **
  ** SQLite does not do anything special to evaluate ordered-set aggregates.  The
  ** aggregate function itself is expected to do any required ordering on its own.
  ** This is just syntactic sugar.
  **
  ** This syntax:        percentile(f) WITHIN GROUP ( ORDER BY y )
  **
  ** Is equivalent to:   percentile(y,f)
  **
  ** The purpose of this function is to generate an Expr node from the first syntax
  ** into a TK_FUNCTION node that looks like it came from the second syntax.
  **
  ** Only functions that have the SQLITE_SELFORDER1 property are allowed to do this
  ** transformation.  Because DISTINCT is not allowed in the ordered-set aggregate
  ** syntax, an error is raised if DISTINCT is used.
  */
  ایستا عبارت *sqlite3_عبارت_Add_Orderedset_Function(
    Parse *pParse,         /* Parsing context */
    Token *pFuncname,      /* Name of the function */
    صحیح isDistinct,        /* DISTINCT or ALL qualifier */
    عبارت_List *pOrig,       /* Arguments to the function */
    عبارت *pOrderby         /* Expression in the ORDER BY clause */                
  ){
    عبارت_List *p;           /* Modified argument list */
    عبارت *p_عبارت;           /* Final result */
    p = sqlite3_عبارت_List_Append(pParse, 0, pOrderby);
    اگر( pOrig ){
      صحیح i;
      برای(i=0; i<pOrig->n_عبارت; i++){
        p = sqlite3_عبارت_List_Append(pParse, p, pOrig->a[i].p_عبارت);
        pOrig->a[i].p_عبارت = 0;
      }
      sqlite3_عبارت_List_Delete(pParse->db, pOrig);
    }
    p_عبارت = sqlite3_عبارت_Function(pParse, p, pFuncname, 0);
    اگر( pParse->nErr==0 ){
      FuncDef *pDef;
      u8 enc = ENC(pParse->db);
      أكد( p_عبارت!=0 );  /* Because otherwise pParse->nErr would not be zero */
      أكد( p!=0 );      /* Because otherwise pParse->nErr would not be zero */
      pDef = sqlite3FindFunction(pParse->db, p_عبارت->u.zToken, -2, enc, 0);
      اگر( pDef==0 || (pDef->funcFlags & SQLITE_SELFORDER1)==0 ){
        sqlite3_Error_پیام(pParse, "%#T() is not an ordered-set aggregate", p_عبارت);
      }وگرنه اگر( isDistinct==SF_Distinct ){
        sqlite3_Error_پیام(pParse, "DISTINCT not allowed on ordered-set aggregate %T()",
                        pFuncname);
      }
    }
    بازگشت p_عبارت;
  }
}
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN GROUP LP ORDER BY عبارت_2(E) RP. {
  A = sqlite3_عبارت_Add_Orderedset_Function(pParse, &X, D, Y, E);
}
%endif SQLITE_ENABLE_ORDERED_SET_AGGREGATES

%ifndef SQLITE_OMIT_WINDOWFUNC
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP filter_over(Z). {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
  sqlite3WindowAttach(pParse, A, Z);
}
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) ORDER BY sortlist(O) RP filter_over(Z). {
  A = sqlite3_عبارت_Function(pParse, Y, &X, D);
  sqlite3WindowAttach(pParse, A, Z);
  sqlite3_عبارت_Add_Function_Order_By(pParse, A, O);
}
عبارت_2(A) ::= idj(X) LP STAR RP filter_over(Z). {
  A = sqlite3_عبارت_Function(pParse, 0, &X, 0);
  sqlite3WindowAttach(pParse, A, Z);
}
%ifdef SQLITE_ENABLE_ORDERED_SET_AGGREGATES
عبارت_2(A) ::= idj(X) LP distinct(D) exprlist(Y) RP WITHIN GROUP LP ORDER BY عبارت_2(E) RP
            filter_over(Z). {
  A = sqlite3_عبارت_Add_Orderedset_Function(pParse, &X, D, Y, E);
  sqlite3WindowAttach(pParse, A, Z);
}
%endif SQLITE_ENABLE_ORDERED_SET_AGGREGATES

%endif SQLITE_OMIT_WINDOWFUNC

term(A) ::= CTIME_KW(OP). {
  A = sqlite3_عبارت_Function(pParse, 0, &OP, 0);
}

عبارت_2(A) ::= LP nexprlist(X) COMMA عبارت_2(Y) RP. {
  عبارت_List *pList = sqlite3_عبارت_List_Append(pParse, X, Y);
  A = sqlite3PExpr(pParse, TK_VECTOR, 0, 0);
  اگر( A ){
    صحیح i;
    A->x.pList = pList;
    برای(i=0; i<pList->n_عبارت; i++){
      أكد( pList->a[i].p_عبارت!=0 );
      A->flags |= pList->a[i].p_عبارت->flags & EP_Propagate;
    }
  }وگرنه{
    sqlite3_عبارت_List_Delete(pParse->db, pList);
  }
}

عبارت_2(A) ::= عبارت_2(A) AND عبارت_2(Y).        {A=sqlite3_عبارت_And(pParse,A,Y);}
عبارت_2(A) ::= عبارت_2(A) OR(OP) عبارت_2(Y).     {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) LT|GT|GE|LE(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) EQ|NE(OP) عبارت_2(Y).  {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) BITAND|BITOR|LSHIFT|RSHIFT(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) PLUS|MINUS(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) STAR|SLASH|REM(OP) عبارت_2(Y).
                                        {A=sqlite3PExpr(pParse,@OP,A,Y);}
عبارت_2(A) ::= عبارت_2(A) CONCAT(OP) عبارت_2(Y). {A=sqlite3PExpr(pParse,@OP,A,Y);}
%نوع likeop {Token}
likeop(A) ::= LIKE_KW|MATCH(A).
likeop(A) ::= NOT LIKE_KW|MATCH(X). {A=X; A.n|=0x80000000; /*A-overwrite-X*/}
عبارت_2(A) ::= عبارت_2(A) likeop(OP) عبارت_2(Y).  [LIKE_KW]  {
  عبارت_List *pList;
  صحیح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_عبارت_List_Append(pParse,0, Y);
  pList = sqlite3_عبارت_List_Append(pParse,pList, A);
  A = sqlite3_عبارت_Function(pParse, pList, &OP, 0);
  اگر( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  اگر( A ) A->flags |= EP_InfixFunc;
}
عبارت_2(A) ::= عبارت_2(A) likeop(OP) عبارت_2(Y) ESCAPE عبارت_2(E).  [LIKE_KW]  {
  عبارت_List *pList;
  صحیح bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_عبارت_List_Append(pParse,0, Y);
  pList = sqlite3_عبارت_List_Append(pParse,pList, A);
  pList = sqlite3_عبارت_List_Append(pParse,pList, E);
  A = sqlite3_عبارت_Function(pParse, pList, &OP, 0);
  اگر( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  اگر( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  ایستا عبارت *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    صحیح op,         /* TK_ISNULL or TK_NOTNULL */
    عبارت *p_چپ     /* Operand */
  ){
    عبارت *p = p_چپ;
    أكد( op==TK_ISNULL || op==TK_NOTNULL );
    أكد( p_چپ!=0 );
    وقتی( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_چپ;
      أكد( p!=0 );
    }
    انتخاب( p->op ){
      حالت TK_INTEGER:
      حالت TK_STRING:
      حالت TK_FLOAT:
      حالت TK_BLOB: 
        sqlite3_عبارت_Deferred_Delete(pParse, p_چپ);
        p = sqlite3_عبارت_Int32(pParse->db, op==TK_NOTNULL);
        اگر( p ) p->op2 = 1;
        بازگشت p;
      پیشفرض:
        بشکن;
    }
    بازگشت sqlite3PExpr(pParse, op, p_چپ, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  ایستا عبارت *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    صحیح op,         /* TK_IS or TK_ISNOT */
    عبارت *p_چپ,    /* Left operand */
    عبارت *p_راست    /* Right operand */
  ){
    اگر( p_راست && p_راست->op==TK_NULL ){
      sqlite3_عبارت_Deferred_Delete(pParse, p_راست);
      بازگشت sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_چپ);
    }
    بازگشت sqlite3PExpr(pParse, op, p_چپ, p_راست);
  }
}

عبارت_2(A) ::= عبارت_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
عبارت_2(A) ::= عبارت_2(A) NOT پوچ.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
عبارت_2(A) ::= عبارت_2(A) IS عبارت_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
عبارت_2(A) ::= عبارت_2(A) IS NOT عبارت_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}
عبارت_2(A) ::= عبارت_2(A) IS NOT DISTINCT FROM عبارت_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
عبارت_2(A) ::= عبارت_2(A) IS DISTINCT FROM عبارت_2(Y). {
  A = sqlite3PExprIs(pParse, TK_ISNOT, A, Y);
}

عبارت_2(A) ::= NOT(B) عبارت_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
عبارت_2(A) ::= BITNOT(B) عبارت_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
عبارت_2(A) ::= PLUS|MINUS(B) عبارت_2(X). [BITNOT] {
  عبارت *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  أكد( TK_UPLUS>TK_PLUS );
  أكد( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  اگر( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }وگرنه{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

عبارت_2(A) ::= عبارت_2(B) PTR(C) عبارت_2(D). {
  عبارت_List *pList = sqlite3_عبارت_List_Append(pParse, 0, B);
  pList = sqlite3_عبارت_List_Append(pParse, pList, D);
  A = sqlite3_عبارت_Function(pParse, pList, &C, 0);
}

%نوع between_op {صحیح}
between_op(A) ::= BETWEEN.     {A = 0;}
between_op(A) ::= NOT BETWEEN. {A = 1;}
عبارت_2(A) ::= عبارت_2(A) between_op(N) عبارت_2(X) AND عبارت_2(Y). [BETWEEN] {
  عبارت_List *pList = sqlite3_عبارت_List_Append(pParse,0, X);
  pList = sqlite3_عبارت_List_Append(pParse,pList, Y);
  A = sqlite3PExpr(pParse, TK_BETWEEN, A, 0);
  اگر( A ){
    A->x.pList = pList;
    sqlite3_عبارت_Set_Height_And_Flags(pParse, A);
  }وگرنه{
    sqlite3_عبارت_List_Delete(pParse->db, pList);
  } 
  اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
}
%ifndef SQLITE_OMIT_SUBQUERY
  %نوع in_op {صحیح}
  in_op(A) ::= IN.      {A = 0;}
  in_op(A) ::= NOT IN.  {A = 1;}
  عبارت_2(A) ::= عبارت_2(A) in_op(N) LP exprlist(Y) RP. [IN] {
    اگر( Y==0 ){
      /* Expressions of the form
      **
      **      expr1 IN ()
      **      expr1 NOT IN ()
      **
      ** simplify to constants 0 (false) and 1 (true), respectively.
      **
      ** Except, do not apply this optimization if expr1 contains a function
      ** because that function might be an aggregate (we don't know yet whether
      ** it is or not) and if it is an aggregate, that could change the meaning
      ** of the whole query.
      */
      عبارت *pB = sqlite3_عبارت(pParse->db, TK_STRING, N ? "true" : "false");
      اگر( pB ) sqlite3_عبارت_Id_To_True_False(pB);
      اگر( !عبارت_Has_Property(A, EP_HasFunc) ){
        sqlite3_عبارت_Unmap_And_Delete(pParse, A);
        A = pB;
      }وگرنه{
        A = sqlite3PExpr(pParse, N ? TK_OR : TK_AND, pB, A);
      }
    }وگرنه{
      عبارت *pRHS = Y->a[0].p_عبارت;
      اگر( Y->n_عبارت==1
       && sqlite3_عبارت_Is_Constant(pParse,pRHS)
       && pRHS->op!=TK_COLLATE
       && A->op!=TK_VECTOR
      ){
        Y->a[0].p_عبارت = 0;
        sqlite3_عبارت_List_Delete(pParse->db, Y);
        pRHS = sqlite3PExpr(pParse, TK_UPLUS, pRHS, 0);
        A = sqlite3PExpr(pParse, TK_EQ, A, pRHS);
      }وگرنه اگر( Y->n_عبارت==1 && pRHS->op==TK_SELECT ){
        A = sqlite3PExpr(pParse, TK_IN, A, 0);
        sqlite3PExprAddSelect(pParse, A, pRHS->x.pSelect);
        pRHS->x.pSelect = 0;
        sqlite3_عبارت_List_Delete(pParse->db, Y);
      }وگرنه{
        A = sqlite3PExpr(pParse, TK_IN, A, 0);
        اگر( A==0 ){
          sqlite3_عبارت_List_Delete(pParse->db, Y);
        }وگرنه اگر( A->p_چپ->op==TK_VECTOR ){
          صحیح n_عبارت = A->p_چپ->x.pList->n_عبارت;
          Select *pSelectRHS = sqlite3_عبارت_List_To_مقادیر(pParse, n_عبارت, Y);
          اگر( pSelectRHS ){
            parserDoubleLinkSelect(pParse, pSelectRHS);
            sqlite3PExprAddSelect(pParse, A, pSelectRHS);
          }
        }وگرنه{
          A->x.pList = Y;
          sqlite3_عبارت_Set_Height_And_Flags(pParse, A);
        }
      }
      اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
    }
  }
  عبارت_2(A) ::= LP select(X) RP. {
    A = sqlite3PExpr(pParse, TK_SELECT, 0, 0);
    sqlite3PExprAddSelect(pParse, A, X);
  }
  عبارت_2(A) ::= عبارت_2(A) in_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_IN, A, 0);
    sqlite3PExprAddSelect(pParse, A, Y);
    اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  عبارت_2(A) ::= عبارت_2(A) in_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    اگر( E )  sqlite3SrcListFuncArgs(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_IN, A, 0);
    sqlite3PExprAddSelect(pParse, A, pSelect);
    اگر( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  عبارت_2(A) ::= EXISTS LP select(Y) RP. {
    عبارت *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3PExprAddSelect(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
عبارت_2(A) ::= CASE case_operand(X) case_exprlist(Y) case_else(Z) END. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  اگر( A ){
    A->x.pList = Z ? sqlite3_عبارت_List_Append(pParse,Y,Z) : Y;
    sqlite3_عبارت_Set_Height_And_Flags(pParse, A);
  }وگرنه{
    sqlite3_عبارت_List_Delete(pParse->db, Y);
    sqlite3_عبارت_Delete(pParse->db, Z);
  }
}
%نوع case_exprlist {عبارت_List*}
