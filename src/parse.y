  OP.n &= 0x7fffffff;
  pList = sqlite3_ৰাশিমালা_List_Append(pParse,0, Y);
  pList = sqlite3_ৰাশিমালা_List_Append(pParse,pList, A);
  A = sqlite3_ৰাশিমালা_Function(pParse, pList, &OP, 0);
  যদি( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  যদি( A ) A->flags |= EP_InfixFunc;
}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) likeop(OP) ৰাশিমালা_2(Y) ESCAPE ৰাশিমালা_2(E).  [LIKE_KW]  {
  ৰাশিমালা_List *pList;
  পূর্ণাঙ্ক bNot = OP.n & 0x80000000;
  OP.n &= 0x7fffffff;
  pList = sqlite3_ৰাশিমালা_List_Append(pParse,0, Y);
  pList = sqlite3_ৰাশিমালা_List_Append(pParse,pList, A);
  pList = sqlite3_ৰাশিমালা_List_Append(pParse,pList, E);
  A = sqlite3_ৰাশিমালা_Function(pParse, pList, &OP, 0);
  যদি( bNot ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  যদি( A ) A->flags |= EP_InfixFunc;
}

%include {
  /* Create a TK_ISNULL or TK_NOTNULL expression, perhaps optimized to
  ** to TK_TRUEFALSE, if possible */
  স্থির ৰাশিমালা *sqlite3PExprIsNull(
    Parse *pParse,  /* Parsing context */
    পূর্ণাঙ্ক op,         /* TK_ISNULL or TK_NOTNULL */
    ৰাশিমালা *p_বাম     /* Operand */
  ){
    ৰাশিমালা *p = p_বাম;
    প্রতিজ্ঞা( op==TK_ISNULL || op==TK_NOTNULL );
    প্রতিজ্ঞা( p_বাম!=0 );
    যেতিয়ালৈ( p->op==TK_UPLUS || p->op==TK_UMINUS ){
      p = p->p_বাম;
      প্রতিজ্ঞা( p!=0 );
    }
    ৱিকল্প( p->op ){
      পক্ষ TK_INTEGER:
      পক্ষ TK_STRING:
      পক্ষ TK_FLOAT:
      পক্ষ TK_BLOB: 
        sqlite3_ৰাশিমালা_Deferred_Delete(pParse, p_বাম);
        p = sqlite3_ৰাশিমালা_Int32(pParse->db, op==TK_NOTNULL);
        যদি( p ) p->op2 = 1;
        ঘূৰাই p;
      স্ৱভাৱ:
        ভঙ্গ;
    }
    ঘূৰাই sqlite3PExpr(pParse, op, p_বাম, 0);
  }

  /* Create a TK_IS or TK_ISNOT operator, perhaps optimized to
  ** TK_ISNULL or TK_NOTNULL or TK_TRUEFALSE. */
  স্থির ৰাশিমালা *sqlite3PExprIs(
    Parse *pParse,  /* Parsing context */
    পূর্ণাঙ্ক op,         /* TK_IS or TK_ISNOT */
    ৰাশিমালা *p_বাম,    /* Left operand */
    ৰাশিমালা *p_ডান    /* Right operand */
  ){
    যদি( p_ডান && p_ডান->op==TK_NULL ){
      sqlite3_ৰাশিমালা_Deferred_Delete(pParse, p_ডান);
      ঘূৰাই sqlite3PExprIsNull(pParse, op==TK_IS ? TK_ISNULL : TK_NOTNULL, p_বাম);
    }
    ঘূৰাই sqlite3PExpr(pParse, op, p_বাম, p_ডান);
  }
}

ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) ISNULL|NOTNULL(E).   {A = sqlite3PExprIsNull(pParse,@E,A);}
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) NOT রিক্ত.    {A = sqlite3PExprIsNull(pParse,TK_NOTNULL,A);}

//    expr1 IS expr2       same as    expr1 IS NOT DISTINCT FROM expr2
//    expr1 IS NOT expr2   same as    expr1 IS DISTINCT FROM expr2
//
ৰাশিমালা_2(A) ::= ৰাশিমালা_2(A) IS ৰাশিমালা_2(Y).     {
  A = sqlite3PExprIs(pParse, TK_IS, A, Y);
}
