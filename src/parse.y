%إذا SQLITE_ENABLE_UPDATE_DELETE_حد_بندي || SQLITE_UDL_CAPABLE_PARSER
cmd ::= with UPDATE orconf(R) xfullname(X) اشاريي_وارو_opt(I) سيٽ setlist(Y) from(F)
        where_opt_ret(W) orderby_opt(O) حد_بندي_opt(L).  {
  sqlite3_Src_List_اشاريي_وارو_By(pParse, X, &I);
  إذا( F ){
    SrcList *pFromClause = F;
    إذا( pFromClause->nSrc>1 ){
      Select *pSubquery;
      Token as;
      pSubquery = sqlite3SelectNew(pParse,0,pFromClause,0,0,0,0,SF_NestedFrom,0);
      as.n = 0;
      as.z = 0;
      pFromClause = sqlite3_Src_List_Append_From_رڪن(pParse,0,0,0,&as,pSubquery,0);
    }
    X = sqlite3SrcListAppendList(pParse, X, pFromClause);
  }
  sqlite3_اظهار_List_Check_ڊيگهائي(pParse,Y,"set list"); 
#جيڪڏهن_وصف_نه_ٿيل SQLITE_ENABLE_UPDATE_DELETE_حد_بندي
  إذا( O || L ){
    update_Delete_حد_بندي_Error(pParse,O,L);
    O = 0;
    L = 0;
  }
#جيڪڏهن_پورو
  sqlite3Update(pParse,X,Y,W,R,O,L,0);
}
