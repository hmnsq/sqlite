ৰাশিমালা_2(A) ::= NOT(B) ৰাশিমালা_2(X).  
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
ৰাশিমালা_2(A) ::= BITNOT(B) ৰাশিমালা_2(X).
              {A = sqlite3PExpr(pParse, @B, X, 0);/*A-overwrites-B*/}
ৰাশিমালা_2(A) ::= PLUS|MINUS(B) ৰাশিমালা_2(X). [BITNOT] {
  ৰাশিমালা *p = X;
  u8 op = @B + (TK_UPLUS-TK_PLUS);
  প্রতিজ্ঞা( TK_UPLUS>TK_PLUS );
  প্রতিজ্ঞা( TK_UMINUS == TK_MINUS + (TK_UPLUS - TK_PLUS) );
  যদি( p && p->op==TK_UPLUS ){
    p->op = op;
    A = p;
  }অন্যথা{
    A = sqlite3PExpr(pParse, op, p, 0);
    /*A-overwrites-B*/
  }
}

ৰাশিমালা_2(A) ::= ৰাশিমালা_2(B) PTR(C) ৰাশিমালা_2(D). {
