  %రకం లోపల_op {పూర్ణాంకం}
  లోపల_op(A) ::= లోపల_2.      {A = 0;}
  లోపల_op(A) ::= NOT లోపల_2.  {A = 1;}
  సమాసం_2(A) ::= సమాసం_2(A) లోపల_op(N) LP exprlist(Y) RP. [IN] {
    ఒకవేళ( Y==0 ){
