when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN व्यञ्जकम्_2(X). { A = X; }

%प्रकार trigger_cmd_list {Trigger_चरणः*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_चरणः(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_चरमः->p_अग्र = X;
  A->p_चरमः = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
