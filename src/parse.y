  }
  సమాసం_2(A) ::= సమాసం_2(A) లోపల_op(N) LP select(Y) RP.  [IN] {
    A = sqlite3PExpr(pParse, TK_లోపల, A, 0);
    sqlite3_PExpr_కూడు_Select(pParse, A, Y);
    ఒకవేళ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  సమాసం_2(A) ::= సమాసం_2(A) లోపల_op(N) nm(Y) dbnm(Z) paren_exprlist(E). [IN] {
    SrcList *pSrc = sqlite3SrcListAppend(pParse, 0,&Y,&Z);
    Select *pSelect = sqlite3SelectNew(pParse, 0,pSrc,0,0,0,0,0,0);
    ఒకవేళ( E )  sqlite3_Src_List_Func_వాదనలు(pParse, pSelect ? pSrc : 0, E);
    A = sqlite3PExpr(pParse, TK_లోపల, A, 0);
    sqlite3_PExpr_కూడు_Select(pParse, A, pSelect);
    ఒకవేళ( N ) A = sqlite3PExpr(pParse, TK_NOT, A, 0);
  }
  సమాసం_2(A) ::= EXISTS LP select(Y) RP. {
    సమాసం *p;
    p = A = sqlite3PExpr(pParse, TK_EXISTS, 0, 0);
    sqlite3_PExpr_కూడు_Select(pParse, p, Y);
  }
%endif SQLITE_OMIT_SUBQUERY

/* CASE expressions */
సమాసం_2(A) ::= CASE case_నిర్వాహ్యం(X) case_exprlist(Y) case_else(Z) చివర. {
  A = sqlite3PExpr(pParse, TK_CASE, X, 0);
  ఒకవేళ( A ){
    A->x.pList = Z ? sqlite3_సమాసం_List_Append(pParse,Y,Z) : Y;
    sqlite3_సమాసం_సమితి_ఎత్తు_And_Flags(pParse, A);
  }లేకపోతే{
    sqlite3_సమాసం_List_Delete(pParse->db, Y);
    sqlite3_సమాసం_Delete(pParse->db, Z);
  }
}
%రకం case_exprlist {సమాసం_List*}
%destructor case_exprlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
case_exprlist(A) ::= case_exprlist(A) WHEN సమాసం_2(Y) THEN సమాసం_2(Z). {
  A = sqlite3_సమాసం_List_Append(pParse,A, Y);
  A = sqlite3_సమాసం_List_Append(pParse,A, Z);
}
case_exprlist(A) ::= WHEN సమాసం_2(Y) THEN సమాసం_2(Z). {
  A = sqlite3_సమాసం_List_Append(pParse,0, Y);
  A = sqlite3_సమాసం_List_Append(pParse,A, Z);
}
%రకం case_else {సమాసం*}
%destructor case_else {sqlite3_సమాసం_Delete(pParse->db, $$);}
case_else(A) ::=  ELSE సమాసం_2(X).         {A = X;}
case_else(A) ::=  .                     {A = 0;} 
%రకం case_నిర్వాహ్యం {సమాసం*}
%destructor case_నిర్వాహ్యం {sqlite3_సమాసం_Delete(pParse->db, $$);}
case_నిర్వాహ్యం(A) ::= సమాసం_2(A).
case_నిర్వాహ్యం(A) ::= .                   {A = 0;} 

%రకం exprlist {సమాసం_List*}
%destructor exprlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
%రకం nexprlist {సమాసం_List*}
%destructor nexprlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}

exprlist(A) ::= nexprlist(A).
exprlist(A) ::= .                            {A = 0;}
nexprlist(A) ::= nexprlist(A) COMMA సమాసం_2(Y).
    {A = sqlite3_సమాసం_List_Append(pParse,A,Y);}
nexprlist(A) ::= సమాసం_2(Y).
    {A = sqlite3_సమాసం_List_Append(pParse,0,Y); /*A-overwrites-Y*/}

%ifndef SQLITE_OMIT_SUBQUERY
/* A paren_exprlist is an optional expression list contained inside
** of parenthesis */
%రకం paren_exprlist {సమాసం_List*}
%destructor paren_exprlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
paren_exprlist(A) ::= .   {A = 0;}
paren_exprlist(A) ::= LP exprlist(X) RP.  {A = X;}
%endif SQLITE_OMIT_SUBQUERY


///////////////////////////// The CREATE INDEX command ///////////////////////
//
cmd ::= createkw(S) uniqueflag(U) సూచీ_2 ifnotexists(NE) nm(X) dbnm(D)
        ON nm(Y) LP sortlist(Z) RP where_opt(W). {
  sqlite3_Create_సూచీ(pParse, &X, &D, 
                     sqlite3SrcListAppend(pParse,0,&Y,0), Z, U,
                      &S, W, SQLITE_SO_ASC, NE, SQLITE_IDXTYPE_APPDEF);
  ఒకవేళ( లోపల_RENAME_OBJECT && pParse->p_New_సూచీ ){
    sqlite3RenameTokenMap(pParse, pParse->p_New_సూచీ->zName, &Y);
  }
}

%రకం uniqueflag {పూర్ణాంకం}
uniqueflag(A) ::= UNIQUE.  {A = OE_Abort;}
uniqueflag(A) ::= .        {A = OE_None;}


// The eidlist non-terminal (Expression Id List) generates an ExprList
// from a list of identifiers.  The identifier names are in ExprList.a[].zName.
// This list is stored in an ExprList rather than an IdList so that it
// can be easily sent to sqlite3ColumnsExprList().
//
// eidlist is grouped with CREATE INDEX because it used to be the non-terminal
// used for the arguments to an index.  That is just an historical accident.
//
// IMPORTANT COMPATIBILITY NOTE:  Some prior versions of SQLite accepted
// COLLATE clauses and ASC or DESC keywords on ID lists in inappropriate
// places - places that might have been stored in the sqlite_schema table.
// Those extra features were ignored.  But because they might be in some
// (busted) old databases, we need to continue parsing them when loading
// historical schemas.
//
%రకం eidlist {సమాసం_List*}
%destructor eidlist {sqlite3_సమాసం_List_Delete(pParse->db, $$);}
%రకం eidlist_opt {సమాసం_List*}
%destructor eidlist_opt {sqlite3_సమాసం_List_Delete(pParse->db, $$);}

%include {
  /* Add a single new term to an ExprList that is used to store a
  ** list of identifiers.  Report an error if the ID list contains
  ** a COLLATE clause or an ASC or DESC keyword, except ignore the
  ** error while parsing a legacy schema.
  */
  స్థిర సమాసం_List *parser_కూడు_సమాసం_Id_List_పదం(
    Parse *pParse,
    సమాసం_List *p_పూర్వ,
    Token *pIdToken,
    పూర్ణాంకం hasCollate,
    పూర్ణాంకం క్రమీకరించు_క్రమం
  ){
    సమాసం_List *p = sqlite3_సమాసం_List_Append(pParse, p_పూర్వ, 0);
    ఒకవేళ( (hasCollate || క్రమీకరించు_క్రమం!=SQLITE_SO_UNDEFINED)
        && pParse->db->init.busy==0
    ){
      sqlite3_Error_సందేశం(pParse, "syntax error after column name \"%.*s\"",
                         pIdToken->n, pIdToken->z);
    }
    sqlite3_సమాసం_List_సమితి_Name(pParse, p, pIdToken, 1);
    తిరిగి p;
  }
} // end %include

eidlist_opt(A) ::= .                         {A = 0;}
eidlist_opt(A) ::= LP eidlist(X) RP.         {A = X;}
eidlist(A) ::= eidlist(A) COMMA nm(Y) collate(C) sortorder(Z).  {
  A = parser_కూడు_సమాసం_Id_List_పదం(pParse, A, &Y, C, Z);
}
eidlist(A) ::= nm(Y) collate(C) sortorder(Z). {
  A = parser_కూడు_సమాసం_Id_List_పదం(pParse, 0, &Y, C, Z); /*A-overwrites-Y*/
}

%రకం collate {పూర్ణాంకం}
collate(C) ::= .              {C = 0;}
collate(C) ::= COLLATE ids.   {C = 1;}


///////////////////////////// The DROP INDEX command /////////////////////////
//
cmd ::= DROP సూచీ_2 ifexists(E) fullname(X).   {sqlite3_Drop_సూచీ(pParse, X, E);}

///////////////////////////// The VACUUM command /////////////////////////////
//
%ఒకవేళ !SQLITE_OMIT_VACUUM && !SQLITE_OMIT_ATTACH
%రకం vinto {సమాసం*}
%destructor vinto {sqlite3_సమాసం_Delete(pParse->db, $$);}
cmd ::= VACUUM vinto(Y).                {sqlite3Vacuum(pParse,0,Y);}
cmd ::= VACUUM nm(X) vinto(Y).          {sqlite3Vacuum(pParse,&X,Y);}
vinto(A) ::= INTO సమాసం_2(X).              {A = X;}
vinto(A) ::= .                          {A = 0;}
%endif

///////////////////////////// The PRAGMA command /////////////////////////////
//
%ifndef SQLITE_OMIT_PRAGMA
cmd ::= PRAGMA nm(X) dbnm(Z).                {sqlite3Pragma(pParse,&X,&Z,0,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ nmnum(Y).    {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP nmnum(Y) RP. {sqlite3Pragma(pParse,&X,&Z,&Y,0);}
cmd ::= PRAGMA nm(X) dbnm(Z) EQ minus_అంకె(Y). 
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}
cmd ::= PRAGMA nm(X) dbnm(Z) LP minus_అంకె(Y) RP.
                                             {sqlite3Pragma(pParse,&X,&Z,&Y,1);}

nmnum(A) ::= plus_అంకె(A).
nmnum(A) ::= nm(A).
nmnum(A) ::= ON(A).
nmnum(A) ::= DELETE(A).
nmnum(A) ::= DEFAULT(A).
%endif SQLITE_OMIT_PRAGMA
%token_class సంఖ్య INTEGER|FLOAT.
plus_అంకె(A) ::= PLUS సంఖ్య(X).       {A = X;}
plus_అంకె(A) ::= సంఖ్య(A).
minus_అంకె(A) ::= MINUS సంఖ్య(X).     {A = X;}
//////////////////////////// The CREATE TRIGGER command /////////////////////

%ifndef SQLITE_OMIT_TRIGGER

cmd ::= createkw trigger_decl(A) BEGIN trigger_cmd_list(S) చివర(Z). {
  Token all;
  all.z = A.z;
  all.n = (పూర్ణాంకం)(Z.z - A.z) + Z.n;
  sqlite3_ముగింపు_Trigger(pParse, S, &all);
}

trigger_decl(A) ::= తాత్కాలిక(T) TRIGGER ifnotexists(NOERR) nm(B) dbnm(Z) 
                    trigger_సమయం(C) trigger_event(D)
                    ON fullname(E) foreach_clause when_clause(G). {
  sqlite3BeginTrigger(pParse, &B, &Z, C, D.a, D.b, E, G, T, NOERR);
  A = (Z.n==0?B:Z); /*A-overwrites-T*/
#నిర్వచితమైతే SQLITE_DEBUG
  ప్రతిజ్ఞా( pParse->isCreate ); /* Set by createkw reduce action */
  pParse->isCreate = 0;       /* But, should not be set for CREATE TRIGGER */
#అయితే_ముగింపు
}

%రకం trigger_సమయం {పూర్ణాంకం}
trigger_సమయం(A) ::= BEFORE|AFTER(X).  { A = @X; /*A-overwrites-X*/ }
trigger_సమయం(A) ::= INSTEAD యొక్క_2.  { A = TK_INSTEAD;}
trigger_సమయం(A) ::= .            { A = TK_BEFORE; }

%రకం trigger_event {నిర్మాణం TrigEvent}
%destructor trigger_event {sqlite3IdListDelete(pParse->db, $$.b);}
trigger_event(A) ::= DELETE|చొప్పించు(X).   {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE(X).          {A.a = @X; /*A-overwrites-X*/ A.b = 0;}
trigger_event(A) ::= UPDATE యొక్క_2 idlist(X).{A.a = TK_UPDATE; A.b = X;}

foreach_clause ::= .
foreach_clause ::= FOR EACH అడ్డువరుస.

%రకం when_clause {సమాసం*}
%destructor when_clause {sqlite3_సమాసం_Delete(pParse->db, $$);}
when_clause(A) ::= .             { A = 0; }
when_clause(A) ::= WHEN సమాసం_2(X). { A = X; }

%రకం trigger_cmd_list {Trigger_అడుగు*}
%destructor trigger_cmd_list {sqlite3_Delete_Trigger_అడుగు(pParse->db, $$);}
trigger_cmd_list(A) ::= trigger_cmd_list(A) trigger_cmd(X) SEMI. {
  A->p_చివరి->p_తదుపరి = X;
  A->p_చివరి = X;
}
trigger_cmd_list(A) ::= trigger_cmd(A) SEMI. { 
  A->p_చివరి = A;
}

// Disallow the INDEX BY and NOT INDEXED clauses on UPDATE and DELETE
// statements within triggers.  We make a specific error message for this
// since it is an exception to the default grammar rules.
//
tridxby ::= .
tridxby ::= సూచీకృత BY nm. {
  sqlite3_Error_సందేశం(pParse,
        "the INDEXED BY clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}
tridxby ::= NOT సూచీకృత. {
  sqlite3_Error_సందేశం(pParse,
        "the NOT INDEXED clause is not allowed on UPDATE or DELETE statements "
        "within triggers");
}



%రకం trigger_cmd {Trigger_అడుగు*}
%destructor trigger_cmd {sqlite3_Delete_Trigger_అడుగు(pParse->db, $$);}
// UPDATE 
trigger_cmd(A) ::=
   UPDATE(B) orconf(R) xfullname(X) tridxby సమితి setlist(Y) from(F) where_opt(Z) scanpt(E).  
   {A = sqlite3_Trigger_Update_అడుగు(pParse, X, F, Y, Z, R, B.z, E);}

//చొప్పించు
trigger_cmd(A) ::= scanpt(B) చొప్పించు_cmd(R) INTO
                   xfullname(X) idlist_opt(F) select(S) upsert(U) scanpt(Z). {
   A = sqlite3_Trigger_చొప్పించు_అడుగు(pParse,X,F,S,R,U,B,Z);/*A-overwrites-R*/
}
// DELETE
trigger_cmd(A) ::= DELETE(B) FROM xfullname(X) tridxby where_opt(Y) scanpt(E).
   {A = sqlite3_Trigger_Delete_అడుగు(pParse, X, Y, B.z, E);}

// SELECT
trigger_cmd(A) ::= scanpt(B) select(X) scanpt(E).
   {A = sqlite3_Trigger_Select_అడుగు(pParse->db, X, B, E); /*A-overwrites-X*/}

// The special RAISE expression that may occur in trigger programs
సమాసం_2(A) ::= RAISE LP IGNORE RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, 0, 0); 
  ఒకవేళ( A ){
    A->aff_సమాసం = OE_Ignore;
  }
}
సమాసం_2(A) ::= RAISE LP raisetype(T) COMMA సమాసం_2(Z) RP.  {
  A = sqlite3PExpr(pParse, TK_RAISE, Z, 0);
  ఒకవేళ( A ) {
    A->aff_సమాసం = (అక్షరం)T;
  }
}
%endif  !SQLITE_OMIT_TRIGGER

%రకం raisetype {పూర్ణాంకం}
raisetype(A) ::= ROLLBACK.  {A = OE_Rollback;}
raisetype(A) ::= ABORT.     {A = OE_Abort;}
raisetype(A) ::= FAIL.      {A = OE_Fail;}


////////////////////////  DROP TRIGGER statement //////////////////////////////
%ifndef SQLITE_OMIT_TRIGGER
cmd ::= DROP TRIGGER ifexists(NOERR) fullname(X). {
  sqlite3DropTrigger(pParse,X,NOERR);
}
%endif  !SQLITE_OMIT_TRIGGER

//////////////////////// ATTACH DATABASE file AS name /////////////////////////
%ifndef SQLITE_OMIT_ATTACH
cmd ::= ATTACH database_kw_opt సమాసం_2(F) AS సమాసం_2(D) కీలకం_opt(K). {
  sqlite3Attach(pParse, F, D, K);
}
cmd ::= DETACH database_kw_opt సమాసం_2(D). {
  sqlite3Detach(pParse, D);
}

%రకం కీలకం_opt {సమాసం*}
%destructor కీలకం_opt {sqlite3_సమాసం_Delete(pParse->db, $$);}
కీలకం_opt(A) ::= .                     { A = 0; }
కీలకం_opt(A) ::= కీలకం_2 సమాసం_2(X).          { A = X; }

database_kw_opt ::= DATABASE.
database_kw_opt ::= .
%endif SQLITE_OMIT_ATTACH

////////////////////////// REINDEX collation //////////////////////////////////
%ifndef SQLITE_OMIT_REINDEX
cmd ::= REINDEX.                {sqlite3Reindex(pParse, 0, 0);}
cmd ::= REINDEX nm(X) dbnm(Y).  {sqlite3Reindex(pParse, &X, &Y);}
%endif  SQLITE_OMIT_REINDEX

/////////////////////////////////// ANALYZE ///////////////////////////////////
%ifndef SQLITE_OMIT_ANALYZE
cmd ::= ANALYZE.                {sqlite3Analyze(pParse, 0, 0);}
cmd ::= ANALYZE nm(X) dbnm(Y).  {sqlite3Analyze(pParse, &X, &Y);}
%endif

//////////////////////// ALTER TABLE table ... ////////////////////////////////
%ifndef SQLITE_OMIT_ALTERTABLE 
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= ALTER పట్టిక_3 fullname(X) RENAME గమ్యం_2 nm(Z). {
  sqlite3_Alter_Rename_పట్టిక(pParse,X,&Z);
}

// The ALTER TABLE ADD COLUMN command. This is broken into two sections so
// that sqlite3AlterBeginAddColumn() is called before parsing the various
// constraints and so on (carglist) attached to the new column definition.
cmd ::= alter_కూడు(Y) carglist. {
  Y.n = (పూర్ణాంకం)(pParse->s_చివరి_Token.z-Y.z) + pParse->s_చివరి_Token.n;
  sqlite3_Alter_ముగింపు_కూడు_స్తంభం(pParse, &Y);
}
alter_కూడు(A) ::= ALTER పట్టిక_3 fullname(X) కూడు kwcolumn_opt nm(Y) typetoken(Z). {
  disableLookaside(pParse);
  sqlite3_Alter_Begin_కూడు_స్తంభం(pParse, X);
  sqlite3_కూడు_స్తంభం(pParse, Y, Z);
  A = Y;
}

cmd ::= ALTER పట్టిక_3 fullname(X) DROP kwcolumn_opt nm(Y). {
  sqlite3_Alter_Drop_స్తంభం(pParse, X, &Y);
}
cmd ::= ALTER పట్టిక_3 fullname(X) RENAME kwcolumn_opt nm(Y) గమ్యం_2 nm(Z). {
  sqlite3_Alter_Rename_స్తంభం(pParse, X, &Y, &Z);
}
cmd ::= ALTER పట్టిక_3 fullname(X) DROP CONSTRAINT nm(Y). {
  sqlite3AlterDropConstraint(pParse, X, &Y, 0);
}
cmd ::= ALTER పట్టిక_3 fullname(X) ALTER kwcolumn_opt nm(Y) DROP NOT ఖాళీ. {
  sqlite3AlterDropConstraint(pParse, X, 0, &Y);
}
cmd ::= ALTER పట్టిక_3 fullname(X) ALTER kwcolumn_opt nm(Y) సమితి NOT(Z) ఖాళీ onconf. {
  sqlite3_Alter_సమితి_Not_Null(pParse, X, &Y, &Z);
}
cmd ::= ALTER పట్టిక_3 fullname(X) కూడు CONSTRAINT(Y) nm(Z) CHECK LP(A) సమాసం_2(E) RP(B) onconf. {
  sqlite3_Alter_కూడు_Constraint(pParse, X, &Y, &Z, A.z+1, (B.z-A.z-1), E);
}
cmd ::= ALTER పట్టిక_3 fullname(X) కూడు CHECK(Y) LP(A) సమాసం_2(E) RP(B) onconf. {
  sqlite3_Alter_కూడు_Constraint(pParse, X, &Y, 0, A.z+1, (B.z-A.z-1), E);
}

kwcolumn_opt ::= .
kwcolumn_opt ::= COLUMNKW.

%endif SQLITE_OMIT_VIRTUALTABLE
%endif SQLITE_OMIT_ALTERTABLE

//////////////////////// CREATE VIRTUAL TABLE ... /////////////////////////////
%ifndef SQLITE_OMIT_VIRTUALTABLE
cmd ::= create_vtab.                       {sqlite3_Vtab_ముగింపు_Parse(pParse,0);}
cmd ::= create_vtab LP vtabarglist RP(X).  {sqlite3_Vtab_ముగింపు_Parse(pParse,&X);}
create_vtab ::= createkw VIRTUAL పట్టిక_3 ifnotexists(E)
                nm(X) dbnm(Y) USING nm(Z). {
    sqlite3VtabBeginParse(pParse, &X, &Y, &Z, E);
}
vtabarglist ::= vtabarg.
vtabarglist ::= vtabarglist COMMA vtabarg.
vtabarg ::= .                       {sqlite3VtabArgInit(pParse);}
vtabarg ::= vtabarg vtabargtoken.
vtabargtoken ::= ANY(X).            {sqlite3VtabArgExtend(pParse,&X);}
vtabargtoken ::= lp anylist RP(X).  {sqlite3VtabArgExtend(pParse,&X);}
lp ::= LP(X).                       {sqlite3VtabArgExtend(pParse,&X);}
anylist ::= .
anylist ::= anylist LP anylist RP.
anylist ::= anylist ANY.
%endif  SQLITE_OMIT_VIRTUALTABLE


//////////////////////// COMMON TABLE EXPRESSIONS ////////////////////////////
%రకం wqlist {With*}
%destructor wqlist {sqlite3WithDelete(pParse->db, $$);}
%రకం wqitem {Cte*}
// %destructor wqitem {sqlite3CteDelete(pParse->db, $$);} // not reachable

with ::= .
%ifndef SQLITE_OMIT_CTE
with ::= WITH wqlist(W).              { sqlite3_With_నెట్టు(pParse, W, 1); }
with ::= WITH RECURSIVE wqlist(W).    { sqlite3_With_నెట్టు(pParse, W, 1); }

%రకం wqas {u8}
wqas(A)   ::= AS.                  {A = M10d_Any;}
wqas(A)   ::= AS MATERIALIZED.     {A = M10d_Yes;}
wqas(A)   ::= AS NOT MATERIALIZED. {A = M10d_No;}
wqitem(A) ::= withnm(X) eidlist_opt(Y) wqas(M) LP select(Z) RP. {
  A = sqlite3CteNew(pParse, &X, Y, Z, M); /*A-overwrites-X*/
}
withnm(A) ::= nm(A). {pParse->bHasWith = 1;}
wqlist(A) ::= wqitem(X). {
  A = sqlite3_With_కూడు(pParse, 0, X); /*A-overwrites-X*/
}
wqlist(A) ::= wqlist(A) COMMA wqitem(X). {
  A = sqlite3_With_కూడు(pParse, A, X);
}
%endif  SQLITE_OMIT_CTE

//////////////////////// WINDOW FUNCTION EXPRESSIONS /////////////////////////
// These must be at the end of this file. Specifically, the rules that
// introduce tokens WINDOW, OVER and FILTER must appear last. This causes 
// the integer values assigned to these tokens to be larger than all other 
// tokens that may be output by the tokenizer except TK_SPACE, TK_COMMENT,
// and TK_ILLEGAL.
//
%ifndef SQLITE_OMIT_WINDOWFUNC
%రకం windowdefn_list {కిటికీ*}
%destructor windowdefn_list {sqlite3_కిటికీ_List_Delete(pParse->db, $$);}
windowdefn_list(A) ::= windowdefn(A).
windowdefn_list(A) ::= windowdefn_list(Y) COMMA windowdefn(Z). {
  ప్రతిజ్ఞా( Z!=0 );
  sqlite3_కిటికీ_Chain(pParse, Z, Y);
  Z->p_తదుపరి_Win = Y;
  A = Z;
}

%రకం windowdefn {కిటికీ*}
%destructor windowdefn {sqlite3_కిటికీ_Delete(pParse->db, $$);}
windowdefn(A) ::= nm(X) AS LP కిటికీ_2(Y) RP. {
  ఒకవేళ( ALWAYS(Y) ){
    Y->zName = sqlite3DbStrNDup(pParse->db, X.z, X.n);
  }
  A = Y;
}

%రకం కిటికీ_2 {కిటికీ*}
%destructor కిటికీ_2 {sqlite3_కిటికీ_Delete(pParse->db, $$);}

%రకం చట్రం_opt {కిటికీ*}
%destructor చట్రం_opt {sqlite3_కిటికీ_Delete(pParse->db, $$);}

%రకం part_opt {సమాసం_List*}
%destructor part_opt {sqlite3_సమాసం_List_Delete(pParse->db, $$);}

%రకం filter_clause {సమాసం*}
%destructor filter_clause {sqlite3_సమాసం_Delete(pParse->db, $$);}

%రకం over_clause {కిటికీ*}
%destructor over_clause {sqlite3_కిటికీ_Delete(pParse->db, $$);}

%రకం filter_over {కిటికీ*}
%destructor filter_over {sqlite3_కిటికీ_Delete(pParse->db, $$);}

%రకం range_or_అడ్డువరుసలు {పూర్ణాంకం}

%రకం చట్రం_bound {నిర్మాణం చట్రం_Bound}
%destructor చట్రం_bound {sqlite3_సమాసం_Delete(pParse->db, $$.p_సమాసం);}
%రకం చట్రం_bound_s {నిర్మాణం చట్రం_Bound}
%destructor చట్రం_bound_s {sqlite3_సమాసం_Delete(pParse->db, $$.p_సమాసం);}
%రకం చట్రం_bound_e {నిర్మాణం చట్రం_Bound}
%destructor చట్రం_bound_e {sqlite3_సమాసం_Delete(pParse->db, $$.p_సమాసం);}

కిటికీ_2(A) ::= విభజన BY nexprlist(X) orderby_opt(Y) చట్రం_opt(Z). {
  A = sqlite3_కిటికీ_Assemble(pParse, Z, X, Y, 0);
}
కిటికీ_2(A) ::= nm(W) విభజన BY nexprlist(X) orderby_opt(Y) చట్రం_opt(Z). {
  A = sqlite3_కిటికీ_Assemble(pParse, Z, X, Y, &W);
}
కిటికీ_2(A) ::= క్రమం BY sortlist(Y) చట్రం_opt(Z). {
  A = sqlite3_కిటికీ_Assemble(pParse, Z, 0, Y, 0);
}
కిటికీ_2(A) ::= nm(W) క్రమం BY sortlist(Y) చట్రం_opt(Z). {
  A = sqlite3_కిటికీ_Assemble(pParse, Z, 0, Y, &W);
}
కిటికీ_2(A) ::= చట్రం_opt(A).
కిటికీ_2(A) ::= nm(W) చట్రం_opt(Z). {
  A = sqlite3_కిటికీ_Assemble(pParse, Z, 0, 0, &W);
}

చట్రం_opt(A) ::= .                             { 
  A = sqlite3_కిటికీ_Alloc(pParse, 0, TK_UNBOUNDED, 0, TK_CURRENT, 0, 0);
}
చట్రం_opt(A) ::= range_or_అడ్డువరుసలు(X) చట్రం_bound_s(Y) చట్రం_exclude_opt(Z). { 
  A = sqlite3_కిటికీ_Alloc(pParse, X, Y.eType, Y.p_సమాసం, TK_CURRENT, 0, Z);
}
చట్రం_opt(A) ::= range_or_అడ్డువరుసలు(X) BETWEEN చట్రం_bound_s(Y) AND
                          చట్రం_bound_e(Z) చట్రం_exclude_opt(W). { 
  A = sqlite3_కిటికీ_Alloc(pParse, X, Y.eType, Y.p_సమాసం, Z.eType, Z.p_సమాసం, W);
}

range_or_అడ్డువరుసలు(A) ::= RANGE|అడ్డువరుసలు|GROUPS(X).   {A = @X; /*A-overwrites-X*/}

చట్రం_bound_s(A) ::= చట్రం_bound(X).         {A = X;}
చట్రం_bound_s(A) ::= UNBOUNDED(X) PRECEDING. {A.eType = @X; A.p_సమాసం = 0;}
చట్రం_bound_e(A) ::= చట్రం_bound(X).         {A = X;}
చట్రం_bound_e(A) ::= UNBOUNDED(X) FOLLOWING. {A.eType = @X; A.p_సమాసం = 0;}

చట్రం_bound(A) ::= సమాసం_2(X) PRECEDING|FOLLOWING(Y).
                                             {A.eType = @Y; A.p_సమాసం = X;}
చట్రం_bound(A) ::= CURRENT(X) అడ్డువరుస.           {A.eType = @X; A.p_సమాసం = 0;}

%రకం చట్రం_exclude_opt {u8}
చట్రం_exclude_opt(A) ::= . {A = 0;}
చట్రం_exclude_opt(A) ::= EXCLUDE చట్రం_exclude(X). {A = X;}

%రకం చట్రం_exclude {u8}
చట్రం_exclude(A) ::= NO(X) OTHERS.   {A = @X; /*A-overwrites-X*/}
చట్రం_exclude(A) ::= CURRENT(X) అడ్డువరుస. {A = @X; /*A-overwrites-X*/}
చట్రం_exclude(A) ::= సమూహం|TIES(X).  {A = @X; /*A-overwrites-X*/}


%రకం కిటికీ_clause {కిటికీ*}
%destructor కిటికీ_clause {sqlite3_కిటికీ_List_Delete(pParse->db, $$);}
కిటికీ_clause(A) ::= కిటికీ_3 windowdefn_list(B). { A = B; }

filter_over(A) ::= filter_clause(F) over_clause(O). {
  ఒకవేళ( O ){
    O->pFilter = F;
  }లేకపోతే{
    sqlite3_సమాసం_Delete(pParse->db, F);
  }
  A = O;
}
filter_over(A) ::= over_clause(O). {
  A = O;
}
filter_over(A) ::= filter_clause(F). {
  A = (కిటికీ*)sqlite3DbMallocZero(pParse->db, పరిమాణం(కిటికీ));
  ఒకవేళ( A ){
    A->eFrmType = TK_FILTER;
    A->pFilter = F;
  }లేకపోతే{
    sqlite3_సమాసం_Delete(pParse->db, F);
  }
}

over_clause(A) ::= OVER LP కిటికీ_2(Z) RP. {
  A = Z;
  ప్రతిజ్ఞా( A!=0 );
}
over_clause(A) ::= OVER nm(Z). {
  A = (కిటికీ*)sqlite3DbMallocZero(pParse->db, పరిమాణం(కిటికీ));
  ఒకవేళ( A ){
    A->zName = sqlite3DbStrNDup(pParse->db, Z.z, Z.n);
  }
}

filter_clause(A) ::= FILTER LP WHERE సమాసం_2(X) RP.  { A = X; }
%endif /* SQLITE_OMIT_WINDOWFUNC */

/*
** The code generator needs some extra TK_ token values for tokens that
** are synthesized and do not actually appear in the grammar:
*/
%token
  స్తంభం_2          /* Reference to a table column */
  AGG_FUNCTION    /* An aggregate function */
  AGG_స్తంభం      /* An aggregated column */
  TRUEFALSE       /* True or false keyword */
  ISNOT           /* Combination of IS and NOT */
  FUNCTION        /* A function invocation */
  UPLUS           /* Unary plus */
  UMINUS          /* Unary minus */
  TRUTH           /* IS TRUE or IS FALSE or IS NOT TRUE or IS NOT FALSE */
  రిజిస్టరు        /* Reference to a VDBE register */
  సదిశ          /*సదిశ*/
  SELECT_స్తంభం   /* Choose a single column from a multi-column SELECT */
  IF_NULL_అడ్డువరుస     /* the if-null-row operator */
  ASTERISK        /* The "*" in count(*) and similar */
  పరిధి            /* The span operator */
  ERROR           /* An expression containing an error */
.

పదం(A) ::= QNUMBER(X). {
  A=token_సమాసం(pParse,@X,X);
  sqlite3_Dequote_సంఖ్య(pParse, A);
}

/* There must be no more than 255 tokens defined above.  If this grammar
** is extended with new rules and tokens, they must either be so few in
** number that TK_SPAN is no more than 255, or else the new tokens must
** appear after this line.
*/
%include {
#ఒకవేళ TK_పరిధి>255
# error too many టోకెన్లు in the grammar
#అయితే_ముగింపు
}

/*
** The TK_SPACE, TK_COMMENT, and TK_ILLEGAL tokens must be the last three
** tokens.  The parser depends on this.  Those tokens are not used in any
** grammar rule.  They are only used by the tokenizer.  Declare them last
** so that they are guaranteed to be the last three.
*/
%token SPACE COMMENT ILLEGAL.
